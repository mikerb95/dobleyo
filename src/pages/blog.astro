---
import Layout from "../layouts/Layout.astro";
import DarkHero from "../components/shop/DarkHero.astro";
import PostCard from "../components/shop/PostCard.astro";
import { getCanonicalUrl, getHreflangPair } from "../i18n/index.ts";

const STATIC_POSTS = [
  { slug: 'dia-de-cosecha', title: 'Un día de cosecha: lo que cuesta cada grano que te tomas', excerpt: 'Detrás de esa taza de la mañana hay madrugadas en la montaña, canastos al hombro y manos que escogen grano por grano. Vale la pena conocer ese trabajo.', cover_image_url: 'https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
  { slug: 'del-tinto-al-especialidad', title: 'Del tinto de la esquina al café de especialidad (sin traicionar a nadie)', excerpt: 'Tomar café de especialidad no significa renegar del tinto de toda la vida. Es más bien volverse curioso. Te cuento cómo hacer el salto sin volverte insoportable.', cover_image_url: 'https://images.unsplash.com/photo-1447933601403-0c6688de566e?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
  { slug: 'procesos-lavado-honey-natural', title: 'Lavado, honey o natural: lo que le pasa al café antes de llegar a tu taza', excerpt: 'En la etiqueta dice "honey" o "natural" y suena a chino. Pero ese paso, que ocurre en la finca, define buena parte de lo que vas a saborear. Te lo explico fácil.', cover_image_url: 'https://images.unsplash.com/photo-1442512595331-e89e73853f31?q=80&w=800&auto=format&fit=crop', reading_time_min: 6 },
  { slug: 'greca-en-casa', title: 'La greca de la casa: cómo sacarle un buen café al método más nuestro', excerpt: 'Casi todas las cocinas colombianas tienen una greca arrumada por ahí. No es un método de segunda: bien usada, da un café con carácter. Aquí te cuento cómo.', cover_image_url: 'https://images.unsplash.com/photo-1521302080334-4bebac2763a6?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
  { slug: 'cafe-narino', title: 'Nariño: el café que crece donde casi no debería', excerpt: 'En Nariño los cafetales suben hasta donde otros cultivos ya se rinden. Esa terquedad de la montaña es justo lo que vuelve esta taza tan especial.', cover_image_url: 'https://images.unsplash.com/photo-1459755486867-b55449bb39ff?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
  { slug: 'receta-v60', title: 'Mi receta de V60 para empezar la mañana', excerpt: 'No necesitas equipo de campeonato para sacar una taza honesta en casa. Esta es la receta con la que arranco casi todos los días.', cover_image_url: 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=800&auto=format&fit=crop', reading_time_min: 4 },
  { slug: 'notas-cata-huila', title: 'Lo que hay detrás de una taza de Huila', excerpt: 'Cuando alguien dice que un café "sabe a durazno", no está exagerando. Te cuento qué buscar en una taza de Huila y por qué nos enamoró este origen.', cover_image_url: 'https://images.unsplash.com/photo-1497515114629-f71d768fd07c?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
  { slug: 'guia-molienda', title: 'La molienda: el detalle que casi nadie cuida (y lo cambia todo)', excerpt: 'Compras un café buenísimo, lo preparas… y sabe a poco. Casi siempre el culpable no es el grano: es la molienda. Aquí te lo explico sin enredos.', cover_image_url: 'https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?q=80&w=800&auto=format&fit=crop', reading_time_min: 5 },
];

let posts: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT slug, title, excerpt, cover_image_url, reading_time_min, tags, published_at
     FROM blog_posts WHERE is_published = 1 ORDER BY published_at DESC`
  );
  if (result.rows.length > 0) posts = result.rows;
} catch (_) { /* BD no disponible */ }

if (!posts.length) posts = STATIC_POSTS;

const hreflang = getHreflangPair("/blog");
// El más reciente va de portada en el encabezado; el resto, en la rejilla
const [featured, ...rest] = posts;
// Rejilla de 3 sin huecos al final: con 3k+2 artículos el primero va ancho;
// con 3k+1, el primero y el cuarto (cada uno ocupa dos columnas)
const wide = new Set<number>(rest.length % 3 === 2 ? [0] : rest.length % 3 === 1 && rest.length >= 4 ? [0, 3] : []);
---

<Layout
  title="Blog · DobleYo Café"
  description="Recetas, notas de cata y guías de preparación para amantes del café de especialidad."
  canonical={getCanonicalUrl('/blog', 'es')}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    crumb="Blog"
    title="Historias del café"
    titleEm="colombiano."
    lead="Recetas, notas de origen y guías de preparación, contadas desde la finca hasta su taza."
    facts={[
      { icon: "file-text", text: `${posts.length} artículos` },
      { icon: "dripper", text: "Recetas y métodos" },
    ]}
  >
    {featured && <PostCard post={featured} feature label="Lo más reciente" />}
  </DarkHero>

  {rest.length > 0 && (
    <section class="blog">
      <h2 class="blog__title">Más artículos</h2>
      <ul class="blog__grid" data-blog-grid>
        {rest.map((post: any, i: number) => (
          <li class:list={{ "blog__wide": wide.has(i) }}><PostCard post={post} wide={wide.has(i)} /></li>
        ))}
      </ul>
    </section>
  )}

  <script>
    import "../scripts/shop/index.ts";
  </script>
</Layout>

<style>
  .blog { max-width: 1200px; margin: 0 auto; padding: var(--space-16) 1.25rem var(--space-16); }
  .blog__title { margin: 0 0 var(--space-8); font-family: var(--font-display); font-size: var(--text-3xl); color: var(--espresso); }
  .blog__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  @media (min-width: 640px) { .blog__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .blog__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .blog__wide { grid-column: span 2; }
  }
</style>
