---
import Layout from "../layouts/Layout.astro";
import Stars from "../components/Stars.astro";
import HomeHero from "../components/home/HomeHero.astro";
import OriginStrip from "../components/home/OriginStrip.astro";
import TraceJourney from "../components/home/TraceJourney.astro";
import Manifesto from "../components/home/Manifesto.astro";
import HomeFarms from "../components/home/HomeFarms.astro";
import WhyGrid from "../components/home/WhyGrid.astro";
import { getFeaturedLot } from "../lib/lot.server.ts";
import { products as staticProducts } from "../data/products.ts";
import { getCanonicalUrl, getHreflangPair } from "../i18n/index.ts";
import { reviewAggregateSql } from "../lib/products.server.ts";
import {
  getRating,
  getNotes,
  formatWeight,
  stockLabel,
  getStockLevel,
} from "../lib/products.ts";
import { SHOW_CUPPING } from "../lib/flags.ts";

const _hreflang = getHreflangPair("/");

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DobleYo Café",
  url: "https://dobleyo.cafe",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: "https://dobleyo.cafe/buscar?q={search_term_string}",
    },
    "query-input": "required name=search_term_string",
  },
};

// Lote destacado: alimenta la etiqueta viva del hero y la escena del viaje
const featuredLot = await getFeaturedLot("es");

// Productos desde BD (fallback a estáticos)
let coffeeProducts: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT p.id, p.slug, p.name, p.origin, p.process, p.roast, p.price, p.rating,
            p.tasting_notes, p.weight, p.weight_unit,
            p.is_bestseller AS bestseller, p.is_new AS new, p.image_url AS image,
            p.stock_quantity AS stock,
            ${reviewAggregateSql("p")}
     FROM products p
     WHERE p.is_active = 1 AND p.category = 'cafe'
     ORDER BY p.is_bestseller DESC, p.is_new DESC, p.rating DESC
     LIMIT 3`
  );
  if (result.rows.length > 0) {
    coffeeProducts = result.rows;
  }
} catch (_) {}

if (!coffeeProducts.length) {
  coffeeProducts = staticProducts
    .filter((p) => p.category === "Cafés")
    .slice(0, 3);
}

// Fincas destacadas
let featuredFarms: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT name, slug, region, altitude_min, altitude_max, cover_image_url
     FROM farms WHERE is_published = 1 ORDER BY created_at DESC LIMIT 3`
  );
  featuredFarms = result.rows;
} catch (_) {}

// Últimos posts del blog
let recentPosts: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT slug, title, excerpt, cover_image_url, reading_time_min, published_at
     FROM blog_posts WHERE is_published = 1 ORDER BY published_at DESC LIMIT 3`
  );
  recentPosts = result.rows;
} catch (_) {}

// Kits de regalo
let featuredKits: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT id, name, description, price, image_url AS image
     FROM products WHERE is_gift_set = 1 AND is_active = 1
     ORDER BY price ASC LIMIT 3`
  );
  featuredKits = result.rows;
} catch (_) {}

// Reseñas destacadas
let featuredReviews: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT r.reviewer_name, r.rating, r.comment, p.name AS product_name
     FROM product_reviews r
     JOIN products p ON p.id = r.product_id
     WHERE r.is_approved = 1 AND r.comment IS NOT NULL AND r.comment != ''
     ORDER BY r.created_at DESC LIMIT 3`
  );
  featuredReviews = result.rows;
} catch (_) {}
---

<Layout
  lang="es"
  canonical={getCanonicalUrl("/", "es")}
  hreflangEs={_hreflang?.es}
  hreflangEn={_hreflang?.en}
  jsonLd={websiteJsonLd}
>
  <HomeHero lang="es" lot={featuredLot} />

  <OriginStrip lang="es" />

  <!-- Cafés en venta -->
  <section class="cs-section" aria-labelledby="csSectionTitle">
    <div class="cs-header container">
      <div>
        <p class="cs-eyebrow">Nuestros cafés</p>
        <h2 id="csSectionTitle" class="cs-title">Origen único, tueste fresco</h2>
      </div>
      <a href="/tienda" class="cs-all-link">Ver todos los productos →</a>
    </div>

    <div class="cs-grid container">
      {
        coffeeProducts.map((p) => {
          const rating = getRating(p);
          const notes = SHOW_CUPPING ? getNotes(p, "es") : [];
          const weight = formatWeight(p, "es");
          const stockLevel = getStockLevel(p);
          const stock = stockLabel(p, "es");
          return (
          <article class="cs-card">
            <div class="cs-card__img-wrap">
              <img src={p.image} alt={p.name} class="cs-card__img" loading="lazy" width="400" height="480" />
              {p.bestseller && <span class="cs-card__flag">Más vendido</span>}
              {p.new && !p.bestseller && <span class="cs-card__flag cs-card__flag--new">Nuevo</span>}
              {stock && (
                <span class={`cs-card__stock cs-card__stock--${stockLevel}`}>{stock}</span>
              )}
            </div>
            <div class="cs-card__body">
              <p class="cs-card__meta">
                {p.origin}
                {p.process && <span class="cs-card__dot" aria-hidden="true">·</span>}
                {p.process && <span>{p.process}</span>}
              </p>
              <h3 class="cs-card__name">{p.name}</h3>
              {rating && (
                <Stars
                  value={rating.value}
                  count={rating.count}
                  fromReviews={rating.fromReviews}
                  lang="es"
                />
              )}
              {notes.length > 0 && (
                <ul class="cs-card__notes" aria-label="Notas de cata">
                  {notes.map((n) => (
                    <li class="cs-card__note">{n}</li>
                  ))}
                </ul>
              )}
              <div class="cs-card__footer">
                <span class="cs-card__pricing">
                  <span class="cs-card__price">${p.price.toLocaleString("es-CO")}</span>
                  {weight && <span class="cs-card__weight">{weight}</span>}
                </span>
                <button
                  class="cs-card__add btn-add"
                  aria-label={`Agregar ${p.name} al carrito`}
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.price}
                  data-image={p.image}
                  disabled={stockLevel === "out" || undefined}
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
          );
        })
      }
    </div>
  </section>

  <!-- Del grano a tu taza: el recorrido del lote destacado -->
  <TraceJourney lang="es" lot={featuredLot} />

  <Manifesto lang="es" />

  <HomeFarms lang="es" farms={featuredFarms} />

  <WhyGrid lang="es" lot={featuredLot} />

  <!-- Kits de regalo -->
  {featuredKits.length > 0 && (
    <section class="kits-section" aria-labelledby="kitsTitle">
      <div class="container">
        <div class="kits-header">
          <div>
            <p class="kits-eyebrow">Para regalar</p>
            <h2 id="kitsTitle" class="kits-title">Kits diseñados para sorprender</h2>
          </div>
          <a href="/regalos" class="kits-link">Ver todos los kits →</a>
        </div>
        <div class="kits-grid">
          {featuredKits.map((kit: any) => (
            <a href={`/producto/${kit.id}`} class="kit-card">
              <div class="kit-card__img-wrap">
                <img
                  src={kit.image || 'https://images.unsplash.com/photo-1559496417-e7f25cb247f3?q=80&w=600&auto=format&fit=crop'}
                  alt={kit.name}
                  loading="lazy"
                  class="kit-card__img"
                />
              </div>
              <div class="kit-card__body">
                <span class="kit-card__tag">Kit regalo</span>
                <h3 class="kit-card__name">{kit.name}</h3>
                {kit.description && <p class="kit-card__desc">{kit.description.slice(0, 90)}…</p>}
                <span class="kit-card__price">${Number(kit.price).toLocaleString('es-CO')}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter en home -->
  <section class="newsletter-section" aria-labelledby="nlTitle">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-copy">
          <p class="newsletter-eyebrow">Newsletter</p>
          <h2 id="nlTitle" class="newsletter-title">10% de descuento en tu primera compra</h2>
          <p class="newsletter-sub">Suscríbete y recibe el código al instante. También te avisamos de nuevas cosechas y lanzamientos.</p>
        </div>
        <form class="newsletter-form" id="homeNewsletterForm" novalidate>
          <label for="homeNlEmail" class="sr-only">Correo electrónico</label>
          <input
            type="email"
            id="homeNlEmail"
            class="newsletter-input"
            placeholder="tu@correo.com"
            required
            autocomplete="email"
          />
          <button type="submit" class="newsletter-btn">Suscribirse</button>
        </form>
        <p class="newsletter-msg" id="homeNlMsg" style="display:none"></p>
      </div>
    </div>
  </section>

  <!-- Últimas entradas del blog -->
  {recentPosts.length > 0 && (
    <section class="blog-section" aria-labelledby="blogTitle">
      <div class="container">
        <div class="blog-home-header">
          <div>
            <p class="blog-eyebrow">Blog</p>
            <h2 id="blogTitle" class="blog-home-title">Recetas, notas de cata y guías</h2>
          </div>
          <a href="/blog" class="blog-home-link">Ver todas las entradas →</a>
        </div>
        <div class="blog-home-grid">
          {recentPosts.map((post: any) => (
            <a href={`/blog/${post.slug}`} class="blog-home-card">
              <div class="blog-home-card__img-wrap">
                <img
                  src={post.cover_image_url || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=600&auto=format&fit=crop'}
                  alt={post.title}
                  loading="lazy"
                  class="blog-home-card__img"
                />
              </div>
              <div class="blog-home-card__body">
                <h3 class="blog-home-card__title">{post.title}</h3>
                {post.excerpt && <p class="blog-home-card__exc">{post.excerpt.slice(0, 80)}…</p>}
                <span class="blog-home-card__time">{post.reading_time_min ?? 3} min de lectura</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Reseñas -->
  {featuredReviews.length > 0 && (
    <section class="reviews-home" aria-labelledby="reviewsHomeTitle">
      <div class="container">
        <div class="reviews-home-header">
          <p class="reviews-eyebrow">Lo que dicen nuestros clientes</p>
          <h2 id="reviewsHomeTitle" class="reviews-home-title">Reseñas verificadas</h2>
        </div>
        <div class="reviews-home-grid">
          {featuredReviews.map((r: any) => (
            <div class="review-home-card">
              <div class="review-home-card__stars" aria-label={`${r.rating} estrellas`}>
                {"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}
              </div>
              <p class="review-home-card__comment">"{r.comment}"</p>
              <div class="review-home-card__meta">
                <strong>{r.reviewer_name}</strong>
                {r.product_name && <span>sobre {r.product_name}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Script: newsletter de home -->
  <!-- Newsletter + botones "+" del grid (externalizado por CSP estricta) -->
  <script is:inline src="/assets/js/home.js"></script>
  <script>
    import "../scripts/home/index.ts";
  </script>
  <style>
    /* =============================================
       COFFEE SECTION
    ============================================= */
    .cs-section {
      padding: 4rem 0;
      border-top: 1px solid var(--border);
    }
    .cs-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .cs-eyebrow {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .5rem;
    }
    .cs-title {
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--coffee);
      margin: 0;
      line-height: 1.1;
    }
    .cs-all-link {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: .85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
      padding-bottom: 1px;
      border-bottom: 1px solid transparent;
      transition: border-color .15s;
    }
    .cs-all-link:hover { border-bottom-color: var(--accent); }

    .cs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 1024px) { .cs-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
    @media (max-width: 480px)  { .cs-grid { grid-template-columns: 1fr; gap: 1rem; } }

    .cs-card {
      display: flex;
      flex-direction: column;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: .875rem;
      overflow: hidden;
      transition: box-shadow .2s ease, transform .2s ease;
    }
    .cs-card:hover {
      box-shadow: 0 8px 32px rgba(37,26,20,.1);
      transform: translateY(-3px);
    }

    .cs-card__img-wrap {
      position: relative;
      overflow: hidden;
      background: var(--cream);
      aspect-ratio: 4 / 5;
    }
    .cs-card__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .4s ease;
    }
    .cs-card:hover .cs-card__img { transform: scale(1.04); }

    .cs-card__flag {
      position: absolute;
      top: .875rem;
      left: .875rem;
      background: var(--coffee);
      color: var(--accent-contrast);
      font-family: 'Inter', sans-serif;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: .25rem .6rem;
      border-radius: .25rem;
    }
    .cs-card__flag--new { background: var(--leaf); }

    /* Señal de disponibilidad: abajo a la izquierda para no chocar con el flag */
    .cs-card__stock {
      position: absolute;
      bottom: .875rem;
      left: .875rem;
      font-family: var(--font-body);
      font-size: .68rem;
      font-weight: 700;
      letter-spacing: .04em;
      padding: .25rem .55rem;
      border-radius: 99px;
      backdrop-filter: blur(4px);
    }
    .cs-card__stock--low {
      background: var(--warning-bg);
      color: var(--caramel-deep);
      border: 1px solid var(--warning-border);
    }
    .cs-card__stock--out {
      background: var(--danger-bg);
      color: var(--danger);
      border: 1px solid var(--danger);
    }

    .cs-card__body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: .375rem;
      flex: 1;
    }
    .cs-card__meta {
      font-family: 'Inter', sans-serif;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0;
    }
    .cs-card__dot { margin: 0 .2rem; opacity: .5; }
    .cs-card__name {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--coffee);
      margin: 0;
      line-height: 1.2;
    }
    /* Notas de cata: la señal que distingue un café de especialidad de un genérico */
    .cs-card__notes {
      display: flex;
      flex-wrap: wrap;
      gap: .35rem;
      list-style: none;
      margin: .15rem 0 0;
      padding: 0;
    }
    .cs-card__note {
      font-family: var(--font-body);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .02em;
      color: var(--leaf);
      background: var(--leaf-bg);
      padding: .2rem .5rem;
      border-radius: 99px;
    }

    .cs-card__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: .875rem;
      border-top: 1px solid var(--border);
    }
    .cs-card__pricing {
      display: flex;
      align-items: baseline;
      gap: .4rem;
    }
    .cs-card__price {
      font-family: 'Inter', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--coffee);
    }
    .cs-card__weight {
      font-family: var(--font-body);
      font-size: .78rem;
      color: var(--muted-fg);
    }
    .cs-card__add {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--coffee);
      color: var(--accent-contrast);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s, transform .15s;
      flex-shrink: 0;
    }
    .cs-card__add:hover { background: var(--accent); }
    .cs-card__add:disabled {
      background: var(--border);
      color: var(--muted-fg);
      cursor: not-allowed;
    }
    .cs-card__add--added {
      background: var(--leaf);
      transform: scale(.92);
    }

    /* =============================================
       KITS DE REGALO
    ============================================= */
    .kits-section {
      padding: 5rem 0;
      border-top: 1px solid var(--border);
      background: var(--sand);
    }
    .kits-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .kits-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .5rem;
    }
    .kits-title {
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--coffee);
      margin: 0;
    }
    .kits-link {
      font-family: 'Inter', sans-serif;
      font-size: .85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
    }
    .kits-link:hover { text-decoration: underline; }
    .kits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .kit-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: .875rem;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      transition: box-shadow .2s, transform .2s;
    }
    .kit-card:hover { box-shadow: 0 8px 28px rgba(37,26,20,.1); transform: translateY(-3px); }
    .kit-card__img-wrap { aspect-ratio: 4/3; overflow: hidden; background: var(--cream); }
    .kit-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .kit-card:hover .kit-card__img { transform: scale(1.04); }
    .kit-card__body { padding: 1.25rem; display: flex; flex-direction: column; gap: .4rem; }
    .kit-card__tag {
      font-family: 'Inter', sans-serif;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .kit-card__name { font-size: 1.05rem; font-weight: 700; color: var(--coffee); margin: 0; }
    .kit-card__desc { font-size: .82rem; color: var(--muted-fg); margin: 0; line-height: 1.5; }
    .kit-card__price { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 700; color: var(--coffee); margin-top: .25rem; }
    @media (max-width: 1024px) { .kits-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .kits-grid { grid-template-columns: 1fr; } }

    /* =============================================
       NEWSLETTER EN HOME
    ============================================= */
    .newsletter-section {
      padding: 5rem 0;
      background: transparent;
      border-top: 1px solid var(--border);
    }
    .newsletter-inner {
      max-width: 640px;
      margin: 0 auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .newsletter-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0;
    }
    .newsletter-title {
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      color: var(--coffee);
      margin: 0;
      line-height: 1.2;
    }
    .newsletter-sub {
      font-size: .92rem;
      color: var(--muted-fg);
      margin: 0;
      line-height: 1.6;
      max-width: 48ch;
    }
    .newsletter-form {
      display: flex;
      gap: .5rem;
      width: 100%;
      max-width: 460px;
      margin-top: .5rem;
    }
    .newsletter-input {
      flex: 1;
      padding: .7rem 1rem;
      border: 1.5px solid var(--border);
      border-radius: 6px;
      background: var(--card);
      color: var(--coffee);
      font-size: .95rem;
      outline: none;
      font-family: inherit;
    }
    .newsletter-input::placeholder { color: var(--muted-fg); }
    .newsletter-input:focus { border-color: var(--accent); }
    .newsletter-btn {
      padding: .7rem 1.4rem;
      background: var(--accent);
      color: var(--accent-contrast);
      border: none;
      border-radius: 6px;
      font-size: .9rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity .15s;
      font-family: inherit;
    }
    .newsletter-btn:hover { opacity: .88; }
    .newsletter-btn:disabled { opacity: .5; cursor: not-allowed; }
    .newsletter-msg { font-size: .88rem; margin: 0; }
    .newsletter-msg.success { color: var(--leaf); }
    .newsletter-msg.error { color: var(--danger); }
