---
import Layout from "../layouts/Layout.astro";
import DarkHero from "../components/shop/DarkHero.astro";
import BrewGuide from "../components/shop/BrewGuide.astro";
import NumberedList from "../components/shop/NumberedList.astro";
import CtaBand from "../components/shop/CtaBand.astro";
import { getCanonicalUrl, getHreflangPair } from "../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/guias");
const pageTitle = "Guías de preparación · DobleYo Café";
const pageDescription =
  "Aprenda a preparar el mejor café de especialidad en casa: molienda, proporciones, temperatura y métodos paso a paso. Guías prácticas de DobleYo Café.";

// Recetas: el panel saca los números de estos textos (lib/brew.ts)
const metodos = [
  {
    icon: "dripper",
    title: "Método V60",
    summary: "Un filtrado limpio que resalta las notas florales y cítricas de los cafés de origen.",
    ratio: "1:16 (15 g de café · 240 ml de agua)",
    grind: "Media",
    time: "2:30 a 3:00 min",
    temp: "92 a 94 °C",
  },
  {
    icon: "chemex",
    title: "Chemex",
    summary: "Filtro grueso para una taza nítida y de cuerpo ligero, ideal para compartir.",
    ratio: "1:15 (40 g de café · 600 ml de agua)",
    grind: "Media-gruesa",
    time: "4:00 a 5:00 min",
    temp: "93 a 95 °C",
  },
  {
    icon: "press",
    title: "Prensa francesa",
    summary: "Inmersión total para un café con cuerpo y mayor presencia de aceites.",
    ratio: "1:14 (30 g de café · 420 ml de agua)",
    grind: "Gruesa",
    time: "4:00 min",
    temp: "93 °C",
  },
  {
    icon: "moka",
    title: "Moka / Greca",
    summary: "El clásico de la cocina colombiana: intenso, concentrado y rápido.",
    ratio: "Llenar el embudo sin presionar",
    grind: "Fina-media",
    time: "4:00 a 5:00 min",
    temp: "Fuego medio-bajo",
  },
];

const consejos = [
  { title: "Agua filtrada", text: "El café es 98 % agua: su calidad se nota en la taza." },
  { title: "Muela al momento", text: "Muela justo antes de preparar para conservar los aromas." },
  { title: "Use balanza", text: "Pese el café y el agua para que cada taza salga igual." },
  { title: "Tueste reciente", text: "Consuma el café dentro de las 4 semanas posteriores al tueste." },
  { title: "Bien guardado", text: "Guarde el grano en un recipiente hermético, lejos de la luz y el calor." },
];
---

<Layout
  lang="es"
  title={pageTitle}
  description={pageDescription}
  canonical={getCanonicalUrl("/guias", "es")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    crumb="Guías"
    title="Prepare un mejor café"
    titleEm="en casa."
    lead="Recetas paso a paso para sacarle todo el potencial a nuestros cafés de especialidad. Elija su método y vea la receta."
    facts={[
      { icon: "dripper", text: "4 métodos" },
      { icon: "clock", text: "Tiempos y temperaturas" },
    ]}
  >
    <BrewGuide methods={metodos} lang="es" />
  </DarkHero>

  <NumberedList eyebrow="Antes de empezar" title="5 consejos esenciales" items={consejos} />

  <CtaBand
    title="Ponga en práctica estas guías"
    text="Elija un café de especialidad y empiece a experimentar en su taza."
    primary={{ href: "/tienda", label: "Ver la tienda" }}
    secondary={{ href: "/accesorios", label: "Ver accesorios" }}
  />

  <script>
    import "../scripts/shop/index.ts";
  </script>
</Layout>
