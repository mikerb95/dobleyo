---
import Layout from "../layouts/Layout.astro";
import DarkHero from "../components/shop/DarkHero.astro";
import SupplyLine from "../components/shop/SupplyLine.astro";
import FeatureGrid from "../components/shop/FeatureGrid.astro";
import ChipRow from "../components/shop/ChipRow.astro";
import CtaBand from "../components/shop/CtaBand.astro";
import { getCanonicalUrl, getHreflangPair } from "../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/partners");
const pageTitle = "Zona de partners · DobleYo Café";
const pageDescription =
  "Conviértase en aliado de DobleYo Café: cafeterías, restaurantes, tiendas y distribuidores. Café de especialidad colombiano de origen único y acompañamiento comercial.";

const beneficios = [
  {
    icon: "handshake",
    title: "Comercio directo",
    text: "Compramos a los caficultores sin intermediarios y le trasladamos esa calidad a precio de aliado.",
  },
  {
    icon: "map-pin",
    title: "Origen con nombre propio",
    text: "Cada lote viene de una finca y una cosecha concretas, una historia que puede contarles a sus clientes.",
  },
  {
    icon: "flame",
    title: "Tueste a la medida",
    text: "Definimos el perfil de tueste según su método y volumen, con entregas frescas y programadas.",
  },
  {
    icon: "trending-up",
    title: "Acompañamiento",
    text: "Material de marca, capacitación de barismo y soporte para que su operación crezca con nosotros.",
  },
];

const perfiles = [
  { icon: "coffee", label: "Cafeterías y coffee shops" },
  { icon: "utensils", label: "Restaurantes y hoteles" },
  { icon: "store", label: "Tiendas y mercados de especialidad" },
  { icon: "truck", label: "Distribuidores regionales" },
  { icon: "building", label: "Oficinas y espacios corporativos" },
];
---

<Layout
  lang="es"
  title={pageTitle}
  description={pageDescription}
  canonical={getCanonicalUrl("/partners", "es")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    crumb="Partners"
    title="Crezcamos juntos"
    titleEm="con café de origen."
    lead="Si su negocio vive del buen café, queremos ser su aliado: café de especialidad colombiano de origen único, tueste a la medida y el acompañamiento que su operación necesita."
    cta={{ href: "/contacto", label: "Quiero ser partner" }}
    cta2={{ href: "/mayoristas", label: "Ver mayoristas" }}
  >
    <SupplyLine
      stops={[
        { icon: "sprout", title: "La finca", text: "Compra directa al caficultor" },
        { icon: "flame", title: "Tueste a su medida", text: "Perfil según su método" },
        { icon: "store", title: "Su negocio", text: "Entregas frescas y programadas" },
      ]}
    />
  </DarkHero>

  <FeatureGrid eyebrow="Beneficios" title="Por qué aliarse con DobleYo" items={beneficios} />

  <ChipRow title="¿Para quién es?" items={perfiles}>
    ¿Maneja volúmenes mayores? Conozca también nuestra opción para <a href="/mayoristas">mayoristas</a>.
  </ChipRow>

  <CtaBand
    title="Hablemos de su negocio"
    text="Cuéntenos qué necesita y diseñamos una propuesta a su medida."
    primary={{ href: "/contacto", label: "Contáctenos" }}
  />

  <script>
    import "../scripts/shop/index.ts";
  </script>
</Layout>
