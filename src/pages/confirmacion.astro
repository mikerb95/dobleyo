---
import Icon from "../components/Icon.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Confirmación de pedido — DobleYo Café"
  description="Resumen y estado de tu pedido en DobleYo Café."
  noindex={true}
>
  <div class="conf-page">

    <!-- Loading -->
    <div id="stateLoading" class="conf-loading" aria-live="polite">
      <div class="conf-spinner" role="status" aria-label="Verificando pedido..."></div>
      <p class="conf-loading__text">Verificando su pedido…</p>
    </div>

    <!-- Pagado / Procesando -->
    <div id="statePaid" class="conf-state" style="display:none;">
      <div class="conf-anim conf-anim--success" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M5 14l6 6 12-12" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="conf-title" id="paidTitle">¡Pedido confirmado!</h1>
      <p class="conf-subtitle" id="paidSubtitle">Recibirá un correo de confirmación con los detalles de su pedido.</p>
      <section id="orderTracking" class="conf-card conf-tracking" aria-labelledby="trackingTitle" hidden></section>
      <div id="orderDetails" class="conf-card"></div>
      <div class="conf-next-steps" id="nextSteps">
        <div class="conf-step-item">
          <span class="conf-step-icon" aria-hidden="true"><Icon name="inbox" size={22} /></span>
          <div>
            <p class="conf-step-title">Confirmación por email</p>
            <p class="conf-step-desc">En los próximos minutos</p>
          </div>
        </div>
        <div class="conf-step-item">
          <span class="conf-step-icon" aria-hidden="true"><Icon name="package" size={22} /></span>
          <div>
            <p class="conf-step-title">Preparación del pedido</p>
            <p class="conf-step-desc">1–2 días hábiles</p>
          </div>
        </div>
        <div class="conf-step-item">
          <span class="conf-step-icon" aria-hidden="true"><Icon name="truck" size={22} /></span>
          <div>
            <p class="conf-step-title">Envío a su puerta</p>
            <p class="conf-step-desc">3–5 días hábiles</p>
          </div>
        </div>
      </div>
      <a href="/tienda" class="conf-btn-primary">Seguir comprando</a>
    </div>

    <!-- Pago pendiente -->
    <div id="statePending" class="conf-state" style="display:none;">
      <div class="conf-anim conf-anim--pending" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="#fff" stroke-width="2"/><path d="M14 9v5l3 3" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 class="conf-title">Pago en proceso</h1>
      <p class="conf-subtitle" id="pendingSubtitle">Su pedido fue creado. Estamos esperando la confirmación de Wompi; esta página se actualiza sola.</p>
      <div id="orderDetailsPending" class="conf-card"></div>
      <p class="conf-help">
        ¿Problemas con el pago?
        <a href="/contacto">Contáctenos</a>
      </p>
    </div>

    <!-- No se pudo verificar (error de red): no es lo mismo que un pago rechazado -->
    <div id="stateUnknown" class="conf-state" style="display:none;">
      <div class="conf-anim conf-anim--pending" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="#fff" stroke-width="2"/><path d="M14 9v6M14 18.5v.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
      </div>
      <h1 class="conf-title">No pudimos verificar su pedido</h1>
      <p class="conf-subtitle">Hubo un problema de conexión al consultar el estado del pago. Si pagó, su pedido está registrado y le llegará un correo de confirmación.</p>
      <div class="conf-error-actions">
        <button type="button" class="conf-btn-primary" id="retryVerify">Volver a verificar</button>
      </div>
      <p class="conf-help">¿Necesita ayuda? <a href="/contacto">Contáctenos</a></p>
    </div>

    <!-- Error / Cancelado -->
    <div id="stateError" class="conf-state" style="display:none;">
      <div class="conf-anim conf-anim--error" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M8 8l12 12M20 8L8 20" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
      </div>
      <h1 class="conf-title conf-title--error">Pago no completado</h1>
      <p class="conf-subtitle">Su pago fue rechazado o cancelado. No se realizó ningún cobro.</p>
      <div class="conf-error-actions">
        <a href="/checkout" class="conf-btn-primary">Intentar de nuevo</a>
        <a href="/cart" class="conf-btn-secondary">Ver carrito</a>
      </div>
      <p class="conf-help">¿Necesita ayuda? <a href="/contacto">Contáctenos</a></p>
    </div>

    <!-- No encontrado -->
    <div id="stateNotFound" class="conf-state" style="display:none;">
      <div class="conf-anim conf-anim--error" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="14" r="10" stroke="#fff" stroke-width="2"/><path d="M14 9v6M14 17v1.5" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/></svg>
      </div>
      <h1 class="conf-title">Pedido no encontrado</h1>
      <p class="conf-subtitle">No pudimos encontrar un pedido con esta referencia.</p>
      <a href="/" class="conf-btn-primary">Ir al inicio</a>
    </div>

  </div>

  <script is:inline src="/assets/js/confirmacion.js"></script>

  <style>
    .conf-page {
      max-width: 520px;
      margin: 0 auto;
      padding: 3rem 1.25rem 5rem;
    }
    @media (max-width: 480px) {
      .conf-page { padding: 2rem 1rem 4rem; }
      .conf-card { padding: 1.25rem; }
      .conf-title { font-size: 1.4rem; }
      .conf-next-steps { border-radius: .75rem; }
      .conf-step-item { padding: .875rem 1.125rem; }
      .conf-btn-primary { width: 100%; }
      .conf-error-actions { flex-direction: column; }
      .conf-btn-secondary { width: 100%; }
    }

    /* Loading */
    .conf-loading {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 4rem 0;
      gap: 1rem;
    }
    .conf-spinner {
      width: 44px;
      height: 44px;
      border: 3px solid var(--border);
      border-top-color: var(--coffee);
      border-radius: 50%;
      animation: conf-spin .75s linear infinite;
    }
    @keyframes conf-spin { to { transform: rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .conf-spinner { animation: none; } }
    .conf-loading__text { color: var(--muted-fg); font-size: .9rem; }

    /* States */
    .conf-state { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0; }

    /* Animated icon */
    .conf-anim {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      animation: conf-pop .4s cubic-bezier(.175,.885,.32,1.275);
    }
    @keyframes conf-pop {
      from { transform: scale(.5); opacity: 0; }
      to   { transform: scale(1); opacity: 1; }
    }
    .conf-anim--success { background: linear-gradient(135deg, #16a34a, #22c55e); box-shadow: 0 8px 24px rgba(22,163,74,.25); }
    .conf-anim--pending { background: linear-gradient(135deg, #d97706, #f59e0b); box-shadow: 0 8px 24px rgba(217,119,6,.25); }
    .conf-anim--error   { background: linear-gradient(135deg, #dc2626, #ef4444); box-shadow: 0 8px 24px rgba(220,38,38,.25); }

    .conf-title {
      font-size: clamp(1.5rem, 4vw, 2rem);
      font-weight: 800;
      color: var(--coffee);
      margin: 0 0 .5rem;
    }
    .conf-title--error { color: #b91c1c; }
    .conf-subtitle {
      color: var(--muted-fg);
      font-size: .95rem;
      line-height: 1.6;
      margin: 0 0 1.75rem;
    }

    /* Order card */
    .conf-card {
      width: 100%;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.5rem;
      text-align: left;
      margin-bottom: 1.75rem;
    }
    .oc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1.25rem;
      border-bottom: 1px solid var(--border);
    }
    .oc-ref-label { font-size: .7rem; color: var(--muted-fg); text-transform: uppercase; letter-spacing: .05em; margin: 0 0 .2rem; }
    .oc-ref { font-size: 1.1rem; font-weight: 700; color: var(--coffee); margin: 0; }
    .oc-status {
      font-size: .75rem;
      font-weight: 700;
      padding: .3rem .75rem;
      border-radius: 9999px;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .oc-items { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1rem; }
    .oc-line {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      font-size: .875rem;
    }
    .oc-line__name { color: var(--coffee); flex: 1; min-width: 0; }
    .oc-line__price { color: var(--coffee); font-weight: 600; white-space: nowrap; }

    .oc-totals {
      border-top: 1px solid var(--border);
      padding-top: .875rem;
      display: flex;
      flex-direction: column;
      gap: .4rem;
      margin-bottom: .875rem;
    }
    .oc-total-line {
      display: flex;
      justify-content: space-between;
      font-size: .875rem;
      color: var(--muted-fg);
    }
    .oc-total-line--final {
      font-weight: 800;
      font-size: 1.05rem;
      color: var(--coffee);
      border-top: 1px solid var(--border);
      padding-top: .625rem;
      margin-top: .25rem;
    }

    .oc-delivery {
      display: flex;
      align-items: center;
      gap: .4rem;
      font-size: .8rem;
      color: #4a6741;
      background: #f0fdf4;
      padding: .5rem .875rem;
      border-radius: .5rem;
    }

    /* Next steps */
    .conf-next-steps {
      width: 100%;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 1rem;
      overflow: hidden;
      margin-bottom: 1.75rem;
      text-align: left;
    }
    .conf-step-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid var(--border);
    }
    .conf-step-item:last-child { border-bottom: none; }
    .conf-step-icon { flex-shrink: 0; color: var(--caramel); }
    .conf-step-title { font-size: .9rem; font-weight: 600; color: var(--coffee); margin: 0 0 .15rem; }
    .conf-step-desc  { font-size: .8rem; color: var(--muted-fg); margin: 0; }

    /* Buttons */
    .conf-btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .875rem 2.5rem;
      background: var(--coffee);
      color: #fff;
      border: none;
      border-radius: .75rem;
      font-size: .975rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: opacity .15s, transform .1s;
      min-height: 48px;
    }
    .conf-btn-primary:hover { opacity: .88; }
    .conf-btn-primary:active { transform: scale(.98); }

    .conf-btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: .875rem 2rem;
      background: transparent;
      color: var(--coffee);
      border: 1.5px solid var(--border);
      border-radius: .75rem;
      font-size: .975rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      transition: border-color .15s, background .15s;
      min-height: 48px;
    }
    .conf-btn-secondary:hover { border-color: var(--coffee); background: #f9f6f2; }

    .conf-error-actions {
      display: flex;
      gap: .75rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 1.25rem;
    }

    .conf-help {
      font-size: .85rem;
      color: var(--muted-fg);
      margin: .875rem 0 0;
    }
    .conf-help a { color: var(--accent); text-decoration: none; }
    .conf-help a:hover { text-decoration: underline; }

    /* Seguimiento del envío */
    .conf-tracking[hidden] { display: none; }
    .tr-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
    .tr-title { font-size: 1rem; font-weight: 700; color: var(--coffee); margin: 0 0 .2rem; }
    .tr-carrier { font-size: .85rem; color: var(--muted-fg); margin: 0; }
    .tr-guide {
      display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap;
      background: #f9f6f2; border-radius: .625rem; padding: .75rem 1rem; margin-bottom: 1rem;
    }
    .tr-guide__label { font-size: .7rem; color: var(--muted-fg); text-transform: uppercase; letter-spacing: .05em; margin: 0 0 .15rem; }
    .tr-guide__number { font-size: 1.05rem; font-weight: 700; color: var(--coffee); margin: 0; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
    .tr-link {
      display: inline-flex; align-items: center; min-height: 40px; padding: 0 1rem;
      border-radius: .5rem; background: var(--coffee); color: #fff; font-size: .85rem; font-weight: 600; text-decoration: none;
    }
    .tr-link:hover { opacity: .88; }
    .tr-events { list-style: none; margin: 0; padding: 0; }
    .tr-events li { display: grid; grid-template-columns: 14px 1fr; gap: .75rem; padding-bottom: .875rem; }
    .tr-events li::before { content: ""; width: 10px; height: 10px; margin-top: 5px; border-radius: 50%; background: var(--border); }
    .tr-events li:first-child::before { background: #16a34a; box-shadow: 0 0 0 4px rgba(22,163,74,.15); }
    .tr-events__state { font-size: .875rem; font-weight: 600; color: var(--coffee); margin: 0; }
    .tr-events__meta { font-size: .78rem; color: var(--muted-fg); margin: .1rem 0 0; }
    .tr-empty { font-size: .85rem; color: var(--muted-fg); margin: 0; }
  </style>
</Layout>
