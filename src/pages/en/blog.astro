---
import Layout from "../../layouts/Layout.astro";
import DarkHero from "../../components/shop/DarkHero.astro";
import CtaBand from "../../components/shop/CtaBand.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/blog");
// Por ahora los artículos están solo en español (blog_posts no tiene idioma).
// Se enlazan en su versión original en vez de mostrarlos en una página en inglés.
---

<Layout
  lang="en"
  title="Blog · DobleYo Café"
  description="Recipes, brewing guides, tasting notes and stories from the Colombian coffee world. DobleYo Café blog."
  canonical={getCanonicalUrl("/blog", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    lang="en"
    crumb="Blog"
    title="Recipes, notes"
    titleEm="and coffee stories."
    lead="Brewing guides, tasting notes and behind-the-scenes stories from Colombia's coffee farms. For now, our articles are written in Spanish."
    cta={{ href: "https://dobleyo.cafe/blog", label: "Read them in Spanish" }}
    cta2={{ href: "/guides", label: "Brewing guides" }}
  />

  <CtaBand
    title="Brew along in English"
    text="Our brewing guides are already in English: ratios, grind, times and temperatures for each method."
    primary={{ href: "/guides", label: "See the guides" }}
    secondary={{ href: "/shop", label: "Browse coffees" }}
  />

  <script>
    import "../../scripts/shop/index.ts";
  </script>
</Layout>
