---
import Layout from "../../layouts/Layout.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/nosotros");
---

<Layout
  lang="en"
  title="About · DobleYo Café"
  description="DobleYo Café is a small Colombian coffee company that buys directly from farming families and roasts in small batches."
  canonical={getCanonicalUrl("/about", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <article class="about">
    <header class="about__head">
      <h1 class="about__title">We're a small coffee company in Colombia.</h1>
      <p class="about__lead">
        We buy from coffee-farming families, roast in small batches and send it to people's homes.
        That's most of the job.
      </p>
    </header>

    <img
      class="about__photo"
      src="/assets/img/origen-cosecha.webp"
      alt="Ripe coffee cherries on the branch"
      loading="lazy"
    />

    <div class="about__body">
      <h2>The name</h2>
      <p>
        DobleYo means something like "double I": the farmer who grows the coffee with care and the
        person looking for an honest cup. One needs the other, and we work in the space between them.
      </p>

      <h2>How we work</h2>
      <p>
        We buy directly, from regions like Huila, Nariño and the Sierra Nevada. Each coffee keeps the
        name of the place it came from instead of disappearing into a blend. We roast in small
        batches and your order goes out within 15 days of roasting.
      </p>

      <h2>Why there's a site in English</h2>
      <p>
        Plenty of people living in Colombia read English first, and buying coffee for your own
        kitchen shouldn't take a dictionary. Same coffee and same prices as our Spanish site, and
        you can write to us in either language.
      </p>
    </div>

    <nav class="about__next" aria-label="Keep reading">
      <a href="/shop">Shop the coffee</a>
      <a href="/farms">See the farms</a>
      <a href="/contact">Say hello</a>
    </nav>
  </article>
</Layout>

<style>
  .about { max-width: 760px; margin: 0 auto; padding: var(--space-12) 0 var(--space-16); }
  .about__title {
    margin: 0 0 var(--space-4); font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 2vw, 3.25rem); line-height: 1.08; letter-spacing: -.01em;
    color: var(--espresso); text-wrap: balance;
  }
  .about__lead { margin: 0; font-size: var(--text-lg); line-height: 1.6; color: var(--ink-muted); }
  .about__photo { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin: var(--space-8) 0; border-radius: var(--radius-lg); }
  .about__body h2 { margin: var(--space-8) 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-xl); color: var(--espresso); }
  .about__body p { margin: 0; line-height: 1.75; color: var(--ink); }
  .about__next { display: flex; flex-wrap: wrap; gap: var(--space-5); margin-top: var(--space-10); padding-top: var(--space-5); border-top: 1px solid var(--border); }
  .about__next a { color: var(--caramel-deep); font-weight: 600; }
</style>
