---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

const hreflang = getHreflangPair("/envios-devoluciones");

const faq = [
  { q: "Can I change my order after placing it?", a: "Yes, if you write to us within 2 hours of buying. Once it has shipped, the returns policy applies." },
  { q: "How do I track my order?", a: "You get an email with the tracking number as soon as it ships. Use it on the courier's website." },
  { q: "What if my package arrives damaged?", a: "Send us photos right away and don't open it more than you need to. We'll sort it out with the courier and replace your order at no cost." },
  { q: "Who pays for a return?", a: "We do if it's our mistake or a defect. If you changed your mind, the return shipping is on you." },
  { q: "How do refunds work?", a: "They go back to your original payment method and can take 5 to 10 business days to appear, depending on your bank." },
  { q: "Can I return part of an order?", a: "Yes. We review each product on its own." },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  lang="en"
  title="Delivery & Returns · DobleYo Café"
  description="Delivery times and costs across Colombia, and how returns work at DobleYo Café. Free delivery over $120,000 COP."
  canonical={getCanonicalUrl("/shipping", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
  jsonLd={faqJsonLd}
>
  <section class="ship-page">
    <header class="ship-hero">
      <h1>Delivery &amp; returns</h1>
      <p class="ship-hero__lead">How long it takes, what it costs and what happens if something goes wrong.</p>
    </header>

    <ul class="ship-stats">
      <li class="ship-stats__item">
        <Icon name="truck" size={22} />
        <div>
          <strong>Free delivery</strong>
          <span>On orders over $120,000 COP</span>
        </div>
      </li>
      <li class="ship-stats__item">
        <Icon name="rotate-cw" size={22} />
        <div>
          <strong>30 days</strong>
          <span>To ask for a return on unopened products</span>
        </div>
      </li>
      <li class="ship-stats__item">
        <Icon name="clock" size={22} />
        <div>
          <strong>Tracking included</strong>
          <span>From dispatch to your door</span>
        </div>
      </li>
    </ul>

    <div class="ship-grid">
      <article class="card">
        <div class="card__head">
          <span class="card__icon"><Icon name="package" /></span>
          <h2>Delivery</h2>
        </div>

        <h3>How long it takes</h3>
        <table class="ship-table">
          <tbody>
            <tr><th scope="row">Bogotá and metro area</th><td>2 to 3 business days</td></tr>
            <tr><th scope="row">Other main cities</th><td>3 to 5 business days</td></tr>
            <tr><th scope="row">Everywhere else</th><td>4 to 7 business days</td></tr>
          </tbody>
        </table>

        <h3>What it costs</h3>
        <ul class="ship-list">
          <li>Orders under $120,000 COP: <strong>$12,000 COP</strong></li>
          <li>Orders of $120,000 COP or more: <strong>free</strong></li>
          <li>Subscriptions: delivery is always included</li>
        </ul>

        <h3>Cash on delivery</h3>
        <p>
          Choose it at checkout and the courier collects the full amount when they hand over your
          order. You'll need a Colombian mobile number.
        </p>

        <h3>Your ID number</h3>
        <p>
          The courier asks for one to issue the shipping label. A cédula de extranjería or a passport works fine.
        </p>
      </article>

      <article class="card">
        <div class="card__head">
          <span class="card__icon"><Icon name="rotate-cw" /></span>
          <h2>Returns</h2>
        </div>

        <h3>How long you have</h3>
        <p>You have <strong>30 days</strong> from the date you bought to ask for a return or exchange.</p>

        <h3>What we need</h3>
        <ul class="ship-list">
          <li>The product unopened and in its original condition</li>
          <li>All of its original packaging and accessories</li>
          <li>Your proof of purchase</li>
        </ul>

        <h3>How it works</h3>
        <ol class="ship-steps">
          <li>Write to us with your order number</li>
          <li>We send you instructions and a return label</li>
          <li>Pack the product securely and send it back</li>
          <li>We check it (3 to 5 business days)</li>
          <li>We process your refund or exchange (5 to 7 business days)</li>
        </ol>

        <h3>Your right to change your mind</h3>
        <p>
          Colombian consumer law (Article 47, Law 1480 of 2011) also lets you cancel a purchase made
          at a distance within 5 business days of delivery, without giving a reason. It doesn't cover
          perishable products or coffee that has been opened. See our <a href="/terms">terms</a>.
        </p>
      </article>
    </div>

    <div class="callout callout--warning">
      <Icon name="alert-triangle" size={22} />
      <div>
        <h3>What we can't take back</h3>
        <ul class="ship-list">
          <li><strong>Ground or whole-bean coffee</strong>, once opened</li>
          <li><strong>Perishable products</strong>, once opened</li>
          <li>Personalized or made-to-order accessories</li>
          <li>Products damaged after delivery</li>
          <li>Purchases from clearance sales</li>
        </ul>
      </div>
    </div>

    <div class="card card--wide">
      <div class="card__head">
        <span class="card__icon"><Icon name="phone" /></span>
        <h2>Need a hand?</h2>
      </div>
      <div class="contact-grid">
        <div class="contact-item">
          <Icon name="whatsapp" size={18} />
          <h3>WhatsApp</h3>
          <a href="https://wa.me/573204981580" target="_blank" rel="noopener" class="contact-item__link">+57 320 498 1580</a>
          <span class="contact-item__meta">Monday to Friday, 9 a.m. to 6 p.m.</span>
        </div>
        <div class="contact-item">
          <Icon name="mail" size={18} />
          <h3>Email</h3>
          <a href="mailto:hello@dobleyo.cafe" class="contact-item__link">hello@dobleyo.cafe</a>
          <span class="contact-item__meta">We reply within 24 to 48 hours</span>
        </div>
      </div>
    </div>

    <div class="ship-qa">
      <h2>Common questions</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <style>
    .ship-page {
      max-width: 1200px;
      margin-inline: auto;
      padding: var(--space-12) 1.25rem var(--space-16);
    }

    .ship-hero {
      max-width: 640px;
      margin-bottom: var(--space-10);
    }

    .ship-hero h1 {
      font-size: var(--text-3xl);
      margin: 0 0 var(--space-3);
    }

    .ship-hero__lead {
      font-size: var(--text-lg);
      color: var(--ink-muted);
      margin: 0;
    }

    .ship-stats {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-4);
      margin: 0 0 var(--space-10);
      padding: 0;
    }

    .ship-stats__item {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: var(--space-5);
      color: var(--caramel);
    }

    .ship-stats__item div {
      display: flex;
      flex-direction: column;
      color: var(--fg);
    }

    .ship-stats__item strong {
      font-size: var(--text-base);
      font-weight: 600;
    }

    .ship-stats__item span {
      font-size: var(--text-sm);
      color: var(--ink-muted);
    }

    .ship-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: var(--space-6);
      margin-bottom: var(--space-8);
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      padding: var(--space-8);
    }

    .card--wide {
      margin-bottom: var(--space-8);
    }

    .card__head {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
    }

    .card__icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 999px;
      background: var(--cream);
      color: var(--caramel);
      flex-shrink: 0;
    }

    .card h2 {
      font-size: var(--text-xl);
      margin: 0;
    }

    .card h3 {
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--ink-muted);
      margin: var(--space-5) 0 var(--space-2);
    }

    .card h3:first-of-type {
      margin-top: 0;
    }

    .card p {
      margin: 0 0 var(--space-2);
      line-height: 1.65;
    }

    .card a {
      color: var(--caramel);
      text-decoration: underline;
    }

    .ship-list {
      margin: 0 0 var(--space-2);
      padding-left: 1.25rem;
      line-height: 1.8;
    }

    .ship-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: var(--space-2);
    }

    .ship-table th,
    .ship-table td {
      text-align: left;
      padding: var(--space-2) 0;
      border-bottom: 1px solid var(--border);
      font-weight: 400;
      font-size: var(--text-sm);
    }

    .ship-table th {
      color: var(--fg);
      font-weight: 500;
    }

    .ship-table td {
      color: var(--ink-muted);
      text-align: right;
    }

    .ship-table tr:last-child th,
    .ship-table tr:last-child td {
      border-bottom: none;
    }

    .ship-steps {
      list-style: none;
      margin: 0 0 var(--space-2);
      padding: 0;
      counter-reset: step;
    }

    .ship-steps li {
      position: relative;
      padding: 0 0 var(--space-4) var(--space-8);
      line-height: 1.5;
    }

    .ship-steps li::before {
      content: counter(step);
      counter-increment: step;
      position: absolute;
      left: 0;
      top: 0;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--cream);
      border: 1.5px solid var(--caramel);
      color: var(--caramel-deep);
      font-size: 0.7rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .ship-steps li:not(:last-child)::after {
      content: "";
      position: absolute;
      left: 10px;
      top: 22px;
      bottom: 0;
      width: 1px;
      background: var(--border);
    }

    .ship-steps li:last-child {
      padding-bottom: 0;
    }

    .callout {
      display: flex;
      gap: var(--space-4);
      background: var(--warning-bg);
      border-radius: var(--radius-sm);
      padding: var(--space-6);
      margin-bottom: var(--space-8);
      color: var(--coffee-700);
    }

    .callout > :global(svg) {
      color: var(--warning-border);
      flex-shrink: 0;
      margin-top: 2px;
    }

    .callout h3 {
      font-size: var(--text-base);
      font-weight: 600;
      margin: 0 0 var(--space-2);
      color: var(--espresso);
    }

    .callout p {
      margin: 0;
    }

    .callout a {
      color: var(--caramel-deep);
      text-decoration: underline;
    }

    .contact-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--space-6);
    }

    .contact-item {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      color: var(--caramel);
    }

    .contact-item h3 {
      font-size: var(--text-sm);
      color: var(--ink-muted);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin: var(--space-1) 0 0;
    }

    .contact-item__link {
      font-size: var(--text-base);
      font-weight: 600;
      color: var(--espresso);
      text-decoration: none;
    }

    a.contact-item__link:hover {
      color: var(--caramel);
    }

    .contact-item__meta {
      font-size: var(--text-sm);
      color: var(--ink-muted);
    }

    .ship-commitment {
      background: var(--espresso);
      color: #fff;
      text-align: center;
      padding: var(--space-12) var(--space-8);
      border-radius: var(--radius-lg);
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .ship-commitment :global(svg) {
      color: var(--caramel);
      margin-bottom: var(--space-4);
    }

    .ship-commitment h2 {
      color: #fff;
      font-size: var(--text-2xl);
      margin: 0 0 var(--space-3);
    }

    .ship-commitment p {
      margin: 0;
      max-width: 560px;
      color: rgba(255, 255, 255, 0.85);
      font-size: var(--text-base);
      line-height: 1.65;
    }

    @media (max-width: 768px) {
      .ship-stats {
        grid-template-columns: 1fr;
      }

      .ship-grid {
        grid-template-columns: 1fr;
      }

      .card {
        padding: var(--space-6);
      }
    }
    .ship-qa { margin-top: var(--space-10); }
  .ship-qa h2 { margin: 0 0 var(--space-4); font-family: var(--font-display); font-size: var(--text-2xl); color: var(--espresso); }
  .ship-qa details { border-top: 1px solid var(--border); padding: var(--space-3) 0; }
  .ship-qa summary { cursor: pointer; font-weight: 600; color: var(--espresso); }
  .ship-qa p { margin: var(--space-2) 0 0; line-height: 1.6; color: var(--ink-muted); }
</style>
</Layout>
