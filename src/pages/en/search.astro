---
import Layout from "../../layouts/Layout.astro";
import SearchResults from "../../components/SearchResults.astro";
import { getCanonicalUrl } from "../../i18n/index.ts";
import { searchProducts } from "../../lib/products.server.ts";

export const prerender = false;

const q = (Astro.url.searchParams.get("q") ?? "").trim().slice(0, 80);
const results = await searchProducts(q);

// noindex por el mismo motivo que /buscar: los resultados duplican el catálogo.
---

<Layout
  lang="en"
  title={q ? `Results for “${q}” | DobleYo Coffee` : "Search | DobleYo Coffee"}
  description="Search Colombian specialty coffees by origin, process, roast level or tasting note."
  canonical={getCanonicalUrl("/en/search", "en")}
  noindex
>
  <SearchResults query={q} results={results} lang="en" />
</Layout>
