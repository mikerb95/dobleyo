---
import DarkHero from "../../components/shop/DarkHero.astro";
import RefFlow from "../../components/shop/RefFlow.astro";
import NumberedList from "../../components/shop/NumberedList.astro";
import FeatureGrid from "../../components/shop/FeatureGrid.astro";
import CtaBand from "../../components/shop/CtaBand.astro";
import Layout from "../../layouts/Layout.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/afiliados");

const steps = [
  {
    title: "Apply",
    text: "Request access to the program through our contact form. We review your profile and welcome you aboard.",
  },
  {
    title: "Share your link",
    text: "Receive a unique affiliate link to share on social media, your blog or with your community.",
  },
  {
    title: "Earn commissions",
    text: "For every purchase made through your link, you earn a commission on the sale.",
  },
  {
    title: "Get paid",
    text: "We settle your commissions monthly once the minimum withdrawal threshold is reached.",
  },
];

const perks = [
  { icon: "percent", title: "Per-sale commission", text: "Competitive commission on every referred sale." },
  { icon: "link", title: "Your own link", text: "A unique, trackable affiliate link." },
  { icon: "bar-chart", title: "Monthly report", text: "A monthly report of your earnings." },
  { icon: "coffee", title: "Welcome discount", text: "A discount on your first personal order." },
  { icon: "palette", title: "Brand assets", text: "Ready-to-use brand assets and copy." },
  { icon: "handshake", title: "Real support", text: "Dedicated support from our team." },
];
const faq = [
  { q: "Who can join the program?", a: "Anyone with an active online presence (content creators, coffee enthusiasts, bloggers, newsletter writers or anyone who loves specialty coffee)." },
  { q: "What is the commission rate?", a: "Commission details are shared upon approval. We offer competitive rates benchmarked against the specialty coffee industry." },
  { q: "How long does the cookie last?", a: "Your referral cookie is valid for 30 days from the click. Any purchase within that window counts as your referral." },
  { q: "When do I get paid?", a: "Commissions are settled monthly, on the first week of each month, once you've reached the minimum payout threshold." },
];
---

<Layout
  lang="en"
  title="Affiliate Program · DobleYo Café"
  description="Earn commissions recommending Colombian specialty coffee. Join the DobleYo Café affiliate program: your own link, per-sale commissions and monthly payments."
  canonical={getCanonicalUrl("/affiliates", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    lang="en"
    crumb="Affiliates"
    title="Share great coffee."
    titleEm="Earn with every sale."
    lead="Love DobleYo coffee? Recommend it to your audience and earn a commission on every order that comes through your link."
    cta={{ href: "/contact", label: "Apply now" }}
  >
    <RefFlow lang="en" />
  </DarkHero>

  <NumberedList eyebrow="Step by step" title="How it works" items={steps} connected />

  <FeatureGrid eyebrow="Perks" title="What you get" items={perks} />

  <section class="faq">
    <h2 class="faq__title">Frequently asked questions</h2>
    <div class="faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand
    title="Ready to join?"
    text="Apply through our contact form and we'll get back to you within 2 business days."
    primary={{ href: "/contact", label: "Apply now" }}
  />

  <script>
    import "../../scripts/shop/index.ts";
  </script>
</Layout>

<style>
  .faq { max-width: 860px; margin: 0 auto; padding: var(--space-12) 1.25rem var(--space-8); }
  .faq__title { margin: 0 0 var(--space-6); font-family: var(--font-display); font-size: var(--text-2xl); color: var(--espresso); }
  .faq__list { display: grid; gap: var(--space-2); }
  .faq__item { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-md); }
  .faq__item summary {
    list-style: none; cursor: pointer; padding: var(--space-4) var(--space-5);
    display: flex; justify-content: space-between; gap: var(--space-4);
    font-weight: 700; color: var(--espresso);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: "+"; font-size: var(--text-lg); line-height: 1; color: var(--caramel); transition: transform var(--dur) var(--ease); }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item summary:focus-visible { outline: 2px solid var(--caramel); outline-offset: 2px; border-radius: var(--radius-md); }
  .faq__item p { margin: 0; padding: 0 var(--space-5) var(--space-5); color: var(--ink-muted); line-height: 1.6; }
</style>
