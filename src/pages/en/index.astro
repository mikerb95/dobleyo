---
import Layout from "../../layouts/Layout.astro";
import { getCanonicalUrl, getHreflangPair, formatPrice } from "../../i18n/index.ts";
import HomeHero from "../../components/home/HomeHero.astro";
import OriginStrip from "../../components/home/OriginStrip.astro";
import TraceJourney from "../../components/home/TraceJourney.astro";
import Manifesto from "../../components/home/Manifesto.astro";
import HomeFarms from "../../components/home/HomeFarms.astro";
import WhyGrid from "../../components/home/WhyGrid.astro";
import { getFeaturedLot } from "../../lib/lot.server.ts";

const _hreflang = getHreflangPair("/");

// WebSite — no SearchAction: the site doesn't have working site-wide search yet
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DobleYo Café",
  url: "https://en.dobleyo.cafe",
};

// Featured lot: feeds the hero's live label and the journey scenes
const featuredLot = await getFeaturedLot("en");

// Featured coffees from DB (USD prices)
let coffeeProducts: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const result = await query(
    `SELECT id, name, name_en, origin, process, roast, price_usd,
            is_bestseller AS bestseller, is_new AS new, image_url AS image,
            stock_quantity AS stock
     FROM products
     WHERE is_active = 1 AND category = 'cafe'
     ORDER BY is_bestseller DESC, is_new DESC, rating DESC
     LIMIT 3`
  );
  if (result.rows.length > 0) {
    coffeeProducts = result.rows.map((p: any) => ({
      ...p,
      name: p.name_en || p.name,
    }));
  }
} catch (_) {}

// Featured farms
let featuredFarms: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const result = await query(
    `SELECT name, slug, region, altitude_min, altitude_max, cover_image_url
     FROM farms WHERE is_published = 1 ORDER BY created_at DESC LIMIT 3`
  );
  featuredFarms = result.rows;
} catch (_) {}

// Recent blog posts
let recentPosts: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const result = await query(
    `SELECT slug, title, excerpt, cover_image_url, reading_time_min, published_at
     FROM blog_posts WHERE is_published = 1 ORDER BY published_at DESC LIMIT 3`
  );
  recentPosts = result.rows;
} catch (_) {}

// Gift kits
let featuredKits: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const result = await query(
    `SELECT id, name, name_en, description, price_usd, image_url AS image
     FROM products WHERE is_gift_set = 1 AND is_active = 1
     ORDER BY price_usd ASC LIMIT 3`
  );
  featuredKits = result.rows.map((k: any) => ({
    ...k,
    name: k.name_en || k.name,
  }));
} catch (_) {}

// Featured reviews
let featuredReviews: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const result = await query(
    `SELECT r.reviewer_name, r.rating, r.comment, p.name_en AS product_name_en, p.name AS product_name
     FROM product_reviews r
     JOIN products p ON p.id = r.product_id
     WHERE r.is_approved = 1 AND r.comment IS NOT NULL AND r.comment != ''
     ORDER BY r.created_at DESC LIMIT 3`
  );
  featuredReviews = result.rows.map((r: any) => ({
    ...r,
    product_name: r.product_name_en || r.product_name,
  }));
} catch (_) {}
---

<Layout
  title="DobleYo Café — Colombian Specialty Coffee, Farm to Cup"
  description="Single-origin Colombian specialty coffee, freshly roasted and shipped worldwide. Single-origin lots, direct from the farm to your cup."
  lang="en"
  canonical={getCanonicalUrl("/", "en")}
  hreflangEs={_hreflang?.es}
  hreflangEn={_hreflang?.en}
  jsonLd={websiteJsonLd}
>
  <HomeHero lang="en" lot={featuredLot} />

  <OriginStrip lang="en" />

  <!-- Featured coffees -->
  <section class="cs-section" aria-labelledby="csSectionTitle">
    <div class="cs-header container">
      <div>
        <p class="cs-eyebrow">Our coffees</p>
        <h2 id="csSectionTitle" class="cs-title">Single origin, fresh roast</h2>
      </div>
      <a href="/shop" class="cs-all-link">Shop all products →</a>
    </div>

    <div class="cs-grid container">
      {
        coffeeProducts.map((p) => (
          <article class="cs-card">
            <div class="cs-card__img-wrap">
              <img src={p.image} alt={p.name} class="cs-card__img" loading="lazy" width="400" height="480" />
              {p.bestseller && <span class="cs-card__flag">Best seller</span>}
              {p.new && !p.bestseller && <span class="cs-card__flag cs-card__flag--new">New</span>}
            </div>
            <div class="cs-card__body">
              <p class="cs-card__meta">
                {p.origin}
                {p.process && <span class="cs-card__dot" aria-hidden="true">·</span>}
                {p.process && <span>{p.process}</span>}
              </p>
              <h3 class="cs-card__name">{p.name}</h3>
              <div class="cs-card__footer">
                <span class="cs-card__price">{formatPrice(Number(p.price_usd), "en")}</span>
                <button
                  class="cs-card__add btn-add"
                  aria-label={`Add ${p.name} to cart`}
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.price_usd}
                  data-image={p.image}
                >
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- From bean to cup: the featured lot's journey -->
  <TraceJourney lang="en" lot={featuredLot} />

  <Manifesto lang="en" />

  <HomeFarms lang="en" farms={featuredFarms} />

  <WhyGrid lang="en" lot={featuredLot} />

  <!-- Gift kits -->
  {featuredKits.length > 0 && (
    <section class="kits-section" aria-labelledby="kitsTitle">
      <div class="container">
        <div class="kits-header">
          <div>
            <p class="kits-eyebrow">Gift sets</p>
            <h2 id="kitsTitle" class="kits-title">Kits designed to delight</h2>
          </div>
          <a href="/shop" class="kits-link">Shop all kits →</a>
        </div>
        <div class="kits-grid">
          {featuredKits.map((kit: any) => (
            <a href={`/product/${kit.id}`} class="kit-card">
              <div class="kit-card__img-wrap">
                <img
                  src={kit.image || 'https://images.unsplash.com/photo-1559496417-e7f25cb247f3?q=80&w=600&auto=format&fit=crop'}
                  alt={kit.name}
                  loading="lazy"
                  class="kit-card__img"
                />
              </div>
              <div class="kit-card__body">
                <span class="kit-card__tag">Gift set</span>
                <h3 class="kit-card__name">{kit.name}</h3>
                {kit.description && <p class="kit-card__desc">{kit.description.slice(0, 90)}…</p>}
                <span class="kit-card__price">{formatPrice(Number(kit.price_usd), "en")}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Newsletter -->
  <section class="newsletter-section" aria-labelledby="nlTitle">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-copy">
          <p class="newsletter-eyebrow">Newsletter</p>
          <h2 id="nlTitle" class="newsletter-title">10% off your first order</h2>
          <p class="newsletter-sub">Subscribe and receive your code instantly. We'll also keep you posted on new harvests and releases.</p>
        </div>
        <form class="newsletter-form" id="homeNewsletterForm" novalidate>
          <label for="homeNlEmail" class="sr-only">Email address</label>
          <input
            type="email"
            id="homeNlEmail"
            class="newsletter-input"
            placeholder="your@email.com"
            required
            autocomplete="email"
          />
          <button type="submit" class="newsletter-btn">Subscribe</button>
        </form>
        <p class="newsletter-msg" id="homeNlMsg" style="display:none"></p>
      </div>
    </div>
  </section>

  <!-- Recent blog posts -->
  {recentPosts.length > 0 && (
    <section class="blog-section" aria-labelledby="blogTitle">
      <div class="container">
        <div class="blog-home-header">
          <div>
            <p class="blog-eyebrow">Blog</p>
            <h2 id="blogTitle" class="blog-home-title">Recipes, tasting notes and guides</h2>
          </div>
          <a href="/blog" class="blog-home-link">View all posts →</a>
        </div>
        <div class="blog-home-grid">
          {recentPosts.map((post: any) => (
            <a href={`/blog/${post.slug}`} class="blog-home-card">
              <div class="blog-home-card__img-wrap">
                <img
                  src={post.cover_image_url || 'https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?q=80&w=600&auto=format&fit=crop'}
                  alt={post.title}
                  loading="lazy"
                  class="blog-home-card__img"
                />
              </div>
              <div class="blog-home-card__body">
                <h3 class="blog-home-card__title">{post.title}</h3>
                {post.excerpt && <p class="blog-home-card__exc">{post.excerpt.slice(0, 80)}…</p>}
                <span class="blog-home-card__time">{post.reading_time_min ?? 3} min read</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Reviews -->
  {featuredReviews.length > 0 && (
    <section class="reviews-home" aria-labelledby="reviewsHomeTitle">
      <div class="container">
        <div class="reviews-home-header">
          <p class="reviews-eyebrow">What our customers say</p>
          <h2 id="reviewsHomeTitle" class="reviews-home-title">Verified reviews</h2>
        </div>
        <div class="reviews-home-grid">
          {featuredReviews.map((r: any) => (
            <div class="review-home-card">
              <div class="review-home-card__stars" aria-label={`${r.rating} stars`}>
                {"★".repeat(r.rating)}{"☆".repeat(5 - r.rating)}
              </div>
              <p class="review-home-card__comment">"{r.comment}"</p>
              <div class="review-home-card__meta">
                <strong>{r.reviewer_name}</strong>
                {r.product_name && <span>on {r.product_name}</span>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <script is:inline src="/assets/js/home-en.js"></script>
  <script>
    import "../../scripts/home/index.ts";
  </script>
  <style>
    /* =============================================
       COFFEE SECTION
    ============================================= */
    .cs-section {
      padding: 4rem 0;
      border-top: 1px solid var(--border);
    }
    .cs-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .cs-eyebrow {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .5rem;
    }
    .cs-title {
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--coffee);
      margin: 0;
      line-height: 1.1;
    }
    .cs-all-link {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: .85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
      padding-bottom: 1px;
      border-bottom: 1px solid transparent;
      transition: border-color .15s;
    }
    .cs-all-link:hover { border-bottom-color: var(--accent); }

    .cs-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    @media (max-width: 900px) { .cs-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
    @media (max-width: 540px)  { .cs-grid { grid-template-columns: 1fr; gap: 1rem; } }

    .cs-card {
      display: flex;
      flex-direction: column;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: .875rem;
      overflow: hidden;
      transition: box-shadow .2s ease, transform .2s ease;
    }
    .cs-card:hover {
      box-shadow: 0 8px 32px rgba(37,26,20,.1);
      transform: translateY(-3px);
    }

    .cs-card__img-wrap {
      position: relative;
      overflow: hidden;
      background: var(--cream);
      aspect-ratio: 4 / 5;
    }
    .cs-card__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform .4s ease;
    }
    .cs-card:hover .cs-card__img { transform: scale(1.04); }

    .cs-card__flag {
      position: absolute;
      top: .875rem;
      left: .875rem;
      background: var(--coffee);
      color: var(--accent-contrast);
      font-family: 'Inter', sans-serif;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .08em;
      text-transform: uppercase;
      padding: .25rem .6rem;
      border-radius: .25rem;
    }
    .cs-card__flag--new { background: var(--leaf); }

    .cs-card__body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      gap: .375rem;
      flex: 1;
    }
    .cs-card__meta {
      font-family: 'Inter', sans-serif;
      font-size: .72rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0;
    }
    .cs-card__dot { margin: 0 .2rem; opacity: .5; }
    .cs-card__name {
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--coffee);
      margin: 0;
      line-height: 1.2;
    }
    .cs-card__footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: .875rem;
      border-top: 1px solid var(--border);
    }
    .cs-card__price {
      font-family: 'Inter', sans-serif;
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--coffee);
    }
    .cs-card__add {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: var(--coffee);
      color: var(--accent-contrast);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background .15s, transform .15s;
      flex-shrink: 0;
    }
    .cs-card__add:hover { background: var(--accent); }
    .cs-card__add--added {
      background: var(--leaf);
      transform: scale(.92);
    }

    /* =============================================
       GIFT KITS
    ============================================= */
    .kits-section {
      padding: 5rem 0;
      border-top: 1px solid var(--border);
      background: var(--footer-bg);
    }
    .kits-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .kits-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .5rem;
    }
    .kits-title {
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--coffee);
      margin: 0;
    }
    .kits-link {
      font-family: 'Inter', sans-serif;
      font-size: .85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
    }
    .kits-link:hover { text-decoration: underline; }
    .kits-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .kit-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: .875rem;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      transition: box-shadow .2s, transform .2s;
    }
    .kit-card:hover { box-shadow: 0 8px 28px rgba(37,26,20,.1); transform: translateY(-3px); }
    .kit-card__img-wrap { aspect-ratio: 4/3; overflow: hidden; background: var(--cream); }
    .kit-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .kit-card:hover .kit-card__img { transform: scale(1.04); }
    .kit-card__body { padding: 1.25rem; display: flex; flex-direction: column; gap: .4rem; }
    .kit-card__tag {
      font-family: 'Inter', sans-serif;
      font-size: .65rem;
      font-weight: 700;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--accent);
    }
    .kit-card__name { font-size: 1.05rem; font-weight: 700; color: var(--coffee); margin: 0; }
    .kit-card__desc { font-size: .82rem; color: var(--muted-fg); margin: 0; line-height: 1.5; }
    .kit-card__price { font-family: 'Inter', sans-serif; font-size: 1rem; font-weight: 700; color: var(--coffee); margin-top: .25rem; }
    @media (max-width: 900px) { .kits-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .kits-grid { grid-template-columns: 1fr; } }

    /* =============================================
       NEWSLETTER
    ============================================= */
    .newsletter-section {
      padding: 5rem 0;
      background: var(--coffee);
      border-top: 1px solid rgba(255,255,255,.06);
    }
    .newsletter-inner {
      max-width: 640px;
      margin: 0 auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }
    .newsletter-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: rgba(255,255,255,.5);
      margin: 0;
    }
    .newsletter-title {
      font-size: clamp(1.5rem, 3.5vw, 2.2rem);
      color: var(--accent-contrast);
      margin: 0;
      line-height: 1.2;
    }
    .newsletter-sub {
      font-size: .92rem;
      color: rgba(255,255,255,.65);
      margin: 0;
      line-height: 1.6;
      max-width: 48ch;
    }
    .newsletter-form {
      display: flex;
      gap: .5rem;
      width: 100%;
      max-width: 460px;
      margin-top: .5rem;
    }
    .newsletter-input {
      flex: 1;
      padding: .7rem 1rem;
      border: 1.5px solid rgba(255,255,255,.2);
      border-radius: 6px;
      background: rgba(255,255,255,.08);
      color: var(--accent-contrast);
      font-size: .95rem;
      outline: none;
      font-family: inherit;
    }
    .newsletter-input::placeholder { color: rgba(255,255,255,.4); }
    .newsletter-input:focus { border-color: var(--accent); }
    .newsletter-btn {
      padding: .7rem 1.4rem;
      background: var(--accent);
      color: var(--accent-contrast);
      border: none;
      border-radius: 6px;
      font-size: .9rem;
      font-weight: 700;
      cursor: pointer;
      white-space: nowrap;
      transition: opacity .15s;
      font-family: inherit;
    }
    .newsletter-btn:hover { opacity: .88; }
    .newsletter-btn:disabled { opacity: .5; cursor: not-allowed; }
    .newsletter-msg { font-size: .88rem; margin: 0; }
    .newsletter-msg.success { color: var(--leaf-bg); }
    .newsletter-msg.error { color: var(--danger-bg); }
    @media (max-width: 480px) {
      .newsletter-form { flex-direction: column; }
      .newsletter-btn { width: 100%; }
    }

    /* =============================================
       BLOG
    ============================================= */
    .blog-section {
      padding: 5rem 0;
      border-top: 1px solid var(--border);
    }
    .blog-home-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      margin-bottom: 2.5rem;
      flex-wrap: wrap;
    }
    .blog-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--accent);
      margin: 0 0 .5rem;
    }
    .blog-home-title {
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--coffee);
      margin: 0;
    }
    .blog-home-link {
      font-family: 'Inter', sans-serif;
      font-size: .85rem;
      font-weight: 600;
      color: var(--accent);
      text-decoration: none;
      white-space: nowrap;
    }
    .blog-home-link:hover { text-decoration: underline; }
    .blog-home-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
    .blog-home-card {
      border: 1px solid var(--border);
      border-radius: .875rem;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      background: var(--card);
      transition: box-shadow .2s, transform .2s;
    }
    .blog-home-card:hover { box-shadow: 0 6px 24px rgba(37,26,20,.09); transform: translateY(-2px); }
    .blog-home-card__img-wrap { aspect-ratio: 16/9; overflow: hidden; background: var(--cream); }
    .blog-home-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
    .blog-home-card:hover .blog-home-card__img { transform: scale(1.04); }
    .blog-home-card__body { padding: 1.1rem; display: flex; flex-direction: column; gap: .35rem; flex: 1; }
    .blog-home-card__title { font-size: .95rem; font-weight: 700; color: var(--coffee); margin: 0; line-height: 1.3; }
    .blog-home-card__exc { font-size: .8rem; color: var(--muted-fg); margin: 0; line-height: 1.5; flex: 1; }
    .blog-home-card__time { font-size: .72rem; color: var(--muted-fg); margin-top: auto; padding-top: .5rem; border-top: 1px solid var(--border); }
    @media (max-width: 900px) { .blog-home-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .blog-home-grid { grid-template-columns: 1fr; } }

    /* =============================================
       REVIEWS
    ============================================= */
    .reviews-home {
      padding: 5rem 0;
      background: var(--footer-bg);
      border-top: 1px solid var(--border);
    }
    .reviews-home-header {
      text-align: center;
      margin-bottom: 2.5rem;
    }
    .reviews-eyebrow {
      font-family: 'Inter', sans-serif;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .14em;
