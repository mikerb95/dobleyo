---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import AltitudeBrew from "../../components/en/AltitudeBrew.astro";
import Icon from "../../components/Icon.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";
import { reviewAggregateSql } from "../../lib/products.server.ts";
import { products as staticProducts } from "../../data/products";
import { processEn, roastEn } from "../../data/en-copy.ts";

const hreflang = getHreflangPair("/");

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DobleYo Café",
  url: "https://en.dobleyo.cafe",
};

const faq = [
  {
    q: "How fresh is it?",
    a: "We roast in small batches and send your coffee out within 15 days of roasting. It doesn't sit in a warehouse or on a supermarket shelf.",
  },
  {
    q: "How long does delivery take?",
    a: "2 to 3 business days in Bogotá and its metro area, 3 to 5 to other main cities and 4 to 7 everywhere else. You get a tracking number when it ships.",
  },
  {
    q: "What does delivery cost?",
    a: "$12,000 COP, and free once your order reaches $120,000 COP.",
  },
  {
    q: "How can I pay?",
    a: "Card, PSE, Nequi or Daviplata through Wompi, or cash on delivery. Prices are in Colombian pesos and include tax.",
  },
  {
    q: "Why do you ask for an ID number at checkout?",
    a: "The courier needs one to issue the shipping label. A cédula de extranjería works fine.",
  },
  {
    q: "Is the coffee whole bean or ground?",
    a: "Whole bean, in 250 g bags. It keeps better that way and you grind only what you need.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// The coffees on sale right now
let coffees: any[] = [];
try {
  const { query } = await import("../../../server/db.js");
  const { rows } = await query(
    `SELECT p.id, COALESCE(p.name_en, p.name) AS name, p.category, p.origin, p.process, p.roast, p.price, p.rating,
            p.weight, p.weight_unit, p.is_bestseller AS bestseller, p.is_new AS new,
            p.image_url AS image, p.stock_quantity AS stock,
            ${reviewAggregateSql("p")}
     FROM products p
     WHERE p.is_active = 1 AND p.category = 'cafe'
     ORDER BY p.is_bestseller DESC, p.is_new DESC, p.rating DESC
     LIMIT 4`
  );
  coffees = rows.map((p: any) => ({ ...p, category: "Coffee", process: processEn(p.process), roast: roastEn(p.roast) }));
} catch (_) {}

if (!coffees.length) {
  coffees = staticProducts
    .filter((p) => p.category === "Cafés")
    .slice(0, 4)
    .map((p) => ({ ...p, name: p.nameEn || p.name, category: "Coffee", process: processEn(p.process), roast: roastEn(p.roast), stock: 99 }));
}

const words = [
  { es: "Tinto", en: "A small black coffee. Often sweetened already, so ask for it sin azúcar if you take it plain." },
  { es: "Pintadito / perico", en: "A small coffee with a splash of milk. The name changes from city to city." },
  { es: "Grano", en: "Whole bean. Molido means it's already ground." },
  { es: "Pasilla", en: "Lower-grade beans, the ones left after the export sort. Worth knowing when a supermarket bag looks like a bargain." },
];
---

<Layout
  title="Colombian Specialty Coffee Delivered to Your Door | DobleYo Café"
  description="Fresh specialty coffee from small Colombian farms, delivered to your door. Free delivery over $120,000 COP. Pay by card, PSE, Nequi or cash on delivery."
  lang="en"
  canonical={getCanonicalUrl("/", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
  jsonLd={[websiteJsonLd, faqJsonLd]}
>
  <section class="intro" aria-labelledby="introTitle">
    <div class="intro__copy">
      <h1 id="introTitle" class="intro__title">You're in coffee country. Your coffee should taste like it.</h1>
      <p class="intro__lead">
        A lot of Colombia's best coffee gets exported before you ever see it. We buy from small
        farms, roast in small batches and bring it to your door.
      </p>
      <a class="intro__cta" href="/shop">Shop the coffee <Icon name="arrow-right" size={18} /></a>
    </div>

    <aside class="slip" aria-label="Delivery and payment">
      <p class="slip__head">Delivery &amp; payment</p>
      <dl class="slip__rows">
        <div><dt>Bogotá</dt><dd>2 to 3 business days</dd></div>
        <div><dt>Other main cities</dt><dd>3 to 5 business days</dd></div>
        <div><dt>Everywhere else</dt><dd>4 to 7 business days</dd></div>
        <div><dt>Delivery</dt><dd>$12,000 COP</dd></div>
        <div class="slip__free"><dt>Over $120,000 COP</dt><dd>Free</dd></div>
      </dl>
      <p class="slip__pay">Card, PSE, Nequi, Daviplata or cash on delivery</p>
    </aside>
  </section>

  <section class="band" aria-labelledby="coffeeTitle">
    <header class="band__head">
      <h2 id="coffeeTitle" class="band__title">On the shelf now</h2>
      <a class="band__link" href="/shop">See everything <Icon name="arrow-right" size={16} /></a>
    </header>
    <div class="coffee-grid">
      {coffees.map((p) => <ProductCard product={p} lang="en" />)}
      <a class="cacao-tile" href="/cacao">
        <img src="/assets/img/cacao/chocolate-de-mesa.webp" alt="" loading="lazy" />
        <span class="cacao-tile__text">
          <strong>Hot chocolate, too</strong>
          <span>Drinking chocolate, cacao bars, powder and butter <Icon name="arrow-right" size={16} /></span>
        </span>
      </a>
    </div>
  </section>

  <section class="kitchen" aria-labelledby="kitchenTitle">
    <div class="kitchen__copy">
      <h2 id="kitchenTitle" class="band__title">Brewing here isn't like brewing back home</h2>
      <p>
        Most recipes assume water boils at 100 °C. In much of Colombia it doesn't, and that changes
        how you should pour. Pick your city and see what it means for your cup.
      </p>
      <a class="band__link" href="/guides">Recipes for V60, Chemex, French press and moka <Icon name="arrow-right" size={16} /></a>
    </div>
    <AltitudeBrew compact />
  </section>

  <section class="band words" aria-labelledby="wordsTitle">
    <h2 id="wordsTitle" class="band__title">A little coffee Spanish</h2>
    <dl class="words__list">
      {words.map((w) => (
        <div>
          <dt lang="es">{w.es}</dt>
          <dd>{w.en}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="sub-strip" aria-labelledby="subTitle">
    <div>
      <h2 id="subTitle" class="sub-strip__title">Running out is the worst part of the morning</h2>
      <p>A subscription brings fresh coffee every 15 or 30 days, with a discount and delivery included. Pause or cancel whenever you like.</p>
    </div>
    <a class="sub-strip__cta" href="/subscription">Set one up</a>
  </section>

  <section class="band faq" aria-labelledby="faqTitle">
    <h2 id="faqTitle" class="band__title">Things people ask</h2>
    <div class="faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
    <p class="also">
      Anything else? <a href="https://wa.me/573204981580" target="_blank" rel="noopener noreferrer">Message us on WhatsApp</a>, in English or Spanish.
    </p>
  </section>
</Layout>

<style>
  /* Sangrado completo desde dentro de <main class="container"> */
  .intro {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    display: grid;
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-10) 1.25rem var(--space-12);
    color: var(--cream);
    background:
      linear-gradient(90deg, rgba(var(--espresso-rgb), .94) 0%, rgba(var(--espresso-rgb), .82) 55%, rgba(var(--espresso-rgb), .62) 100%),
      var(--espresso) url("/assets/img/hero-viaje-sm.webp") center / cover no-repeat;
  }
  .intro__title {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 3vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -.015em;
    color: var(--cream);
    text-wrap: balance;
  }
  .intro__lead { margin: 0 0 var(--space-6); max-width: 46ch; font-size: var(--text-lg); line-height: 1.55; color: rgba(var(--cream-rgb), .86); }
  .intro__cta {
    display: inline-flex; align-items: center; gap: var(--space-2); min-height: 48px; padding: 0 var(--space-6);
    border-radius: 999px; background: var(--cream); color: var(--espresso); font-weight: 700; text-decoration: none;
    transition: background var(--dur) var(--ease);
  }
  .intro__cta:hover { background: var(--mucilage); }

  .slip { background: var(--card); color: var(--espresso); border-radius: var(--radius-md); padding: var(--space-5) var(--space-6); box-shadow: 0 18px 40px rgba(0, 0, 0, .28); }
  .slip__head { margin: 0 0 var(--space-3); font-weight: 700; }
  .slip__rows { margin: 0; }
  .slip__rows div { display: flex; justify-content: space-between; gap: var(--space-4); padding: var(--space-2) 0; border-top: 1px dashed var(--border); font-size: var(--text-sm); }
  .slip__rows dt { color: var(--ink-muted); }
  .slip__rows dd { margin: 0; font-weight: 600; text-align: right; }
  .slip__free dd { color: var(--leaf); }
  .slip__pay { margin: 0; padding-top: var(--space-3); border-top: 1px dashed var(--border); font-size: var(--text-sm); color: var(--ink-muted); }

  .band { max-width: 1200px; margin: 0 auto; padding: var(--space-12) 0 0; }
  .band__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-6); }
  .band__title { margin: 0; font-family: var(--font-display); font-size: var(--text-3xl); line-height: 1.15; color: var(--espresso); }
  .band__link { display: inline-flex; align-items: center; gap: var(--space-1); color: var(--caramel-deep); font-weight: 600; text-decoration: none; }
  .band__link:hover { text-decoration: underline; }
  .coffee-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
  .cacao-tile {
    position: relative; display: flex; align-items: flex-end; min-height: 260px; overflow: hidden;
    border-radius: var(--radius-md); background: var(--espresso); color: var(--cream); text-decoration: none;
  }
  .cacao-tile img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); }
  .cacao-tile:hover img { transform: scale(1.03); }
  .cacao-tile__text {
    position: relative; display: grid; gap: var(--space-1); width: 100%; padding: var(--space-10) var(--space-5) var(--space-5);
    background: linear-gradient(to top, rgba(var(--espresso-rgb), .92) 40%, rgba(var(--espresso-rgb), 0)); font-size: var(--text-sm); line-height: 1.5;
  }
  .cacao-tile__text strong { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 500; }
  .also { margin: var(--space-6) 0 0; color: var(--ink-muted); }
  .also a { color: var(--caramel-deep); font-weight: 600; }

  .kitchen { max-width: 1200px; margin: 0 auto; padding: var(--space-16) 0 0; display: grid; gap: var(--space-8); align-items: center; }
  .kitchen__copy p { margin: var(--space-3) 0 var(--space-4); max-width: 52ch; line-height: 1.65; color: var(--ink-muted); }

  .words__list { display: grid; gap: 0; margin: var(--space-5) 0 0; }
  .words__list div { padding: var(--space-4) 0; border-top: 1px solid var(--border); }
  .words__list dt { font-family: var(--font-display); font-style: italic; font-size: var(--text-xl); color: var(--espresso); }
  .words__list dd { margin: var(--space-1) 0 0; line-height: 1.6; color: var(--ink-muted); }

  .sub-strip {
    max-width: 1200px; margin: var(--space-16) auto 0; padding: var(--space-8) var(--space-6);
    display: grid; gap: var(--space-5); align-items: center;
    border-radius: var(--radius-lg); background: var(--leaf-bg); color: var(--espresso);
  }
  .sub-strip__title { margin: 0 0 var(--space-2); font-family: var(--font-display); font-size: var(--text-2xl); line-height: 1.2; }
  .sub-strip p { margin: 0; max-width: 58ch; line-height: 1.6; }
  .sub-strip__cta {
    justify-self: start; display: inline-flex; align-items: center; min-height: 48px; padding: 0 var(--space-6);
    border-radius: 999px; background: var(--espresso); color: var(--cream); font-weight: 700; text-decoration: none; white-space: nowrap;
  }
  .sub-strip__cta:hover { background: var(--caramel-deep); }

  .faq { padding-bottom: var(--space-16); }
  .faq__list { max-width: 820px; margin-top: var(--space-5); }
  .faq__item { border-top: 1px solid var(--border); }
  .faq__item:last-child { border-bottom: 1px solid var(--border); }
  .faq__item summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: var(--space-4);
    padding: var(--space-4) 0; font-weight: 600; color: var(--espresso);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after { content: "+"; color: var(--caramel); font-size: var(--text-lg); line-height: 1; transition: transform var(--dur) var(--ease); }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item summary:focus-visible { outline: 2px solid var(--caramel); outline-offset: 3px; }
  .faq__item p { margin: 0; padding: 0 0 var(--space-4); max-width: 68ch; line-height: 1.65; color: var(--ink-muted); }

  @media (min-width: 768px) {
    .coffee-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .intro { background-image:
      linear-gradient(90deg, rgba(var(--espresso-rgb), .94) 0%, rgba(var(--espresso-rgb), .82) 55%, rgba(var(--espresso-rgb), .62) 100%),
      url("/assets/img/hero-viaje.webp"); }
    .sub-strip { grid-template-columns: 1fr auto; padding: var(--space-8) var(--space-10); }
    .sub-strip__cta { justify-self: end; }
    .words__list { grid-template-columns: 1fr 1fr; column-gap: var(--space-10); }
    .kitchen { grid-template-columns: 1fr minmax(0, 460px); gap: var(--space-12); }
  }
  @media (min-width: 1024px) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 380px;
      gap: var(--space-12);
      padding: var(--space-16) max(2rem, calc((100vw - 1200px) / 2)) var(--space-16);
    }
  }
</style>
