---
import Layout from "../../layouts/Layout.astro";
import DarkHero from "../../components/shop/DarkHero.astro";
import BrewGuide from "../../components/shop/BrewGuide.astro";
import NumberedList from "../../components/shop/NumberedList.astro";
import CtaBand from "../../components/shop/CtaBand.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/guias");

// Recipes: the panel reads the numbers from these texts (lib/brew.ts)
const methods = [
  {
    icon: "dripper",
    title: "V60 Pour-Over",
    summary: "A clean filter brew that highlights the floral and citrus notes of single-origin coffees.",
    ratio: "1:16 (15 g coffee · 240 ml water)",
    grind: "Medium",
    time: "2:30 to 3:00 min",
    temp: "92 to 94 °C / 198 to 201 °F",
  },
  {
    icon: "chemex",
    title: "Chemex",
    summary: "A thick filter for a crisp, light-bodied cup, ideal for sharing with friends.",
    ratio: "1:15 (40 g coffee · 600 ml water)",
    grind: "Medium-coarse",
    time: "4:00 to 5:00 min",
    temp: "93 to 95 °C / 199 to 203 °F",
  },
  {
    icon: "press",
    title: "French Press",
    summary: "Full immersion for a full-bodied, rich cup with more natural oils present.",
    ratio: "1:14 (30 g coffee · 420 ml water)",
    grind: "Coarse",
    time: "4:00 min",
    temp: "93 °C / 199 °F",
  },
  {
    icon: "moka",
    title: "Moka Pot",
    summary: "The stovetop classic: intense, concentrated and ready in minutes.",
    ratio: "Fill the basket without pressing",
    grind: "Fine-medium",
    time: "4:00 to 5:00 min",
    temp: "Medium-low heat",
  },
];

const tips = [
  { title: "Filtered water", text: "Coffee is 98% water, so its quality shows in the cup." },
  { title: "Grind fresh", text: "Grind just before brewing to preserve volatile aromas." },
  { title: "Use a scale", text: "Weigh coffee and water for consistent results." },
  { title: "Fresh roast", text: "Drink within 4 weeks of the roast date for peak flavor." },
  { title: "Store it right", text: "Keep whole beans in an airtight container, away from light and heat." },
];
---

<Layout
  lang="en"
  title="Brewing Guides · DobleYo Café"
  description="Step-by-step brewing guides to get the most out of your Colombian specialty coffee. V60, Chemex, French Press, Moka Pot and expert tips."
  canonical={getCanonicalUrl("/guides", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    lang="en"
    crumb="Guides"
    title="Brew a better cup"
    titleEm="at home."
    lead="Step-by-step recipes to unlock the full potential of our specialty coffees. Pick your method and see the recipe."
    facts={[
      { icon: "dripper", text: "4 methods" },
      { icon: "clock", text: "Times and temperatures" },
    ]}
  >
    <BrewGuide methods={methods} lang="en" />
  </DarkHero>

  <NumberedList eyebrow="Before you start" title="5 essential tips" items={tips} />

  <CtaBand
    title="Put these guides into practice"
    text="Pick a specialty coffee and start experimenting in your cup."
    primary={{ href: "/shop", label: "Browse coffees" }}
  />

  <script>
    import "../../scripts/shop/index.ts";
  </script>
</Layout>
