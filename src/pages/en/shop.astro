---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/ProductCard.astro";
import ShopHero from "../../components/shop/ShopHero.astro";
import { products as staticProducts } from "../../data/products";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";
import { reviewAggregateSql } from "../../lib/products.server.ts";

const lang = "en" as const;
const hreflang = getHreflangPair("/tienda");

// Traducción es→en de etiquetas almacenadas en español
const CAT_EN: Record<string, string> = { cafe: "Coffee", accesorio: "Accessories", merchandising: "Merch", cacao: "Cacao" };
const PROC_EN: Record<string, string> = { Lavado: "Washed", Honey: "Honey", Natural: "Natural" };
const ROAST_EN: Record<string, string> = { Claro: "Light", Medio: "Medium", Oscuro: "Dark" };

// Cargar productos desde la BD (precios en USD); fallback al catálogo estático
let rows: any[] = [];
try {
    const { query } = await import("../../../server/db.js");
    const res = await query(
        `SELECT p.id, p.name, p.name_en, p.category, p.origin, p.process, p.roast,
                p.price, p.price_usd, p.rating, p.tasting_notes, p.weight, p.weight_unit,
                p.is_deal AS deal, p.is_bestseller AS bestseller, p.is_new AS new, p.is_fast AS fast,
                p.image_url AS image, p.stock_quantity AS stock,
                ${reviewAggregateSql("p")}
         FROM products p
         WHERE p.is_active = 1
         ORDER BY p.is_bestseller DESC, p.is_new DESC, p.is_deal DESC, p.rating DESC`
    );
    rows = res.rows;
} catch (_) { /* BD no disponible */ }

const products: any[] = rows.length
    ? rows.map((p: any) => ({
        id: p.id,
        name: p.name_en || p.name,
        category: CAT_EN[p.category] ?? p.category,
        origin: p.origin ?? null,
        process: p.process ? (PROC_EN[p.process] ?? p.process) : null,
        roast: p.roast ? (ROAST_EN[p.roast] ?? p.roast) : null,
        price: Number(p.price_usd ?? Math.round(Number(p.price) / 4000)),
        rating: Number(p.rating) || 0,
        review_count: p.review_count,
        review_avg: p.review_avg,
        tasting_notes: p.tasting_notes,
        weight: p.weight,
        weight_unit: p.weight_unit,
        deal: !!p.deal, bestseller: !!p.bestseller, new: !!p.new, fast: !!p.fast,
        image: p.image,
        stock: p.stock,
    }))
    : staticProducts.map((p) => ({
        id: p.id,
        name: p.nameEn || p.name,
        category: p.categoryEn || p.category,
        origin: p.origin ?? null,
        process: (p.processEn || p.process) ?? null,
        roast: (p.roastEn || p.roast) ?? null,
        price: p.priceUsd ?? Math.round(p.price / 4000),
        rating: p.rating,
        deal: p.deal ?? false, bestseller: p.bestseller ?? false,
        new: p.new ?? false, fast: p.fast ?? false,
        image: p.image,
        stock: 99,
    }));

// Cafés del mostrador del hero (una bolsa por origen)
const counterCoffees = products.filter((p) => p.category === "Coffee" && p.origin);

// Escapar "<" para poder inyectar el JSON de forma segura en un <script type="application/json">
const productsJson = JSON.stringify(products).replace(/</g, "\\u003c");
---

<Layout
    title="Shop · DobleYo Café | Colombian Specialty Coffee"
    description="Browse our selection of Colombian specialty coffees and accessories. Single-origin, freshly roasted, farm-to-cup."
    lang={lang}
    canonical={getCanonicalUrl("/shop", "en")}
    hreflangEs={hreflang?.es}
    hreflangEn={hreflang?.en}
>
    <ShopHero coffees={counterCoffees} lang="en" />

    <!-- Filter chips + sort bar -->
    <section class="shop-topbar" aria-label="Quick filters">
        <div class="chips" id="topChips" role="toolbar" aria-label="Quick filters">
            <button class="chip" data-flag="fast">Fast delivery</button>
            <button class="chip" data-flag="deal">On sale</button>
            <button class="chip" data-flag="new">New arrivals</button>
            <button class="chip" data-flag="bestseller">Best sellers</button>
        </div>
        <div class="actions">
            <button class="filters-toggle" id="filtersToggle" aria-expanded="false">Filters</button>
            <label class="sort">
                <span>Sort by:</span>
                <select id="shopSort" aria-label="Sort results">
                    <option value="relevance">Relevance</option>
                    <option value="price-asc">Price: lowest first</option>
                    <option value="price-desc">Price: highest first</option>
                    <option value="rating-desc">Highest rated</option>
                </select>
            </label>
        </div>
    </section>

    <section class="shop-layout" aria-label="Shop results">
        <aside class="shop-sidebar" id="shopSidebar">
            <div class="filter-group">
                <div class="filter-title">Categories</div>
                <div class="filter-list" id="catList"></div>
            </div>
            <div class="filter-group">
                <div class="filter-title">Origin</div>
                <div class="filter-list" id="originList"></div>
            </div>
            <div class="filter-group">
                <div class="filter-title">Process</div>
                <div class="filter-list" id="processList"></div>
            </div>
            <div class="filter-group">
                <div class="filter-title">Roast</div>
                <div class="filter-list" id="roastList"></div>
            </div>
            <div class="filter-group">
                <div class="filter-title">Price (USD)</div>
                <div class="price-inputs">
                    <input type="number" id="priceMin" placeholder="Min" min="0" step="1" aria-label="Minimum price" />
                    <span>-</span>
                    <input type="number" id="priceMax" placeholder="Max" min="0" step="1" aria-label="Maximum price" />
                </div>
                <button class="btn small" id="applyPrice">Apply</button>
            </div>
            <div class="filter-actions">
                <button class="btn outline" id="clearFilters">Clear filters</button>
            </div>
        </aside>

        <section class="shop-content">
            <div class="applied-filters" id="appliedFilters"></div>
            <div class="grid" id="shopResults">
                {products.map((p) => <ProductCard product={p} lang="en" />)}
            </div>
            <p id="noResults" class="muted" hidden>No products found for these filters.</p>
        </section>
    </section>

    <script type="application/json" id="shopData" set:html={productsJson}></script>

    <script>
        // Misma card que ProductCard.astro (lang="en") para que el repintado al
        // filtrar se vea idéntico al HTML del servidor.
        import { getRating, formatWeight } from "../../lib/products.ts";

        type P = Record<string, any>;
        const fmt = (n: number) => `$${Number(n).toLocaleString("en-US")}`;
        const esc = (s: unknown) =>
            String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
        const ratingValue = (p: P) => getRating(p)?.value ?? 0;

        function starsHtml(p: P) {
            const r = getRating(p);
            if (!r) return "";
            const pct = (Math.max(0, Math.min(5, r.value)) / 5) * 100;
            const shown = r.value.toFixed(1).replace(".0", "");
            const count = r.fromReviews && r.count > 0
                ? `<span class="stars-rating__count">(${r.count === 1 ? "1 review" : `${r.count} reviews`})</span>`
                : "";
            return `<div class="card-rating"><span class="stars-rating stars-rating--sm">
                <span class="stars-rating__glyphs" role="img" aria-label="${shown} out of 5">
                  <span class="stars-rating__bg" aria-hidden="true">★★★★★</span>
                  <span class="stars-rating__fg" style="width:${pct}%" aria-hidden="true">★★★★★</span>
                </span>
                <span class="stars-rating__value">${shown}</span>${count}
              </span></div>`;
        }

        function card(p: P) {
            const out = typeof p.stock === "number" && p.stock === 0;
            const low = typeof p.stock === "number" && p.stock > 0 && p.stock <= 5;
            const weight = formatWeight(p, "en");
            return `
            <article class="card">
              <a href="/product/${esc(p.id)}" class="card-link" tabindex="-1" aria-hidden="true">
                <img src="${esc(p.image)}" alt="${esc(p.name)}" loading="lazy">
              </a>
              <div class="p">
                <div class="muted" style="font-size:.85rem">${esc(p.category)}${p.origin ? " · " + esc(p.origin) : ""}</div>
                <h3><a href="/product/${esc(p.id)}" class="card-name-link">${esc(p.name)}</a></h3>
                <div class="muted" style="font-size:.85rem">${esc(p.process || "")}${p.process && p.roast ? " · " : ""}${esc(p.roast || "")}</div>
                ${starsHtml(p)}
                <div class="price-row">
                  <span class="price">${fmt(p.price)}</span>
                  ${weight ? `<span class="card-weight">${esc(weight)}</span>` : ""}
                </div>
                ${out ? `<span class="stock-badge out">Sold out</span>` : low ? `<span class="stock-badge low">Last ${p.stock}</span>` : ""}
              </div>
              <div class="card-actions">
                <div style="display:flex; gap:.5rem; padding: 0 1rem 1rem;">
                  <button class="btn small" data-add="${esc(p.id)}"${out ? " disabled" : ""}>${out ? "Sold out" : "Add"}</button>
                  <a class="btn outline small" href="/cart">View cart</a>
                </div>
              </div>
            </article>`;
        }

        function initShop() {
            const grid = document.getElementById("shopResults");
            if (!grid || grid.dataset.jsInit) return;
            grid.dataset.jsInit = "1";

            const ALL: P[] = JSON.parse(document.getElementById("shopData")?.textContent || "[]");
            const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s);
            const state = {
                flags: new Set<string>(),
                sets: { cat: new Set<string>(), origin: new Set<string>(), process: new Set<string>(), roast: new Set<string>() },
                min: "", max: "", sort: "relevance",
            };
            const field: Record<string, string> = { cat: "category", origin: "origin", process: "process", roast: "roast" };

            const uniq = (k: string) => [...new Set(ALL.map((p) => p[k]).filter(Boolean))].sort() as string[];
            const fill = (id: string, name: string, values: string[]) => {
                const el = document.getElementById(id);
                if (el) el.innerHTML = values.map((v) => `<label><input type="checkbox" name="${name}" value="${esc(v)}"> ${esc(v)}</label>`).join("");
            };
            fill("catList", "cat", uniq("category"));
            fill("originList", "origin", uniq("origin"));
            fill("processList", "process", uniq("process"));
            fill("roastList", "roast", uniq("roast"));

            function list() {
                let out = ALL.filter((p) => {
                    for (const f of state.flags) if (!p[f]) return false;
                    for (const [k, set] of Object.entries(state.sets)) if (set.size && !set.has(p[field[k]])) return false;
                    if (state.min && p.price < Number(state.min)) return false;
                    if (state.max && p.price > Number(state.max)) return false;
                    return true;
                });
                if (state.sort === "price-asc") out = out.sort((a, b) => a.price - b.price);
                else if (state.sort === "price-desc") out = out.sort((a, b) => b.price - a.price);
                else if (state.sort === "rating-desc") out = out.sort((a, b) => ratingValue(b) - ratingValue(a));
                return out;
            }

            function render() {
                const items = list();
                grid!.innerHTML = items.map(card).join("");
                const none = document.getElementById("noResults");
                if (none) none.hidden = items.length > 0;
                const pills = [...state.flags].map((f) => $(`.chip[data-flag="${f}"]`)?.textContent ?? f);
                for (const set of Object.values(state.sets)) pills.push(...set);
                if (state.min) pills.push(`≥ ${fmt(Number(state.min))}`);
                if (state.max) pills.push(`≤ ${fmt(Number(state.max))}`);
                const applied = document.getElementById("appliedFilters");
                if (applied) applied.innerHTML = pills.map((t) => `<span class="pill">${esc(t)}</span>`).join("");
                // Avisa al motion (src/scripts/shop/catalog.ts) que hay cards nuevas
                grid!.dispatchEvent(new CustomEvent("shop:render"));
            }

            // El HTML del servidor ya es la lista completa en orden de relevancia:
            // solo se repinta cuando cambia un filtro.
            grid.addEventListener("click", (e) => {
                const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-add]");
                if (!btn || btn.disabled) return;
                const p = ALL.find((x) => x.id === btn.dataset.add);
                if (!p) return;
                (window as any).Cart?.addToCart({ id: p.id, name: p.name, price: p.price, image: p.image, qty: 1 });
                btn.textContent = "✓ Added";
                setTimeout(() => (btn.textContent = "Add"), 1500);
            });

            $("#topChips")?.addEventListener("click", (e) => {
                const chip = (e.target as HTMLElement).closest<HTMLElement>(".chip");
                if (!chip) return;
                const f = chip.dataset.flag!;
                state.flags.has(f) ? state.flags.delete(f) : state.flags.add(f);
                chip.classList.toggle("active", state.flags.has(f));
                render();
            });
            $<HTMLSelectElement>("#shopSort")?.addEventListener("change", (e) => {
                state.sort = (e.target as HTMLSelectElement).value;
                render();
            });
            $("#filtersToggle")?.addEventListener("click", () => {
                const open = $("#shopSidebar")?.classList.toggle("open");
                $("#filtersToggle")?.setAttribute("aria-expanded", String(!!open));
            });
            $("#shopSidebar")?.addEventListener("change", (e) => {
                const t = e.target as HTMLInputElement;
                if (t.type !== "checkbox") return;
                const set = state.sets[t.name as keyof typeof state.sets];
                if (!set) return;
                t.checked ? set.add(t.value) : set.delete(t.value);
                render();
            });
            $("#applyPrice")?.addEventListener("click", () => {
                state.min = $<HTMLInputElement>("#priceMin")?.value ?? "";
                state.max = $<HTMLInputElement>("#priceMax")?.value ?? "";
                render();
            });
            $("#clearFilters")?.addEventListener("click", () => {
                state.flags.clear();
                Object.values(state.sets).forEach((s) => s.clear());
                state.min = state.max = "";
                state.sort = "relevance";
                document.querySelectorAll<HTMLInputElement>("#shopSidebar input").forEach((i) => (i.type === "checkbox" ? (i.checked = false) : (i.value = "")));
                document.querySelectorAll(".chip").forEach((c) => c.classList.remove("active"));
                const sort = $<HTMLSelectElement>("#shopSort");
                if (sort) sort.value = "relevance";
                render();
            });
        }

        initShop();
        document.addEventListener("astro:page-load", initShop);
    </script>
    <script>
        import "../../scripts/shop/index.ts";
    </script>
</Layout>
