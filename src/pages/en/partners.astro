---
import DarkHero from "../../components/shop/DarkHero.astro";
import SupplyLine from "../../components/shop/SupplyLine.astro";
import FeatureGrid from "../../components/shop/FeatureGrid.astro";
import ChipRow from "../../components/shop/ChipRow.astro";
import CtaBand from "../../components/shop/CtaBand.astro";
import Layout from "../../layouts/Layout.astro";
import { getCanonicalUrl, getHreflangPair } from "../../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/partners");

const benefits = [
  {
    icon: "handshake",
    title: "Direct sourcing",
    text: "We buy from farmers with no middlemen and pass that quality on to you at partner pricing.",
  },
  {
    icon: "map-pin",
    title: "Origin with a name",
    text: "Every lot comes from a specific farm and harvest, a story you can share with your customers.",
  },
  {
    icon: "flame",
    title: "Custom roast profile",
    text: "We define the roast curve based on your brewing method and volume, with fresh, scheduled deliveries.",
  },
  {
    icon: "trending-up",
    title: "Commercial support",
    text: "Brand materials, barista training and ongoing support to help your operation grow with us.",
  },
  {
    icon: "package",
    title: "Flexible quantities",
    text: "From small cafés to multi-location chains, we adapt our supply to your actual needs.",
  },
  {
    icon: "sprout",
    title: "Sustainable story",
    text: "Partner with a brand your customers can trust: transparent supply chain, fair trade, Colombian heritage.",
  },
];

const types = [
  { icon: "coffee", label: "Specialty cafés" },
  { icon: "utensils", label: "Restaurants & hotels" },
  { icon: "store", label: "Specialty retailers" },
  { icon: "building", label: "Corporate offices" },
  { icon: "gift", label: "Gift & lifestyle brands" },
  { icon: "globe", label: "International importers" },
];
---

<Layout
  lang="en"
  title="Partner Zone · DobleYo Café"
  description="Become a DobleYo Café partner: cafés, restaurants, retailers and distributors. Single-origin Colombian specialty coffee, custom roasts and commercial support."
  canonical={getCanonicalUrl("/partners", "en")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    lang="en"
    crumb="Partners"
    title="Bring single-origin coffee"
    titleEm="to your customers."
    lead="We supply specialty cafés, restaurants, retailers and distributors with freshly roasted, single-origin Colombian coffee, direct from the farms."
    cta={{ href: "/contact", label: "Request information" }}
    cta2={{ href: "/wholesale", label: "Wholesale info" }}
  >
    <SupplyLine
      stops={[
        { icon: "sprout", title: "The farm", text: "Bought direct from the grower" },
        { icon: "flame", title: "Your roast", text: "Profile for your brew method" },
        { icon: "store", title: "Your business", text: "Fresh, scheduled deliveries" },
      ]}
    />
  </DarkHero>

  <ChipRow title="Who we work with" items={types} />

  <FeatureGrid eyebrow="Benefits" title="Why partner with DobleYo" items={benefits} />

  <CtaBand
    title="Ready to start?"
    text="Tell us about your operation (volume, brewing methods and needs) and we'll put together a custom proposal."
    primary={{ href: "/contact", label: "Contact us" }}
    secondary={{ href: "/wholesale", label: "Wholesale info" }}
  />

  <script>
    import "../../scripts/shop/index.ts";
  </script>
</Layout>
