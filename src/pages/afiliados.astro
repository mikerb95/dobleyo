---
import Layout from "../layouts/Layout.astro";
import DarkHero from "../components/shop/DarkHero.astro";
import RefFlow from "../components/shop/RefFlow.astro";
import NumberedList from "../components/shop/NumberedList.astro";
import FeatureGrid from "../components/shop/FeatureGrid.astro";
import CtaBand from "../components/shop/CtaBand.astro";
import { getCanonicalUrl, getHreflangPair } from "../i18n/index.ts";

export const prerender = false;

const hreflang = getHreflangPair("/afiliados");
const pageTitle = "Programa de afiliados · DobleYo Café";
const pageDescription =
  "Gane comisiones recomendando café de especialidad colombiano. Únase al programa de afiliados de DobleYo Café: enlace propio, comisiones por venta y pagos mensuales.";

const pasos = [
  {
    title: "Regístrese",
    text: "Solicite su acceso al programa desde el formulario de contacto. Revisamos su perfil y le damos la bienvenida.",
  },
  {
    title: "Comparta su enlace",
    text: "Reciba un enlace de afiliado único para compartir en redes, blog o con su comunidad.",
  },
  {
    title: "Gane comisiones",
    text: "Por cada compra realizada con su enlace, usted gana una comisión sobre la venta.",
  },
  {
    title: "Reciba sus pagos",
    text: "Liquidamos sus comisiones de forma mensual una vez superado el mínimo de retiro.",
  },
];

const ventajas = [
  { icon: "percent", title: "Comisión por venta", text: "Comisión competitiva sobre cada venta confirmada." },
  { icon: "clock", title: "30 días de seguimiento", text: "Cookie de seguimiento de 30 días desde el clic." },
  { icon: "bar-chart", title: "Panel propio", text: "Consulte sus clics, ventas y comisiones." },
  { icon: "palette", title: "Material de marca", text: "Material gráfico y de marca listo para usar." },
  { icon: "check", title: "Sin costos", text: "Sin costo de inscripción ni permanencia." },
];
---

<Layout
  lang="es"
  title={pageTitle}
  description={pageDescription}
  canonical={getCanonicalUrl("/afiliados", "es")}
  hreflangEs={hreflang?.es}
  hreflangEn={hreflang?.en}
>
  <DarkHero
    crumb="Afiliados"
    title="Recomiende café,"
    titleEm="gane comisiones."
    lead="Si le apasiona el buen café y tiene una comunidad que confía en usted, conviértalo en ingresos: comparta DobleYo y reciba una comisión por cada venta que genere."
    cta={{ href: "/contacto", label: "Quiero afiliarme" }}
  >
    <RefFlow lang="es" />
  </DarkHero>

  <NumberedList eyebrow="Paso a paso" title="Cómo funciona" items={pasos} connected />

  <FeatureGrid eyebrow="Ventajas" title="Lo que incluye el programa" items={ventajas} />

  <CtaBand
    title="Empiece a ganar hoy"
    text="La inscripción es gratuita. Escríbanos y le activamos su enlace de afiliado."
    primary={{ href: "/contacto", label: "Solicitar acceso" }}
  />

  <script>
    import "../scripts/shop/index.ts";
  </script>
</Layout>
