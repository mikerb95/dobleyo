      display: block; height: auto; padding: 0; border: 0; text-align: left; min-width: 0;
    }
    .pg-mercadolibre .rtable tbody td[data-label]::before {
      content: attr(data-label); display: block;
      font-size: 11px; color: var(--text-3); margin-bottom: 2px; font-family: var(--font-sans, inherit); font-weight: 400;
    }
    .pg-mercadolibre .rtable td.empty-state { grid-column: 1 / -1; text-align: center; }
    .pg-mercadolibre .rtable .c-full { grid-column: 1 / -1; }
    .pg-mercadolibre .rtable .row-actions { justify-content: flex-start; flex-wrap: wrap; gap: 6px; }
    .pg-mercadolibre .rtable .row-actions .btn-icon { width: auto; padding: 0 10px; }
