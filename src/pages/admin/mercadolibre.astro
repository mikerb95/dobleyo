  .pg-mercadolibre .quick-action:hover { background: var(--active-bg); color: var(--brand-dark); }
  .pg-mercadolibre .quick-action:focus-visible { outline: none; box-shadow: inset 0 0 0 2px var(--brand); }
  .pg-mercadolibre .quick-action svg { flex-shrink: 0; opacity: .6; }
  .pg-mercadolibre .quick-action:hover svg { opacity: 1; }

  /* Configuración: etiqueta arriba, valor abajo; nada se parte a la mitad. */
  .pg-mercadolibre .cfg { margin: 0; padding: 4px 16px 8px; }
  .pg-mercadolibre .cfg-item {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    padding: 9px 0; border-bottom: 1px solid var(--rule);
  }
  .pg-mercadolibre .cfg-item:last-child { border-bottom: 0; }
  .pg-mercadolibre .cfg-item dt { font-size: 12px; color: var(--text-3); }
  .pg-mercadolibre .cfg-item dd { margin: 0; font-size: 12px; color: var(--text-1); text-align: right; }
  .pg-mercadolibre .cfg-details { border-top: 1px solid var(--border); }
  .pg-mercadolibre .cfg-details summary {
    cursor: pointer; padding: 10px 16px; font-size: 12px; font-weight: 500; color: var(--text-2);
    list-style-position: inside; transition: background-color .15s;
  }
  .pg-mercadolibre .cfg-details summary:hover { background: var(--hover); color: var(--brand-dark); }
  .pg-mercadolibre .cfg-tech { padding: 0 16px 14px; }
  .pg-mercadolibre .cfg-tech-label { font-size: 11px; color: var(--text-3); margin: 0 0 4px; }
  .pg-mercadolibre .cfg-copy { display: flex; gap: 6px; align-items: center; margin-bottom: 10px; }
  .pg-mercadolibre .cfg-copy code {
    flex: 1; min-width: 0; font-family: var(--font-mono); font-size: 11px;
    background: var(--hover); padding: 6px 8px; border-radius: 4px;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .pg-mercadolibre .cfg-note { font-size: 11px; color: var(--text-3); line-height: 1.6; margin: 0 0 8px; }
  .pg-mercadolibre .cfg-note:last-child { margin-bottom: 0; }
  .pg-mercadolibre .cfg-note code { background: var(--hover); padding: 1px 4px; border-radius: 2px; font-family: var(--font-mono); }

  /* ── CRM ─────────────────────────────────────────────────────── */
  .pg-mercadolibre .crm-chip {
    display: inline-flex; align-items: center; gap: 6px; max-width: 170px;
    background: var(--c-success-bg); color: var(--c-success); border: 1px solid var(--c-success-border);
    padding: 2px 4px 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;
  }
  .pg-mercadolibre .crm-chip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pg-mercadolibre .crm-unlink {
    background: none; border: none; cursor: pointer; color: inherit; border-radius: 50%;
    width: 18px; height: 18px; font-size: 11px; line-height: 1; padding: 0; opacity: .7;
  }
  .pg-mercadolibre .crm-unlink:hover { opacity: 1; background: var(--c-success-border); }

  /* ── Modales ─────────────────────────────────────────────────── */
  .pg-mercadolibre .crm-modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.4);
    display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 16px;
  }
  .pg-mercadolibre .crm-modal {
    background: var(--card-bg); border-radius: 8px; width: 100%; max-width: 420px;
    box-shadow: 0 16px 48px -12px rgba(0,0,0,.3); border: 1px solid var(--border);
  }
  .pg-mercadolibre .crm-modal-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; border-bottom: 1px solid var(--border);
  }
  .pg-mercadolibre .crm-modal-close {
    background: none; border: none; cursor: pointer; font-size: 16px; color: var(--text-2);
    width: 30px; height: 30px; border-radius: 4px; line-height: 1;
  }
  .pg-mercadolibre .crm-modal-close:hover { background: var(--active-bg); color: var(--brand-dark); }
  .pg-mercadolibre .crm-modal--wide { max-width: 640px; max-height: calc(100vh - 32px); display: flex; flex-direction: column; }
  .pg-mercadolibre .lnk-body { padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }
  .pg-mercadolibre .lnk-step { border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin: 0; min-width: 0; }
  .pg-mercadolibre .lnk-step legend { font-size: 12px; font-weight: 600; padding: 0 6px; color: var(--text-1); }
  .pg-mercadolibre .lnk-field { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; font-size: 12px; color: var(--text-2); }
  .pg-mercadolibre .lnk-field .ml-input { width: 100%; height: 36px; font-size: 13px; }
  .pg-mercadolibre .lnk-field small { font-size: 11px; color: var(--text-3); line-height: 1.5; }
  .pg-mercadolibre .lnk-search { display: flex; gap: 8px; }
  .pg-mercadolibre .lnk-search .ml-input { flex: 1; min-width: 0; height: 32px; }
  .pg-mercadolibre .lnk-items { margin-top: 8px; max-height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px; }
  .pg-mercadolibre .lnk-item {
    display: flex; gap: 10px; align-items: center; width: 100%; text-align: left;
    padding: 8px 10px; background: none; border: none; border-bottom: 1px solid var(--border);
    font-family: inherit; font-size: 12px; color: var(--text-1); cursor: pointer; transition: background-color .15s;
  }
  .pg-mercadolibre .lnk-item:last-child { border-bottom: none; }
  .pg-mercadolibre .lnk-item:hover:not([disabled]), .pg-mercadolibre .lnk-item[aria-selected="true"] { background: var(--active-bg); }
  .pg-mercadolibre .lnk-item[aria-selected="true"] { box-shadow: inset 0 0 0 1px var(--brand); }
  .pg-mercadolibre .lnk-item[disabled] { cursor: default; opacity: .55; }
  .pg-mercadolibre .lnk-item img { width: 36px; height: 36px; object-fit: cover; border-radius: 4px; flex-shrink: 0; background: var(--hover); }
  .pg-mercadolibre .lnk-item-main { flex: 1; min-width: 0; }
  .pg-mercadolibre .lnk-item-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .pg-mercadolibre .lnk-item-meta { display: block; font-size: 11px; color: var(--text-3); font-family: var(--font-mono); }
  .pg-mercadolibre .lnk-error { margin: 0; padding: 10px 12px; border-radius: 6px; background: var(--c-error-bg); color: var(--c-error); font-size: 12px; }
  .pg-mercadolibre .lnk-foot { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
  @media (max-width: 480px) {
    .pg-mercadolibre .lnk-foot .btn { flex: 1; justify-content: center; }
    .pg-mercadolibre .stk-actions { width: 100%; }
    .pg-mercadolibre .stk-actions .btn { flex: 1; justify-content: center; }
    .pg-mercadolibre .ord-ff { flex: 1 1 40%; }
    .pg-mercadolibre .ord-ff .ml-input, .pg-mercadolibre .ord-ff input[type="text"] { width: 100%; }
  }
</style>

<script>
  // ── State ──────────────────────────────────────────────────
  let currentPage = 0;
  const limit = 25;
  let totalOrders = 0;
  let allSalesCache: any[] = [];

  const fmt = (n: number) =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(n);

  const fmtDate = (s: string) =>
    s ? new Date(s).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

  // ── Load stats ─────────────────────────────────────────────
  async function loadStats() {
    try {
      const res = await fetch('/api/mercadolibre/stats', { credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) return;

      // El estado de la conexión lo decide /status, no la existencia de pedidos
      // (hay pedidos de demostración sembrados que no prueban nada).
      const ov = json.overview;
      if (!ov || !ov.total_orders) {
        document.getElementById('kpiOrders')!.textContent = '0';
        document.getElementById('kpiRevenue')!.textContent = '$0';
        document.getElementById('kpiAvg')!.textContent = '$0';
        document.getElementById('kpiCities')!.textContent = '0';
      } else {
        document.getElementById('kpiOrders')!.textContent = ov.total_orders.toLocaleString('es-CO');
        document.getElementById('kpiOrdersRange')!.textContent = `${fmtDate(ov.first_order_date)} - ${fmtDate(ov.last_order_date)}`;
        document.getElementById('kpiRevenue')!.textContent = fmt(ov.total_revenue ?? 0);
        document.getElementById('kpiAvg')!.textContent = fmt(ov.avg_order_value ?? 0);
        document.getElementById('kpiCities')!.textContent = (ov.unique_cities ?? 0).toString();
        document.getElementById('kpiStates')!.textContent = `en ${ov.unique_states ?? 0} departamentos`;
      }

      renderCities(json.top_cities ?? []);
    } catch { /* los KPIs quedan con el esqueleto */ }
  }

  // ── Estado de la conexión ──────────────────────────────────
  // /status?check=1 llama a MercadoLibre con el token: verde solo si responde.
  const fmtDateTime = (s: string | null) => {
    if (!s) return '-';
    const d = new Date(/[zZ]|[+-]\d{2}:?\d{2}$/.test(s) ? s : `${String(s).replace(' ', 'T')}Z`);
    if (Number.isNaN(d.getTime())) return '-';
    return d.toLocaleString('es-CO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota' });
  };

  function setStatusText(el: HTMLElement, kind: 'ok'|'warn'|'error'|'info'|'', text: string) {
    el.className = `status${kind ? ` status--${kind}` : ''}`;
    el.textContent = text;
  }

  function renderConnActions(conn: any) {
    const box = document.getElementById('connActions')!;
    box.innerHTML = '';
    if (conn.oauth_configured) {
      const a = document.createElement('a');
      a.className = `btn btn-sm ${conn.source === 'oauth' ? 'btn-secondary' : 'btn-primary'}`;
      a.href = '/api/mercadolibre/oauth/start';
      a.textContent = conn.source === 'oauth' ? 'Reconectar' : 'Conectar MercadoLibre';
      box.appendChild(a);
    }
    if (conn.source === 'oauth') {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn btn-sm btn-ghost';
      b.textContent = 'Desconectar';
      b.addEventListener('click', disconnectMl);
      box.appendChild(b);
    }
  }

  async function disconnectMl() {
    if (!confirm('¿Desconectar la cuenta de MercadoLibre? El stock dejará de enviarse hasta que la vuelva a conectar.')) return;
    try {
      const res = await fetch('/api/mercadolibre/oauth/disconnect', { method: 'POST', credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo desconectar');
      await checkCredentials();
    } catch (e: any) {
      showStkBanner('error', e.message);
    }
  }

  async function checkCredentials() {
    const cfgConn = document.getElementById('cfgConn')!;
    const cfgCron = document.getElementById('cfgCron')!;
    try {
      const res = await fetch('/api/mercadolibre/status?check=1', { credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'status');
      const { connection: conn, live, cron_secret_configured, last_sync, webhook_url, stock } = json.data;

      renderConnActions(conn);
      document.getElementById('cfgAccount')!.textContent =
        conn.nickname ? `${conn.nickname} (${conn.ml_user_id})` : (conn.ml_user_id ?? '-');
      document.getElementById('cfgExpires')!.textContent =
        conn.source === 'oauth' ? `${fmtDateTime(conn.expires_at)} (se renueva solo)` : (conn.source === 'env' ? 'Desconocido' : '-');
      document.getElementById('cfgLastSync')!.textContent = fmtDateTime(last_sync);
      if (webhook_url) document.getElementById('cfgWebhook')!.textContent = webhook_url;
      setStatusText(cfgCron, cron_secret_configured ? 'ok' : '', cron_secret_configured ? 'Configurado' : 'No configurado');

      if (!conn.connected) {
        setConnectionStatus('err', 'MercadoLibre no está conectado',
          conn.oauth_configured
            ? 'Conecte la cuenta de vendedor para sincronizar órdenes y stock.'
            : 'Faltan ML_CLIENT_ID y ML_CLIENT_SECRET en las variables de entorno para poder conectar.');
        setStatusText(cfgConn, 'error', 'Sin conexión');
      } else if (live && !live.ok) {
        setConnectionStatus('err', 'MercadoLibre rechazó la conexión', live.error || 'Vuelva a conectar la cuenta.');
        setStatusText(cfgConn, 'error', conn.source === 'oauth' ? 'OAuth con error' : 'Token fijo vencido');
      } else if (conn.source === 'env') {
        setConnectionStatus('warn', 'Conectado con un token fijo',
          'ML_ACCESS_TOKEN vence a las 6 horas y no se puede renovar. Conecte con OAuth para que se renueve solo.');
        setStatusText(cfgConn, 'warn', 'Token fijo');
      } else {
        const who = live?.nickname || conn.nickname || conn.ml_user_id;
        const extra = stock ? ` · ${stock.linked} publicación(es) vinculada(s)` : '';
        setConnectionStatus('ok', `Conectado a MercadoLibre como ${who}`, `Token vigente hasta ${fmtDateTime(conn.expires_at)}, se renueva solo${extra}`);
        setStatusText(cfgConn, 'ok', 'OAuth');
      }
      if (conn.last_error && conn.source === 'oauth') {
        document.getElementById('connSub')!.textContent += ` · Último error: ${conn.last_error}`;
      }
    } catch {
      setConnectionStatus('warn', 'No se pudo verificar la conexión', 'Revise los logs del servidor');
      setStatusText(cfgConn, 'warn', 'Sin verificar');
    }
  }

  function setConnectionStatus(type: 'ok'|'err'|'warn', title: string, sub: string) {
    const dot = document.getElementById('connDot')!;
    dot.className = `conn-dot ${type}`;
    document.getElementById('connTitle')!.textContent = title;
    document.getElementById('connSub')!.textContent = sub;
  }

  // ── Load orders ────────────────────────────────────────────
  async function loadOrders(page = 0) {
    currentPage = page;
    const tbody = document.getElementById('ordersBody')!;
    tbody.innerHTML = '<tr><td colspan="10" class="empty-state">Cargando...</td></tr>';

    const city = (document.getElementById('filterCity') as HTMLInputElement).value.trim();
    const dateFrom = (document.getElementById('filterFrom') as HTMLInputElement).value;
    const dateTo = (document.getElementById('filterTo') as HTMLInputElement).value;
    const status = (document.getElementById('filterStatus') as HTMLSelectElement).value;

    const params = new URLSearchParams({
      limit: String(limit),
      offset: String(page * limit),
      ...(city && { city }),
      ...(dateFrom && { dateFrom }),
      ...(dateTo && { dateTo }),
      ...(status && { status }),
    });

    try {
      const res = await fetch(`/api/mercadolibre/sales?${params}`, { credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) {
        tbody.innerHTML = `<tr><td colspan="10" class="empty-state">No se pudieron cargar los pedidos. ${esc(json.error ?? '')}</td></tr>`;
        return;
      }

      const rows: any[] = json.data ?? [];

      allSalesCache = rows;
      totalOrders = json.pagination?.total ?? rows.length;

      document.getElementById('tableSubtitle')!.textContent =
        `${totalOrders.toLocaleString('es-CO')} pedidos`;

      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" class="empty-state">No hay pedidos con estos filtros.</td></tr>';
        document.getElementById('paginationBar')!.style.display = 'none';
        return;
      }

      tbody.innerHTML = rows.map((r: any) => `
        <tr>
          <td class="mono ml-nowrap">${esc(r.ml_order_id ?? r.id ?? '-')}</td>
          <td class="mono ml-nowrap">${fmtDate(r.purchase_date ?? r.created_at)}</td>
          <td>${esc(r.buyer_nickname ?? r.buyer_name ?? '-')}</td>
          <td>${esc(r.recipient_city ?? '-')}</td>
          <td>${esc(r.recipient_state ?? '-')}</td>
          <td class="num mono ml-nowrap">${fmt(r.total_amount ?? 0)}</td>
          <td>${badgeStatus(r.payment_status)}</td>
          <td>${badgeShipping(r.shipping_status)}</td>
          <td>${crmCell(r)}</td>
          <td>
            ${r.ml_order_id ? `<a href="https://www.mercadolibre.com.co/ventas/${encodeURIComponent(r.ml_order_id)}/detalle" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" title="Ver en MercadoLibre" aria-label="Ver pedido en MercadoLibre">↗</a>` : ''}
          </td>
        </tr>
      `).join('');

      bindCrmButtons();
      renderPagination(json.pagination);
    } catch (e: any) {
      tbody.innerHTML = `<tr><td colspan="10" class="empty-state">Error de red: ${esc(e.message)}</td></tr>`;
    }
  }

  const STATUS_DOT: Record<string, string> = {
    success: 'status--paid', info: 'status--confirmed', warning: 'status--pending', error: 'status--cancelled',
  };

  function badgeStatus(s: string) {
    const map: Record<string, string> = {
      paid: 'success', approved: 'success',
      pending: 'warning',
      cancelled: 'error', rejected: 'error',
    };
    const key = (s ?? '').toLowerCase();
    const cls = map[key] ?? 'neutral';
    const labels: Record<string, string> = { paid:'Pagado', approved:'Aprobado', pending:'Pendiente', cancelled:'Cancelado', rejected:'Rechazado' };
    return `<span class="status ${STATUS_DOT[cls] ?? ''}">${esc(labels[key] ?? s ?? '-')}</span>`;
  }

  function badgeShipping(s: string) {
    const map: Record<string, string> = {
      delivered: 'success', handling: 'info', ready_to_ship: 'info',
      shipped: 'info', not_delivered: 'error', cancelled: 'error',
    };
    const key = (s ?? '').toLowerCase();
    const cls = map[key] ?? 'neutral';
    const labels: Record<string, string> = {
      delivered:'Entregado', handling:'Preparando', ready_to_ship:'Listo', shipped:'Enviado',
      not_delivered:'No entregado', cancelled:'Cancelado',
    };
    return `<span class="status ${STATUS_DOT[cls] ?? ''}">${esc(labels[key] ?? s ?? '-')}</span>`;
  }

  function renderPagination(pag: any) {
    if (!pag || pag.pages <= 1) {
      document.getElementById('paginationBar')!.style.display = 'none';
      return;
    }
    const bar = document.getElementById('paginationBar')!;
    bar.style.display = 'flex';

    const from = currentPage * limit + 1;
    const to = Math.min((currentPage + 1) * limit, pag.total);
    document.getElementById('pagInfo')!.textContent = `${from}-${to} de ${pag.total}`;

    const prevBtn = document.getElementById('btnPrev') as HTMLButtonElement;
    const nextBtn = document.getElementById('btnNext') as HTMLButtonElement;
    prevBtn.disabled = currentPage === 0;
    nextBtn.disabled = currentPage >= pag.pages - 1;

    const container = document.getElementById('pagPages')!;
    container.innerHTML = '';
    const maxPages = 5;
    let start = Math.max(0, currentPage - Math.floor(maxPages / 2));
    let end = Math.min(pag.pages - 1, start + maxPages - 1);
    if (end - start < maxPages - 1) start = Math.max(0, end - maxPages + 1);

    for (let i = start; i <= end; i++) {
      const btn = document.createElement('button');
      btn.className = `btn btn-ghost${i === currentPage ? ' pag-btn-active' : ''}`;
      btn.style.cssText = 'height:30px;padding:0 10px;font-size:12px;min-width:32px';
      btn.textContent = String(i + 1);
      btn.addEventListener('click', () => loadOrders(i));
      container.appendChild(btn);
    }
  }

  // ── Top cities ─────────────────────────────────────────────
  function renderCities(cities: any[]) {
    const el = document.getElementById('citiesList')!;
    if (!cities.length) {
      el.innerHTML = '<div class="empty-state">Sin datos</div>';
      return;
    }
    const max = cities[0]?.order_count ?? 1;
    el.innerHTML = cities.slice(0, 10).map((c: any, i: number) => `
      <div class="city-row">
        <div class="city-rank">${i + 1}</div>
        <div class="city-name">${c.recipient_city ?? '-'}</div>
        <div class="city-bar-wrap"><div class="city-bar" style="width:${Math.round((c.order_count / max) * 100)}%"></div></div>
        <div class="city-count">${c.order_count}</div>
      </div>
    `).join('');
  }

  // ── Sync ───────────────────────────────────────────────────
  async function doSync() {
    const btn = document.getElementById('btnSync')!;
    const icon = document.getElementById('syncIcon')!;
    const banner = document.getElementById('syncBanner')!;

    btn.setAttribute('disabled', '');
    icon.classList.add('spinning');
    banner.style.display = 'none';

    try {
      const res = await fetch('/api/mercadolibre/sync', { method: 'POST', credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) {
        banner.innerHTML = `<div class="banner error">La sincronización falló: ${esc(json.error ?? json.details ?? 'error desconocido')}</div>`;
      } else {
        const st = json.stock;
        const stockTxt = st && (st.applied || st.reverted)
          ? ` Stock: ${esc(st.applied)} venta(s) descontada(s)${st.reverted ? `, ${esc(st.reverted)} cancelación(es) repuesta(s)` : ''}.`
          : '';
        banner.innerHTML = `<div class="banner success">Sincronización completada: ${esc(json.processed ?? 0)} procesados, ${esc(json.saved ?? 0)} guardados${json.failed ? `, ${esc(json.failed)} con error` : ''}.${stockTxt}</div>`;
        await loadStats();
        await loadOrders(0);
        await loadListings();
      }
    } catch (e: any) {
      banner.innerHTML = `<div class="banner error">Error de red: ${esc(e.message)}</div>`;
    } finally {
      btn.removeAttribute('disabled');
      icon.classList.remove('spinning');
      banner.style.display = 'block';
      setTimeout(() => { banner.style.display = 'none'; }, 8000);
    }
  }

  // ── CSV export ─────────────────────────────────────────────
  function exportCSV() {
    if (!allSalesCache.length) { alert('No hay datos para exportar. Cargue los pedidos primero.'); return; }
    const headers = ['Pedido ML','Fecha','Comprador','Ciudad','Dpto','Total COP','Estado Pago','Estado Envío','Cuenta CRM'];
    const rows = allSalesCache.map((r: any) => [
      r.ml_order_id ?? r.id ?? '',
      r.purchase_date ?? r.created_at ?? '',
      r.buyer_nickname ?? r.buyer_name ?? '',
      r.recipient_city ?? '',
      r.recipient_state ?? '',
      r.total_amount ?? 0,
      r.payment_status ?? '',
      r.shipping_status ?? '',
      r.crm_account_name ?? '',
    ]);
    const csv = [headers, ...rows].map((row: any[]) =>
      row.map((v: any) => `"${String(v).replace(/"/g, '""')}"`).join(',')
    ).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pedidos-ml-${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // ── CRM linking ────────────────────────────────────────────
  let crmAccounts: any[] = [];
  let crmModalSaleId: number | null = null;

  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c: string) =>
    ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c] as string));

  function crmCell(r: any) {
    const saleId = r.id;
    if (r.crm_account_id) {
      return `<span class="crm-chip">
        <span class="crm-chip-name" title="${esc(r.crm_account_name)}">${esc(r.crm_account_name ?? 'Cuenta')}</span>
        <button class="crm-unlink js-crm-unlink" data-sale-id="${saleId}" title="Desvincular">✕</button>
      </span>`;
    }
    return `<button class="btn btn-ghost js-crm-link" data-sale-id="${saleId}" data-order-id="${esc(r.ml_order_id ?? '')}"
      style="height:28px;padding:0 10px;font-size:11px">+ Vincular</button>`;
  }

  function bindCrmButtons() {
    document.querySelectorAll('.js-crm-link').forEach(btn => {
      btn.addEventListener('click', () => {
        const saleId = Number((btn as HTMLElement).dataset.saleId);
        const orderId = (btn as HTMLElement).dataset.orderId ?? '';
        openCrmModal(saleId, orderId);
      });
    });
    document.querySelectorAll('.js-crm-unlink').forEach(btn => {
      btn.addEventListener('click', () => doUnlink(Number((btn as HTMLElement).dataset.saleId)));
    });
  }

  async function loadCrmAccounts() {
    try {
      const res = await fetch('/api/crm/accounts?limit=200', { credentials: 'include' });
      const json = await res.json();
      crmAccounts = json?.data?.items ?? [];
    } catch { crmAccounts = []; }
  }

  function openCrmModal(saleId: number, orderId: string) {
    crmModalSaleId = saleId;
    document.getElementById('crmModalOrderId')!.textContent = orderId || `#${saleId}`;
    const sel = document.getElementById('crmAccountSelect') as HTMLSelectElement;
    if (!crmAccounts.length) {
      sel.innerHTML = '<option value="">No hay cuentas CRM. Créelas en /admin/crm</option>';
    } else {
      sel.innerHTML = '<option value="">Seleccione una cuenta…</option>' +
        crmAccounts.map((a: any) => `<option value="${a.id}">${esc(a.display_name)}</option>`).join('');
    }
    document.getElementById('crmModal')!.style.display = 'flex';
  }

  function closeCrmModal() {
    document.getElementById('crmModal')!.style.display = 'none';
    crmModalSaleId = null;
  }

  async function confirmCrmLink() {
    const sel = document.getElementById('crmAccountSelect') as HTMLSelectElement;
    const accountId = Number(sel.value);
    if (!accountId || !crmModalSaleId) { alert('Seleccione una cuenta.'); return; }
    try {
      const res = await fetch(`/api/crm/accounts/${accountId}/sales`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sale_ids: [crmModalSaleId] }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) { alert(`No se pudo vincular: ${json?.error?.message ?? 'error'}`); return; }
      closeCrmModal();
      loadOrders(currentPage);
    } catch (e: any) {
      alert(`Error de red: ${e.message}`);
    }
  }

  async function doUnlink(saleId: number) {
    if (!confirm('¿Desvincular este pedido de la cuenta CRM?')) return;
    try {
      const res = await fetch(`/api/crm/sales/${saleId}/link`, { method: 'DELETE', credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) { alert(`No se pudo desvincular: ${json?.error?.message ?? 'error'}`); return; }
      loadOrders(currentPage);
    } catch (e: any) {
      alert(`Error de red: ${e.message}`);
    }
  }

  document.getElementById('crmModalClose')?.addEventListener('click', closeCrmModal);
  document.getElementById('crmModalCancel')?.addEventListener('click', closeCrmModal);
  document.getElementById('crmModalConfirm')?.addEventListener('click', confirmCrmLink);
  document.getElementById('crmModal')?.addEventListener('click', (e: MouseEvent) => {
    if ((e.target as HTMLElement).id === 'crmModal') closeCrmModal();
  });

  // ── Event listeners ────────────────────────────────────────
  document.getElementById('btnSync')?.addEventListener('click', doSync);
  document.getElementById('btnSyncQuick')?.addEventListener('click', doSync);
  document.getElementById('btnFilter')?.addEventListener('click', () => loadOrders(0));
  document.getElementById('btnExportCSV')?.addEventListener('click', exportCSV);
  document.getElementById('btnPrev')?.addEventListener('click', () => loadOrders(currentPage - 1));
  document.getElementById('btnNext')?.addEventListener('click', () => loadOrders(currentPage + 1));

  // Enter key on filters
  ['filterCity','filterFrom','filterTo','filterStatus'].forEach(id => {
    document.getElementById(id)?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') loadOrders(0);
    });
  });

  // ── Centralizador de stock ─────────────────────────────────
  type Listing = any;
  let listingsCache: Listing[] = [];

  const OAUTH_ERRORS: Record<string, string> = {
    ML_OAUTH_NOT_CONFIGURED: 'Faltan ML_CLIENT_ID y ML_CLIENT_SECRET en las variables de entorno.',
    ML_OAUTH_DENIED: 'La autorización fue cancelada en MercadoLibre.',
    ML_OAUTH_STATE: 'La respuesta de MercadoLibre no coincide con la solicitud (puede haber expirado). Intente de nuevo.',
    ML_NO_REFRESH_TOKEN: 'MercadoLibre no entregó refresh token. Active el permiso offline_access en la aplicación de ML.',
    ML_TOKEN_SECRET_MISSING: 'Falta ML_TOKEN_SECRET (o JWT_SECRET) para cifrar los tokens.',
    ML_OAUTH_EXCHANGE: 'MercadoLibre no aceptó el código de autorización. Revise que la URL de regreso de la app coincida.',
  };

  function showStkBanner(kind: 'success'|'error'|'info', text: string) {
    const el = document.getElementById('stkBanner')!;
    el.className = `stk-banner ${kind}`;
    el.textContent = text;
    el.hidden = false;
    clearTimeout((el as any)._t);
    (el as any)._t = setTimeout(() => { el.hidden = true; }, kind === 'error' ? 15000 : 8000);
  }

  function showOAuthResult() {
    const params = new URLSearchParams(location.search);
    if (params.get('ml') === 'connected') {
      showStkBanner('success', 'Cuenta de MercadoLibre conectada. El token se renovará automáticamente.');
    } else if (params.get('ml_error')) {
      const code = params.get('ml_error')!;
      showStkBanner('error', `No se pudo conectar MercadoLibre: ${OAUTH_ERRORS[code] ?? code}`);
    } else {
      return;
    }
    params.delete('ml');
    params.delete('ml_error');
    const qs = params.toString();
    history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
  }

  function listingState(l: Listing): { kind: 'ok'|'warn'|'error'|'info'|'', text: string } {
    if (!Number(l.is_active)) return { kind: '', text: 'Pausado' };
    if (l.is_fulfillment) return { kind: 'info', text: 'Full: stock en ML' };
    if (l.local_available === null) return { kind: 'error', text: 'Producto borrado' };
    if (l.last_error) return { kind: 'error', text: 'Error' };
    if (Number(l.pending_push)) return { kind: 'warn', text: 'Pendiente' };
    return { kind: 'ok', text: 'Sincronizado' };
  }

  const numCell = (v: any) => (v === null || v === undefined ? '-' : esc(Number(v).toLocaleString('es-CO')));

  function renderListings() {
    const tbody = document.getElementById('stkBody')!;
    const sub = document.getElementById('stkSubtitle')!;
    if (!listingsCache.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="empty-state">Aún no hay publicaciones vinculadas. Use "Vincular publicación" para empezar.</td></tr>';
      return;
    }
    const pending = listingsCache.filter((l) => Number(l.is_active) && Number(l.pending_push)).length;
    const errors = listingsCache.filter((l) => Number(l.is_active) && l.last_error).length;
    sub.textContent = `${listingsCache.length} vinculada(s) · ${pending} pendiente(s) · ${errors} con error`;

    tbody.innerHTML = listingsCache.map((l) => {
      const st = listingState(l);
      const drift = !l.is_fulfillment && l.ml_available_qty !== null && l.target_qty !== null
        && Number(l.ml_available_qty) !== Number(l.target_qty);
      const itemUrl = l.permalink || `https://articulo.mercadolibre.com.co/${encodeURIComponent(String(l.ml_item_id).replace(/^([A-Z]{3})/, '$1-'))}`;
      const active = Number(l.is_active) === 1;
      return `
        <tr data-id="${esc(l.id)}">
          <td>
            <span class="stk-prod">${esc(l.product_name ?? `Producto ${l.product_id}`)}</span>
            ${l.variant_label ? `<span class="stk-sub">${esc(l.variant_label)}</span>` : ''}
            ${l.product_sku ? `<span class="stk-sub mono">${esc(l.product_sku)}</span>` : ''}
          </td>
          <td class="stk-item">
            <a href="${esc(itemUrl)}" target="_blank" rel="noopener noreferrer" class="mono">${esc(l.ml_item_id)}</a>
            ${l.ml_variation_id ? `<span class="stk-sub mono">Variación ${esc(l.ml_variation_id)}</span>` : ''}
            ${l.title ? `<span class="stk-title" title="${esc(l.title)}">${esc(l.title)}</span>` : ''}
          </td>
          <td class="num mono">${numCell(l.local_available)}</td>
          <td class="num">
            <input type="number" min="0" step="1" class="ml-input stk-buffer-input js-stk-buffer" data-id="${esc(l.id)}"
              value="${esc(l.stock_buffer ?? 0)}" aria-label="Colchón de ${esc(l.product_name ?? '')}" ${l.is_fulfillment ? 'disabled' : ''}>
          </td>
          <td class="num mono">${l.is_fulfillment ? '-' : numCell(l.target_qty)}</td>
          <td class="num mono ${drift ? 'stk-drift' : ''}" ${drift ? 'title="MercadoLibre reporta un valor distinto al del sitio. Use Enviar para corregirlo."' : ''}>${numCell(l.ml_available_qty)}</td>
          <td>
            <span class="status${st.kind ? ` status--${st.kind}` : ''}">${esc(st.text)}</span>
            ${l.last_error ? `<span class="stk-err">${esc(l.last_error)}</span>` : ''}
          </td>
          <td class="mono ml-nowrap">${esc(fmtDateTime(l.last_pushed_at))}</td>
          <td>
            <div class="stk-row-actions">
              <button type="button" class="btn btn-sm btn-secondary js-stk-push" data-id="${esc(l.id)}" ${!active || l.is_fulfillment ? 'disabled' : ''}>Enviar</button>
              <button type="button" class="btn btn-sm btn-ghost js-stk-toggle" data-id="${esc(l.id)}" data-active="${active ? 1 : 0}">${active ? 'Pausar' : 'Activar'}</button>
              <button type="button" class="btn btn-sm btn-ghost js-stk-unlink" data-id="${esc(l.id)}" aria-label="Quitar vínculo">Quitar</button>
            </div>
          </td>
        </tr>`;
    }).join('');

    tbody.querySelectorAll<HTMLButtonElement>('.js-stk-push').forEach((b) =>
      b.addEventListener('click', () => pushOne(Number(b.dataset.id), b)));
    tbody.querySelectorAll<HTMLButtonElement>('.js-stk-toggle').forEach((b) =>
      b.addEventListener('click', () => patchListing(Number(b.dataset.id), { is_active: b.dataset.active !== '1' }, b)));
    tbody.querySelectorAll<HTMLButtonElement>('.js-stk-unlink').forEach((b) =>
      b.addEventListener('click', () => unlinkOne(Number(b.dataset.id))));
    tbody.querySelectorAll<HTMLInputElement>('.js-stk-buffer').forEach((input) =>
      input.addEventListener('change', () => {
        const v = Math.max(0, Math.floor(Number(input.value) || 0));
        input.value = String(v);
        patchListing(Number(input.dataset.id), { stock_buffer: v }, input);
      }));
  }

  async function loadListings() {
    try {
      const res = await fetch('/api/mercadolibre/stock/listings', { credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudieron cargar los vínculos');
      listingsCache = json.data ?? [];
      renderListings();
    } catch (e: any) {
      document.getElementById('stkBody')!.innerHTML =
        `<tr><td colspan="9" class="empty-state">${esc(e.message)}</td></tr>`;
    }
  }

  function describePush(r: any) {
    switch (r?.status) {
      case 'pushed': return `Enviado: ML ofrece ${r.quantity} unidad(es).`;
      case 'unchanged': return `Sin cambios: ML ya ofrece ${r.quantity} unidad(es).`;
      case 'skipped_full': return 'Publicación Full: el stock lo maneja MercadoLibre.';
      case 'inactive': return 'El vínculo está pausado.';
      default: return r?.error ? `Error: ${r.error}` : 'No se pudo enviar.';
    }
  }

  async function pushOne(id: number, btn: HTMLButtonElement) {
    btn.disabled = true;
    try {
      const res = await fetch(`/api/mercadolibre/stock/listings/${id}/push`, { method: 'POST', credentials: 'include' });
      const json = await res.json();
      showStkBanner(json.success ? 'success' : 'error', describePush(json.data ?? { error: json.error }));
    } catch (e: any) {
      showStkBanner('error', `Error de red: ${e.message}`);
    } finally {
      btn.disabled = false;
      loadListings();
    }
  }

  async function patchListing(id: number, payload: Record<string, unknown>, el: HTMLElement) {
    el.setAttribute('disabled', '');
    try {
      const res = await fetch(`/api/mercadolibre/stock/listings/${id}`, {
        method: 'PATCH', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo actualizar');
      showStkBanner(json.data.push?.status === 'error' ? 'error' : 'success', describePush(json.data.push));
    } catch (e: any) {
      showStkBanner('error', e.message);
    } finally {
      el.removeAttribute('disabled');
      loadListings();
    }
  }

  async function unlinkOne(id: number) {
    const l = listingsCache.find((x) => Number(x.id) === id);
    const name = l ? `${l.product_name ?? ''} ↔ ${l.ml_item_id}` : `#${id}`;
    if (!confirm(`¿Quitar el vínculo ${name}? MercadoLibre conservará la última cantidad enviada y dejará de actualizarse.`)) return;
    try {
      const res = await fetch(`/api/mercadolibre/stock/listings/${id}`, { method: 'DELETE', credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo quitar el vínculo');
      showStkBanner('info', 'Vínculo quitado. Revise el stock de esa publicación directamente en MercadoLibre.');
    } catch (e: any) {
      showStkBanner('error', e.message);
    } finally {
      loadListings();
    }
  }

  async function pushAll(all: boolean) {
    const btn = document.getElementById(all ? 'btnStkPushAll' : 'btnStkPush') as HTMLButtonElement;
    btn.disabled = true;
    try {
      const res = await fetch('/api/mercadolibre/stock/push', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ all }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo enviar el stock');
      const d = json.data;
      if (!d.total) {
        showStkBanner('info', all ? 'No hay vínculos activos.' : 'No hay envíos pendientes.');
      } else {
        showStkBanner(d.errors ? 'error' : 'success',
          `${d.pushed} enviado(s), ${d.unchanged} sin cambios${d.skipped_full ? `, ${d.skipped_full} Full` : ''}${d.errors ? `, ${d.errors} con error` : ''}.`);
      }
    } catch (e: any) {
      showStkBanner('error', e.message);
    } finally {
      btn.disabled = false;
      loadListings();
    }
  }

  // ── Modal de vínculo ───────────────────────────────────────
  let lnkProducts: any[] = [];
  let lnkItems: any[] = [];

  const lnk = {
    modal: () => document.getElementById('lnkModal')!,
    product: () => document.getElementById('lnkProduct') as HTMLSelectElement,
    variant: () => document.getElementById('lnkVariant') as HTMLSelectElement,
    variantWrap: () => document.getElementById('lnkVariantWrap')!,
    itemId: () => document.getElementById('lnkItemId') as HTMLInputElement,
    variation: () => document.getElementById('lnkVariation') as HTMLSelectElement,
    variationWrap: () => document.getElementById('lnkVariationWrap')!,
    buffer: () => document.getElementById('lnkBuffer') as HTMLInputElement,
    error: () => document.getElementById('lnkError')!,
    items: () => document.getElementById('lnkItems')!,
    submit: () => document.getElementById('lnkSubmit') as HTMLButtonElement,
  };

  function lnkSetError(msg: string | null) {
    const el = lnk.error();
    el.hidden = !msg;
    el.textContent = msg ?? '';
  }

  async function openLinkModal() {
    lnkSetError(null);
    lnk.itemId().value = '';
    lnk.buffer().value = '0';
    lnk.variationWrap().hidden = true;
    lnk.modal().style.display = 'flex';
    lnk.product().focus();
    if (!lnkProducts.length) await loadLnkProducts();
    if (!lnkItems.length) searchItems();
  }

  function closeLinkModal() {
    lnk.modal().style.display = 'none';
  }

  async function loadLnkProducts() {
    const sel = lnk.product();
    try {
      const res = await fetch('/api/mercadolibre/stock/products', { credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudieron cargar los productos');
      lnkProducts = json.data ?? [];
      sel.innerHTML = '<option value="">Seleccione un producto...</option>' + lnkProducts.map((p: any) =>
        `<option value="${esc(p.id)}">${esc(p.name)}${p.sku ? ` · ${esc(p.sku)}` : ''}${p.is_active ? '' : ' (inactivo)'}</option>`).join('');
    } catch (e: any) {
      sel.innerHTML = `<option value="">${esc(e.message)}</option>`;
    }
  }

  function onProductChange() {
    const p = lnkProducts.find((x: any) => String(x.id) === lnk.product().value);
    const variants = (p?.variants ?? []).filter((v: any) => v.is_active);
    lnk.variantWrap().hidden = variants.length === 0;
    lnk.variant().innerHTML = variants.length
      ? '<option value="">Seleccione la variante...</option>' + variants.map((v: any) =>
          `<option value="${esc(v.id)}">${esc(v.label)} · ${esc(v.stock_quantity)} u.</option>`).join('')
      : '';
  }

  async function searchItems() {
    const box = lnk.items();
    box.innerHTML = '<div class="empty-state">Buscando publicaciones...</div>';
    const q = (document.getElementById('lnkSearch') as HTMLInputElement).value.trim();
    try {
      const params = new URLSearchParams({ status: 'active', ...(q && { search: q }) });
      const res = await fetch(`/api/mercadolibre/stock/items?${params}`, { credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudieron traer las publicaciones');
      lnkItems = json.data.items ?? [];
      renderItems();
    } catch (e: any) {
      box.innerHTML = `<div class="empty-state">${esc(e.message)} Puede pegar el ID de la publicación abajo.</div>`;
    }
  }

  function renderItems() {
    const box = lnk.items();
    if (!lnkItems.length) {
      box.innerHTML = '<div class="empty-state">No se encontraron publicaciones activas.</div>';
      return;
    }
    box.innerHTML = lnkItems.map((it: any) => {
      const allLinked = it.variations.length
        ? it.variations.every((v: any) => v.link)
        : Boolean(it.link);
      const meta = [it.id, it.sku ? `SKU ${it.sku}` : '', `${it.available_quantity ?? 0} u. en ML`,
        it.logistic_type === 'fulfillment' ? 'Full' : '', it.variations.length ? `${it.variations.length} variaciones` : '',
        allLinked ? 'ya vinculada' : ''].filter(Boolean).join(' · ');
      return `<button type="button" class="lnk-item js-lnk-item" role="option" data-id="${esc(it.id)}" ${allLinked ? 'disabled' : ''}>
          ${it.thumbnail ? `<img src="${esc(it.thumbnail)}" alt="" loading="lazy">` : ''}
          <span class="lnk-item-main">
            <span class="lnk-item-title">${esc(it.title)}</span>
            <span class="lnk-item-meta">${esc(meta)}</span>
          </span>
        </button>`;
    }).join('');
    box.querySelectorAll<HTMLButtonElement>('.js-lnk-item').forEach((b) =>
      b.addEventListener('click', () => selectItem(b.dataset.id!)));
  }

  function fillVariations(variations: any[], preselect?: string) {
    lnk.variationWrap().hidden = variations.length === 0;
    lnk.variation().innerHTML = variations.length
      ? '<option value="">Seleccione la variación...</option>' + variations.map((v: any) =>
          `<option value="${esc(v.id)}" ${v.link ? 'disabled' : ''} ${preselect === v.id ? 'selected' : ''}>${esc(v.label)}${v.sku ? ` · SKU ${esc(v.sku)}` : ''} · ${esc(v.available_quantity ?? 0)} u.${v.link ? ' (ya vinculada)' : ''}</option>`).join('')
      : '';
  }

  function selectItem(id: string) {
    const it = lnkItems.find((x: any) => x.id === id);
    if (!it) return;
    lnk.items().querySelectorAll('.js-lnk-item').forEach((b) =>
      b.setAttribute('aria-selected', (b as HTMLElement).dataset.id === id ? 'true' : 'false'));
    lnk.itemId().value = it.id;
    fillVariations(it.variations);

    // Sugerencia por SKU: si el producto aún no está elegido, se propone el que coincide.
    const sug = it.suggestion || it.variations.find((v: any) => v.suggestion)?.suggestion;
    if (sug && !lnk.product().value) {
      lnk.product().value = String(sug.product_id);
      onProductChange();
      if (sug.variant_id) lnk.variant().value = String(sug.variant_id);
      const sv = it.variations.find((v: any) => v.suggestion?.product_id === sug.product_id && (v.suggestion?.variant_id ?? null) === (sug.variant_id ?? null));
      if (sv) lnk.variation().value = sv.id;
    }
  }

  async function submitLink(e: Event) {
    e.preventDefault();
    lnkSetError(null);
    const productId = lnk.product().value;
    const needsVariant = !lnk.variantWrap().hidden;
    const variantId = needsVariant ? lnk.variant().value : '';
    const itemId = lnk.itemId().value.trim();
    const variationId = lnk.variationWrap().hidden ? '' : lnk.variation().value;

    if (!productId) return lnkSetError('Seleccione el producto del sitio.');
    if (needsVariant && !variantId) return lnkSetError('Seleccione la variante del producto.');
    if (!itemId) return lnkSetError('Indique la publicación de MercadoLibre.');
    if (!lnk.variationWrap().hidden && !variationId) return lnkSetError('Seleccione la variación de la publicación.');

    const btn = lnk.submit();
    btn.disabled = true;
    btn.textContent = 'Vinculando...';
    try {
      const res = await fetch('/api/mercadolibre/stock/listings', {
        method: 'POST', credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          product_id: productId,
          variant_id: variantId ? Number(variantId) : null,
          ml_item_id: itemId,
          ml_variation_id: variationId || null,
          stock_buffer: Math.max(0, Math.floor(Number(lnk.buffer().value) || 0)),
        }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) {
        // La publicación tiene variaciones que el formulario aún no mostraba.
        if (json.code === 'ML_VARIATION_REQUIRED' && Array.isArray(json.variations)) fillVariations(json.variations);
        throw new Error(json.error || 'No se pudo vincular');
      }
      closeLinkModal();
      lnkItems = [];
      showStkBanner(json.data.push?.status === 'error' ? 'error' : 'success',
        `Publicación vinculada. ${describePush(json.data.push)}`);
      loadListings();
    } catch (err: any) {
      lnkSetError(err.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Vincular y enviar stock';
    }
  }

  document.getElementById('btnStkLink')?.addEventListener('click', openLinkModal);
  document.getElementById('btnStkPush')?.addEventListener('click', () => pushAll(false));
  document.getElementById('btnStkPushAll')?.addEventListener('click', () => pushAll(true));
  document.getElementById('lnkClose')?.addEventListener('click', closeLinkModal);
  document.getElementById('lnkCancel')?.addEventListener('click', closeLinkModal);
  document.getElementById('lnkModal')?.addEventListener('click', (e: MouseEvent) => {
    if ((e.target as HTMLElement).id === 'lnkModal') closeLinkModal();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape' && lnk.modal().style.display === 'flex') closeLinkModal();
  });
  document.getElementById('lnkProduct')?.addEventListener('change', onProductChange);
  document.getElementById('lnkSearchBtn')?.addEventListener('click', searchItems);
  document.getElementById('lnkSearch')?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Enter') { e.preventDefault(); searchItems(); }
  });
  document.getElementById('lnkForm')?.addEventListener('submit', submitLink);

  // ── Init ───────────────────────────────────────────────────
  showOAuthResult();
  loadStats();
  loadCrmAccounts();
  loadOrders(0);
  checkCredentials();
  loadListings();
</script>
