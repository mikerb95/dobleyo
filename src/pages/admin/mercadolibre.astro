---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="MercadoLibre · DobleYo ERP" section="mercadolibre">

  <!-- ── Page Header ─────────────────────────────────────────── -->
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">
          <a href="/admin">Admin</a> / MercadoLibre
        </div>
        <h1 class="page-title">Canal MercadoLibre</h1>
      </div>
      <div class="page-header-actions">
        <a href="/admin/sales-map" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
          </svg>
          Mapa de calor
        </a>
        <button class="btn btn-primary" id="btnSync">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="syncIcon">
            <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          Sincronizar ahora
        </button>
      </div>
    </div>
  </div>

  <div class="erp-body">

    <!-- ── Sync result banner ──────────────────────────────────── -->
    <div id="syncBanner" style="display:none;margin-bottom:1.5rem"></div>

    <!-- ── Connection status ──────────────────────────────────── -->
    <div class="conn-card" id="connCard">
      <div class="conn-dot" id="connDot"></div>
      <div>
        <div class="conn-title" id="connTitle">Verificando conexión…</div>
        <div class="conn-sub" id="connSub">Comprobando credenciales de MercadoLibre</div>
      </div>
      <div class="conn-actions" id="connActions"></div>
    </div>

    <!-- ── Centralizador de stock ─────────────────────────────── -->
    <section class="card stk" aria-labelledby="stkTitle">
      <div class="card-header stk-head">
        <div>
          <div class="card-title" id="stkTitle">Stock sincronizado con MercadoLibre</div>
          <div class="card-subtitle" id="stkSubtitle">El inventario del sitio manda: cada cambio se envía a las publicaciones vinculadas y cada venta en ML descuenta aquí.</div>
        </div>
        <div class="stk-actions">
          <button class="btn btn-secondary btn-sm" id="btnStkPushAll" type="button" title="Revisa todos los vínculos y reenvía los que no coincidan">Revisar todo</button>
          <button class="btn btn-secondary btn-sm" id="btnStkPush" type="button">Enviar pendientes</button>
          <button class="btn btn-primary btn-sm" id="btnStkLink" type="button">Vincular publicación</button>
        </div>
      </div>
      <div id="stkBanner" class="stk-banner" hidden></div>
      <div class="stk-table-wrap">
        <table class="erp-table stk-table">
          <thead>
            <tr>
              <th>Producto del sitio</th>
              <th>Publicación ML</th>
              <th class="num" title="Lo que el sitio puede vender">Disponible</th>
              <th class="num" title="Unidades que no se ofrecen en ML">Colchón</th>
              <th class="num" title="Disponible menos colchón">Se ofrece</th>
              <th class="num" title="Última cantidad que ML reportó">ML reporta</th>
              <th>Estado</th>
              <th>Último envío</th>
              <th><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="stkBody">
            <tr><td colspan="9" class="empty-state">Cargando vínculos...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── KPI Row ─────────────────────────────────────────────── -->
    <div class="kpi-grid" style="margin-bottom:1.5rem">
      <div class="kpi-tile brand">
        <div class="kpi-label">Pedidos</div>
        <div class="kpi-value" id="kpiOrders"><span class="skeleton" style="width:60px"></span></div>
        <div class="kpi-sub" id="kpiOrdersRange">-</div>
      </div>
      <div class="kpi-tile success">
        <div class="kpi-label">Ingresos Totales</div>
        <div class="kpi-value" id="kpiRevenue"><span class="skeleton" style="width:80px"></span></div>
        <div class="kpi-sub">COP acumulado</div>
      </div>
      <div class="kpi-tile info">
        <div class="kpi-label">Ticket promedio</div>
        <div class="kpi-value" id="kpiAvg"><span class="skeleton" style="width:70px"></span></div>
        <div class="kpi-sub">por pedido</div>
      </div>
      <div class="kpi-tile warning">
        <div class="kpi-label">Ciudades Únicas</div>
        <div class="kpi-value" id="kpiCities"><span class="skeleton" style="width:40px"></span></div>
        <div class="kpi-sub" id="kpiStates">-</div>
      </div>
    </div>

    <!-- ── Main grid ───────────────────────────────────────────── -->
    <div class="ml-main-grid">

      <!-- ── Orders table ─────────────────────────────────────── -->
      <div class="card">
        <div class="card-header">
          <div>
            <div class="card-title">Pedidos sincronizados</div>
            <div class="card-subtitle" id="tableSubtitle">Cargando datos…</div>
          </div>
          <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
            <input type="date" id="filterFrom" class="ml-input" title="Desde">
            <input type="date" id="filterTo" class="ml-input" title="Hasta">
            <input type="text" id="filterCity" class="ml-input" placeholder="Ciudad" style="width:120px">
            <select id="filterStatus" class="ml-input">
              <option value="">Todos los estados</option>
              <option value="paid">Pagado</option>
              <option value="pending">Pendiente</option>
              <option value="cancelled">Cancelado</option>
            </select>
            <button class="btn btn-secondary" id="btnFilter" style="height:32px;padding:0 12px;font-size:12px">
              Filtrar
            </button>
          </div>
        </div>
        <div style="overflow-x:auto">
          <table class="erp-table">
            <thead>
              <tr>
                <th>Pedido ML</th>
                <th>Fecha</th>
                <th>Comprador</th>
                <th>Ciudad</th>
                <th>Dpto.</th>
                <th>Total</th>
                <th>Estado pago</th>
                <th>Estado envío</th>
                <th>Cuenta CRM</th>
                <th>Acciones</th>
              </tr>
            </thead>
            <tbody id="ordersBody">
              <tr><td colspan="10" class="empty-state">Cargando pedidos...</td></tr>
            </tbody>
          </table>
        </div>
        <!-- Pagination -->
        <div class="pagination-bar" id="paginationBar" style="display:none">
          <span class="pag-info" id="pagInfo"></span>
          <div style="display:flex;gap:4px">
            <button class="btn btn-ghost" id="btnPrev" style="height:30px;padding:0 10px;font-size:12px" disabled>‹ Anterior</button>
            <div id="pagPages" style="display:flex;gap:2px"></div>
            <button class="btn btn-ghost" id="btnNext" style="height:30px;padding:0 10px;font-size:12px">Siguiente ›</button>
          </div>
        </div>
      </div>

      <!-- ── Right sidebar ────────────────────────────────────── -->
      <div class="ml-sidebar">

        <!-- Top ciudades -->
        <div class="card">
          <div class="card-header">
            <div>
              <div class="card-title">Top Ciudades</div>
              <div class="card-subtitle">Por número de pedidos</div>
            </div>
          </div>
          <div style="padding:0" id="citiesList">
            <div class="empty-state">Cargando…</div>
          </div>
        </div>

        <!-- Acciones rápidas -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">Acciones rápidas</div>
          </div>
          <div style="padding:8px 0">
            <a href="/admin/sales-map" class="quick-action">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
                <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
              </svg>
              Ver mapa de calor de ventas
            </a>
            <a href="/admin/ventas" class="quick-action">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/>
              </svg>
              Dashboard de ventas operativo
            </a>
            <button class="quick-action" id="btnExportCSV">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Exportar tabla a CSV
            </button>
            <button class="quick-action" id="btnSyncQuick">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
              </svg>
              Sincronizar pedidos
            </button>
          </div>
        </div>

        <!-- Config / Webhooks -->
        <div class="card">
          <div class="card-header">
            <div class="card-title">Configuración e integración</div>
          </div>
          <div class="cfg">
            <div class="config-row">
              <div class="config-label">Conexión</div>
              <span id="cfgConn" class="status">-</span>
            </div>
            <div class="config-row">
              <div class="config-label">Cuenta</div>
              <span id="cfgAccount" class="mono cfg-val">-</span>
            </div>
            <div class="config-row">
              <div class="config-label">Token vence</div>
              <span id="cfgExpires" class="mono cfg-val">-</span>
            </div>
            <div class="config-row">
              <div class="config-label">CRON_SECRET</div>
              <span id="cfgCron" class="status">-</span>
            </div>
            <div class="config-row">
              <div class="config-label">Última sincronización</div>
              <span id="cfgLastSync" class="mono cfg-val">-</span>
            </div>
            <div class="cfg-rule"></div>
            <div class="config-row">
              <div class="config-label">Sync manual</div>
              <code class="cfg-code">POST /api/mercadolibre/sync</code>
            </div>
            <div class="config-row">
              <div class="config-label">Cron</div>
              <code class="cfg-code">GET /api/mercadolibre/cron-sync</code>
            </div>
            <div class="config-row">
              <div class="config-label">Webhook</div>
              <code class="cfg-code" id="cfgWebhook">POST /api/mercadolibre/webhook</code>
            </div>
            <div class="cfg-rule"></div>
            <p class="cfg-note">
              No hay un cron agendado en el proyecto. Para sincronizar sin intervención, programe un cron (Vercel Cron o uno externo) que llame <code>/api/mercadolibre/cron-sync</code> con la cabecera <code>Authorization: Bearer CRON_SECRET</code>: trae órdenes nuevas y reintenta los envíos de stock pendientes.
            </p>
            <p class="cfg-note">
              Para tiempo casi real, registre la URL del webhook en su aplicación de MercadoLibre con los temas <code>orders_v2</code> e <code>items</code>.
            </p>
          </div>
        </div>

      </div><!-- /.ml-sidebar -->
    </div><!-- /.ml-main-grid -->

    <!-- ── Modal: vincular venta a cuenta CRM ──────────────────── -->
    <div id="crmModal" class="crm-modal-overlay" style="display:none">
      <div class="crm-modal">
        <div class="crm-modal-head">
          <div class="card-title">Vincular pedido a una cuenta CRM</div>
          <button class="crm-modal-close" id="crmModalClose" aria-label="Cerrar">✕</button>
        </div>
        <div style="padding:16px">
          <p style="font-size:12px;color:var(--text-2);margin:0 0 12px">
            Pedido <code id="crmModalOrderId" style="background:var(--hover);padding:1px 5px;border-radius:3px"></code>.
            Seleccione la cuenta B2B a la que pertenece esta venta; sumará a su LTV.
          </p>
          <select id="crmAccountSelect" class="ml-input" style="width:100%;height:36px">
            <option value="">Cargando cuentas…</option>
          </select>
          <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
            <button class="btn btn-secondary" id="crmModalCancel">Cancelar</button>
            <button class="btn btn-primary" id="crmModalConfirm">Vincular</button>
          </div>
        </div>
      </div>
    </div>
    <!-- ── Modal: vincular publicación ─────────────────────────── -->
    <div id="lnkModal" class="crm-modal-overlay" style="display:none">
      <div class="crm-modal crm-modal--wide" role="dialog" aria-modal="true" aria-labelledby="lnkTitle">
        <div class="crm-modal-head">
          <div class="card-title" id="lnkTitle">Vincular publicación de MercadoLibre</div>
          <button class="crm-modal-close" id="lnkClose" type="button" aria-label="Cerrar">✕</button>
        </div>
        <form class="lnk-body" id="lnkForm" novalidate>
          <fieldset class="lnk-step">
            <legend>1. Producto del sitio</legend>
            <label class="lnk-field">
              <span>Producto</span>
              <select id="lnkProduct" class="ml-input" required>
                <option value="">Cargando productos...</option>
              </select>
            </label>
            <label class="lnk-field" id="lnkVariantWrap" hidden>
              <span>Variante</span>
              <select id="lnkVariant" class="ml-input"></select>
              <small>Este producto se vende por variantes: vincule cada variante con su publicación o variación.</small>
            </label>
          </fieldset>

          <fieldset class="lnk-step">
            <legend>2. Publicación en MercadoLibre</legend>
            <div class="lnk-search">
              <input type="text" id="lnkSearch" class="ml-input" placeholder="Buscar en sus publicaciones activas" aria-label="Buscar publicaciones">
              <button type="button" class="btn btn-secondary btn-sm" id="lnkSearchBtn">Buscar</button>
            </div>
            <div class="lnk-items" id="lnkItems" role="listbox" aria-label="Publicaciones">
              <div class="empty-state">Abra la lista o pegue el ID de la publicación abajo.</div>
            </div>
            <label class="lnk-field">
              <span>ID o enlace de la publicación</span>
              <input type="text" id="lnkItemId" class="ml-input" placeholder="MCO1234567890" autocomplete="off" required>
            </label>
            <label class="lnk-field" id="lnkVariationWrap" hidden>
              <span>Variación</span>
              <select id="lnkVariation" class="ml-input"></select>
            </label>
          </fieldset>

          <fieldset class="lnk-step">
            <legend>3. Colchón</legend>
            <label class="lnk-field">
              <span>Unidades que no se ofrecen en ML</span>
              <input type="number" id="lnkBuffer" class="ml-input" min="0" step="1" value="0" inputmode="numeric">
              <small>Con 2, si el sitio tiene 10 unidades, ML ofrece 8. Sirve para no sobrevender las últimas.</small>
            </label>
          </fieldset>

          <p class="lnk-error" id="lnkError" role="alert" hidden></p>
          <div class="lnk-foot">
            <button class="btn btn-secondary" id="lnkCancel" type="button">Cancelar</button>
            <button class="btn btn-primary" id="lnkSubmit" type="submit">Vincular y enviar stock</button>
          </div>
        </form>
      </div>
    </div>
  </div><!-- /.erp-body -->

</AdminLayout>

<style is:global>
  /* Global y acotado a .pg-mercadolibre (lo pone AdminLayout): parte de esta
     página se pinta con innerHTML y los estilos scoped no le llegan. */
  .pg-mercadolibre .ml-nowrap { white-space: nowrap; }
  .pg-mercadolibre .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .pg-mercadolibre .ml-main-grid {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 1.5rem;
    align-items: start;
  }
  @media (max-width: 1200px) {
    .pg-mercadolibre .ml-main-grid { grid-template-columns: 1fr; }
  }

  .pg-mercadolibre .ml-sidebar { display: flex; flex-direction: column; gap: 1rem; }

  /* Connection banner */
  .pg-mercadolibre .conn-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 14px 18px;
    margin-bottom: 1.5rem;
  }
  .pg-mercadolibre .conn-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-3);
    flex-shrink: 0;
  }
  .pg-mercadolibre .conn-dot.ok  { background: var(--c-success); box-shadow: 0 0 0 3px var(--c-success-bg); }
  .pg-mercadolibre .conn-dot.err { background: var(--c-error);   box-shadow: 0 0 0 3px var(--c-error-bg); }
  .pg-mercadolibre .conn-dot.warn{ background: var(--c-warning);  box-shadow: 0 0 0 3px var(--c-warning-bg); }
  .pg-mercadolibre .conn-title { font-weight: 600; font-size: 13px; }
  .pg-mercadolibre .conn-sub   { font-size: 12px; color: var(--text-2); }

  /* Filters */
  .pg-mercadolibre .ml-input {
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 12px;
    font-family: inherit;
    color: var(--text-1);
    background: var(--card-bg);
  }
  .pg-mercadolibre .ml-input:focus { outline: none; border-color: var(--brand); }

  /* Pagination */
  .pg-mercadolibre .pagination-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-top: 1px solid var(--border);
    background: var(--hover);
    flex-wrap: wrap;
    gap: 8px;
  }
  .pg-mercadolibre .pag-info { font-size: 12px; color: var(--text-2); }
  .pg-mercadolibre .pag-btn-active {
    background: var(--brand) !important;
    color: var(--paper) !important;
    border-color: var(--brand-dark) !important;
  }

  /* Top cities list */
  .pg-mercadolibre .city-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 20px;
    border-bottom: 1px solid rgba(0,0,0,.04);
    font-size: 13px;
  }
  .pg-mercadolibre .city-row:last-child { border-bottom: none; }
  .pg-mercadolibre .city-rank {
    width: 20px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-3);
    flex-shrink: 0;
    text-align: right;
  }
  .pg-mercadolibre .city-name { flex: 1; font-weight: 500; }
  .pg-mercadolibre .city-bar-wrap { width: 70px; height: 6px; background: var(--rule); border-radius: 3px; flex-shrink: 0; }
  .pg-mercadolibre .city-bar      { height: 6px; background: var(--brand); border-radius: 3px; }
  .pg-mercadolibre .city-count    { font-size: 12px; font-weight: 600; color: var(--text-2); min-width: 28px; text-align: right; flex-shrink: 0; }

  /* Quick actions */
  .pg-mercadolibre .quick-action {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    font-size: 13px;
    color: var(--text-1);
    text-decoration: none;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    text-align: left;
    font-family: inherit;
    transition: background 0.12s;
    border-bottom: 1px solid rgba(0,0,0,.04);
  }
  .pg-mercadolibre .quick-action:last-child { border-bottom: none; }
  .pg-mercadolibre .quick-action:hover { background: var(--nav-hover-bg); color: var(--brand-dark); }
  .pg-mercadolibre .quick-action svg { flex-shrink: 0; opacity: 0.55; }

  /* Config rows */
  .pg-mercadolibre .config-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .pg-mercadolibre .config-row:last-child { margin-bottom: 0; }
  .pg-mercadolibre .config-label { font-size: 12px; color: var(--text-2); font-family: var(--font-mono, ui-monospace, monospace); }

  /* Sync banner */
  .pg-mercadolibre .banner {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid transparent;
  }
  .pg-mercadolibre .banner.success { background: var(--c-success-bg); color: var(--c-success); border-color: var(--c-success-border); }
  .pg-mercadolibre .banner.error   { background: var(--c-error-bg);   color: var(--c-error);   border-color: var(--c-error-border); }

  /* Spin animation for sync */
  @keyframes spin { to { transform: rotate(360deg); } }
  .pg-mercadolibre .spinning { animation: spin 0.8s linear infinite; display: inline-block; }

  /* CRM cell */
  .pg-mercadolibre .crm-chip {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--c-success-bg); color: var(--c-success);
    border: 1px solid var(--c-success-border);
    padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600;
    max-width: 160px;
  }
  .pg-mercadolibre .crm-chip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pg-mercadolibre .crm-unlink {
    background: none; border: none; cursor: pointer; color: inherit;
    font-size: 11px; line-height: 1; padding: 0; opacity: .6;
  }
  .pg-mercadolibre .crm-unlink:hover { opacity: 1; }

  /* CRM modal */
  .pg-mercadolibre .crm-modal-overlay {
    position: fixed; inset: 0; background: rgba(0,0,0,.4);
    display: flex; align-items: center; justify-content: center; z-index: 1000;
    padding: 16px;
  }
  .pg-mercadolibre .crm-modal {
    background: var(--card-bg); border-radius: 8px; width: 100%; max-width: 420px;
    box-shadow: 0 16px 48px -12px rgba(0,0,0,.3); border: 1px solid var(--border);
  }
  .pg-mercadolibre .crm-modal-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 16px; border-bottom: 1px solid var(--border);
  }
  .pg-mercadolibre .crm-modal-close {
    background: none; border: none; cursor: pointer; font-size: 16px;
    color: var(--text-2); line-height: 1;
  }

  /* Acciones del aviso de conexión */
  .pg-mercadolibre .conn-card { flex-wrap: wrap; }
  .pg-mercadolibre .conn-actions { margin-left: auto; display: flex; gap: 8px; flex-wrap: wrap; }

  /* Configuración */
  .pg-mercadolibre .cfg { padding: 16px; }
  .pg-mercadolibre .cfg-val { font-size: 12px; color: var(--text-1); text-align: right; overflow-wrap: anywhere; }
  .pg-mercadolibre .cfg-rule { height: 1px; background: var(--border); margin: 12px 0; }
  .pg-mercadolibre .cfg-code {
    font-family: var(--font-mono); font-size: 11px; color: var(--text-2);
    background: var(--hover); padding: 2px 6px; border-radius: 3px; overflow-wrap: anywhere; text-align: right;
  }
  .pg-mercadolibre .cfg-note { font-size: 11px; color: var(--text-3); line-height: 1.6; margin: 0 0 8px; }
  .pg-mercadolibre .cfg-note:last-child { margin-bottom: 0; }
  .pg-mercadolibre .cfg-note code { background: var(--hover); padding: 1px 4px; border-radius: 2px; font-family: var(--font-mono); }

  /* Centralizador de stock */
  .pg-mercadolibre .stk { margin-bottom: 1.5rem; }
  .pg-mercadolibre .stk-head { flex-wrap: wrap; gap: 12px; }
  .pg-mercadolibre .stk-head .card-subtitle { max-width: 62ch; }
  .pg-mercadolibre .stk-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pg-mercadolibre .stk-banner { margin: 0 16px 12px; padding: 10px 14px; border-radius: 6px; font-size: 13px; border: 1px solid transparent; }
  .pg-mercadolibre .stk-banner.success { background: var(--c-success-bg); color: var(--c-success); border-color: var(--c-success-border); }
  .pg-mercadolibre .stk-banner.error   { background: var(--c-error-bg);   color: var(--c-error);   border-color: var(--c-error-border); }
  .pg-mercadolibre .stk-banner.info    { background: var(--c-info-bg);    color: var(--c-info); }
  .pg-mercadolibre .stk-table-wrap { overflow-x: auto; }
  .pg-mercadolibre .stk-table td { vertical-align: top; }
  .pg-mercadolibre .stk-prod { font-weight: 600; }
  .pg-mercadolibre .stk-sub { display: block; font-size: 11px; color: var(--text-3); margin-top: 2px; }
  .pg-mercadolibre .stk-item a { color: var(--brand-dark); text-decoration: none; }
  .pg-mercadolibre .stk-item a:hover { text-decoration: underline; }
  .pg-mercadolibre .stk-title { display: block; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; color: var(--text-3); }
  .pg-mercadolibre .stk-drift { color: var(--c-error); font-weight: 600; }
  .pg-mercadolibre .stk-err { display: block; font-size: 11px; color: var(--c-error); margin-top: 3px; max-width: 280px; white-space: normal; }
  .pg-mercadolibre .stk-row-actions { display: flex; gap: 4px; justify-content: flex-end; flex-wrap: nowrap; }
  .pg-mercadolibre .stk-buffer-input { width: 64px; height: 28px; text-align: right; }
  .pg-mercadolibre .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* Modal de vínculo */
  .pg-mercadolibre .crm-modal--wide { max-width: 640px; max-height: calc(100vh - 32px); display: flex; flex-direction: column; }
  .pg-mercadolibre .lnk-body { padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 14px; }
  .pg-mercadolibre .lnk-step { border: 1px solid var(--border); border-radius: 6px; padding: 12px; margin: 0; min-width: 0; }
  .pg-mercadolibre .lnk-step legend { font-size: 12px; font-weight: 600; padding: 0 6px; color: var(--text-1); }
  .pg-mercadolibre .lnk-field { display: flex; flex-direction: column; gap: 4px; margin-top: 8px; font-size: 12px; color: var(--text-2); }
  .pg-mercadolibre .lnk-field .ml-input { width: 100%; height: 36px; font-size: 13px; }
  .pg-mercadolibre .lnk-field small { font-size: 11px; color: var(--text-3); line-height: 1.5; }
  .pg-mercadolibre .lnk-search { display: flex; gap: 8px; }
  .pg-mercadolibre .lnk-search .ml-input { flex: 1; min-width: 0; height: 32px; }
  .pg-mercadolibre .lnk-items { margin-top: 8px; max-height: 220px; overflow-y: auto; border: 1px solid var(--border); border-radius: 4px; }
  .pg-mercadolibre .lnk-item {
    display: flex; gap: 10px; align-items: center; width: 100%; text-align: left;
    padding: 8px 10px; background: none; border: none; border-bottom: 1px solid var(--border);
    font-family: inherit; font-size: 12px; color: var(--text-1); cursor: pointer;
  }
  .pg-mercadolibre .lnk-item:last-child { border-bottom: none; }
  .pg-mercadolibre .lnk-item:hover, .pg-mercadolibre .lnk-item[aria-selected="true"] { background: var(--active-bg); }
  .pg-mercadolibre .lnk-item[disabled] { cursor: default; opacity: .55; background: none; }
  .pg-mercadolibre .lnk-item img { width: 36px; height: 36px; object-fit: cover; border-radius: 4px; flex-shrink: 0; background: var(--hover); }
  .pg-mercadolibre .lnk-item-main { flex: 1; min-width: 0; }
  .pg-mercadolibre .lnk-item-title { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
  .pg-mercadolibre .lnk-item-meta { display: block; font-size: 11px; color: var(--text-3); font-family: var(--font-mono); }
  .pg-mercadolibre .lnk-error { margin: 0; padding: 10px 12px; border-radius: 6px; background: var(--c-error-bg); color: var(--c-error); font-size: 12px; }
  .pg-mercadolibre .lnk-foot { display: flex; gap: 8px; justify-content: flex-end; flex-wrap: wrap; }
  @media (max-width: 480px) {
    .pg-mercadolibre .lnk-foot .btn { flex: 1; }
    .pg-mercadolibre .conn-actions { margin-left: 0; width: 100%; }
  }
</style>

<script>
  // ── State ──────────────────────────────────────────────────
  let currentPage = 0;
  const limit = 25;
  let totalOrders = 0;
  let allSalesCache: any[] = [];

  const fmt = (n: number) =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(n);

  const fmtDate = (s: string) =>
    s ? new Date(s).toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

  // ── Load stats ─────────────────────────────────────────────
  async function loadStats() {
    try {
      const res = await fetch('/api/mercadolibre/stats', { credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) return;

      // El estado de la conexión lo decide /status, no la existencia de pedidos
      // (hay pedidos de demostración sembrados que no prueban nada).
      const ov = json.overview;
      if (!ov || !ov.total_orders) {
        document.getElementById('kpiOrders')!.textContent = '0';
        document.getElementById('kpiRevenue')!.textContent = '$0';
        document.getElementById('kpiAvg')!.textContent = '$0';
        document.getElementById('kpiCities')!.textContent = '0';
      } else {
        document.getElementById('kpiOrders')!.textContent = ov.total_orders.toLocaleString('es-CO');
        document.getElementById('kpiOrdersRange')!.textContent = `${fmtDate(ov.first_order_date)} - ${fmtDate(ov.last_order_date)}`;
        document.getElementById('kpiRevenue')!.textContent = fmt(ov.total_revenue ?? 0);
        document.getElementById('kpiAvg')!.textContent = fmt(ov.avg_order_value ?? 0);
        document.getElementById('kpiCities')!.textContent = (ov.unique_cities ?? 0).toString();
        document.getElementById('kpiStates')!.textContent = `en ${ov.unique_states ?? 0} departamentos`;
      }

      renderCities(json.top_cities ?? []);
    } catch { /* los KPIs quedan con el esqueleto */ }
  }

  // ── Estado de la conexión ──────────────────────────────────
  // /status?check=1 llama a MercadoLibre con el token: verde solo si responde.
  const fmtDateTime = (s: string | null) => {
    if (!s) return '-';
    const d = new Date(/[zZ]|[+-]\d{2}:?\d{2}$/.test(s) ? s : `${String(s).replace(' ', 'T')}Z`);
    if (Number.isNaN(d.getTime())) return '-';
    return d.toLocaleString('es-CO', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', timeZone: 'America/Bogota' });
  };

  function setStatusText(el: HTMLElement, kind: 'ok'|'warn'|'error'|'info'|'', text: string) {
    el.className = `status${kind ? ` status--${kind}` : ''}`;
    el.textContent = text;
  }

  function renderConnActions(conn: any) {
    const box = document.getElementById('connActions')!;
    box.innerHTML = '';
    if (conn.oauth_configured) {
      const a = document.createElement('a');
      a.className = `btn btn-sm ${conn.source === 'oauth' ? 'btn-secondary' : 'btn-primary'}`;
      a.href = '/api/mercadolibre/oauth/start';
      a.textContent = conn.source === 'oauth' ? 'Reconectar' : 'Conectar MercadoLibre';
      box.appendChild(a);
    }
    if (conn.source === 'oauth') {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn btn-sm btn-ghost';
      b.textContent = 'Desconectar';
      b.addEventListener('click', disconnectMl);
      box.appendChild(b);
    }
  }

  async function disconnectMl() {
    if (!confirm('¿Desconectar la cuenta de MercadoLibre? El stock dejará de enviarse hasta que la vuelva a conectar.')) return;
    try {
      const res = await fetch('/api/mercadolibre/oauth/disconnect', { method: 'POST', credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'No se pudo desconectar');
      await checkCredentials();
    } catch (e: any) {
      showStkBanner('error', e.message);
    }
  }

  async function checkCredentials() {
    const cfgConn = document.getElementById('cfgConn')!;
    const cfgCron = document.getElementById('cfgCron')!;
    try {
      const res = await fetch('/api/mercadolibre/status?check=1', { credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.error || 'status');
      const { connection: conn, live, cron_secret_configured, last_sync, webhook_url, stock } = json.data;

      renderConnActions(conn);
      document.getElementById('cfgAccount')!.textContent =
        conn.nickname ? `${conn.nickname} (${conn.ml_user_id})` : (conn.ml_user_id ?? '-');
      document.getElementById('cfgExpires')!.textContent =
        conn.source === 'oauth' ? `${fmtDateTime(conn.expires_at)} (se renueva solo)` : (conn.source === 'env' ? 'Desconocido' : '-');
      document.getElementById('cfgLastSync')!.textContent = fmtDateTime(last_sync);
      if (webhook_url) document.getElementById('cfgWebhook')!.textContent = webhook_url;
      setStatusText(cfgCron, cron_secret_configured ? 'ok' : '', cron_secret_configured ? 'Configurado' : 'No configurado');

      if (!conn.connected) {
        setConnectionStatus('err', 'MercadoLibre no está conectado',
          conn.oauth_configured
            ? 'Conecte la cuenta de vendedor para sincronizar órdenes y stock.'
            : 'Faltan ML_CLIENT_ID y ML_CLIENT_SECRET en las variables de entorno para poder conectar.');
        setStatusText(cfgConn, 'error', 'Sin conexión');
      } else if (live && !live.ok) {
        setConnectionStatus('err', 'MercadoLibre rechazó la conexión', live.error || 'Vuelva a conectar la cuenta.');
        setStatusText(cfgConn, 'error', conn.source === 'oauth' ? 'OAuth con error' : 'Token fijo vencido');
      } else if (conn.source === 'env') {
        setConnectionStatus('warn', 'Conectado con un token fijo',
          'ML_ACCESS_TOKEN vence a las 6 horas y no se puede renovar. Conecte con OAuth para que se renueve solo.');
        setStatusText(cfgConn, 'warn', 'Token fijo');
      } else {
        const who = live?.nickname || conn.nickname || conn.ml_user_id;
        const extra = stock ? ` · ${stock.linked} publicación(es) vinculada(s)` : '';
        setConnectionStatus('ok', `Conectado a MercadoLibre como ${who}`, `Token vigente hasta ${fmtDateTime(conn.expires_at)}, se renueva solo${extra}`);
        setStatusText(cfgConn, 'ok', 'OAuth');
      }
      if (conn.last_error && conn.source === 'oauth') {
        document.getElementById('connSub')!.textContent += ` · Último error: ${conn.last_error}`;
      }
    } catch {
      setConnectionStatus('warn', 'No se pudo verificar la conexión', 'Revise los logs del servidor');
      setStatusText(cfgConn, 'warn', 'Sin verificar');
    }
  }

  function setConnectionStatus(type: 'ok'|'err'|'warn', title: string, sub: string) {
    const dot = document.getElementById('connDot')!;
    dot.className = `conn-dot ${type}`;
    document.getElementById('connTitle')!.textContent = title;
    document.getElementById('connSub')!.textContent = sub;
  }

  // ── Load orders ────────────────────────────────────────────
  async function loadOrders(page = 0) {
    currentPage = page;
    const tbody = document.getElementById('ordersBody')!;
    tbody.innerHTML = '<tr><td colspan="10" class="empty-state">Cargando...</td></tr>';

    const city = (document.getElementById('filterCity') as HTMLInputElement).value.trim();
    const dateFrom = (document.getElementById('filterFrom') as HTMLInputElement).value;
    const dateTo = (document.getElementById('filterTo') as HTMLInputElement).value;
    const status = (document.getElementById('filterStatus') as HTMLSelectElement).value;

    const params = new URLSearchParams({
      limit: String(limit),
      offset: String(page * limit),
      ...(city && { city }),
      ...(dateFrom && { dateFrom }),
      ...(dateTo && { dateTo }),
      ...(status && { status }),
    });

    try {
      const res = await fetch(`/api/mercadolibre/sales?${params}`, { credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) {
        tbody.innerHTML = `<tr><td colspan="10" class="empty-state">No se pudieron cargar los pedidos. ${esc(json.error ?? '')}</td></tr>`;
        return;
      }

      const rows: any[] = json.data ?? [];

      allSalesCache = rows;
      totalOrders = json.pagination?.total ?? rows.length;

      document.getElementById('tableSubtitle')!.textContent =
        `${totalOrders.toLocaleString('es-CO')} pedidos`;

      if (rows.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" class="empty-state">No hay pedidos con estos filtros.</td></tr>';
        document.getElementById('paginationBar')!.style.display = 'none';
        return;
      }

      tbody.innerHTML = rows.map((r: any) => `
        <tr>
          <td class="mono ml-nowrap">${esc(r.ml_order_id ?? r.id ?? '-')}</td>
          <td class="mono ml-nowrap">${fmtDate(r.purchase_date ?? r.created_at)}</td>
          <td>${esc(r.buyer_nickname ?? r.buyer_name ?? '-')}</td>
          <td>${esc(r.recipient_city ?? '-')}</td>
          <td>${esc(r.recipient_state ?? '-')}</td>
          <td class="num mono ml-nowrap">${fmt(r.total_amount ?? 0)}</td>
          <td>${badgeStatus(r.payment_status)}</td>
          <td>${badgeShipping(r.shipping_status)}</td>
          <td>${crmCell(r)}</td>
          <td>
            ${r.ml_order_id ? `<a href="https://www.mercadolibre.com.co/ventas/${encodeURIComponent(r.ml_order_id)}/detalle" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" title="Ver en MercadoLibre" aria-label="Ver pedido en MercadoLibre">↗</a>` : ''}
          </td>
        </tr>
      `).join('');

      bindCrmButtons();
      renderPagination(json.pagination);
    } catch (e: any) {
      tbody.innerHTML = `<tr><td colspan="10" class="empty-state">Error de red: ${esc(e.message)}</td></tr>`;
    }
  }

  const STATUS_DOT: Record<string, string> = {
    success: 'status--paid', info: 'status--confirmed', warning: 'status--pending', error: 'status--cancelled',
  };

  function badgeStatus(s: string) {
    const map: Record<string, string> = {
      paid: 'success', approved: 'success',
      pending: 'warning',
      cancelled: 'error', rejected: 'error',
    };
    const key = (s ?? '').toLowerCase();
    const cls = map[key] ?? 'neutral';
    const labels: Record<string, string> = { paid:'Pagado', approved:'Aprobado', pending:'Pendiente', cancelled:'Cancelado', rejected:'Rechazado' };
    return `<span class="status ${STATUS_DOT[cls] ?? ''}">${esc(labels[key] ?? s ?? '-')}</span>`;
  }

  function badgeShipping(s: string) {
    const map: Record<string, string> = {
      delivered: 'success', handling: 'info', ready_to_ship: 'info',
      shipped: 'info', not_delivered: 'error', cancelled: 'error',
    };
    const key = (s ?? '').toLowerCase();
    const cls = map[key] ?? 'neutral';
    const labels: Record<string, string> = {
      delivered:'Entregado', handling:'Preparando', ready_to_ship:'Listo', shipped:'Enviado',
      not_delivered:'No entregado', cancelled:'Cancelado',
    };
    return `<span class="status ${STATUS_DOT[cls] ?? ''}">${esc(labels[key] ?? s ?? '-')}</span>`;
  }

  function renderPagination(pag: any) {
    if (!pag || pag.pages <= 1) {
      document.getElementById('paginationBar')!.style.display = 'none';
      return;
    }
    const bar = document.getElementById('paginationBar')!;
    bar.style.display = 'flex';

    const from = currentPage * limit + 1;
    const to = Math.min((currentPage + 1) * limit, pag.total);
    document.getElementById('pagInfo')!.textContent = `${from}-${to} de ${pag.total}`;

    const prevBtn = document.getElementById('btnPrev') as HTMLButtonElement;
    const nextBtn = document.getElementById('btnNext') as HTMLButtonElement;
    prevBtn.disabled = currentPage === 0;
    nextBtn.disabled = currentPage >= pag.pages - 1;

    const container = document.getElementById('pagPages')!;
    container.innerHTML = '';
    const maxPages = 5;
    let start = Math.max(0, currentPage - Math.floor(maxPages / 2));
    let end = Math.min(pag.pages - 1, start + maxPages - 1);
    if (end - start < maxPages - 1) start = Math.max(0, end - maxPages + 1);

    for (let i = start; i <= end; i++) {
      const btn = document.createElement('button');
      btn.className = `btn btn-ghost${i === currentPage ? ' pag-btn-active' : ''}`;
      btn.style.cssText = 'height:30px;padding:0 10px;font-size:12px;min-width:32px';
      btn.textContent = String(i + 1);
      btn.addEventListener('click', () => loadOrders(i));
      container.appendChild(btn);
    }
  }

  // ── Top cities ─────────────────────────────────────────────
  function renderCities(cities: any[]) {
    const el = document.getElementById('citiesList')!;
    if (!cities.length) {
      el.innerHTML = '<div class="empty-state">Sin datos</div>';
      return;
    }
    const max = cities[0]?.order_count ?? 1;
    el.innerHTML = cities.slice(0, 10).map((c: any, i: number) => `
      <div class="city-row">
        <div class="city-rank">${i + 1}</div>
        <div class="city-name">${c.recipient_city ?? '-'}</div>
        <div class="city-bar-wrap"><div class="city-bar" style="width:${Math.round((c.order_count / max) * 100)}%"></div></div>
        <div class="city-count">${c.order_count}</div>
      </div>
    `).join('');
  }

  // ── Sync ───────────────────────────────────────────────────
  async function doSync() {
    const btn = document.getElementById('btnSync')!;
    const icon = document.getElementById('syncIcon')!;
    const banner = document.getElementById('syncBanner')!;

    btn.setAttribute('disabled', '');
    icon.classList.add('spinning');
    banner.style.display = 'none';

    try {
      const res = await fetch('/api/mercadolibre/sync', { method: 'POST', credentials: 'include' });
      const json = await res.json();

      if (!res.ok || !json.success) {
        banner.innerHTML = `<div class="banner error">La sincronización falló: ${esc(json.error ?? json.details ?? 'error desconocido')}</div>`;
      } else {
        const st = json.stock;
        const stockTxt = st && (st.applied || st.reverted)
          ? ` Stock: ${esc(st.applied)} venta(s) descontada(s)${st.reverted ? `, ${esc(st.reverted)} cancelación(es) repuesta(s)` : ''}.`
          : '';
        banner.innerHTML = `<div class="banner success">Sincronización completada: ${esc(json.processed ?? 0)} procesados, ${esc(json.saved ?? 0)} guardados${json.failed ? `, ${esc(json.failed)} con error` : ''}.${stockTxt}</div>`;
        await loadStats();
        await loadOrders(0);
        await loadListings();
      }
    } catch (e: any) {
      banner.innerHTML = `<div class="banner error">Error de red: ${esc(e.message)}</div>`;
    } finally {
      btn.removeAttribute('disabled');
      icon.classList.remove('spinning');
      banner.style.display = 'block';
      setTimeout(() => { banner.style.display = 'none'; }, 8000);
    }
  }

  // ── CSV export ─────────────────────────────────────────────
  function exportCSV() {
    if (!allSalesCache.length) { alert('No hay datos para exportar. Cargue los pedidos primero.'); return; }
    const headers = ['Pedido ML','Fecha','Comprador','Ciudad','Dpto','Total COP','Estado Pago','Estado Envío','Cuenta CRM'];
    const rows = allSalesCache.map((r: any) => [
      r.ml_order_id ?? r.id ?? '',
      r.purchase_date ?? r.created_at ?? '',
      r.buyer_nickname ?? r.buyer_name ?? '',
      r.recipient_city ?? '',
      r.recipient_state ?? '',
      r.total_amount ?? 0,
      r.payment_status ?? '',
      r.shipping_status ?? '',
      r.crm_account_name ?? '',
    ]);
    const csv = [headers, ...rows].map((row: any[]) =>
      row.map((v: any) => `"${String(v).replace(/"/g, '""')}"`).join(',')
    ).join('\n');
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `pedidos-ml-${new Date().toISOString().slice(0,10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // ── CRM linking ────────────────────────────────────────────
  let crmAccounts: any[] = [];
  let crmModalSaleId: number | null = null;

  const esc = (s: any) => String(s ?? '').replace(/[&<>"']/g, (c: string) =>
    ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c] as string));

  function crmCell(r: any) {
    const saleId = r.id;
    if (r.crm_account_id) {
      return `<span class="crm-chip">
        <span class="crm-chip-name" title="${esc(r.crm_account_name)}">${esc(r.crm_account_name ?? 'Cuenta')}</span>
        <button class="crm-unlink js-crm-unlink" data-sale-id="${saleId}" title="Desvincular">✕</button>
      </span>`;
    }
    return `<button class="btn btn-ghost js-crm-link" data-sale-id="${saleId}" data-order-id="${esc(r.ml_order_id ?? '')}"
      style="height:28px;padding:0 10px;font-size:11px">+ Vincular</button>`;
  }

  function bindCrmButtons() {
    document.querySelectorAll('.js-crm-link').forEach(btn => {
      btn.addEventListener('click', () => {
        const saleId = Number((btn as HTMLElement).dataset.saleId);
        const orderId = (btn as HTMLElement).dataset.orderId ?? '';
        openCrmModal(saleId, orderId);
      });
    });
    document.querySelectorAll('.js-crm-unlink').forEach(btn => {
      btn.addEventListener('click', () => doUnlink(Number((btn as HTMLElement).dataset.saleId)));
    });
  }

  async function loadCrmAccounts() {
    try {
      const res = await fetch('/api/crm/accounts?limit=200', { credentials: 'include' });
      const json = await res.json();
      crmAccounts = json?.data?.items ?? [];
    } catch { crmAccounts = []; }
  }

  function openCrmModal(saleId: number, orderId: string) {
    crmModalSaleId = saleId;
    document.getElementById('crmModalOrderId')!.textContent = orderId || `#${saleId}`;
    const sel = document.getElementById('crmAccountSelect') as HTMLSelectElement;
    if (!crmAccounts.length) {
      sel.innerHTML = '<option value="">No hay cuentas CRM. Créelas en /admin/crm</option>';
    } else {
      sel.innerHTML = '<option value="">Seleccione una cuenta…</option>' +
        crmAccounts.map((a: any) => `<option value="${a.id}">${esc(a.display_name)}</option>`).join('');
    }
    document.getElementById('crmModal')!.style.display = 'flex';
  }

  function closeCrmModal() {
    document.getElementById('crmModal')!.style.display = 'none';
    crmModalSaleId = null;
  }

  async function confirmCrmLink() {
    const sel = document.getElementById('crmAccountSelect') as HTMLSelectElement;
    const accountId = Number(sel.value);
    if (!accountId || !crmModalSaleId) { alert('Seleccione una cuenta.'); return; }
    try {
      const res = await fetch(`/api/crm/accounts/${accountId}/sales`, {
        method: 'POST',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sale_ids: [crmModalSaleId] }),
      });
      const json = await res.json();
      if (!res.ok || !json.success) { alert(`No se pudo vincular: ${json?.error?.message ?? 'error'}`); return; }
      closeCrmModal();
      loadOrders(currentPage);
    } catch (e: any) {
      alert(`Error de red: ${e.message}`);
    }
  }

  async function doUnlink(saleId: number) {
    if (!confirm('¿Desvincular este pedido de la cuenta CRM?')) return;
    try {
      const res = await fetch(`/api/crm/sales/${saleId}/link`, { method: 'DELETE', credentials: 'include' });
      const json = await res.json();
      if (!res.ok || !json.success) { alert(`No se pudo desvincular: ${json?.error?.message ?? 'error'}`); return; }
      loadOrders(currentPage);
    } catch (e: any) {
      alert(`Error de red: ${e.message}`);
    }
  }

  document.getElementById('crmModalClose')?.addEventListener('click', closeCrmModal);
  document.getElementById('crmModalCancel')?.addEventListener('click', closeCrmModal);
  document.getElementById('crmModalConfirm')?.addEventListener('click', confirmCrmLink);
  document.getElementById('crmModal')?.addEventListener('click', (e: MouseEvent) => {
    if ((e.target as HTMLElement).id === 'crmModal') closeCrmModal();
  });

  // ── Event listeners ────────────────────────────────────────
  document.getElementById('btnSync')?.addEventListener('click', doSync);
  document.getElementById('btnSyncQuick')?.addEventListener('click', doSync);
  document.getElementById('btnFilter')?.addEventListener('click', () => loadOrders(0));
  document.getElementById('btnExportCSV')?.addEventListener('click', exportCSV);
  document.getElementById('btnPrev')?.addEventListener('click', () => loadOrders(currentPage - 1));
  document.getElementById('btnNext')?.addEventListener('click', () => loadOrders(currentPage + 1));

  // Enter key on filters
  ['filterCity','filterFrom','filterTo','filterStatus'].forEach(id => {
    document.getElementById(id)?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter') loadOrders(0);
    });
  });

  // ── Init ───────────────────────────────────────────────────
  showOAuthResult();
  loadStats();
  loadCrmAccounts();
  loadOrders(0);
  checkCredentials();
  loadListings();
</script>
