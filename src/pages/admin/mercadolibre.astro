  .pg-mercadolibre .city-bar-wrap { width: 80px; height: 6px; background: var(--rule); border-radius: 3px; flex-shrink: 0; }
  .pg-mercadolibre .city-bar { height: 6px; background: var(--brand); border-radius: 3px; }
  .pg-mercadolibre .city-count { font-size: 12px; font-weight: 600; color: var(--text-2); min-width: 28px; text-align: right; font-family: var(--font-mono); }

  .pg-mercadolibre .qa-list { padding: 6px 0; }
  .pg-mercadolibre .quick-action {
    display: flex; align-items: center; gap: 10px; width: 100%;
    padding: 10px 16px; font: inherit; font-size: 13px; text-align: left;
