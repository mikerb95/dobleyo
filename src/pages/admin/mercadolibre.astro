  .pg-mercadolibre .pag-btn-active, .pg-mercadolibre .pag-btn-active:hover {
    background: var(--brand-dark) !important; color: var(--paper) !important; border-color: var(--brand-dark) !important;
  }

  /* ── Fila inferior ───────────────────────────────────────────── */
  .pg-mercadolibre .ml-bottom {
    display: grid; gap: 1rem; align-items: start;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  .pg-mercadolibre .city-row {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 16px; border-bottom: 1px solid var(--rule); font-size: 13px;
