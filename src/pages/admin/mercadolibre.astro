    .pg-mercadolibre .rtable .cell-title, .pg-mercadolibre .stk-err { max-width: 100%; white-space: normal; }
    .pg-mercadolibre .stk-table tbody tr { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .pg-mercadolibre .ord-table tbody tr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @container (max-width: 420px) {
    .pg-mercadolibre .stk-table tbody tr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .pg-mercadolibre .btn-label { display: none; }

  /* ── Paginación ──────────────────────────────────────────────── */
  .pg-mercadolibre .pagination-bar {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;
    padding: 10px 16px; border-top: 1px solid var(--border); background: var(--hover);
  }
  .pg-mercadolibre .pag-info { font-size: 12px; color: var(--text-2); font-family: var(--font-mono); }
