---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="MercadoLibre · DobleYo ERP" section="mercadolibre">

  <!-- ── Page Header ─────────────────────────────────────────── -->
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">
          <a href="/admin">Admin</a> / MercadoLibre
        </div>
        <h1 class="page-title">Canal MercadoLibre</h1>
      </div>
      <div class="page-header-actions">
        <a href="/admin/sales-map" class="btn btn-secondary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
            <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
          </svg>
          Mapa de calor
        </a>
        <button class="btn btn-primary" id="btnSync">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="syncIcon">
            <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
          Sincronizar ahora
        </button>
      </div>
    </div>
  </div>

  <div class="erp-body">

    <!-- ── Sync result banner ──────────────────────────────────── -->
    <div id="syncBanner" style="display:none;margin-bottom:1.5rem"></div>

    <!-- ── Connection status ──────────────────────────────────── -->
    <div class="conn-card" id="connCard">
      <div class="conn-dot" id="connDot"></div>
      <div>
        <div class="conn-title" id="connTitle">Verificando conexión…</div>
        <div class="conn-sub" id="connSub">Comprobando credenciales de MercadoLibre</div>
      </div>
      <div class="conn-actions" id="connActions"></div>
    </div>

    <!-- ── Centralizador de stock ─────────────────────────────── -->
    <section class="card stk" aria-labelledby="stkTitle">
      <div class="card-header stk-head">
        <div class="stk-head-text">
          <div class="card-title" id="stkTitle">Stock sincronizado con MercadoLibre</div>
          <div class="card-subtitle" id="stkSubtitle">El inventario del sitio manda: cada cambio se envía a las publicaciones vinculadas y cada venta en ML se descuenta aquí.</div>
        </div>
        <div class="stk-actions">
          <button class="btn btn-secondary btn-sm" id="btnStkPushAll" type="button" title="Revisa todos los vínculos y reenvía los que no coincidan">Revisar todo</button>
          <button class="btn btn-secondary btn-sm" id="btnStkPush" type="button">Enviar pendientes</button>
          <button class="btn btn-primary btn-sm" id="btnStkLink" type="button">Vincular publicación</button>
        </div>
      </div>
      <div id="stkBanner" class="stk-banner" role="status" hidden></div>
      <div class="rtable-wrap">
        <table class="erp-table rtable stk-table">
          <thead>
            <tr>
              <th>Producto del sitio</th>
              <th>Publicación ML</th>
              <th class="num" title="Lo que el sitio puede vender">Disponible</th>
              <th class="num" title="Unidades que no se ofrecen en ML">Colchón</th>
              <th class="num" title="Disponible menos colchón">Se ofrece</th>
              <th class="num" title="Última cantidad que ML reportó">ML reporta</th>
              <th>Estado</th>
              <th class="stk-th-actions"><span class="sr-only">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="stkBody">
            <tr><td colspan="8" class="empty-state">Cargando vínculos...</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- ── KPI Row ─────────────────────────────────────────────── -->
    <div class="kpi-grid ml-kpis">
      <div class="kpi-tile">
        <div class="kpi-label">Pedidos</div>
        <div class="kpi-value" id="kpiOrders"><span class="skeleton" style="width:60px"></span></div>
        <div class="kpi-sub" id="kpiOrdersRange">-</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Ingresos totales</div>
        <div class="kpi-value" id="kpiRevenue"><span class="skeleton" style="width:80px"></span></div>
        <div class="kpi-sub">COP acumulado</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Ticket promedio</div>
        <div class="kpi-value" id="kpiAvg"><span class="skeleton" style="width:70px"></span></div>
        <div class="kpi-sub">por pedido</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Ciudades</div>
        <div class="kpi-value" id="kpiCities"><span class="skeleton" style="width:40px"></span></div>
        <div class="kpi-sub" id="kpiStates">-</div>
      </div>
    </div>

    <!-- ── Pedidos (a todo el ancho) ─────────────────────────────── -->
    <section class="card ord" aria-labelledby="ordTitle">
      <div class="card-header ord-head">
        <div>
          <div class="card-title" id="ordTitle">Pedidos sincronizados</div>
          <div class="card-subtitle" id="tableSubtitle">Cargando datos…</div>
        </div>
        <div class="ord-filters">
          <label class="ord-ff"><span>Desde</span><input type="date" id="filterFrom" class="ml-input"></label>
          <label class="ord-ff"><span>Hasta</span><input type="date" id="filterTo" class="ml-input"></label>
          <label class="ord-ff"><span>Ciudad</span><input type="text" id="filterCity" class="ml-input" placeholder="Todas"></label>
          <label class="ord-ff"><span>Estado</span>
            <select id="filterStatus" class="ml-input">
              <option value="">Todos</option>
              <option value="paid">Pagado</option>
              <option value="pending">Pendiente</option>
              <option value="cancelled">Cancelado</option>
            </select>
          </label>
          <button class="btn btn-secondary btn-sm" id="btnFilter" type="button">Filtrar</button>
        </div>
      </div>
      <div class="rtable-wrap">
        <table class="erp-table rtable ord-table">
          <thead>
            <tr>
              <th>Pedido ML</th>
              <th>Fecha</th>
              <th>Comprador</th>
              <th>Destino</th>
              <th class="num">Total</th>
              <th>Pago</th>
              <th>Envío</th>
              <th>Cuenta CRM</th>
              <th><span class="sr-only">Ver en MercadoLibre</span></th>
            </tr>
          </thead>
          <tbody id="ordersBody">
            <tr><td colspan="9" class="empty-state">Cargando pedidos...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="pagination-bar" id="paginationBar" style="display:none">
        <span class="pag-info" id="pagInfo"></span>
        <div class="pag-btns">
          <button class="btn btn-ghost btn-sm" id="btnPrev" type="button" disabled>‹ Anterior</button>
          <div id="pagPages" class="pag-btns"></div>
          <button class="btn btn-ghost btn-sm" id="btnNext" type="button">Siguiente ›</button>
        </div>
      </div>
    </section>

    <!-- ── Fila inferior: ciudades, accesos y configuración ──────── -->
    <div class="ml-bottom">

      <div class="card">
        <div class="card-header">
          <div>
            <div class="card-title">Ciudades con más pedidos</div>
            <div class="card-subtitle">Acumulado del canal</div>
          </div>
        </div>
        <div id="citiesList">
          <div class="empty-state">Cargando…</div>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div class="card-title">Acciones rápidas</div>
        </div>
        <div class="qa-list">
          <a href="/admin/sales-map" class="quick-action">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
              <line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
            </svg>
            Ver mapa de calor de ventas
          </a>
          <a href="/admin/ventas" class="quick-action">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/>
              <line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/>
            </svg>
            Dashboard de ventas
          </a>
          <button class="quick-action" id="btnExportCSV" type="button">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Exportar pedidos a CSV
          </button>
          <button class="quick-action" id="btnSyncQuick" type="button">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
            </svg>
            Sincronizar pedidos
          </button>
        </div>
      </div>

      <div class="card">
        <div class="card-header">
          <div class="card-title">Configuración</div>
        </div>
        <dl class="cfg">
          <div class="cfg-item">
            <dt>Conexión</dt>
            <dd><span id="cfgConn" class="status">-</span></dd>
          </div>
          <div class="cfg-item">
            <dt>Cuenta</dt>
            <dd id="cfgAccount">-</dd>
          </div>
          <div class="cfg-item">
            <dt>Token</dt>
            <dd id="cfgExpires">-</dd>
          </div>
          <div class="cfg-item">
            <dt>Sincronización automática</dt>
            <dd><span id="cfgCron" class="status">-</span></dd>
          </div>
          <div class="cfg-item">
            <dt>Última sincronización</dt>
            <dd id="cfgLastSync">-</dd>
          </div>
        </dl>
        <details class="cfg-details">
          <summary>Detalles técnicos</summary>
          <div class="cfg-tech">
            <p class="cfg-tech-label">URL del webhook</p>
            <div class="cfg-copy">
              <code id="cfgWebhook">https://dobleyo.cafe/api/mercadolibre/webhook</code>
              <button type="button" class="btn btn-ghost btn-sm" id="btnCopyWebhook">Copiar</button>
            </div>
            <p class="cfg-note">Regístrela en la aplicación de MercadoLibre con los temas <code>orders_v2</code> e <code>items</code> para recibir ventas casi en tiempo real.</p>
            <p class="cfg-note">GitHub Actions (<code>mercadolibre-sync.yml</code>) llama <code>/api/mercadolibre/cron-sync</code> cada 30 minutos entre las 8:00 y las 23:00. Necesita <code>CRON_SECRET</code> con el mismo valor en Vercel y en los secretos del repositorio.</p>
          </div>
        </details>
      </div>

    </div><!-- /.ml-bottom -->

    <!-- ── Modal: vincular venta a cuenta CRM ──────────────────── -->
    <div id="crmModal" class="crm-modal-overlay" style="display:none">
      <div class="crm-modal">
        <div class="crm-modal-head">
          <div class="card-title">Vincular pedido a una cuenta CRM</div>
          <button class="crm-modal-close" id="crmModalClose" aria-label="Cerrar">✕</button>
        </div>
        <div style="padding:16px">
          <p style="font-size:12px;color:var(--text-2);margin:0 0 12px">
            Pedido <code id="crmModalOrderId" style="background:var(--hover);padding:1px 5px;border-radius:3px"></code>.
            Seleccione la cuenta B2B a la que pertenece esta venta; sumará a su LTV.
          </p>
          <select id="crmAccountSelect" class="ml-input" style="width:100%;height:36px">
            <option value="">Cargando cuentas…</option>
          </select>
          <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:16px">
            <button class="btn btn-secondary" id="crmModalCancel">Cancelar</button>
            <button class="btn btn-primary" id="crmModalConfirm">Vincular</button>
          </div>
        </div>
      </div>
    </div>
    <!-- ── Modal: vincular publicación ─────────────────────────── -->
    <div id="lnkModal" class="crm-modal-overlay" style="display:none">
      <div class="crm-modal crm-modal--wide" role="dialog" aria-modal="true" aria-labelledby="lnkTitle">
        <div class="crm-modal-head">
          <div class="card-title" id="lnkTitle">Vincular publicación de MercadoLibre</div>
          <button class="crm-modal-close" id="lnkClose" type="button" aria-label="Cerrar">✕</button>
        </div>
        <form class="lnk-body" id="lnkForm" novalidate>
          <fieldset class="lnk-step">
            <legend>1. Producto del sitio</legend>
            <label class="lnk-field">
              <span>Producto</span>
              <select id="lnkProduct" class="ml-input" required>
                <option value="">Cargando productos...</option>
              </select>
            </label>
            <label class="lnk-field" id="lnkVariantWrap" hidden>
              <span>Variante</span>
              <select id="lnkVariant" class="ml-input"></select>
              <small>Este producto se vende por variantes: vincule cada variante con su publicación o variación.</small>
            </label>
          </fieldset>

          <fieldset class="lnk-step">
            <legend>2. Publicación en MercadoLibre</legend>
            <div class="lnk-search">
              <input type="text" id="lnkSearch" class="ml-input" placeholder="Buscar en sus publicaciones activas" aria-label="Buscar publicaciones">
              <button type="button" class="btn btn-secondary btn-sm" id="lnkSearchBtn">Buscar</button>
            </div>
            <div class="lnk-items" id="lnkItems" role="listbox" aria-label="Publicaciones">
              <div class="empty-state">Abra la lista o pegue el ID de la publicación abajo.</div>
            </div>
            <label class="lnk-field">
              <span>ID o enlace de la publicación</span>
              <input type="text" id="lnkItemId" class="ml-input" placeholder="MCO1234567890" autocomplete="off" required>
            </label>
            <label class="lnk-field" id="lnkVariationWrap" hidden>
              <span>Variación</span>
              <select id="lnkVariation" class="ml-input"></select>
            </label>
          </fieldset>

          <fieldset class="lnk-step">
            <legend>3. Colchón</legend>
            <label class="lnk-field">
              <span>Unidades que no se ofrecen en ML</span>
              <input type="number" id="lnkBuffer" class="ml-input" min="0" step="1" value="0" inputmode="numeric">
              <small>Con 2, si el sitio tiene 10 unidades, ML ofrece 8. Sirve para no sobrevender las últimas.</small>
            </label>
          </fieldset>

          <p class="lnk-error" id="lnkError" role="alert" hidden></p>
          <div class="lnk-foot">
            <button class="btn btn-secondary" id="lnkCancel" type="button">Cancelar</button>
            <button class="btn btn-primary" id="lnkSubmit" type="submit">Vincular y enviar stock</button>
          </div>
        </form>
      </div>
    </div>
  </div><!-- /.erp-body -->

</AdminLayout>

<style is:global>
  /* Global y acotado a .pg-mercadolibre (lo pone AdminLayout): casi todo el
     contenido se pinta con innerHTML y los estilos scoped no le llegan. */
  .pg-mercadolibre [hidden] { display: none !important; }
  .pg-mercadolibre .ml-nowrap { white-space: nowrap; }
  .pg-mercadolibre .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ── Botones: hover y foco que se noten ─────────────────────── */
  .pg-mercadolibre .btn { transition: background-color .15s, border-color .15s, color .15s, box-shadow .15s; }
  .pg-mercadolibre .btn:focus-visible { outline: none; box-shadow: 0 0 0 3px var(--c-warning-border); }
  .pg-mercadolibre .btn-secondary:hover:not(:disabled) {
    background: var(--active-bg); border-color: var(--brand); color: var(--brand-dark);
  }
  .pg-mercadolibre .btn-ghost { background: transparent; border-color: transparent; color: var(--text-2); }
  .pg-mercadolibre .btn-ghost:hover:not(:disabled) { background: var(--active-bg); color: var(--brand-dark); }
  .pg-mercadolibre .btn-ghost-danger { background: transparent; border-color: transparent; color: var(--c-error); }
  .pg-mercadolibre .btn-ghost-danger:hover:not(:disabled) { background: var(--c-error-bg); border-color: var(--c-error-border); }
  .pg-mercadolibre .btn:disabled { cursor: not-allowed; }
  .pg-mercadolibre .btn-icon { width: 30px; padding: 0; justify-content: center; }
  .pg-mercadolibre .btn-icon svg { width: 15px; height: 15px; }

  /* ── Campos ──────────────────────────────────────────────────── */
  .pg-mercadolibre .ml-input {
    height: 32px; padding: 0 8px;
    border: 1px solid var(--border); border-radius: 4px;
    font-size: 12px; font-family: inherit; color: var(--text-1); background: var(--card-bg);
    transition: border-color .15s, box-shadow .15s;
  }
  .pg-mercadolibre .ml-input:hover { border-color: var(--rule-2); }
  .pg-mercadolibre .ml-input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--c-warning-bg); }

  /* ── Aviso de conexión ───────────────────────────────────────── */
  .pg-mercadolibre .conn-card {
    display: flex; align-items: center; flex-wrap: wrap; gap: 12px;
    background: var(--card-bg); border: 1px solid var(--border); border-radius: 6px;
    padding: 14px 18px; margin-bottom: 1.5rem;
  }
  .pg-mercadolibre .conn-card > div:nth-child(2) { flex: 1; min-width: 220px; }
  .pg-mercadolibre .conn-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--text-3); flex-shrink: 0; }
  .pg-mercadolibre .conn-dot.ok   { background: var(--c-success); box-shadow: 0 0 0 3px var(--c-success-bg); }
  .pg-mercadolibre .conn-dot.err  { background: var(--c-error);   box-shadow: 0 0 0 3px var(--c-error-bg); }
  .pg-mercadolibre .conn-dot.warn { background: var(--c-warning); box-shadow: 0 0 0 3px var(--c-warning-bg); }
  .pg-mercadolibre .conn-title { font-weight: 600; font-size: 13px; }
  .pg-mercadolibre .conn-sub   { font-size: 12px; color: var(--text-2); margin-top: 2px; }
  .pg-mercadolibre .conn-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  /* ── Avisos de resultado ─────────────────────────────────────── */
  .pg-mercadolibre .banner, .pg-mercadolibre .stk-banner {
    padding: 10px 14px; border-radius: 6px; font-size: 13px; font-weight: 500; border: 1px solid transparent;
  }
  .pg-mercadolibre .stk-banner { margin: 12px 16px 0; }
  .pg-mercadolibre .banner.success, .pg-mercadolibre .stk-banner.success { background: var(--c-success-bg); color: var(--c-success); border-color: var(--c-success-border); }
  .pg-mercadolibre .banner.error,   .pg-mercadolibre .stk-banner.error   { background: var(--c-error-bg);   color: var(--c-error);   border-color: var(--c-error-border); }
  .pg-mercadolibre .stk-banner.info { background: var(--c-info-bg); color: var(--c-info); }
  @keyframes ml-spin { to { transform: rotate(360deg); } }
  .pg-mercadolibre .spinning { animation: ml-spin 0.8s linear infinite; }

  /* ── Secciones ───────────────────────────────────────────────── */
  .pg-mercadolibre .stk, .pg-mercadolibre .ord, .pg-mercadolibre .ml-kpis { margin-bottom: 1.5rem; }
  .pg-mercadolibre .stk-head, .pg-mercadolibre .ord-head { flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .pg-mercadolibre .stk-head-text { flex: 1 1 320px; }
  .pg-mercadolibre .stk-head .card-subtitle { max-width: 64ch; line-height: 1.5; }
  .pg-mercadolibre .stk-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .pg-mercadolibre .ord-filters { display: flex; gap: 8px; align-items: flex-end; flex-wrap: wrap; }
  .pg-mercadolibre .ord-ff { display: flex; flex-direction: column; gap: 3px; font-size: 11px; color: var(--text-3); }
  .pg-mercadolibre .ord-ff .ml-input { min-width: 0; }
  .pg-mercadolibre .ord-ff input[type="text"] { width: 130px; }

  /* ── Tablas que pasan a tarjetas cuando no caben ─────────────────
     Contenedor con container query: la decisión depende del ancho real
     de la tarjeta, no de la pantalla (el menú lateral le quita espacio). */
  .pg-mercadolibre .rtable-wrap { container-type: inline-size; }
  .pg-mercadolibre .rtable td { vertical-align: middle; }
  .pg-mercadolibre .cell-main { font-weight: 600; color: var(--text-1); }
  .pg-mercadolibre .cell-sub { display: block; font-size: 11px; color: var(--text-3); margin-top: 2px; }
  .pg-mercadolibre .cell-sub.mono { font-family: var(--font-mono); }
  .pg-mercadolibre .cell-link { color: var(--brand-dark); text-decoration: none; font-family: var(--font-mono); font-size: 12px; }
  .pg-mercadolibre .cell-link:hover { text-decoration: underline; color: var(--brand); }
  .pg-mercadolibre .cell-title { display: block; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 11px; color: var(--text-3); margin-top: 2px; }
  .pg-mercadolibre .row-actions { display: flex; gap: 2px; justify-content: flex-end; align-items: center; }

  /* Tabla de stock */
  .pg-mercadolibre .stk-buffer-input { width: 56px; height: 28px; text-align: right; font-family: var(--font-mono); }
  .pg-mercadolibre .stk-drift { color: var(--c-error); font-weight: 600; }
  .pg-mercadolibre .stk-drift-note { display: block; font-size: 10px; font-weight: 500; color: var(--c-error); font-family: inherit; }
  .pg-mercadolibre .stk-status-cell { min-width: 150px; }
  .pg-mercadolibre .stk-err {
    display: block; font-size: 11px; color: var(--c-error); margin-top: 3px;
    max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: help;
  }
  .pg-mercadolibre .stk-th-actions { width: 1%; }

  @container (max-width: 960px) {
    .pg-mercadolibre .rtable thead { display: none; }
    .pg-mercadolibre .rtable, .pg-mercadolibre .rtable tbody { display: block; }
