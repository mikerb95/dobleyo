---
// Ingreso al panel para administradores: solo con GitHub. Las cuentas
// autorizadas están en ADMIN_GITHUB_ACCOUNTS (server/routes/auth.js).
// Caficultores siguen entrando por el login general (/login).
import { Image } from "astro:assets";
import Head from "../../components/Head.astro";
import Icon from "../../components/Icon.astro";
import logo from "../../assets/logo.png";
---

<!doctype html>
<html lang="es">
  <head>
    <Head title="Ingreso administración · DobleYo Café" isAdmin={true} />
    <style>
      body {
        margin: 0;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 16px;
        box-sizing: border-box;
        background:
          radial-gradient(120% 80% at 50% 0%, rgba(var(--caramel-rgb), .22), transparent 60%),
          var(--espresso);
        font-family: "IBM Plex Sans", var(--font-body);
        color: var(--espresso);
      }

      .card {
        width: 100%;
        max-width: 380px;
        background: var(--cream);
        border-radius: var(--radius-lg);
        box-shadow: 0 24px 60px rgba(0, 0, 0, .35);
        padding: 32px 24px 24px;
        text-align: center;
      }

      .logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        display: block;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: var(--text-xs);
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--caramel-deep);
        margin: 0 0 8px;
      }

      h1 {
        font-size: var(--text-xl);
        font-weight: 600;
        margin: 0 0 8px;
      }

      .lead {
        font-size: var(--text-sm);
        color: var(--ink-muted);
        margin: 0 0 24px;
        line-height: 1.5;
      }

      .gh-btn {
        position: relative;
        overflow: hidden;
        isolation: isolate;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        box-sizing: border-box;
        padding: 12px 16px;
        border-radius: var(--radius-md);
        background: var(--espresso);
        color: var(--cream);
        font-weight: 600;
        font-size: var(--text-base);
        text-decoration: none;
        transition: background var(--dur) var(--ease), transform var(--dur) var(--ease),
          box-shadow var(--dur) var(--ease);
      }
      .gh-btn:hover { background: var(--caramel-deep); }
      .gh-btn:active { transform: scale(.98); }
      .gh-btn:focus-visible { outline: 2px solid var(--caramel); outline-offset: 3px; }

      /* Ícono con anillo que gira mientras se va a GitHub */
      .gh-icon {
        position: relative;
        display: grid;
        place-items: center;
        width: 20px;
        height: 20px;
      }
      .gh-icon::after {
        content: "";
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 2px solid transparent;
        border-top-color: var(--mucilage);
        border-right-color: var(--mucilage);
        opacity: 0;
        transform: scale(.6);
        transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
      }

      /* Texto que se reemplaza deslizándose hacia arriba */
      .gh-label {
        position: relative;
        display: grid;
        overflow: hidden;
      }
      .gh-label > span {
        grid-area: 1 / 1;
        transition: transform 320ms var(--ease), opacity 320ms var(--ease);
      }
      .gh-label-loading { transform: translateY(110%); opacity: 0; }

      /* Onda desde el punto del clic (se crea por JS: va global para que el
         scope de Astro no la deje sin estilos) */
      :global(.gh-ripple) {
        position: absolute;
        z-index: -1;
        width: 16px;
        height: 16px;
        margin: -8px 0 0 -8px;
        border-radius: 50%;
        background: rgba(var(--caramel-rgb), .55);
        pointer-events: none;
        animation: gh-ripple 650ms var(--ease) forwards;
      }

      /* Barra de progreso indeterminada en el borde inferior */
      .gh-btn::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: 0;
        height: 3px;
        width: 40%;
        background: linear-gradient(90deg, transparent, var(--mucilage), transparent);
        transform: translateX(-100%);
        opacity: 0;
      }

      .gh-btn.is-loading {
        pointer-events: none;
        cursor: progress;
        background: var(--caramel-deep);
        box-shadow: 0 8px 24px rgba(var(--caramel-rgb), .35);
      }
      .gh-btn.is-loading::after {
        opacity: 1;
        animation: gh-progress 1.1s var(--ease) infinite;
      }
      .gh-btn.is-loading .gh-icon svg { animation: gh-pulse 1.1s ease-in-out infinite; }
      .gh-btn.is-loading .gh-icon::after {
        opacity: 1;
        transform: scale(1);
        animation: gh-spin .8s linear infinite;
      }
      .gh-btn.is-loading .gh-label-idle { transform: translateY(-110%); opacity: 0; }
      .gh-btn.is-loading .gh-label-loading { transform: translateY(0); opacity: 1; }

      @keyframes gh-ripple {
        to { transform: scale(40); opacity: 0; }
      }
      @keyframes gh-progress {
        to { transform: translateX(260%); }
      }
      @keyframes gh-spin {
        to { transform: rotate(360deg); }
      }
      @keyframes gh-pulse {
        50% { transform: scale(.85); }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(.gh-ripple),
        .gh-btn.is-loading::after,
        .gh-btn.is-loading .gh-icon svg,
        .gh-btn.is-loading .gh-icon::after { animation: none; }
        .gh-label > span { transition: none; }
      }

      .alert {
        font-size: var(--text-sm);
        text-align: left;
        background: var(--danger-bg);
        color: var(--danger);
        border-radius: var(--radius-sm);
        padding: 10px 12px;
        margin: 0 0 16px;
        line-height: 1.45;
      }
      .alert[hidden] { display: none; }

      .foot {
        margin: 24px 0 0;
        padding-top: 16px;
        border-top: 1px solid rgba(var(--espresso-rgb), .1);
        font-size: var(--text-sm);
        color: var(--ink-muted);
      }
      .foot a { color: var(--caramel-deep); font-weight: 500; }

      @media (min-width: 480px) {
        .card { padding: 40px 36px 28px; }
      }
    </style>
  </head>
  <body>
    <main class="card">
      <Image src={logo} alt="DobleYo" width={64} height={64} class="logo" loading="eager" />
      <p class="eyebrow"><Icon name="lock" size={14} /> Acceso restringido</p>
      <h1>Panel de administración</h1>
      <p class="lead">Ingrese con su cuenta de GitHub. Solo las cuentas autorizadas pueden acceder.</p>

      <p class="alert" id="loginError" role="alert" hidden></p>

      <a class="gh-btn" id="githubBtn" href="/api/auth/github">
        <span class="gh-icon"><Icon name="github" size={20} /></span>
        <span class="gh-label">
          <span class="gh-label-idle">Continuar con GitHub</span>
          <span class="gh-label-loading" aria-hidden="true">Conectando con GitHub…</span>
        </span>
      </a>

      <p class="foot">
        ¿Es caficultor? <a id="caficultorLink" href="/login?redirect=/admin">Ingrese con su cuenta</a>
      </p>
    </main>

    <script>
      const ERRORS: Record<string, string> = {
        not_allowed: "Esta cuenta de GitHub no tiene acceso al panel.",
        denied: "Se canceló la autorización en GitHub.",
        state: "La solicitud de ingreso expiró o no es válida. Intente de nuevo.",
        no_email: "Su cuenta de GitHub no tiene un correo verificado. Verifíquelo en GitHub e intente de nuevo.",
        config: "El ingreso con GitHub no está configurado en este entorno.",
        server: "No pudimos completar el ingreso. Intente de nuevo en unos minutos.",
      };

      const params = new URLSearchParams(window.location.search);
      const redirect = params.get("redirect");
      const errorCode = params.get("error");

      if (redirect && redirect.startsWith("/admin")) {
        const gh = document.getElementById("githubBtn") as HTMLAnchorElement;
        gh.href = "/api/auth/github?redirect=" + encodeURIComponent(redirect);
        const caf = document.getElementById("caficultorLink") as HTMLAnchorElement;
        caf.href = "/login?redirect=" + encodeURIComponent(redirect);
      }

      if (errorCode) {
        const el = document.getElementById("loginError")!;
        el.textContent = ERRORS[errorCode] ?? ERRORS.server;
        el.hidden = false;
      }

      // Con sesión ya abierta no tiene sentido pedir el ingreso otra vez. El
      // middleware manda aquí también cuando solo venció el access token (15 min):
      // si la sesión de 7 días sigue viva, se renueva y se vuelve sin GitHub.
      const getMe = () =>
        fetch("/api/auth/me", { credentials: "include" }).then((res) => (res.ok ? res.json() : null));

      getMe()
        .then(async (user) => {
          if (user) return user;
          const refreshed = await fetch("/api/auth/refresh", { method: "POST", credentials: "include" });
          return refreshed.ok ? getMe() : null;
        })
        .then((user) => {
          if (user && (user.role === "admin" || user.role === "caficultor")) {
            window.location.replace(redirect && redirect.startsWith("/admin") ? redirect : "/admin");
          }
        })
        .catch(() => {});

      const ghBtn = document.getElementById("githubBtn") as HTMLAnchorElement;

      // La animación corre mientras el navegador va a GitHub; no se retrasa la
      // navegación para mostrarla.
      ghBtn.addEventListener("click", (e) => {
        if (ghBtn.classList.contains("is-loading")) {
          e.preventDefault();
          return;
        }
        const rect = ghBtn.getBoundingClientRect();
        // Con teclado (detail 0) no hay coordenadas: la onda sale del centro.
        const fromPointer = e.detail > 0;
        const ripple = document.createElement("span");
        ripple.className = "gh-ripple";
        ripple.style.left = `${fromPointer ? e.clientX - rect.left : rect.width / 2}px`;
        ripple.style.top = `${fromPointer ? e.clientY - rect.top : rect.height / 2}px`;
        ripple.addEventListener("animationend", () => ripple.remove());
        ghBtn.prepend(ripple);

        ghBtn.classList.add("is-loading");
        ghBtn.setAttribute("aria-disabled", "true");
        ghBtn.setAttribute("aria-busy", "true");
        ghBtn.querySelector(".gh-label-idle")!.setAttribute("aria-hidden", "true");
        ghBtn.querySelector(".gh-label-loading")!.removeAttribute("aria-hidden");
      });

      // Al volver con el botón atrás (bfcache) el botón debe quedar usable.
      window.addEventListener("pageshow", () => {
        ghBtn.classList.remove("is-loading");
        ghBtn.removeAttribute("aria-disabled");
        ghBtn.removeAttribute("aria-busy");
        ghBtn.querySelector(".gh-label-idle")!.removeAttribute("aria-hidden");
        ghBtn.querySelector(".gh-label-loading")!.setAttribute("aria-hidden", "true");
        ghBtn.querySelectorAll(".gh-ripple").forEach((r) => r.remove());
      });
    </script>
  </body>
</html>
