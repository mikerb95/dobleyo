---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Lotes entregados · DobleYo Admin" section="lotes-entregados">
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">Mi finca · Entregas</div>
        <h1 class="page-title">Lotes entregados</h1>
        <p class="page-subtitle">Historial de los lotes que usted ha entregado a DobleYo.</p>
      </div>
    </div>
  </div>

  <div class="erp-body le">
    <div class="filter-bar" role="search" aria-label="Filtrar lotes entregados">
      <label class="ff">
        <span>Desde</span>
        <input type="date" id="fechaDesde" class="le-input" />
      </label>
      <label class="ff">
        <span>Hasta</span>
        <input type="date" id="fechaHasta" class="le-input" />
      </label>
      <label class="ff">
        <span>Estado</span>
        <select id="estadoFilter" class="le-input">
          <option value="">Todos</option>
          <option value="recibido">Recibido</option>
          <option value="almacenado">Almacenado</option>
          <option value="tostado">Tostado</option>
          <option value="vendido">Vendido</option>
        </select>
      </label>
    </div>

    <div class="kpi-grid">
      <div class="kpi-tile">
        <div class="kpi-label">Lotes</div>
        <div class="kpi-value" id="totalLotes">0</div>
        <div class="kpi-sub">Entregados en el periodo</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Peso entregado</div>
        <div class="kpi-value" id="totalKg">0</div>
        <div class="kpi-sub">Kilogramos de café verde</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Valor</div>
        <div class="kpi-value" id="totalValor">$0</div>
        <div class="kpi-sub">Peso por precio pactado</div>
      </div>
    </div>

    <section class="panel" aria-labelledby="leTitle">
      <div class="panel-header">
        <h2 id="leTitle" class="panel-title">Lotes</h2>
      </div>
      <div class="table-wrapper">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Código</th>
              <th>Fecha</th>
              <th>Variedad</th>
              <th class="num">Peso (kg)</th>
              <th class="num">Precio/kg</th>
              <th class="num">Total</th>
              <th>Estado</th>
            </tr>
          </thead>
          <tbody id="lotesTableBody">
            <tr><td colspan="7" class="le-msg">Cargando lotes...</td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  // Simular datos de lotes (en producción vendrían de la API)
  const lotesEjemplo = [
    {
      codigo: "DBY-2026-001",
      fecha: "2026-01-05",
      variedad: "Caturra",
      peso: 250,
      precioKg: 12000,
      estado: "almacenado",
    },
    {
      codigo: "DBY-2025-089",
      fecha: "2025-12-28",
      variedad: "Castillo",
      peso: 180,
      precioKg: 11500,
      estado: "tostado",
    },
    {
      codigo: "DBY-2025-076",
      fecha: "2025-12-15",
      variedad: "Pink Bourbon",
      peso: 120,
      precioKg: 15000,
      estado: "vendido",
    },
  ];

  const ESTADOS = {
    recibido: ["Recibido", "status--confirmed"],
    almacenado: ["Almacenado", "status--pending"],
    tostado: ["Tostado", "status--confirmed"],
    vendido: ["Vendido", "status--paid"],
  };
  const esc = (v) => String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const cop = (n) => new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);

  function renderLotes(lotes) {
    const tbody = document.getElementById("lotesTableBody");

    if (lotes.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="le-msg">No hay lotes con estos filtros.</td></tr>';
    } else {
      tbody.innerHTML = lotes
        .map((lote) => {
          const [label, cls] = ESTADOS[lote.estado] ?? [lote.estado, ""];
          return `
        <tr>
          <td class="mono">${esc(lote.codigo)}</td>
          <td class="mono">${new Date(lote.fecha + "T12:00:00").toLocaleDateString("es-CO", { day: "numeric", month: "short", year: "numeric" })}</td>
          <td>${esc(lote.variedad)}</td>
          <td class="num mono">${lote.peso.toLocaleString("es-CO")}</td>
          <td class="num mono">${cop(lote.precioKg)}</td>
          <td class="num mono">${cop(lote.peso * lote.precioKg)}</td>
          <td><span class="status ${cls}">${esc(label)}</span></td>
        </tr>`;
        })
        .join("");
    }

    document.getElementById("totalLotes").textContent = String(lotes.length);
    document.getElementById("totalKg").textContent = lotes
      .reduce((sum, l) => sum + l.peso, 0)
      .toLocaleString("es-CO");
    document.getElementById("totalValor").textContent = cop(
      lotes.reduce((sum, l) => sum + l.peso * l.precioKg, 0)
    );
  }

  // Cargar datos al iniciar
  renderLotes(lotesEjemplo);

  // Filtros (placeholder para implementación futura)
  document.getElementById("estadoFilter")?.addEventListener("change", (e) => {
    const estado = e.target.value;
    const filtered = estado
      ? lotesEjemplo.filter((l) => l.estado === estado)
      : lotesEjemplo;
    renderLotes(filtered);
  });
</script>

<style is:global>
  .pg-lotes-entregados .le { display: flex; flex-direction: column; gap: 16px; }
  .pg-lotes-entregados .le-msg { padding: 32px 16px; text-align: center; color: var(--muted); }
</style>
