---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Registrar Venta Externa · DobleYo Admin" section="ventas">
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">Ventas · Canales externos</div>
        <h1 class="page-title">Ventas externas</h1>
        <p class="page-subtitle">Instagram, WhatsApp, referidos y demás canales sin integración.</p>
      </div>
      <div class="page-header-actions">
        <button id="btnNewSale" class="btn btn-primary" type="button">Registrar venta</button>
      </div>
    </div>
  </div>

  <div class="erp-body ext">
    <div class="kpi-grid">
      <div class="kpi-tile">
        <div class="kpi-label">Ventas registradas</div>
        <div class="kpi-value" id="statTotal">-</div>
        <div class="kpi-sub">Todos los canales</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Ingresos</div>
        <div class="kpi-value" id="statRevenue">-</div>
        <div class="kpi-sub">Suma de los totales</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Este mes</div>
        <div class="kpi-value" id="statMonth">-</div>
        <div class="kpi-sub">Ventas del mes en curso</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Canal principal</div>
        <div class="kpi-value" id="statTopChannel">-</div>
        <div class="kpi-sub">Por número de ventas</div>
      </div>
    </div>

    <div class="filter-bar" role="search" aria-label="Filtrar ventas externas">
      <label class="ff ff--grow">
        <span>Buscar</span>
        <input type="search" id="filterSearch" class="ext-input" placeholder="N.º de venta, cliente o ciudad" />
      </label>
      <label class="ff">
        <span>Canal</span>
        <select id="filterChannel" class="ext-input">
          <option value="">Todos</option>
          <option value="instagram">Instagram</option>
          <option value="whatsapp">WhatsApp</option>
          <option value="referido">Referido</option>
          <option value="tienda_fisica">Tienda física</option>
          <option value="telefono">Teléfono</option>
          <option value="otro">Otro</option>
        </select>
      </label>
      <label class="ff">
        <span>Estado</span>
        <select id="filterStatus" class="ext-input">
          <option value="">Todos</option>
          <option value="completada">Completada</option>
          <option value="pendiente">Pendiente</option>
          <option value="cancelada">Cancelada</option>
        </select>
      </label>
      <label class="ff">
        <span>Desde</span>
        <input type="date" id="filterFrom" class="ext-input" />
      </label>
      <label class="ff">
        <span>Hasta</span>
        <input type="date" id="filterTo" class="ext-input" />
      </label>
      <div class="filter-bar-actions">
        <button id="btnClearFilters" class="btn btn-sm btn-secondary" type="button">Limpiar</button>
        <button id="btnApplyFilters" class="btn btn-sm btn-primary" type="button">Filtrar</button>
      </div>
    </div>

    <section class="panel" aria-labelledby="extTitle">
      <div class="panel-header">
        <h2 id="extTitle" class="panel-title">Ventas</h2>
      </div>
      <div class="table-wrapper">
        <table class="erp-table ext-table" id="salesTable">
          <thead>
            <tr>
              <th>Venta</th>
              <th>Fecha</th>
              <th>Canal</th>
              <th>Cliente</th>
              <th>Ciudad</th>
              <th>Detalle</th>
              <th class="num">Total</th>
              <th>Estado</th>
              <th><span class="ext-sr">Acciones</span></th>
            </tr>
          </thead>
          <tbody id="salesBody">
            <tr><td colspan="9" class="ext-msg">Cargando ventas...</td></tr>
          </tbody>
        </table>
      </div>
      <div class="ext-pager" id="pagination"></div>
    </section>
  </div>

  <!-- ── Modal: Registrar venta ────────────────────────── -->
  <div id="modalNewSale" class="ios-modal-overlay" hidden>
    <div class="ios-modal ios-modal-lg">
      <div class="ios-modal-handle"></div>
      <div class="ios-modal-header">
        <h2>Registrar Venta Externa</h2>
        <button class="ios-modal-close" id="btnCloseModal" aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <form id="formNewSale" novalidate>
        <div class="ios-modal-body">

          <div class="ios-form-row">
            <div class="ios-form-group">
              <label for="fChannel">Canal de venta *</label>
              <select id="fChannel" name="channel" required>
                <option value="">Seleccionar…</option>
                <option value="instagram">Instagram</option>
                <option value="whatsapp">WhatsApp</option>
                <option value="referido">Referido</option>
                <option value="tienda_fisica">Tienda Física</option>
                <option value="telefono">Teléfono</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="ios-form-group">
              <label for="fChannelDetail">Detalle del canal</label>
              <input type="text" id="fChannelDetail" name="channel_detail" placeholder="ej. @usuario, referidor…" />
            </div>
            <div class="ios-form-group">
              <label for="fSaleDate">Fecha de venta *</label>
              <input type="date" id="fSaleDate" name="sale_date" required />
            </div>
          </div>

          <div class="ios-form-row">
            <div class="ios-form-group">
              <label for="fCustomerName">Nombre del cliente</label>
              <input type="text" id="fCustomerName" name="customer_name" placeholder="Nombre completo" />
            </div>
            <div class="ios-form-group">
              <label for="fCustomerContact">Contacto</label>
              <input type="text" id="fCustomerContact" name="customer_contact" placeholder="Teléfono o email" />
            </div>
            <div class="ios-form-group">
              <label for="fCustomerCity">Ciudad</label>
              <input type="text" id="fCustomerCity" name="customer_city" placeholder="Ciudad" />
            </div>
          </div>

          <div class="ios-form-section-title">
            <span>Productos vendidos</span>
            <button type="button" id="btnAddItem" class="ios-btn ios-btn-ghost ios-btn-sm">+ Agregar</button>
          </div>

          <div id="itemsContainer" class="ios-items-container"></div>

          <div class="ios-totals-box">
            <div class="ios-total-line">
              <span>Subtotal</span>
              <span id="tSubtotal">$ 0</span>
            </div>
            <div class="ios-total-line">
              <span class="ios-discount-label">
                Descuento
                <input type="number" id="fDiscount" name="discount" min="0" value="0" class="ios-discount-input" />
                <span class="ios-discount-unit">COP</span>
              </span>
              <span id="tDiscount">−$ 0</span>
            </div>
            <div class="ios-total-line ios-total-bold">
              <span>Total</span>
              <span id="tTotal">$ 0</span>
            </div>
          </div>

          <div class="ios-form-row">
            <div class="ios-form-group">
              <label for="fStatus">Estado</label>
              <select id="fStatus" name="status">
                <option value="completada">Completada (ajusta inventario)</option>
                <option value="pendiente">Pendiente (no ajusta inventario)</option>
              </select>
            </div>
            <div class="ios-form-group ios-form-group--wide">
              <label for="fNotes">Notas internas</label>
              <input type="text" id="fNotes" name="notes" placeholder="Observaciones opcionales" />
            </div>
          </div>

        </div>

        <div class="ios-modal-footer">
          <div id="formError" class="ios-form-error" hidden></div>
          <button type="button" id="btnCancelForm" class="ios-btn ios-btn-secondary">Cancelar</button>
          <button type="submit" id="btnSubmit" class="ios-btn ios-btn-primary">
            <span id="btnSubmitText">Registrar Venta</span>
            <span id="btnSubmitSpinner" class="ios-spinner" hidden></span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ── Modal: Detalle de venta ───────────────────────── -->
  <div id="modalDetail" class="ios-modal-overlay" hidden>
    <div class="ios-modal">
      <div class="ios-modal-handle"></div>
      <div class="ios-modal-header">
        <h2 id="detailTitle">Detalle de Venta</h2>
        <button class="ios-modal-close" id="btnCloseDetail" aria-label="Cerrar">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
      <div class="ios-modal-body" id="detailBody">
        <div class="ext-msg">Cargando...</div>
      </div>
      <div class="ios-modal-footer">
        <button id="btnCancelSale" class="ios-btn ios-btn-danger" hidden>Cancelar Venta</button>
        <button id="btnCloseDetail2" class="ios-btn ios-btn-secondary">Cerrar</button>
      </div>
    </div>
  </div>

<style is:global>
  /* Global y acotado a .pg-venta (lo pone AdminLayout): parte de esta
     página se pinta con innerHTML y los estilos scoped no le llegan. */

  .pg-venta .ext { display: flex; flex-direction: column; gap: 16px; }
  .pg-venta .ext-table { min-width: 860px; }
  .pg-venta .ext-nowrap { white-space: nowrap; }
  .pg-venta .ext-muted { color: var(--muted); }
  .pg-venta .ext-msg { padding: 32px 16px; text-align: center; color: var(--muted); }
  .pg-venta .ext-wide { grid-column: 1 / -1; }
  .pg-venta .ext-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .pg-venta .ext-pager {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px 16px; border-top: 1px solid var(--rule);
    font-size: 12px; color: var(--muted);
  }
  .pg-venta .ext-pager-btns { display: flex; align-items: center; gap: 8px; }

  /* ── Buttons ────────────────────────────────────────────── */
  .pg-venta .ios-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .55rem 1.1rem;
    border-radius: 10px;
    font-size: .875rem;
    font-weight: 600;
    font-family: inherit;
    border: none;
    cursor: pointer;
    transition: filter .12s, transform .1s, background .12s;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
  }
  .pg-venta .ios-btn:active { transform: scale(.96); }
  .pg-venta .ios-btn-primary { background: var(--brand); color: #fff; }
  .pg-venta .ios-btn-primary:hover { filter: brightness(1.08); }
  .pg-venta .ios-btn-secondary { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-1); }
  .pg-venta .ios-btn-secondary:hover { background: var(--nav-hover-bg); }
  .pg-venta .ios-btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text-2); }
  .pg-venta .ios-btn-ghost:hover { background: var(--nav-hover-bg); color: var(--text-1); }
  .pg-venta .ios-btn-danger { background: var(--c-error-bg); color: var(--c-error); border: 1px solid var(--c-error-border); }
  .pg-venta .ios-btn-danger:hover { filter: brightness(.96); }
  .pg-venta .ios-btn-sm { padding: .32rem .7rem !important; font-size: .78rem !important; border-radius: 8px !important; }

  /* ── Modal ──────────────────────────────────────────────── */
  .pg-venta .ios-modal-overlay {
    position: fixed; inset: 0;
    background: rgba(0,0,0,.4);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .pg-venta .ios-modal-overlay[hidden] { display: none; }

  .pg-venta .ios-modal {
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: 0 20px 60px rgba(0,0,0,.22), 0 4px 16px rgba(0,0,0,.1);
    width: 100%;
    max-width: 640px;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .pg-venta .ios-modal-lg { max-width: 860px; }

  .pg-venta .ios-modal-handle {
    width: 40px; height: 5px;
    background: var(--border);
    border-radius: 999px;
    margin: 10px auto 0;
    flex-shrink: 0;
  }

  .pg-venta .ios-modal-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: .875rem 1.5rem;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .pg-venta .ios-modal-header h2 { font-size: 1rem; font-weight: 700; margin: 0; color: var(--text-1); letter-spacing: -.01em; }
  .pg-venta .ios-modal-close {
    background: #f0f0f0;
    border: none;
    cursor: pointer;
    color: var(--text-2);
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    transition: background .12s;
  }
  .pg-venta .ios-modal-close:hover { background: #e0e0e0; color: var(--text-1); }

  .pg-venta .ios-modal-body { padding: 1.25rem 1.5rem; overflow-y: auto; flex: 1; }
  .pg-venta .ios-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border);
    display: flex; align-items: center; justify-content: flex-end; gap: .625rem;
    flex-shrink: 0;
    background: #fafafa;
    border-radius: 0 0 20px 20px;
  }

  /* ── Form ───────────────────────────────────────────────── */
  .pg-venta .ios-form-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-bottom: .75rem; }
  .pg-venta .ios-form-group { display: flex; flex-direction: column; gap: .3rem; }
  .pg-venta .ios-form-group--wide { grid-column: span 2; }
  .pg-venta .ios-form-group label { font-size: .75rem; font-weight: 600; color: var(--text-2); }
  .pg-venta .ios-form-group input, .pg-venta .ios-form-group select {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: .55rem .875rem;
    font-size: .875rem;
    color: var(--text-1);
    background: var(--card-bg);
    outline: none;
    font-family: inherit;
    transition: border-color .15s, box-shadow .15s;
  }
  .pg-venta .ios-form-group input:focus, .pg-venta .ios-form-group select:focus {
    border-color: var(--nav-active-border);
    box-shadow: 0 0 0 3px rgba(200,169,110,.15);
  }

  .pg-venta .ios-form-section-title {
    display: flex; align-items: center; justify-content: space-between;
    margin: 1rem 0 .5rem;
    font-size: .75rem; font-weight: 700; color: var(--text-2);
    text-transform: uppercase; letter-spacing: .07em;
    border-bottom: 1px solid var(--border);
    padding-bottom: .4rem;
  }

  /* Items */
  .pg-venta .ios-items-container { display: flex; flex-direction: column; gap: .5rem; margin-bottom: .75rem; }
  .pg-venta .item-row { display: grid; grid-template-columns: 1fr .6fr .85fr auto; gap: .5rem; align-items: center; }
  .pg-venta .item-row select, .pg-venta .item-row input {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .45rem .65rem;
    font-size: .85rem;
    color: var(--text-1);
    background: var(--card-bg);
    font-family: inherit;
    outline: none;
  }
  .pg-venta .item-row input[type="number"] { text-align: right; }
  .pg-venta .btn-remove-item {
    background: none; border: none; cursor: pointer;
    color: var(--c-error);
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; line-height: 1;
    transition: background .12s;
  }
  .pg-venta .btn-remove-item:hover { background: var(--c-error-bg); }

  /* Totals */
  .pg-venta .ios-totals-box {
    background: var(--erp-bg);
    border-radius: 12px;
    padding: .875rem 1.1rem;
    margin-bottom: .75rem;
    display: flex; flex-direction: column; gap: .4rem;
  }
  .pg-venta .ios-total-line { display: flex; justify-content: space-between; align-items: center; font-size: .875rem; color: var(--text-2); }
  .pg-venta .ios-total-bold { font-weight: 700; font-size: 1rem; color: var(--text-1); border-top: 1px solid var(--border); padding-top: .5rem; margin-top: .1rem; }
  .pg-venta .ios-discount-label { display: flex; align-items: center; gap: .4rem; }
  .pg-venta .ios-discount-input { width: 90px; border: 1px solid var(--border); border-radius: 7px; padding: .28rem .5rem; font-size: .82rem; background: var(--card-bg); font-family: inherit; outline: none; }
  .pg-venta .ios-discount-unit { font-size: .72rem; color: var(--text-3); }

  .pg-venta .ios-form-error { color: var(--c-error); font-size: .82rem; margin-right: auto; }

  .pg-venta .ios-spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: ios-spin .6s linear infinite; }
  @keyframes ios-spin { to { transform: rotate(360deg); } }

  /* Detail content */
  .pg-venta .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem .75rem; margin-bottom: 1rem; }
  .pg-venta .detail-item { display: flex; flex-direction: column; gap: .15rem; }
  .pg-venta .detail-item .dl { font-size: .7rem; font-weight: 700; color: var(--text-2); text-transform: uppercase; letter-spacing: .06em; }
  .pg-venta .detail-item .dv { font-size: .9rem; color: var(--text-1); font-weight: 500; }

  /* ── Mobile bottom sheet ────────────────────────────────── */
  @media (max-width: 640px) {
    .pg-venta .ios-modal-overlay { align-items: flex-end; padding: 0; }
    .pg-venta .ios-modal, .pg-venta .ios-modal.ios-modal-lg {
      max-width: 100%;
      border-radius: 20px 20px 0 0;
      max-height: 95vh;
    }
    .pg-venta .ios-modal-footer { border-radius: 0; }

    .pg-venta .ios-form-row { grid-template-columns: 1fr; }
    .pg-venta .ios-form-group--wide { grid-column: 1; }
    .pg-venta .item-row { grid-template-columns: 1fr 1fr; }

  }

  /* ── Desktop ERP aesthetic (≥768px) ────────────────────── */
  @media (min-width: 768px) {
    /* Buttons: Fiori flat - 36px, radius 4px, border explícito */
    .pg-venta .ios-btn {
      border-radius: 4px;
      height: 36px;
      padding: 0 1rem;
      font-size: .8125rem;
      border: 1px solid transparent;
    }
    .pg-venta .ios-btn:active { transform: none; }
    .pg-venta .ios-btn-primary { border-color: var(--brand-dark); }
    .pg-venta .ios-btn-secondary { border-color: var(--border); }
    .pg-venta .ios-btn-ghost { border-color: transparent; }
    .pg-venta .ios-btn-danger { border-color: var(--c-error-border); }
    .pg-venta .ios-btn-sm {
      height: 28px !important;
      padding: 0 .75rem !important;
      font-size: .75rem !important;
      border-radius: 4px !important;
    }

    /* Modal: diálogo ERP - sin handle, radio 8px, sin blur */
    .pg-venta .ios-modal-handle { display: none; }
    .pg-venta .ios-modal-overlay {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      background: rgba(0,0,0,.5);
    }
    .pg-venta .ios-modal {
      border-radius: 8px;
      box-shadow: 0 8px 32px rgba(0,0,0,.18), 0 2px 8px rgba(0,0,0,.1);
    }
    .pg-venta .ios-modal-footer {
      background: var(--erp-bg);
      border-radius: 0 0 8px 8px;
    }
    .pg-venta .ios-modal-close {
      background: transparent;
      border-radius: 4px;
    }
    .pg-venta .ios-modal-close:hover { background: var(--nav-hover-bg); }

    /* Form inputs: ERP compact */
    .pg-venta .ios-form-group input, .pg-venta .ios-form-group select { border-radius: 4px; padding: .45rem .75rem; }
    .pg-venta .item-row select, .pg-venta .item-row input { border-radius: 4px; }
    .pg-venta .ios-totals-box { border-radius: 6px; }
  }
</style>

<script>
  // ── Estado ─────────────────────────────────────────────────
  let allProducts = [];
  let currentPage = 0;
  const PAGE_SIZE = 20;
  let currentFilters = {};
  let currentDetailId = null;

  const fmt = (n) => new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }).format(n);
  const fmtDate = (d) => d ? new Date(d + 'T12:00:00').toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) : '-';

  const CHANNEL_LABELS = {
    instagram: 'Instagram', whatsapp: 'WhatsApp', referido: 'Referido',
    tienda_fisica: 'Tienda Física', telefono: 'Teléfono', otro: 'Otro',
  };
  const STATUS_LABELS = { completada: 'Completada', pendiente: 'Pendiente', cancelada: 'Cancelada' };
  const STATUS_CLS = { completada: 'status--paid', pendiente: 'status--pending', cancelada: 'status--cancelled' };
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const statusHtml = (st) => `<span class="status ${STATUS_CLS[st] || ''}">${esc(STATUS_LABELS[st] || st)}</span>`;

  // ── Cargar productos para el selector ──────────────────────
  async function loadProducts() {
    try {
      const r = await fetch('/api/inventory/products?active=true', { credentials: 'include' });
      const data = await r.json();
      if (data.success) allProducts = data.products;
    } catch (_) {}
  }

  // ── Cargar y renderizar ventas ─────────────────────────────
  async function loadSales(page = 0) {
    currentPage = page;
    const params = new URLSearchParams({ limit: PAGE_SIZE, offset: page * PAGE_SIZE, ...currentFilters });
    try {
      const r = await fetch(`/api/external-sales?${params}`, { credentials: 'include' });
      const data = await r.json();
      if (!data.success) throw new Error(data.error);

      renderStats(data.stats);
      renderTable(data.sales);
      renderPagination(data.total, page);
    } catch (err) {
      document.getElementById('salesBody').innerHTML =
        `<tr><td colspan="9" class="ext-msg">No se pudieron cargar las ventas. ${esc(err.message)}</td></tr>`;
    }
  }

  function renderStats(stats) {
    const totalSales = stats.reduce((s, r) => s + Number(r.total_sales), 0);
    const totalRevenue = stats.reduce((s, r) => s + Number(r.total_revenue), 0);
    const topChannel = stats[0];

    document.getElementById('statTotal').textContent = totalSales.toLocaleString('es-CO');
    document.getElementById('statRevenue').textContent = fmt(totalRevenue);

    // Ventas de este mes
    const now = new Date();
    const y = now.getFullYear(), m = String(now.getMonth() + 1).padStart(2, '0');
    fetch(`/api/external-sales?limit=1&from=${y}-${m}-01&to=${y}-${m}-31`, { credentials: 'include' })
      .then(r => r.json())
      .then(d => { document.getElementById('statMonth').textContent = d.total ?? '-'; });

    document.getElementById('statTopChannel').textContent = topChannel
      ? `${CHANNEL_LABELS[topChannel.channel] || topChannel.channel} (${topChannel.total_sales})`
      : '-';
  }

  function renderTable(sales) {
    const tbody = document.getElementById('salesBody');
    if (!sales.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="ext-msg">No hay ventas con estos filtros.</td></tr>';
      return;
    }
    tbody.innerHTML = sales.map(s => `
      <tr>
        <td class="mono">${esc(s.sale_number)}</td>
        <td class="mono ext-nowrap">${fmtDate(s.sale_date)}</td>
        <td>${esc(CHANNEL_LABELS[s.channel] || s.channel)}</td>
        <td>${esc(s.customer_name || '-')}</td>
        <td>${esc(s.customer_city || '-')}</td>
        <td class="ext-muted">${esc(s.channel_detail || '-')}</td>
        <td class="num mono">${fmt(s.total)}</td>
        <td>${statusHtml(s.status)}</td>
        <td class="num">
          <button class="btn btn-sm btn-secondary" type="button" data-action="open-detail" data-sale-id="${esc(s.id)}">Ver</button>
        </td>
      </tr>
    `).join('');
  }

  function renderPagination(total, page) {
    const pages = Math.ceil(total / PAGE_SIZE);
    const el = document.getElementById('pagination');
    const count = `<span class="mono">${total.toLocaleString('es-CO')} registros</span>`;
    if (pages <= 1) { el.innerHTML = count; return; }
    el.innerHTML = `
      ${count}
      <div class="ext-pager-btns">
        <span class="mono">Página ${page + 1} de ${pages}</span>
        <button class="btn btn-sm btn-secondary" type="button" data-action="page" data-page="${page - 1}" ${page === 0 ? 'disabled' : ''}>Anterior</button>
        <button class="btn btn-sm btn-secondary" type="button" data-action="page" data-page="${page + 1}" ${page >= pages - 1 ? 'disabled' : ''}>Siguiente</button>
      </div>
    `;
  }

  // ── Items dinámicos en el formulario ──────────────────────
  function buildProductOptions(selectedId = '') {
    return `<option value="">Seleccione un producto</option>` +
      allProducts.map(p => `<option value="${esc(p.id)}" ${p.id === selectedId ? 'selected' : ''}>${esc(p.name)} (stock: ${esc(p.stock_quantity ?? 0)})</option>`).join('');
  }

  function addItemRow() {
    const container = document.getElementById('itemsContainer');
    const idx = container.children.length;
    const row = document.createElement('div');
    row.className = 'item-row';
    row.dataset.idx = idx;
    row.innerHTML = `
      <select class="item-product">${buildProductOptions()}</select>
      <input type="number" class="item-qty" min="1" value="1" placeholder="Cant." />
      <input type="number" class="item-price" min="0" value="0" placeholder="Precio unit. COP" />
      <button type="button" class="btn-remove-item" data-action="remove-item" title="Quitar">×</button>
    `;
    container.appendChild(row);
    recalcTotals();
  }

  window.removeItemRow = (btn) => {
    btn.closest('.item-row').remove();
    recalcTotals();
  };

  function recalcTotals() {
    const rows = document.querySelectorAll('.item-row');
    let subtotal = 0;
    rows.forEach(row => {
      const qty = Number(row.querySelector('.item-qty')?.value || 0);
      const price = Number(row.querySelector('.item-price')?.value || 0);
      subtotal += qty * price;
    });
    const discount = Number(document.getElementById('fDiscount')?.value || 0);
    const total = Math.max(0, subtotal - discount);
    document.getElementById('tSubtotal').textContent = fmt(subtotal);
    document.getElementById('tDiscount').textContent = `−${fmt(discount)}`;
    document.getElementById('tTotal').textContent = fmt(total);
  }

  // ── Abrir / cerrar modal de nueva venta ───────────────────
  function openNewSaleModal() {
    const modal = document.getElementById('modalNewSale');
    document.getElementById('formNewSale').reset();
    document.getElementById('itemsContainer').innerHTML = '';
    document.getElementById('fSaleDate').value = new Date().toISOString().split('T')[0];
    document.getElementById('formError').hidden = true;
    addItemRow();
    recalcTotals();
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function closeNewSaleModal() {
    document.getElementById('modalNewSale').hidden = true;
    document.body.style.overflow = '';
  }

  // ── Enviar formulario ──────────────────────────────────────
  document.getElementById('formNewSale').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errEl = document.getElementById('formError');
    errEl.hidden = true;

    const rows = document.querySelectorAll('.item-row');
    const items = [];
    for (const row of rows) {
      const product_id = row.querySelector('.item-product').value;
      const quantity = Number(row.querySelector('.item-qty').value);
      const unit_price = Number(row.querySelector('.item-price').value);
      if (!product_id || quantity < 1) {
        errEl.textContent = 'Completa todos los campos de productos (producto y cantidad).';
        errEl.hidden = false;
        return;
      }
      items.push({ product_id, quantity, unit_price });
    }

    if (!items.length) {
      errEl.textContent = 'Agrega al menos un producto.';
      errEl.hidden = false;
      return;
    }

    const payload = {
      channel: document.getElementById('fChannel').value,
      channel_detail: document.getElementById('fChannelDetail').value,
      customer_name: document.getElementById('fCustomerName').value,
      customer_contact: document.getElementById('fCustomerContact').value,
      customer_city: document.getElementById('fCustomerCity').value,
      sale_date: document.getElementById('fSaleDate').value,
      discount: Number(document.getElementById('fDiscount').value || 0),
      notes: document.getElementById('fNotes').value,
      status: document.getElementById('fStatus').value,
      items,
    };

    const btnText = document.getElementById('btnSubmitText');
    const btnSpinner = document.getElementById('btnSubmitSpinner');
    const btnSubmit = document.getElementById('btnSubmit');
    btnText.hidden = true;
    btnSpinner.hidden = false;
    btnSubmit.disabled = true;

    try {
      const r = await fetch('/api/external-sales', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload),
      });
      const data = await r.json();

      if (!data.success) {
        const msg = data.errors ? data.errors.map(e => e.msg).join(', ') : (data.error || 'Error desconocido');
        errEl.textContent = msg;
        errEl.hidden = false;
        return;
      }

      closeNewSaleModal();
      loadSales(0);
    } catch (err) {
      errEl.textContent = 'Error de conexión. Intente de nuevo.';
      errEl.hidden = false;
    } finally {
      btnText.hidden = false;
      btnSpinner.hidden = true;
      btnSubmit.disabled = false;
    }
  });

  // ── Detalle de venta ───────────────────────────────────────
  window.openDetail = async (id) => {
    currentDetailId = id;
    const modal = document.getElementById('modalDetail');
    const body = document.getElementById('detailBody');
    const btnCancel = document.getElementById('btnCancelSale');
    body.innerHTML = '<div class="ext-msg">Cargando...</div>';
    btnCancel.hidden = true;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    try {
      const r = await fetch(`/api/external-sales/${id}`, { credentials: 'include' });
      const data = await r.json();
      if (!data.success) throw new Error(data.error);

      const { sale, items } = data;
      document.getElementById('detailTitle').textContent = `Venta ${sale.sale_number}`;

      const dItem = (label, value, wide = false) =>
        `<div class="detail-item${wide ? ' ext-wide' : ''}"><span class="dl">${label}</span><span class="dv">${value}</span></div>`;
      body.innerHTML = `
        <div class="detail-grid">
          ${dItem('Número', `<span class="mono">${esc(sale.sale_number)}</span>`)}
          ${dItem('Fecha', `<span class="mono">${fmtDate(sale.sale_date)}</span>`)}
          ${dItem('Canal', esc((CHANNEL_LABELS[sale.channel] || sale.channel) + (sale.channel_detail ? ` · ${sale.channel_detail}` : '')))}
          ${dItem('Estado', statusHtml(sale.status))}
          ${dItem('Cliente', esc(sale.customer_name || '-'))}
          ${dItem('Contacto', esc(sale.customer_contact || '-'))}
          ${dItem('Ciudad', esc(sale.customer_city || '-'))}
          ${dItem('Registrado por', esc(sale.registered_by_name || '-'))}
          ${sale.notes ? dItem('Notas', esc(sale.notes), true) : ''}
        </div>
        <div class="table-wrapper">
          <table class="erp-table">
            <thead><tr><th>Producto</th><th>SKU</th><th>Lote</th><th class="num">Cant.</th><th class="num">Precio unit.</th><th class="num">Subtotal</th></tr></thead>
            <tbody>
              ${items.map(it => `
                <tr>
                  <td>${esc(it.product_name)}</td>
                  <td class="mono ext-muted">${esc(it.sku || '-')}</td>
                  <td class="mono ext-muted">${esc(it.lot_code || '-')}</td>
                  <td class="num mono">${esc(it.quantity)}</td>
                  <td class="num mono">${fmt(it.unit_price)}</td>
                  <td class="num mono">${fmt(it.subtotal)}</td>
                </tr>
              `).join('')}
            </tbody>
            <tfoot>
              <tr><td colspan="5">Descuento</td><td class="num mono">−${fmt(sale.discount)}</td></tr>
              <tr><td colspan="5"><strong>Total</strong></td><td class="num mono"><strong>${fmt(sale.total)}</strong></td></tr>
            </tfoot>
          </table>
        </div>
      `;

      if (sale.status !== 'cancelada') {
        btnCancel.hidden = false;
      }
    } catch (err) {
      body.innerHTML = `<div class="ext-msg">No se pudo cargar la venta. ${esc(err.message)}</div>`;
    }
  };

  document.getElementById('btnCancelSale').addEventListener('click', async () => {
    if (!currentDetailId) return;
    if (!confirm('¿Confirma que desea cancelar esta venta? Se revertirá el ajuste de inventario.')) return;

    try {
      const r = await fetch(`/api/external-sales/${currentDetailId}/cancel`, {
        method: 'PUT',
        credentials: 'include',
      });
      const data = await r.json();
      if (!data.success) throw new Error(data.error);
      document.getElementById('modalDetail').hidden = true;
      document.body.style.overflow = '';
      loadSales(currentPage);
    } catch (err) {
      alert('Error al cancelar: ' + err.message);
    }
  });

  // ── Filtros ────────────────────────────────────────────────
  document.getElementById('btnApplyFilters').addEventListener('click', () => {
    currentFilters = {};
    const search = document.getElementById('filterSearch').value.trim();
    const channel = document.getElementById('filterChannel').value;
    const status = document.getElementById('filterStatus').value;
    const from = document.getElementById('filterFrom').value;
    const to = document.getElementById('filterTo').value;
    if (search)  currentFilters.search = search;
    if (channel) currentFilters.channel = channel;
    if (status)  currentFilters.status = status;
    if (from)    currentFilters.from = from;
    if (to)      currentFilters.to = to;
    loadSales(0);
  });

  document.getElementById('btnClearFilters').addEventListener('click', () => {
    document.getElementById('filterSearch').value = '';
    document.getElementById('filterChannel').value = '';
    document.getElementById('filterStatus').value = '';
    document.getElementById('filterFrom').value = '';
    document.getElementById('filterTo').value = '';
    currentFilters = {};
    loadSales(0);
  });

  // ── Eventos de UI ──────────────────────────────────────────
  document.getElementById('btnNewSale').addEventListener('click', openNewSaleModal);
  document.getElementById('btnCloseModal').addEventListener('click', closeNewSaleModal);
  document.getElementById('btnCancelForm').addEventListener('click', closeNewSaleModal);
  document.getElementById('btnCloseDetail').addEventListener('click', () => {
    document.getElementById('modalDetail').hidden = true;
    document.body.style.overflow = '';
  });
  document.getElementById('btnCloseDetail2').addEventListener('click', () => {
    document.getElementById('modalDetail').hidden = true;
    document.body.style.overflow = '';
  });
  document.getElementById('btnAddItem').addEventListener('click', addItemRow);
  document.getElementById('fDiscount').addEventListener('input', recalcTotals);

  // Cerrar modales al hacer click fuera
  document.getElementById('modalNewSale').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeNewSaleModal();
  });
  document.getElementById('modalDetail').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) {
      e.currentTarget.hidden = true;
      document.body.style.overflow = '';
    }
  });

  // ── Event delegation para tabla, paginación e items dinámicos ──────────────
  document.getElementById("salesBody")?.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-action='open-detail']");
    if (btn) openDetail(parseInt(btn.dataset.saleId));
  });

  document.getElementById("pagination")?.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-action='page']");
    if (btn && !btn.disabled) loadSales(parseInt(btn.dataset.page));
  });

  document.getElementById("itemsContainer")?.addEventListener("click", (e) => {
    const btn = e.target.closest("[data-action='remove-item']");
    if (btn) removeItemRow(btn);
  });
  document.getElementById("itemsContainer")?.addEventListener("change", (e) => {
    if (e.target.matches(".item-product,.item-qty,.item-price")) recalcTotals();
  });
  document.getElementById("itemsContainer")?.addEventListener("input", (e) => {
    if (e.target.matches(".item-qty,.item-price")) recalcTotals();
  });

  // ── Init ───────────────────────────────────────────────────
  (async () => {
    await loadProducts();
    await loadSales(0);
  })();
</script>
</AdminLayout>
