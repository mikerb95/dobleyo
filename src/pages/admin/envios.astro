---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Envíos · DobleYo Admin" section="envios">
    <style is:global>
  /* Global y acotado a .pg-envios (lo pone AdminLayout): parte de esta
     página se pinta con innerHTML y los estilos scoped no le llegan. */
        .pg-envios .page-header {
            padding: 1.75rem 2rem 1.5rem;
            margin-bottom: 0;
            background: var(--paper);
            border-bottom: 1px solid rgba(0,0,0,.08);
        }
        .pg-envios .page-header h1 {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--color-text);
            margin: 0 0 0.3rem;
        }
        .pg-envios .page-header p {
            margin: 0;
            color: var(--muted);
            font-size: 0.95rem;
        }
        .pg-envios .page-body {
            padding: 1.75rem 2rem 2rem;
        }
        .pg-envios .tabs {
            display: flex;
            gap: 0.25rem;
            margin-bottom: 1.25rem;
            border-bottom: 1px solid var(--rule);
        }
        .pg-envios .tab-btn {
            padding: 0.65rem 1.1rem;
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
        }
        .pg-envios .tab-btn.active {
            color: var(--color-text);
            border-bottom-color: var(--color-primary);
        }
        .pg-envios .tab-panel { display: none; }
        .pg-envios .tab-panel.active { display: block; }

        .pg-envios .table-wrap {
            background: var(--paper);
            border-radius: 8px;
            border: 1px solid var(--border, rgba(0,0,0,.09));
            box-shadow: var(--card-shadow, 0 0 0 1px rgba(0,0,0,.06), 0 2px 8px rgba(0,0,0,.05));
            overflow-x: auto;
            margin-bottom: 1.5rem;
        }
        .pg-envios .empty {
            text-align: center;
            padding: 2.5rem;
            color: var(--muted);
            font-style: italic;
        }
        .pg-envios .badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            border: 1px solid transparent;
            white-space: nowrap;
        }
        .pg-envios .badge-warn { background: var(--c-warning-bg); color: var(--c-warning); border-color: var(--c-warning-border); }
        .pg-envios .badge-ok { background: var(--c-success-bg); color: var(--ok); border-color: var(--c-success-border); }
        .pg-envios .badge-err { background: var(--c-error-bg); color: var(--danger); border-color: var(--c-error-border); }
        .pg-envios .badge-info { background: var(--c-info-bg); color: var(--c-info); border-color: color-mix(in oklab, var(--c-info) 35%, transparent); }
        .pg-envios .badge-default { background: var(--hover); color: var(--muted); border-color: var(--rule); }

        .pg-envios .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 0 10px;
            height: 28px;
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            border: 1px solid var(--border, rgba(0,0,0,.09));
            border-radius: 4px;
            background: var(--card-bg);
            cursor: pointer;
            color: var(--text-1);
            white-space: nowrap;
        }
        .pg-envios .btn-action:hover { background: var(--nav-hover-bg); border-color: var(--rule-2); }
        .pg-envios .btn-primary-sm {
            padding: 0.5rem 1rem;
            background: var(--color-primary);
            color: var(--paper);
            border: none;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }
        .pg-envios .btn-primary-sm:hover { background: color-mix(in oklab, var(--color-primary) 85%, black); }
        .pg-envios .btn-primary-sm:disabled { opacity: 0.5; cursor: default; }

        .pg-envios .toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        /* Modal */
        .pg-envios .modal-back {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            z-index: 300;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .pg-envios .modal-back.open { display: flex; }
        .pg-envios .modal {
            background: var(--paper);
            border-radius: 12px;
            width: 100%;
            max-width: 640px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 8px 32px rgba(37, 26, 20, 0.22);
        }
        .pg-envios .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--rule);
        }
        .pg-envios .modal-header h2 { margin: 0; font-size: 1.1rem; color: var(--color-text); }
        .pg-envios .modal-close {
            background: none; border: none; cursor: pointer;
            color: var(--muted); font-size: 1.4rem; line-height: 1; padding: 0.2rem;
        }
        .pg-envios .modal-body { padding: 1.5rem; }
        .pg-envios .form-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
        .pg-envios .form-field { display: flex; flex-direction: column; gap: 0.3rem; flex: 1; min-width: 120px; }
        .pg-envios .form-field label { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
        .pg-envios .form-field input, .pg-envios .form-field select {
            padding: 0.55rem 0.7rem; border: 1px solid var(--rule); border-radius: 6px;
            font-size: 0.88rem; color: var(--color-text); background: var(--hover);
        }
        .pg-envios .alert-box {
            padding: 0.7rem 0.9rem;
            border-radius: 6px;
            font-size: 0.82rem;
            margin-bottom: 0.9rem;
        }
        .pg-envios .alert-warn { background: var(--c-warning-bg); color: var(--c-warning); border: 1px solid var(--c-warning-border); }
        .pg-envios .alert-err { background: var(--c-error-bg); color: var(--danger); border: 1px solid var(--c-error-border); }

        .pg-envios .quote-table { width: 100%; border-collapse: collapse; font-size: 0.85rem; margin-top: 0.5rem; }
        .pg-envios .quote-table th, .pg-envios .quote-table td { padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid var(--rule); }
        .pg-envios .quote-row { cursor: pointer; }
        .pg-envios .quote-row:hover { background: var(--hover); }
        .pg-envios .quote-row.selected { background: var(--c-success-bg); }

        .pg-envios .save-msg { font-size: 0.82rem; margin-top: 0.5rem; }

        .pg-envios .header-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap; }
        .pg-envios .provider-status { display: flex; gap: 0.5rem; flex-wrap: wrap; }
        .pg-envios .provider-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 600;
            background: var(--hover); border: 1px solid var(--rule); color: var(--color-text);
        }
        .pg-envios .provider-chip .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--rule-2); }
        .pg-envios .provider-chip.ok .dot { background: var(--ok); }
        .pg-envios .provider-chip.err .dot { background: var(--danger); }

        .pg-envios .toolbar-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
        .pg-envios .btn-secondary-sm {
            padding: 0.5rem 0.9rem; background: var(--paper); color: var(--color-primary);
            border: 1px solid var(--color-primary); border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;
        }
        .pg-envios .btn-secondary-sm:hover { background: var(--hover); }
        .pg-envios .btn-secondary-sm:disabled { opacity: 0.45; cursor: default; background: var(--paper); }
        .pg-envios .pdf-links { display: flex; gap: 0.6rem; flex-wrap: wrap; font-size: 0.82rem; }

        .pg-envios .detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem 1.25rem; margin-bottom: 1.25rem; }
        .pg-envios .detail-grid dt { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
        .pg-envios .detail-grid dd { margin: 0.15rem 0 0; font-size: 0.9rem; color: var(--color-text); overflow-wrap: anywhere; }
        .pg-envios .cost-diff-up { color: var(--danger); font-weight: 700; }
        .pg-envios .cost-diff-down { color: var(--ok); font-weight: 700; }
        .pg-envios .timeline { list-style: none; margin: 0; padding: 0; }
        .pg-envios .timeline li { display: grid; grid-template-columns: 12px 1fr; gap: 0.75rem; padding-bottom: 0.9rem; position: relative; }
        .pg-envios .timeline li::before {
            content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--rule-2); margin-top: 4px;
        }
        .pg-envios .timeline li:first-child::before { background: var(--color-primary); }
        .pg-envios .timeline .tl-state { font-weight: 600; font-size: 0.88rem; color: var(--color-text); }
        .pg-envios .timeline .tl-meta { font-size: 0.78rem; color: var(--muted); }
        .pg-envios .section-title { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); margin: 0 0 0.6rem; }

        @media (max-width: 480px) {
            .pg-envios .detail-grid { grid-template-columns: 1fr; }
            .pg-envios .page-header, .pg-envios .page-body { padding-left: 1rem; padding-right: 1rem; }
        }
    </style>

    <header class="page-header">
        <div class="header-row">
            <div>
                <h1>Envíos</h1>
                <p>Cotización, generación de guías y seguimiento con Mipaquete e Interrapidísimo</p>
            </div>
            <div class="provider-status" id="providerStatus" aria-live="polite">
                <span class="provider-chip" data-provider="mipaquete" title="Verificando conexión..."><span class="dot"></span>Mipaquete</span>
                <span class="provider-chip" data-provider="interrapidisimo" title="Verificando conexión..."><span class="dot"></span>Interrapidísimo</span>
            </div>
        </div>
    </header>

    <div class="page-body">

        <div class="tabs">
            <button class="tab-btn active" data-tab="pending">Pendientes de despacho</button>
            <button class="tab-btn" data-tab="active">Envíos activos</button>
            <button class="tab-btn" data-tab="cod">Recaudos contraentrega</button>
            <button class="tab-btn" data-tab="stuck">Estancados</button>
        </div>

        <!-- Pendientes -->
        <div class="tab-panel active" id="panel-pending">
            <div class="toolbar">
                <span id="pendingSummary" style="color:var(--muted);font-size:0.88rem;">Cargando...</span>
            </div>
            <div class="table-wrap">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th>Referencia</th><th>Cliente</th><th>Ciudad</th><th>Pago</th><th>Total</th><th>Fecha</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="pendingBody">
                        <tr><td colspan="7" class="empty">Cargando pedidos...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activos -->
        <div class="tab-panel" id="panel-active">
            <div class="toolbar">
                <span id="activeSummary" style="color:var(--muted);font-size:0.88rem;">Cargando...</span>
                <div class="toolbar-actions">
                    <button class="btn-secondary-sm" id="btnInterPickup" disabled title="Seleccione guías de Interrapidísimo sin recogida">Solicitar recogida</button>
                    <button class="btn-secondary-sm" id="btnInterManifest" disabled title="Seleccione guías de Interrapidísimo por despachar">Planilla de despacho</button>
                    <button class="btn-primary-sm" id="btnRefreshAll">Actualizar todos</button>
                </div>
            </div>
            <div id="activeMsg"></div>
            <div class="table-wrap">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAllInter" aria-label="Seleccionar todas las guías de Interrapidísimo" /></th>
                            <th>Referencia</th><th>Transportadora</th><th>Guía</th><th>Estado</th><th>PDF</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="activeBody">
                        <tr><td colspan="7" class="empty">Cargando envíos...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- COD -->
        <div class="tab-panel" id="panel-cod">
            <div class="toolbar">
                <span id="codSummary" style="color:var(--muted);font-size:0.88rem;">Cargando...</span>
            </div>
            <div class="table-wrap">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th>Referencia</th><th>Cliente</th><th>Valor a recaudar</th><th>Entregado</th><th></th>
                        </tr>
                    </thead>
                    <tbody id="codBody">
                        <tr><td colspan="5" class="empty">Cargando recaudos...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Estancados -->
        <div class="tab-panel" id="panel-stuck">
            <div class="toolbar">
                <span id="stuckSummary" style="color:var(--muted);font-size:0.88rem;">Cargando...</span>
            </div>
            <div class="alert-box alert-warn" style="margin-bottom:1rem;">
                Envíos que exceden el SLA esperado por estado: 24h sin guía asignada, 48h sin recolección, o 7 días en tránsito. Puede indicar que el transportador dejó la guía sin novedad.
            </div>
            <div class="table-wrap">
                <table class="erp-table">
                    <thead>
                        <tr>
                            <th>Referencia</th><th>Cliente</th><th>Ciudad</th><th>Estado</th><th>Transportadora</th><th>Tiempo en estado</th>
                        </tr>
                    </thead>
                    <tbody id="stuckBody">
                        <tr><td colspan="6" class="empty">Cargando...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div><!-- /page-body -->

    <!-- Modal cotizar / generar guía -->
    <div class="modal-back" id="modalBack">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
            <div class="modal-header">
                <h2 id="modalTitle">Cotizar envío</h2>
                <button class="modal-close" id="modalClose" aria-label="Cerrar">&times;</button>
            </div>
            <div class="modal-body">
                <div id="modalAlert"></div>

                <div class="form-row">
                    <div class="form-field">
                        <label for="fWeight">Peso (kg)</label>
                        <input type="number" id="fWeight" step="0.1" min="0.1" value="0.5" />
                    </div>
                    <div class="form-field">
                        <label for="fWidth">Ancho (cm)</label>
                        <input type="number" id="fWidth" min="1" value="20" />
                    </div>
                    <div class="form-field">
                        <label for="fLength">Largo (cm)</label>
                        <input type="number" id="fLength" min="1" value="30" />
                    </div>
                    <div class="form-field">
                        <label for="fHeight">Alto (cm)</label>
                        <input type="number" id="fHeight" min="1" value="15" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="fDane">Ciudad destino (código DANE)</label>
                        <select id="fDane"></select>
                    </div>
                    <div class="form-field">
                        <label for="fDeclaredValue">Valor declarado (COP)</label>
                        <input type="number" id="fDeclaredValue" min="1" />
                    </div>
                </div>

                <button class="btn-primary-sm" id="btnQuote">Cotizar</button>
                <div id="quoteResults"></div>

                <div class="form-row" id="interDocRow" style="margin-top:1rem;display:none;">
                    <div class="form-field">
                        <label for="fDocType">Tipo de documento del destinatario</label>
                        <select id="fDocType">
                            <option value="CC">Cédula de ciudadanía</option>
                            <option value="CE">Cédula de extranjería</option>
                            <option value="NI">NIT</option>
                            <option value="TI">Tarjeta de identidad</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="fDocNumber">Número de documento</label>
                        <input type="text" id="fDocNumber" inputmode="numeric" placeholder="Requerido por Interrapidísimo" />
                    </div>
                </div>

                <div class="form-row" style="margin-top:1rem;">
                    <div class="form-field">
                        <label for="fPickup">Solicitar recogida</label>
                        <select id="fPickup">
                            <option value="true">Sí</option>
                            <option value="false">No (entrega en oficina)</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="fComments">Comentarios</label>
                        <input type="text" id="fComments" placeholder="Opcional" />
                    </div>
                </div>

                <button class="btn-primary-sm" id="btnCreateShipment" disabled>Generar guía</button>
                <div class="save-msg" id="createMsg"></div>
            </div>
        </div>
    </div>

    <!-- Modal despacho manual (órdenes fuera de cobertura Mipaquete, p.ej. USD) -->
    <div class="modal-back" id="modalManualBack">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalManualTitle">
            <div class="modal-header">
                <h2 id="modalManualTitle">Despacho manual</h2>
                <button class="modal-close" id="modalManualClose" aria-label="Cerrar">&times;</button>
            </div>
            <div class="modal-body">
                <div class="alert-box alert-warn">
                    Esta orden no está cubierta por Mipaquete (moneda distinta a COP). Registre la guía del transportador usado manualmente; no se hace ninguna llamada a Mipaquete.
                </div>
                <div id="modalManualAlert"></div>

                <div class="form-row">
                    <div class="form-field">
                        <label for="mCarrier">Transportador</label>
                        <input type="text" id="mCarrier" placeholder="p.ej. FedEx, DHL, USPS" />
                    </div>
                    <div class="form-field">
                        <label for="mGuide">Número de guía</label>
                        <input type="text" id="mGuide" placeholder="Tracking number" />
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-field">
                        <label for="mTrackingUrl">URL de tracking (opcional)</label>
                        <input type="text" id="mTrackingUrl" placeholder="https://..." />
                    </div>
                    <div class="form-field">
                        <label for="mComments">Comentarios (opcional)</label>
                        <input type="text" id="mComments" />
                    </div>
                </div>

                <button class="btn-primary-sm" id="btnManualDispatch">Registrar despacho</button>
                <div class="save-msg" id="manualMsg"></div>
            </div>
        </div>
    </div>

    <!-- Modal detalle del envío -->
    <div class="modal-back" id="modalDetailBack">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modalDetailTitle">
            <div class="modal-header">
                <h2 id="modalDetailTitle">Detalle del envío</h2>
                <button class="modal-close" id="modalDetailClose" aria-label="Cerrar">&times;</button>
            </div>
            <div class="modal-body" id="modalDetailBody">Cargando...</div>
        </div>
    </div>

    <script>
        // ── Utilidades ────────────────────────────────────────────
        const fmtCOP = (n: number) =>
            new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(n);
        const fmtDate = (s: string) =>
            s ? new Date(s).toLocaleDateString("es-CO", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "-";

        const STATUS_LABELS: Record<string, string> = {
            created: "Creado", pickup_requested: "Recogida solicitada", in_transit: "En tránsito",
            delivered: "Entregado", returned: "Devuelto", cancelled: "Cancelado", error: "Error",
        };
        const STATUS_CLASS: Record<string, string> = {
            created: "badge-info", pickup_requested: "badge-info", in_transit: "badge-info",
            delivered: "badge-ok", returned: "badge-warn", cancelled: "badge-default", error: "badge-err",
        };
        const badge = (st: string) => `<span class="badge ${STATUS_CLASS[st] ?? "badge-default"}">${STATUS_LABELS[st] ?? st}</span>`;
        const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, (c) =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]!));
        const PROVIDER_LABELS: Record<string, string> = {
            mipaquete: "Mipaquete", interrapidisimo: "Interrapidísimo (API directa)", manual: "Manual",
        };

        // Descarga/abre un PDF de un endpoint que responde binario (api() espera JSON).
        async function fetchPdf(path: string, opts: RequestInit = {}) {
            const res = await fetch(`/api/shipping${path}`, {
                credentials: "include",
                headers: { "Content-Type": "application/json" },
                ...opts,
            });
            if (!res.ok) {
                const data = await res.json().catch(() => ({}));
                throw new Error(data.error || data.errors?.[0]?.msg || "Error al generar el PDF");
            }
            return { blob: await res.blob(), headers: res.headers };
        }

        // ── Estado de conexión con proveedores ───────────────────
        async function loadProviderStatus() {
            let data: any = null;
            try {
                const res = await fetch("/api/shipping/health", { credentials: "include" });
                data = (await res.json()).data;
            } catch { /* se muestra como error abajo */ }
            document.querySelectorAll<HTMLElement>(".provider-chip").forEach((chip) => {
                const st = data?.[chip.dataset.provider!];
                chip.classList.remove("ok", "err");
                chip.classList.add(st?.ok ? "ok" : "err");
                chip.title = st?.ok ? "Conectado" : `Sin conexión: ${st?.error || "no se pudo verificar"}`;
            });
        }

        async function api(path: string, opts: RequestInit = {}) {
            // Vercel's /api/:path* rewrite 404s on a bare trailing slash, so
            // "/" and "/?query" must be sent without the leading slash segment.
            const normalizedPath = path === "/" || path.startsWith("/?") ? path.slice(1) : path;
            const res = await fetch(`/api/shipping${normalizedPath}`, {
                credentials: "include",
                headers: { "Content-Type": "application/json" },
                ...opts,
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Error en la solicitud");
            return data.data;
        }

        // ── Tabs ──────────────────────────────────────────────────
        document.querySelectorAll(".tab-btn").forEach((btn) => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".tab-btn").forEach((b) => b.classList.remove("active"));
                document.querySelectorAll(".tab-panel").forEach((p) => p.classList.remove("active"));
                btn.classList.add("active");
                const tab = (btn as HTMLElement).dataset.tab;
                document.getElementById(`panel-${tab}`)?.classList.add("active");
                if (tab === "active") loadActive();
                if (tab === "cod") loadCod();
                if (tab === "stuck") loadStuck();
            });
        });

        // ── Pendientes ────────────────────────────────────────────
        async function loadPending() {
            const body = document.getElementById("pendingBody")!;
            body.innerHTML = `<tr><td colspan="7" class="empty">Cargando...</td></tr>`;
            try {
                const orders = await api("/orders-pending");
                document.getElementById("pendingSummary")!.innerHTML = `<strong>${orders.length}</strong> pedidos pendientes de despacho`;
                if (!orders.length) {
                    body.innerHTML = `<tr><td colspan="7" class="empty">No hay pedidos pendientes de despacho.</td></tr>`;
                    return;
                }
                body.innerHTML = orders.map((o: any) => {
                    const isCop = o.currency === "COP" || !o.currency;
                    return `
                    <tr>
                        <td><strong>${o.reference}</strong></td>
                        <td>${o.customer_name}</td>
                        <td>${o.shipping_city ?? "-"}</td>
                        <td>${o.payment_method === "cod" ? '<span class="badge badge-warn">Contraentrega</span>' : '<span class="badge badge-ok">Pagado</span>'}</td>
                        <td style="font-weight:600">${isCop ? fmtCOP(Number(o.total_cop) || 0) : `$${Number(o.total_cop || 0).toLocaleString("en-US")} ${o.currency}`}</td>
                        <td style="color:var(--muted);font-size:0.82rem">${fmtDate(o.created_at)}</td>
                        <td>${isCop
                            ? `<button class="btn-action" data-action="quote" data-id="${o.id}" data-ref="${o.reference}">Cotizar / Generar guía</button>`
                            : `<button class="btn-action" data-action="manual" data-id="${o.id}" data-ref="${o.reference}">Despacho manual</button>`}</td>
                    </tr>
                `;
                }).join("");
                body.querySelectorAll('[data-action="quote"]').forEach((btn) => {
                    btn.addEventListener("click", () => openQuoteModal(
                        Number((btn as HTMLElement).dataset.id),
                        (btn as HTMLElement).dataset.ref!,
                    ));
                });
                body.querySelectorAll('[data-action="manual"]').forEach((btn) => {
                    btn.addEventListener("click", () => openManualModal(
                        Number((btn as HTMLElement).dataset.id),
                        (btn as HTMLElement).dataset.ref!,
                    ));
                });
            } catch (err: any) {
                body.innerHTML = `<tr><td colspan="7" class="empty">Error al cargar: ${err.message}</td></tr>`;
            }
        }

        // ── Activos ───────────────────────────────────────────────

        function updateBatchButtons() {
            const pickupBtn = document.getElementById("btnInterPickup") as HTMLButtonElement;
            const manifestBtn = document.getElementById("btnInterManifest") as HTMLButtonElement;
            const boxes = [...document.querySelectorAll<HTMLInputElement>(".inter-select")];
            const checked = boxes.filter((b) => b.checked);
            const pickupCount = checked.filter((b) => b.dataset.status === "created").length;
            pickupBtn.disabled = pickupCount === 0;
            pickupBtn.textContent = pickupCount ? `Solicitar recogida (${pickupCount})` : "Solicitar recogida";
            manifestBtn.disabled = checked.length === 0;
            manifestBtn.textContent = checked.length ? `Planilla de despacho (${checked.length})` : "Planilla de despacho";
            const selectAll = document.getElementById("selectAllInter") as HTMLInputElement;
            selectAll.disabled = boxes.length === 0;
            selectAll.checked = boxes.length > 0 && checked.length === boxes.length;
        }

        function showActiveMsg(html: string, kind: "ok" | "warn" | "err" = "ok") {
            const cls = kind === "err" ? "alert-err" : "alert-warn";
            const style = kind === "ok" ? ' style="background:var(--c-success-bg);color:var(--ok);border:1px solid var(--c-success-border);"' : "";
            document.getElementById("activeMsg")!.innerHTML = html ? `<div class="alert-box ${cls}"${style}>${html}</div>` : "";
        }

        async function loadActive() {
            const body = document.getElementById("activeBody")!;
            body.innerHTML = `<tr><td colspan="7" class="empty">Cargando...</td></tr>`;
            try {
                const shipments = await api("/");
                document.getElementById("activeSummary")!.innerHTML = `<strong>${shipments.length}</strong> envíos`;
                if (!shipments.length) {
                    body.innerHTML = `<tr><td colspan="7" class="empty">No hay envíos registrados.</td></tr>`;
                    updateBatchButtons();
                    return;
                }
                body.innerHTML = shipments.map((s: any) => {
                    let pdfUrls: string[] = [];
                    try { pdfUrls = s.pdf_guide_urls ? JSON.parse(s.pdf_guide_urls) : []; } catch {}
                    const isInter = s.provider === "interrapidisimo";
                    const selectable = isInter && s.guide_number && (s.status === "created" || s.status === "pickup_requested");
                    const pdfCell = isInter && s.guide_number
                        ? `<span class="pdf-links">
                               <a href="/api/shipping/${s.id}/guide.pdf" target="_blank" rel="noopener">Media carta</a>
                               <a href="/api/shipping/${s.id}/guide.pdf?format=small" target="_blank" rel="noopener">Etiqueta</a>
                           </span>`
                        : (pdfUrls.length ? `<a href="${esc(pdfUrls[0])}" target="_blank" rel="noopener">Ver guía</a>` : "-");
                    const statusCell = s.status === "error" && s.error_detail
                        ? `<span title="${esc(s.error_detail)}">${badge(s.status)}</span>`
                        : badge(s.status);
                    const pickupNote = isInter && s.status === "created"
                        ? `<div style="font-size:0.75rem;color:var(--c-warning);margin-top:2px;">Sin recogida</div>` : "";
                    return `
                    <tr>
                        <td>${selectable
                            ? `<input type="checkbox" class="inter-select" data-id="${s.id}" data-status="${s.status}" aria-label="Seleccionar guía ${esc(s.guide_number)}" />`
                            : ""}</td>
                        <td><strong>${esc(s.reference)}</strong></td>
                        <td>${esc(s.delivery_company_name ?? "-")}</td>
                        <td>${esc(s.guide_number ?? "Pendiente")}</td>
                        <td>${statusCell}${pickupNote}</td>
                        <td>${pdfCell}</td>
                        <td>
                            <button class="btn-action" data-action="detail" data-id="${s.id}">Detalle</button>
                            ${s.delivery_company_id === 'manual'
                                ? (s.status !== 'delivered' && s.status !== 'returned' && s.status !== 'cancelled' ? `
                                    <button class="btn-action" data-action="mark" data-status="delivered" data-id="${s.id}">Marcar entregado</button>
                                    <button class="btn-action" data-action="mark" data-status="returned" data-id="${s.id}">Devuelto</button>
                                    <button class="btn-action" data-action="mark" data-status="cancelled" data-id="${s.id}">Cancelar</button>
                                ` : '')
                                : `
                                    <button class="btn-action" data-action="refresh" data-id="${s.id}">Refrescar</button>
                                    ${s.status !== 'cancelled' && s.status !== 'delivered' && s.status !== 'error' ? `<button class="btn-action" data-action="cancel" data-id="${s.id}">Cancelar</button>` : ''}
                                `}
                        </td>
                    </tr>
                `;
                }).join("");
                body.querySelectorAll<HTMLInputElement>(".inter-select").forEach((box) => {
                    box.addEventListener("change", updateBatchButtons);
                });
                body.querySelectorAll('[data-action="detail"]').forEach((btn) => {
                    btn.addEventListener("click", () => openDetailModal(Number((btn as HTMLElement).dataset.id)));
                });
                updateBatchButtons();
                body.querySelectorAll('[data-action="refresh"]').forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        const id = (btn as HTMLElement).dataset.id;
                        (btn as HTMLButtonElement).disabled = true;
                        try { await api(`/${id}/refresh`, { method: "POST" }); await loadActive(); }
                        catch (err: any) { alert(err.message); }
                    });
                });
                body.querySelectorAll('[data-action="cancel"]').forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        if (!confirm("¿Cancelar este envío?")) return;
                        const id = (btn as HTMLElement).dataset.id;
                        try {
                            const result = await api(`/${id}/cancel`, { method: "PUT" });
                            if (result?.warning) alert(result.warning);
                            await loadActive();
                        }
                        catch (err: any) { alert(err.message); }
                    });
                });
                body.querySelectorAll('[data-action="mark"]').forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        const id = (btn as HTMLElement).dataset.id;
                        const status = (btn as HTMLElement).dataset.status!;
                        const labels: Record<string, string> = { delivered: "marcar como entregado", returned: "marcar como devuelto", cancelled: "cancelar" };
                        if (!confirm(`¿Confirma ${labels[status]} este envío manual?`)) return;
                        try {
                            await api(`/${id}/status`, { method: "PATCH", body: JSON.stringify({ status }) });
                            await loadActive();
                        } catch (err: any) { alert(err.message); }
                    });
                });
            } catch (err: any) {
                body.innerHTML = `<tr><td colspan="7" class="empty">Error al cargar: ${esc(err.message)}</td></tr>`;
                updateBatchButtons();
            }
        }

        document.getElementById("selectAllInter")?.addEventListener("change", (e) => {
            const checked = (e.currentTarget as HTMLInputElement).checked;
            document.querySelectorAll<HTMLInputElement>(".inter-select").forEach((b) => { b.checked = checked; });
            updateBatchButtons();
        });

        const checkedInterIds = (onlyStatus?: string) =>
            [...document.querySelectorAll<HTMLInputElement>(".inter-select")]
                .filter((b) => b.checked && (!onlyStatus || b.dataset.status === onlyStatus))
                .map((b) => Number(b.dataset.id));

        document.getElementById("btnInterPickup")?.addEventListener("click", async (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const shipmentIds = checkedInterIds("created");
            if (!shipmentIds.length) return;
            if (!confirm(`¿Solicitar a Interrapidísimo una recogida para ${shipmentIds.length} guía(s)?`)) return;
            btn.disabled = true;
            btn.textContent = "Solicitando...";
            try {
                const r = await api("/inter/pickup", { method: "POST", body: JSON.stringify({ shipmentIds }) });
                const excluded = r.excluded?.length ? ` Inter no incluyó: ${esc(r.excluded.join(", "))}.` : "";
                showActiveMsg(`Recogida ${esc(r.pickupCode)} solicitada para ${r.included.length} guía(s).${excluded}`, excluded ? "warn" : "ok");
                await loadActive();
            } catch (err: any) {
                showActiveMsg(esc(err.message), "err");
                updateBatchButtons();
            }
        });

        document.getElementById("btnInterManifest")?.addEventListener("click", async (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const shipmentIds = checkedInterIds();
            if (!shipmentIds.length) return;
            btn.disabled = true;
            btn.textContent = "Generando...";
            try {
                const { blob, headers } = await fetchPdf("/inter/manifest", { method: "POST", body: JSON.stringify({ shipmentIds }) });
                const url = URL.createObjectURL(blob);
                window.open(url, "_blank", "noopener");
                setTimeout(() => URL.revokeObjectURL(url), 60_000);
                const rejected = headers.get("X-Rejected-Guides");
                showActiveMsg(rejected
                    ? `Planilla generada. Inter rechazó estas guías: ${esc(rejected)}.`
                    : "Planilla generada. Imprímala para que la firme el mensajero.", rejected ? "warn" : "ok");
            } catch (err: any) {
                showActiveMsg(esc(err.message), "err");
            } finally {
                updateBatchButtons();
            }
        });

        // ── Modal detalle ─────────────────────────────────────────
        async function openDetailModal(id: number) {
            const bodyEl = document.getElementById("modalDetailBody")!;
            bodyEl.innerHTML = "Cargando...";
            document.getElementById("modalDetailBack")!.classList.add("open");
            try {
                const { shipment: s, events, trackingUrl } = await api(`/${id}/detail`);
                document.getElementById("modalDetailTitle")!.textContent = `Envío ${s.reference}`;
                const quoted = s.quoted_shipping_cost_cop != null ? Number(s.quoted_shipping_cost_cop) : null;
                const actual = s.actual_shipping_cost_cop != null ? Number(s.actual_shipping_cost_cop) : null;
                let diff = "";
                if (quoted != null && actual != null && actual !== quoted) {
                    const d = actual - quoted;
                    diff = ` <span class="${d > 0 ? "cost-diff-up" : "cost-diff-down"}">(${d > 0 ? "+" : "−"}${fmtCOP(Math.abs(d))})</span>`;
                }
                const charged = s.shipping_cop != null ? fmtCOP(Number(s.shipping_cop)) : "-";
                bodyEl.innerHTML = `
                    ${s.status === "error" && s.error_detail ? `<div class="alert-box alert-err"><strong>Motivo del error:</strong> ${esc(s.error_detail)}</div>` : ""}
                    <dl class="detail-grid">
                        <div><dt>Estado</dt><dd>${badge(s.status)}</dd></div>
                        <div><dt>Proveedor</dt><dd>${esc(PROVIDER_LABELS[s.provider] ?? s.provider)}</dd></div>
                        <div><dt>Transportadora</dt><dd>${esc(s.delivery_company_name ?? "-")}</dd></div>
                        <div><dt>Guía</dt><dd>${esc(s.guide_number ?? "Pendiente")}${trackingUrl ? ` · <a href="${esc(trackingUrl)}" target="_blank" rel="noopener">Rastrear</a>` : ""}</dd></div>
                        <div><dt>Recogida</dt><dd>${esc(s.pickup_code ?? (s.requested_pickup ? "Sin confirmar" : "No solicitada"))}</dd></div>
                        <div><dt>Pago</dt><dd>${s.payment_mode === "cod" ? `Contraentrega · ${fmtCOP(Number(s.collection_value_cop) || 0)}` : "Prepagado"}</dd></div>
                        <div><dt>Flete cobrado al cliente</dt><dd>${charged}</dd></div>
                        <div><dt>Costo cotizado / real</dt><dd>${quoted != null ? fmtCOP(quoted) : "-"} / ${actual != null ? fmtCOP(actual) : "-"}${diff}</dd></div>
                        <div><dt>Paquete</dt><dd>${s.package_weight_kg ?? "-"} kg · ${s.package_length_cm ?? "-"}×${s.package_width_cm ?? "-"}×${s.package_height_cm ?? "-"} cm</dd></div>
                        <div><dt>Valor declarado</dt><dd>${s.declared_value_cop != null ? fmtCOP(Number(s.declared_value_cop)) : "-"}</dd></div>
                        <div><dt>Destinatario</dt><dd>${esc(s.customer_name)}<br>${esc(s.customer_phone ?? "")}</dd></div>
                        <div><dt>Dirección</dt><dd>${esc(s.shipping_address)}<br>${esc(s.shipping_city)}${s.shipping_department ? `, ${esc(s.shipping_department)}` : ""}</dd></div>
                        <div><dt>Creado</dt><dd>${fmtDate(s.created_at)}</dd></div>
                        <div><dt>Último seguimiento</dt><dd>${fmtDate(s.tracking_updated_at)}</dd></div>
                    </dl>
                    <h3 class="section-title">Historial</h3>
                    ${events.length
                        ? `<ol class="timeline">${events.map((ev: any) => `
                            <li><div>
                                <div class="tl-state">${esc(ev.update_state)}</div>
                                <div class="tl-meta">${fmtDate(ev.event_date || ev.created_at)}${ev.description ? ` · ${esc(ev.description)}` : ""}</div>
                            </div></li>`).join("")}</ol>`
                        : `<p class="empty" style="padding:1rem;">Aún no hay eventos de seguimiento. Use "Refrescar" para consultarlos.</p>`}
                `;
            } catch (err: any) {
                bodyEl.innerHTML = `<div class="alert-box alert-err">${esc(err.message)}</div>`;
            }
        }

        document.getElementById("modalDetailClose")?.addEventListener("click", () => {
            document.getElementById("modalDetailBack")!.classList.remove("open");
        });
        document.getElementById("modalDetailBack")?.addEventListener("click", (e) => {
            if (e.target === e.currentTarget) document.getElementById("modalDetailBack")!.classList.remove("open");
        });

        document.getElementById("btnRefreshAll")?.addEventListener("click", async (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            btn.disabled = true;
            btn.textContent = "Actualizando...";
            try { await api("/refresh-all", { method: "POST" }); await loadActive(); }
            catch (err: any) { alert(err.message); }
            finally { btn.disabled = false; btn.textContent = "Actualizar todos"; }
        });

        // ── COD ───────────────────────────────────────────────────
        async function loadCod() {
            const body = document.getElementById("codBody")!;
            body.innerHTML = `<tr><td colspan="5" class="empty">Cargando...</td></tr>`;
            try {
                const shipments = await api("/?codPending=1");
                document.getElementById("codSummary")!.innerHTML = `<strong>${shipments.length}</strong> recaudos pendientes de conciliar`;
                if (!shipments.length) {
                    body.innerHTML = `<tr><td colspan="5" class="empty">No hay recaudos pendientes.</td></tr>`;
                    return;
                }
                body.innerHTML = shipments.map((s: any) => `
                    <tr>
                        <td><strong>${s.reference}</strong></td>
                        <td>${s.customer_name}</td>
                        <td style="font-weight:600">${fmtCOP(Number(s.collection_value_cop) || 0)}</td>
                        <td>${fmtDate(s.tracking_updated_at)}</td>
                        <td><button class="btn-action" data-id="${s.id}">Marcar conciliado</button></td>
                    </tr>
                `).join("");
                body.querySelectorAll(".btn-action").forEach((btn) => {
                    btn.addEventListener("click", async () => {
                        const id = (btn as HTMLElement).dataset.id;
                        try { await api(`/${id}/reconcile`, { method: "PATCH" }); await loadCod(); }
                        catch (err: any) { alert(err.message); }
                    });
                });
            } catch (err: any) {
                body.innerHTML = `<tr><td colspan="5" class="empty">Error al cargar: ${err.message}</td></tr>`;
            }
        }

        // ── Estancados ────────────────────────────────────────────
        async function loadStuck() {
            const body = document.getElementById("stuckBody")!;
            body.innerHTML = `<tr><td colspan="6" class="empty">Cargando...</td></tr>`;
            try {
                const stuck = await api("/stuck");
                document.getElementById("stuckSummary")!.innerHTML = `<strong>${stuck.length}</strong> envíos exceden su SLA`;
                if (!stuck.length) {
                    body.innerHTML = `<tr><td colspan="6" class="empty">No hay envíos estancados. Todo dentro del SLA esperado.</td></tr>`;
                    return;
                }
                body.innerHTML = stuck.map((s: any) => `
                    <tr>
                        <td><strong>${s.reference}</strong></td>
                        <td>${s.customer_name}</td>
                        <td>${s.shipping_city ?? "-"}</td>
                        <td>${badge(s.status)}</td>
                        <td>${s.delivery_company_name ?? "-"}</td>
                        <td><span class="badge badge-err">${s.ageHours}h (SLA ${s.slaHours}h)</span></td>
                    </tr>
                `).join("");
            } catch (err: any) {
                body.innerHTML = `<tr><td colspan="6" class="empty">Error al cargar: ${err.message}</td></tr>`;
            }
        }

        // ── Modal despacho manual ─────────────────────────────────
        let manualOrderId: number | null = null;

        function openManualModal(orderId: number, ref: string) {
            manualOrderId = orderId;
            document.getElementById("modalManualTitle")!.textContent = `Despacho manual · ${ref}`;
            document.getElementById("modalManualAlert")!.innerHTML = "";
            document.getElementById("manualMsg")!.textContent = "";
            (document.getElementById("mCarrier") as HTMLInputElement).value = "";
            (document.getElementById("mGuide") as HTMLInputElement).value = "";
            (document.getElementById("mTrackingUrl") as HTMLInputElement).value = "";
            (document.getElementById("mComments") as HTMLInputElement).value = "";
            document.getElementById("modalManualBack")!.classList.add("open");
        }

        document.getElementById("btnManualDispatch")?.addEventListener("click", async () => {
            if (!manualOrderId) return;
            const btn = document.getElementById("btnManualDispatch") as HTMLButtonElement;
            const msg = document.getElementById("manualMsg")!;
            const carrierName = (document.getElementById("mCarrier") as HTMLInputElement).value.trim();
            const guideNumber = (document.getElementById("mGuide") as HTMLInputElement).value.trim();
            const trackingUrl = (document.getElementById("mTrackingUrl") as HTMLInputElement).value.trim();
            const comments = (document.getElementById("mComments") as HTMLInputElement).value.trim();

            if (!carrierName || !guideNumber) {
                msg.style.color = "var(--danger)";
                msg.textContent = "Transportador y número de guía son obligatorios.";
                return;
            }

            btn.disabled = true;
            btn.textContent = "Registrando...";
            msg.textContent = "";
            try {
                await api(`/${manualOrderId}/dispatch-manual`, {
                    method: "POST",
                    body: JSON.stringify({ carrierName, guideNumber, trackingUrl: trackingUrl || undefined, comments: comments || undefined }),
                });
                msg.style.color = "var(--ok)";
                msg.textContent = "Despacho registrado.";
                setTimeout(() => {
                    document.getElementById("modalManualBack")!.classList.remove("open");
                    loadPending();
                }, 1000);
            } catch (err: any) {
                msg.style.color = "var(--danger)";
                msg.textContent = `${err.message}`;
            } finally {
                btn.disabled = false;
                btn.textContent = "Registrar despacho";
            }
        });

        document.getElementById("modalManualClose")?.addEventListener("click", () => {
            document.getElementById("modalManualBack")!.classList.remove("open");
        });
        document.getElementById("modalManualBack")?.addEventListener("click", (e) => {
            if (e.target === e.currentTarget) document.getElementById("modalManualBack")!.classList.remove("open");
        });

        // ── Modal cotizar / crear ────────────────────────────────
        let currentOrderId: number | null = null;
        let selectedQuote: any = null;

        async function openQuoteModal(orderId: number, ref: string) {
            currentOrderId = orderId;
            selectedQuote = null;
            document.getElementById("modalTitle")!.textContent = `Cotizar envío · ${ref}`;
            document.getElementById("modalAlert")!.innerHTML = "";
            document.getElementById("quoteResults")!.innerHTML = "";
            document.getElementById("createMsg")!.textContent = "";
            (document.getElementById("btnCreateShipment") as HTMLButtonElement).disabled = true;
            document.getElementById("interDocRow")!.style.display = "none";
            (document.getElementById("fDocNumber") as HTMLInputElement).value = "";
            (document.getElementById("fDocType") as HTMLSelectElement).value = "CC";

            try {
                const suggestion = await api(`/${orderId}/suggest`);
                (document.getElementById("fWeight") as HTMLInputElement).value = String(suggestion.weightKg || 0.5);
                (document.getElementById("fDeclaredValue") as HTMLInputElement).value = String(suggestion.declaredValueCop || 0);
                // Documento capturado en el checkout (pedidos anteriores no lo tienen).
                if (suggestion.order.customer_document_number) {
                    (document.getElementById("fDocType") as HTMLSelectElement).value = suggestion.order.customer_document_type || "CC";
                    (document.getElementById("fDocNumber") as HTMLInputElement).value = suggestion.order.customer_document_number;
                }

                const alertBox = document.getElementById("modalAlert")!;
                if (suggestion.missingWeights?.length) {
                    alertBox.innerHTML += `<div class="alert-box alert-warn">Productos sin peso registrado: ${suggestion.missingWeights.join(", ")}. Verifique el peso antes de cotizar.</div>`;
                }

                const daneSelect = document.getElementById("fDane") as HTMLSelectElement;
                daneSelect.innerHTML = "";
                if (suggestion.dane?.code) {
                    daneSelect.innerHTML = `<option value="${suggestion.dane.code}">${suggestion.order.shipping_city} (${suggestion.dane.code})</option>`;
                } else if (suggestion.dane?.candidates?.length) {
                    daneSelect.innerHTML = suggestion.dane.candidates.map((c: any) =>
                        `<option value="${c.location_code}">${c.location_name} - ${c.department_name} (${c.location_code})</option>`
                    ).join("");
                    alertBox.innerHTML += `<div class="alert-box alert-warn">Ciudad ambigua: seleccione la correcta antes de cotizar.</div>`;
                } else {
                    daneSelect.innerHTML = `<option value="">No se encontró código DANE. Ingréselo manualmente</option>`;
                    alertBox.innerHTML += `<div class="alert-box alert-err">No se pudo resolver la ciudad automáticamente. Contacte soporte de Mipaquete o ingrese el código DANE manualmente en el selector.</div>`;
                }
            } catch (err: any) {
                document.getElementById("modalAlert")!.innerHTML = `<div class="alert-box alert-err">Error al calcular sugerencia: ${err.message}</div>`;
            }

            document.getElementById("modalBack")!.classList.add("open");
        }

        document.getElementById("btnQuote")?.addEventListener("click", async () => {
            if (!currentOrderId) return;
            const resultsEl = document.getElementById("quoteResults")!;
            resultsEl.innerHTML = "Cotizando...";
            (document.getElementById("btnCreateShipment") as HTMLButtonElement).disabled = true;
            document.getElementById("interDocRow")!.style.display = "none";
            selectedQuote = null;

            try {
                const weightKg = Number((document.getElementById("fWeight") as HTMLInputElement).value);
                const width = Number((document.getElementById("fWidth") as HTMLInputElement).value);
                const length = Number((document.getElementById("fLength") as HTMLInputElement).value);
                const height = Number((document.getElementById("fHeight") as HTMLInputElement).value);
                const destinyDaneCode = (document.getElementById("fDane") as HTMLSelectElement).value;
                const declaredValueCop = Number((document.getElementById("fDeclaredValue") as HTMLInputElement).value);

                // paymentMode se determina en el backend según customer_orders.payment_method,
                // pero para la cotización comparativa asumimos prepago salvo indicación explícita.
                const paymentMode = "prepaid";

                const quotes = await api("/quote", {
                    method: "POST",
                    body: JSON.stringify({ orderId: currentOrderId, weightKg, width, length, height, destinyDaneCode, declaredValueCop, paymentMode }),
                });

                if (!quotes.length) {
                    resultsEl.innerHTML = `<div class="alert-box alert-warn">Sin cobertura de transportadoras para este destino.</div>`;
                    return;
                }

                resultsEl.innerHTML = `
                    <table class="quote-table">
                        <thead><tr><th>Transportadora</th><th>Costo</th><th>Tiempo entrega</th><th>Score</th></tr></thead>
                        <tbody>
                            ${quotes.map((q: any, i: number) => `
                                <tr class="quote-row" data-idx="${i}">
                                    <td>${q.deliveryCompanyName} <span class="badge ${q.provider === "interrapidisimo" ? "badge-warn" : "badge-default"}">${q.provider === "interrapidisimo" ? "API directa" : "Mipaquete"}</span></td>
                                    <td>${fmtCOP(q.shippingCost)}</td>
                                    <td>${Math.round(q.shippingTime / 60)} h</td>
                                    <td>${q.score ?? "-"}</td>
                                </tr>
                            `).join("")}
                        </tbody>
                    </table>
                `;

                resultsEl.querySelectorAll(".quote-row").forEach((row) => {
                    row.addEventListener("click", () => {
                        resultsEl.querySelectorAll(".quote-row").forEach((r) => r.classList.remove("selected"));
                        row.classList.add("selected");
                        selectedQuote = quotes[Number((row as HTMLElement).dataset.idx)];
                        document.getElementById("interDocRow")!.style.display =
                            selectedQuote.provider === "interrapidisimo" ? "" : "none";
                        (document.getElementById("btnCreateShipment") as HTMLButtonElement).disabled = false;
                    });
                });
            } catch (err: any) {
                resultsEl.innerHTML = `<div class="alert-box alert-err">${err.message}</div>`;
            }
        });

        document.getElementById("btnCreateShipment")?.addEventListener("click", async () => {
            if (!currentOrderId || !selectedQuote) return;
            const btn = document.getElementById("btnCreateShipment") as HTMLButtonElement;
            const msg = document.getElementById("createMsg")!;
            btn.disabled = true;
            btn.textContent = "Generando...";
            msg.textContent = "";

            try {
                const weightKg = Number((document.getElementById("fWeight") as HTMLInputElement).value);
                const width = Number((document.getElementById("fWidth") as HTMLInputElement).value);
                const length = Number((document.getElementById("fLength") as HTMLInputElement).value);
                const height = Number((document.getElementById("fHeight") as HTMLInputElement).value);
                const destinyDaneCode = (document.getElementById("fDane") as HTMLSelectElement).value;
                const declaredValueCop = Number((document.getElementById("fDeclaredValue") as HTMLInputElement).value);
                const requestPickup = (document.getElementById("fPickup") as HTMLSelectElement).value === "true";
                const comments = (document.getElementById("fComments") as HTMLInputElement).value.trim();
                const paymentMode = "prepaid";
                const isInter = selectedQuote.provider === "interrapidisimo";
                const receiverDocumentType = (document.getElementById("fDocType") as HTMLSelectElement).value;
                const receiverDocumentNumber = (document.getElementById("fDocNumber") as HTMLInputElement).value.trim();
                if (isInter && !receiverDocumentNumber) {
                    msg.style.color = "var(--danger)";
                    msg.textContent = "Ingrese el número de documento del destinatario.";
                    return;
                }

                const result = await api("/create", {
                    method: "POST",
                    body: JSON.stringify({
                        orderId: currentOrderId, weightKg, width, length, height, destinyDaneCode,
                        declaredValueCop, paymentMode, deliveryCompanyId: selectedQuote.deliveryCompanyId,
                        deliveryCompanyName: selectedQuote.deliveryCompanyName,
                        requestPickup, comments,
                        ...(isInter ? { receiverDocumentType, receiverDocumentNumber } : {}),
                    }),
                });

                msg.style.color = "var(--ok)";
                msg.textContent = result.mpCode
                    ? `Envío generado (mpCode ${result.mpCode}).`
                    : `Guía ${result.guideNumber} generada${requestPickup && !result.pickupRequested ? ". La recogida no se pudo programar: solicítela en el portal de Interrapidísimo" : ""}.`;
                setTimeout(() => {
                    document.getElementById("modalBack")!.classList.remove("open");
                    loadPending();
                }, 1200);
            } catch (err: any) {
                msg.style.color = "var(--danger)";
                msg.textContent = `${err.message}`;
            } finally {
                btn.disabled = false;
                btn.textContent = "Generar guía";
            }
        });

        document.getElementById("modalClose")?.addEventListener("click", () => {
            document.getElementById("modalBack")!.classList.remove("open");
        });
        document.getElementById("modalBack")?.addEventListener("click", (e) => {
            if (e.target === e.currentTarget) document.getElementById("modalBack")!.classList.remove("open");
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                document.getElementById("modalBack")!.classList.remove("open");
                document.getElementById("modalManualBack")!.classList.remove("open");
                document.getElementById("modalDetailBack")!.classList.remove("open");
            }
        });

        // ── Init ──────────────────────────────────────────────────
        loadPending();
        loadProviderStatus();
    </script>
</AdminLayout>
