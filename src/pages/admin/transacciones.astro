---
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";

const url = Astro.url;
const params = url.searchParams;

const dateFrom  = params.get("date_from")  ?? "";
const dateTo    = params.get("date_to")    ?? "";
const tipo      = params.get("tipo")       ?? "";
const estado    = params.get("estado")     ?? "";
const direccion = params.get("direccion")  ?? "";
const search    = params.get("search")     ?? "";
const page      = Math.max(1, parseInt(params.get("page") ?? "1", 10));
const limit     = 50;
const offset    = (page - 1) * limit;

let transactions = [];
let total = 0;
let totalIngresos = 0;
let totalEgresos = 0;
let balance = 0;
let fetchError: string | null = null;

const apiParams = new URLSearchParams();
if (dateFrom)  apiParams.set("date_from",  dateFrom);
if (dateTo)    apiParams.set("date_to",    dateTo);
if (tipo)      apiParams.set("tipo",       tipo);
if (estado)    apiParams.set("estado",     estado);
if (direccion) apiParams.set("direccion",  direccion);
if (search)    apiParams.set("search",     search);
apiParams.set("limit",  String(limit));
apiParams.set("offset", String(offset));

try {
  const resp = await fetch(`${url.origin}/api/finance/transactions?${apiParams}`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (resp.ok) {
    const json = await resp.json();
    if (json.success) {
      transactions  = json.data          ?? [];
      total         = json.total         ?? 0;
      totalIngresos = json.total_ingresos ?? 0;
      totalEgresos  = json.total_egresos  ?? 0;
      balance       = json.balance        ?? 0;
    } else {
      fetchError = json.error;
    }
  } else {
    fetchError = resp.status === 401 ? null : `Error del servidor (${resp.status})`;
  }
} catch (e) {
  fetchError = "No se pudo conectar con la base de datos";
}

const totalPages = Math.ceil(total / limit);

function fmtCOP(val: number | string) {
  return new Intl.NumberFormat("es-CO", {
    style: "currency", currency: "COP", maximumFractionDigits: 0
  }).format(Number(val ?? 0));
}

function fmtDate(d: string) {
  if (!d) return "-";
  return new Date(d + "T00:00:00").toLocaleDateString("es-CO", {
    day: "2-digit", month: "short", year: "numeric"
  });
}

const TIPO_LABEL: Record<string, string> = {
  factura_venta:  "Factura de venta",
  factura_compra: "Factura de compra",
  gasto:          "Gasto",
  pago:           "Pago",
};

// Estado -> [etiqueta, modificador de .status]
const ESTADO_META: Record<string, [string, string]> = {
  borrador:       ["Borrador", ""],
  confirmada:     ["Confirmada", "status--confirmed"],
  confirmado:     ["Confirmado", "status--confirmed"],
  pagada_parcial: ["Pago parcial", "status--pending"],
  pagada:         ["Pagada", "status--paid"],
  pagado:         ["Pagado", "status--paid"],
  aprobado:       ["Aprobado", "status--paid"],
  conciliado:     ["Conciliado", "status--paid"],
  cancelada:      ["Cancelada", "status--cancelled"],
  cancelado:      ["Cancelado", "status--cancelled"],
  rechazado:      ["Rechazado", "status--cancelled"],
};

const tipoLabel = (t: string) => TIPO_LABEL[t] ?? t;
const estadoMeta = (s: string) => ESTADO_META[s] ?? [s, ""];
const generatedAt = new Date().toLocaleDateString("es-CO", { day: "numeric", month: "long", year: "numeric", timeZone: "America/Bogota" });

function pageUrl(p: number) {
  const q = new URLSearchParams(apiParams);
  q.set("page", String(p));
  q.delete("limit");
  q.delete("offset");
  return `/admin/transacciones?${q}`;
}
---

<AdminLayout title="Libro de transacciones · DobleYo Admin" section="finanzas">
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">Finanzas · Transacciones</div>
        <h1 class="page-title">Libro de transacciones</h1>
        <p class="page-subtitle">Facturas de venta y de compra, gastos y pagos en un solo registro.</p>
      </div>
      <div class="page-header-actions">
        <a href="/admin/finanzas" class="btn btn-secondary">Finanzas</a>
        <button id="exportBtn" class="btn btn-primary" type="button" disabled={transactions.length === 0}>Exportar CSV</button>
      </div>
    </div>
  </div>

  <div class="erp-body tx">
    {fetchError && (
      <div class="alert alert--error" role="alert">
        <strong>No se pudo cargar el libro.</strong> {fetchError}
      </div>
    )}

    <div class="kpi-grid">
      <div class="kpi-tile">
        <div class="kpi-label">Ingresos</div>
        <div class="kpi-value tx-in">{fmtCOP(totalIngresos)}</div>
        <div class="kpi-sub">Facturas de venta y pagos recibidos</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Egresos</div>
        <div class="kpi-value tx-out">{fmtCOP(totalEgresos)}</div>
        <div class="kpi-sub">Compras, gastos y pagos realizados</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Balance neto</div>
        <div class={`kpi-value ${balance < 0 ? "tx-out" : ""}`}>{fmtCOP(balance)}</div>
        <div class="kpi-sub">Con los filtros actuales</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Movimientos</div>
        <div class="kpi-value">{total.toLocaleString("es-CO")}</div>
        <div class="kpi-sub">Página {page} de {Math.max(1, totalPages)}</div>
      </div>
    </div>

    <form method="get" action="/admin/transacciones" class="filter-bar" role="search" aria-label="Filtrar transacciones">
      <label class="ff ff--grow">
        <span>Buscar</span>
        <input name="search" type="search" class="tx-input" value={search} placeholder="N.º de documento, nombre o descripción" />
      </label>
      <label class="ff">
        <span>Desde</span>
        <input name="date_from" type="date" class="tx-input" value={dateFrom} />
      </label>
      <label class="ff">
        <span>Hasta</span>
        <input name="date_to" type="date" class="tx-input" value={dateTo} />
      </label>
      <label class="ff">
        <span>Tipo</span>
        <select name="tipo" class="tx-input">
          <option value="">Todos</option>
          <option value="factura_venta"  selected={tipo === "factura_venta"}>Facturas de venta</option>
          <option value="factura_compra" selected={tipo === "factura_compra"}>Facturas de compra</option>
          <option value="gasto"          selected={tipo === "gasto"}>Gastos</option>
          <option value="pago"           selected={tipo === "pago"}>Pagos</option>
        </select>
      </label>
      <label class="ff">
        <span>Dirección</span>
        <select name="direccion" class="tx-input">
          <option value="">Todas</option>
          <option value="ingreso" selected={direccion === "ingreso"}>Ingresos</option>
          <option value="egreso"  selected={direccion === "egreso"}>Egresos</option>
        </select>
      </label>
      <label class="ff">
        <span>Estado</span>
        <select name="estado" class="tx-input">
          <option value="">Todos</option>
          <option value="borrador"       selected={estado === "borrador"}>Borrador</option>
          <option value="confirmada"     selected={estado === "confirmada"}>Confirmada</option>
          <option value="confirmado"     selected={estado === "confirmado"}>Confirmado</option>
          <option value="pagada_parcial" selected={estado === "pagada_parcial"}>Pago parcial</option>
          <option value="pagada"         selected={estado === "pagada"}>Pagada</option>
          <option value="pagado"         selected={estado === "pagado"}>Pagado</option>
          <option value="aprobado"       selected={estado === "aprobado"}>Aprobado</option>
          <option value="cancelada"      selected={estado === "cancelada"}>Cancelada</option>
          <option value="rechazado"      selected={estado === "rechazado"}>Rechazado</option>
          <option value="conciliado"     selected={estado === "conciliado"}>Conciliado</option>
        </select>
      </label>
      <div class="filter-bar-actions">
        <a href="/admin/transacciones" class="btn btn-sm btn-secondary">Limpiar</a>
        <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
      </div>
    </form>

    <section class="panel" aria-labelledby="txTitle">
      <div class="panel-header">
        <h2 id="txTitle" class="panel-title">Movimientos</h2>
        <span class="card-subtitle mono">{total.toLocaleString("es-CO")} registros</span>
      </div>
      {transactions.length === 0 && !fetchError ? (
        <p class="empty-state">No hay transacciones con estos filtros.</p>
      ) : (
        <div class="table-wrapper">
          <table class="erp-table tx-table" id="txTable">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Documento</th>
                <th>Tipo</th>
                <th>Contraparte o categoría</th>
                <th>Descripción</th>
                <th class="num">Monto (COP)</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {transactions.map((tx) => {
                const [estadoLabel, estadoCls] = estadoMeta(tx.estado);
                const isIngreso = tx.direccion === "ingreso";
                return (
                  <tr>
                    <td class="mono tx-nowrap">{fmtDate(tx.fecha)}</td>
                    <td class="mono tx-nowrap">{tx.numero}</td>
                    <td class="tx-nowrap">{tipoLabel(tx.tipo)}</td>
                    <td class="tx-clip" title={tx.contraparte || ""}>{tx.contraparte || "-"}</td>
                    <td class="tx-clip tx-muted" title={tx.descripcion || ""}>{tx.descripcion || "-"}</td>
                    <td class={`num mono ${isIngreso ? "tx-in" : "tx-out"}`}>
                      {isIngreso ? "+" : "−"}{fmtCOP(tx.monto)}
                    </td>
                    <td><span class={`status ${estadoCls}`}>{estadoLabel}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )}
      {totalPages > 1 && (
        <nav class="tx-pager" aria-label="Paginación">
          <span class="mono">Página {page} de {totalPages}</span>
          <div class="tx-pager-btns">
            {page > 1 ? <a href={pageUrl(page - 1)} class="btn btn-sm btn-secondary">Anterior</a> : <span class="btn btn-sm btn-secondary" aria-disabled="true">Anterior</span>}
            {page < totalPages ? <a href={pageUrl(page + 1)} class="btn btn-sm btn-secondary">Siguiente</a> : <span class="btn btn-sm btn-secondary" aria-disabled="true">Siguiente</span>}
          </div>
        </nav>
      )}
    </section>

    <p class="tx-legal">
      Este libro reúne todas las transacciones financieras del sistema. Consulta generada el {generatedAt}.
      Conserve copias para efectos fiscales y contables según la normativa de la DIAN.
    </p>
  </div>
</AdminLayout>

<script>
  // Exportar tabla visible a CSV
  document.getElementById("exportBtn")?.addEventListener("click", () => {
    const table = document.getElementById("txTable");
    if (!table) return;

    const rows: string[][] = [];
    const headers = Array.from(table.querySelectorAll("thead th"))
      .map(th => `"${(th as HTMLElement).innerText.trim()}"`);
    rows.push(headers);

    table.querySelectorAll("tbody tr").forEach(tr => {
      const cells = Array.from(tr.querySelectorAll("td"))
        .map(td => `"${(td as HTMLElement).innerText.trim().replace(/"/g, '""')}"`);
      rows.push(cells);
    });

    const csv = rows.map(r => r.join(",")).join("\n");
    const bom = "﻿"; // BOM UTF-8 para Excel en español
    const blob = new Blob([bom + csv], { type: "text/csv;charset=utf-8;" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    const now = new Date().toISOString().slice(0, 10);
    link.download = `transacciones_dobleyo_${now}.csv`;
    link.click();
  });
</script>

<style>
  .tx { display: flex; flex-direction: column; gap: 16px; }
  .tx-in  { color: var(--ok); }
  .tx-out { color: var(--danger); }
  .tx-nowrap { white-space: nowrap; }
  .tx-muted { color: var(--muted); }
  .tx-clip { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tx-table { min-width: 860px; }
  .tx-pager {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 10px 16px; border-top: 1px solid var(--rule);
    font-size: 12px; color: var(--muted);
  }
  .tx-pager-btns { display: flex; gap: 6px; }
  .tx-pager [aria-disabled="true"] { opacity: .45; pointer-events: none; }
  .tx-legal { margin: 0; font-size: 12px; color: var(--muted); line-height: 1.5; }
</style>
