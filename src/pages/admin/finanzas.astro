---
export const prerender = false;

// Panel de Finanzas - Vista de Administrador
// Dashboard financiero: KPIs, facturas, gastos, pagos a caficultores
import AdminLayout from "../../layouts/AdminLayout.astro";

// Fetch del dashboard financiero
let dashboard = {
  month_revenue: 0, month_costs: 0, month_expenses: 0, month_balance: 0,
  pending_payables: 0, pending_invoices_count: 0,
  recent_invoices: [], recent_expenses: [],
};
let fetchError = null;

try {
  const resp = await fetch(`${Astro.url.origin}/api/finance/dashboard`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (resp.ok) {
    const json = await resp.json();
    if (json.success) dashboard = json.data;
    else fetchError = json.error;
  } else {
    fetchError = resp.status === 401 ? null : `Error del servidor (${resp.status})`;
  }
} catch (e) {
  fetchError = "No se pudo conectar con la base de datos";
}

// Helpers
function fmtCOP(val) {
  return new Intl.NumberFormat("es-CO", { style: "currency", currency: "COP", maximumFractionDigits: 0 }).format(Number(val ?? 0));
}
function fmtDate(d) {
  if (!d) return "-";
  return new Date(d).toLocaleDateString("es-CO", { day: "2-digit", month: "short", year: "numeric" });
}
function stateBadge(state) {
  const map = {
    borrador:       ["Borrador", ""],
    confirmada:     ["Confirmada", "status--confirmed"],
    pagada_parcial: ["Pago parcial", "status--pending"],
    pagada:         ["Pagada", "status--paid"],
    cancelada:      ["Cancelada", "status--cancelled"],
    aprobado:       ["Aprobado", "status--paid"],
    pagado:         ["Pagado", "status--paid"],
    rechazado:      ["Rechazado", "status--cancelled"],
  };
  const [text, cls] = map[state] ?? [state, ""];
  return { text, cls };
}
const balancePositive = dashboard.month_balance >= 0;
---

<AdminLayout title="Finanzas · DobleYo Admin" section="finanzas">
  <div class="page-header">
    <div class="page-header-top">
      <div>
        <div class="page-breadcrumb">Finanzas</div>
        <h1 class="page-title">Finanzas</h1>
        <p class="page-subtitle">Ingresos, costos, gastos y cuentas por pagar del mes en curso.</p>
      </div>
      <div class="page-header-actions">
        <a href="/admin/transacciones" class="btn btn-secondary">Libro de transacciones</a>
        <button class="btn btn-secondary" id="btnNewExpense2" type="button">Registrar gasto</button>
        <button class="btn btn-secondary" id="btnNewPurchaseInvoice2" type="button">Factura de compra</button>
        <button class="btn btn-primary" id="btnNewSalesInvoice2" type="button">Factura de venta</button>
      </div>
    </div>
  </div>

  <div class="erp-body">
  <section class="adm-fin">

    {fetchError && (
      <div class="alert alert--error" role="alert">
        <strong>No se pudo cargar el resumen.</strong> {fetchError}
      </div>
    )}

    <div class="kpi-grid">
      <div class="kpi-tile">
        <div class="kpi-label">Ingresos del mes</div>
        <div class="kpi-value">{fmtCOP(dashboard.month_revenue)}</div>
        <div class="kpi-sub">Ventas facturadas</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Costos del mes</div>
        <div class="kpi-value">{fmtCOP(dashboard.month_costs)}</div>
        <div class="kpi-sub">Costo de producción</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Gastos del mes</div>
        <div class="kpi-value">{fmtCOP(dashboard.month_expenses)}</div>
        <div class="kpi-sub">Operación y administración</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Balance del mes</div>
        <div class={`kpi-value ${balancePositive ? "" : "adm-neg"}`}>{fmtCOP(dashboard.month_balance)}</div>
        <div class="kpi-sub">Ingresos menos costos y gastos</div>
      </div>
      <div class="kpi-tile">
        <div class="kpi-label">Por pagar</div>
        <div class="kpi-value">{fmtCOP(dashboard.pending_payables)}</div>
        <div class="kpi-sub">{dashboard.pending_invoices_count} factura(s) de compra abiertas</div>
      </div>
    </div>

    <!-- Navegación por pestañas (JS) -->
    <div class="adm-tabs" id="tabNav">
      <button class="adm-tab adm-tab--active" data-tab="overview">Resumen</button>
      <button class="adm-tab" data-tab="purchase-invoices">Facturas de compra</button>
      <button class="adm-tab" data-tab="sales-invoices">Facturas de venta</button>
      <button class="adm-tab" data-tab="expenses">Gastos</button>
      <button class="adm-tab" data-tab="payments">Pagos</button>
    </div>

    <!-- Panel: Resumen -->
    <div class="adm-panel" id="panel-overview">
      <div class="adm-panel-grid">
        <!-- Últimas facturas de venta -->
        <div class="adm-table-card">
          <h2 class="adm-table-card__title">Últimas facturas de venta</h2>
          {dashboard.recent_invoices.length === 0
            ? <p class="adm-empty">Sin facturas recientes</p>
            : (
              <div class="adm-table-wrap">
              <table class="erp-table adm-table">
                <thead>
                  <tr>
                    <th>Número</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {dashboard.recent_invoices.map((inv) => {
                    const b = stateBadge(inv.state);
                    return (
                      <tr>
                        <td class="mono">{inv.invoice_number}</td>
                        <td>{inv.customer_name}</td>
                        <td>{fmtDate(inv.invoice_date)}</td>
                        <td class="num mono">{fmtCOP(inv.total_amount)}</td>
                        <td>
                          <span class={`status ${b.cls}`}>{b.text}</span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              </div>
            )
          }
          <a href="#" class="adm-link" data-switch-tab="sales-invoices">Ver todas →</a>
        </div>

        <!-- Últimos gastos -->
        <div class="adm-table-card">
          <h2 class="adm-table-card__title">Últimos gastos</h2>
          {dashboard.recent_expenses.length === 0
            ? <p class="adm-empty">Sin gastos recientes</p>
            : (
              <div class="adm-table-wrap">
              <table class="erp-table adm-table">
                <thead>
                  <tr>
                    <th>N°</th>
                    <th>Descripción</th>
                    <th>Categoría</th>
                    <th>Monto</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {dashboard.recent_expenses.map((exp) => {
                    const b = stateBadge(exp.state);
                    return (
                      <tr>
                        <td class="mono">{exp.expense_number}</td>
                        <td>{exp.description}</td>
                        <td class="adm-table__cat">{exp.category}</td>
                        <td class="num mono">{fmtCOP(exp.amount)}</td>
                        <td>
                          <span class={`status ${b.cls}`}>{b.text}</span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
              </div>
            )
          }
          <a href="#" class="adm-link" data-switch-tab="expenses">Ver todos →</a>
        </div>
      </div>
    </div>

    <!-- Panel: Facturas de compra (cargadas por JS) -->
    <div class="adm-panel adm-panel--hidden" id="panel-purchase-invoices">
      <div class="adm-panel-actions">
        <button class="btn btn-primary" id="btnNewPurchaseInvoice">+ Nueva factura de compra</button>
      </div>
      <div id="purchaseInvoicesTable">
        <div class="adm-loading">Cargando facturas de compra…</div>
      </div>
    </div>

    <!-- Panel: Facturas de venta (cargadas por JS) -->
    <div class="adm-panel adm-panel--hidden" id="panel-sales-invoices">
      <div class="adm-panel-actions">
        <button class="btn btn-primary" id="btnNewSalesInvoice">+ Nueva factura de venta</button>
      </div>
      <div id="salesInvoicesTable">
        <div class="adm-loading">Cargando facturas de venta…</div>
      </div>
    </div>

    <!-- Panel: Gastos (cargados por JS) -->
    <div class="adm-panel adm-panel--hidden" id="panel-expenses">
      <div class="adm-panel-actions">
        <button class="btn btn-primary" id="btnNewExpense">+ Registrar gasto</button>
      </div>
      <div id="expensesTable">
        <div class="adm-loading">Cargando gastos…</div>
      </div>
    </div>

    <!-- Panel: Pagos (cargados por JS) -->
    <div class="adm-panel adm-panel--hidden" id="panel-payments">
      <div class="adm-panel-actions">
        <button class="btn btn-primary" id="btnNewPayment">+ Registrar pago</button>
      </div>
      <div id="paymentsTable">
        <div class="adm-loading">Cargando pagos…</div>
      </div>
    </div>

    <!-- Modal: Nuevo Gasto -->
    <dialog id="modalExpense" class="adm-modal">
      <form id="formExpense" class="adm-modal__form">
        <h2 class="adm-modal__title">Registrar Gasto</h2>
        <div class="adm-form-grid">
          <label class="adm-field">
            <span>Fecha *</span>
            <input type="date" name="expense_date" required />
          </label>
          <label class="adm-field">
            <span>Categoría *</span>
            <select name="category" required>
              <option value="">Seleccione...</option>
              <option value="operativo">Operativo</option>
              <option value="administrativo">Administrativo</option>
              <option value="venta">Venta</option>
              <option value="financiero">Financiero</option>
              <option value="otro">Otro</option>
            </select>
          </label>
          <label class="adm-field adm-field--full">
            <span>Descripción *</span>
            <input type="text" name="description" required maxlength="255" />
          </label>
          <label class="adm-field">
            <span>Monto (COP) *</span>
            <input type="number" name="amount" min="1" step="1" required />
          </label>
          <label class="adm-field">
            <span>N° Recibo / Factura</span>
            <input type="text" name="receipt_number" maxlength="100" />
          </label>
          <label class="adm-field adm-field--full">
            <span>Notas</span>
            <textarea name="notes" rows="2"></textarea>
          </label>
        </div>
        <div class="adm-modal__actions">
          <button type="button" class="btn btn-secondary" id="closeModalExpense">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar gasto</button>
        </div>
        <p class="adm-modal__msg" id="expenseMsg"></p>
      </form>
    </dialog>

    <!-- Modal: Nueva Factura de Venta -->
    <dialog id="modalSalesInvoice" class="adm-modal adm-modal--wide">
      <form id="formSalesInvoice" class="adm-modal__form">
        <h2 class="adm-modal__title">Nueva Factura de Venta</h2>
        <div class="adm-form-grid">
          <label class="adm-field">
            <span>Cliente *</span>
            <select name="customer_id" id="selectClient" required>
              <option value="">Seleccione un cliente</option>
            </select>
          </label>
          <label class="adm-field">
            <span>Fecha factura *</span>
            <input type="date" name="invoice_date" required />
          </label>
          <label class="adm-field">
            <span>Fecha vencimiento *</span>
            <input type="date" name="due_date" required />
          </label>
          <label class="adm-field">
            <span>Costo de envío (COP)</span>
            <input type="number" name="shipping_cost" min="0" step="1" value="0" />
          </label>
          <label class="adm-field adm-field--full">
            <span>Notas</span>
            <textarea name="notes" rows="2"></textarea>
          </label>
        </div>

        <h3 class="adm-lines__title">Líneas de la factura</h3>
        <div class="adm-lines-header">
          <span>Descripción</span><span>Cant.</span><span>Precio unit.</span><span>Desc. %</span><span>IVA %</span><span>Total línea</span><span></span>
        </div>
        <div id="salesLines">
          <div class="adm-line-row adm-line-row--sale">
            <input type="text" name="sl[0][description]" placeholder="Descripción del producto" required />
            <input type="number" name="sl[0][quantity]" placeholder="1" min="0.01" step="0.01" required class="adm-line-calc" />
            <input type="number" name="sl[0][unit_price]" placeholder="0" min="0" step="1" required class="adm-line-calc" />
            <input type="number" name="sl[0][discount_percent]" placeholder="0" min="0" max="100" step="0.1" value="0" class="adm-line-calc" />
            <input type="number" name="sl[0][tax_rate]" placeholder="19" min="0" max="100" step="0.1" value="19" class="adm-line-calc" />
            <span class="adm-line-total">$ 0</span>
            <span class="adm-line-remove" data-action="remove-sale-line">✕</span>
          </div>
        </div>
        <div class="adm-lines-footer">
          <button type="button" class="btn btn-secondary adm-btn--sm" id="addSaleLine">+ Agregar línea</button>
          <div class="adm-total-box">
            <span>Subtotal: <strong id="saleSub">$ 0</strong></span>
            <span>IVA: <strong id="saleTax">$ 0</strong></span>
            <span>Envío: <strong id="saleShip">$ 0</strong></span>
            <span class="adm-total-box__grand">TOTAL: <strong id="saleTotal">$ 0</strong></span>
          </div>
        </div>

        <div class="adm-modal__actions">
          <button type="button" class="btn btn-secondary" id="closeModalSalesInvoice">Cancelar</button>
          <button type="submit" class="btn btn-primary">Crear factura</button>
        </div>
        <p class="adm-modal__msg" id="salesInvoiceMsg"></p>
      </form>
    </dialog>

    <!-- Modal: Registrar Pago -->
    <dialog id="modalPayment" class="adm-modal adm-modal--wide">
      <form id="formPayment" class="adm-modal__form">
        <h2 class="adm-modal__title">Registrar Pago</h2>
        <div class="adm-form-grid">
          <label class="adm-field">
            <span>Tipo *</span>
            <select name="payment_type" required>
              <option value="recibido">Cobro recibido (de cliente)</option>
              <option value="realizado">Pago realizado (a proveedor o caficultor)</option>
            </select>
          </label>
          <label class="adm-field">
            <span>Fecha *</span>
            <input type="date" name="payment_date" required />
          </label>
          <label class="adm-field adm-field--full">
            <span>Socio (cliente / proveedor) *</span>
            <select name="partner_id" id="selectPartner" required>
              <option value="">Seleccione una persona</option>
            </select>
          </label>
          <label class="adm-field">
            <span>Monto (COP) *</span>
            <input type="number" name="amount" min="1" step="1" required />
          </label>
          <label class="adm-field">
            <span>Método de pago *</span>
            <select name="payment_method_id" id="selectPaymentMethod" required>
              <option value="">Seleccione un método</option>
            </select>
          </label>
          <label class="adm-field">
            <span>Referencia (N° transacción / cheque)</span>
            <input type="text" name="reference" maxlength="100" placeholder="Opcional" />
          </label>
          <label class="adm-field adm-field--full">
            <span>Notas</span>
            <textarea name="notes" rows="2"></textarea>
          </label>
        </div>
        <div class="adm-modal__actions">
          <button type="button" class="btn btn-secondary" id="closeModalPayment">Cancelar</button>
          <button type="submit" class="btn btn-primary">Registrar pago</button>
        </div>
        <p class="adm-modal__msg" id="paymentMsg"></p>
      </form>
    </dialog>

    <!-- Modal: Nueva Factura de Compra -->
    <dialog id="modalPurchaseInvoice" class="adm-modal adm-modal--wide">
      <form id="formPurchaseInvoice" class="adm-modal__form">
        <h2 class="adm-modal__title">Nueva Factura de Compra (Pago a Caficultor)</h2>
        <div class="adm-form-grid">
          <label class="adm-field">
            <span>Fecha factura *</span>
            <input type="date" name="invoice_date" required />
          </label>
          <label class="adm-field">
            <span>Fecha vencimiento *</span>
            <input type="date" name="due_date" required />
          </label>
          <label class="adm-field">
            <span>Caficultor</span>
            <select name="caficultor_id" id="selectCaficultor">
              <option value="">Seleccione un caficultor</option>
            </select>
          </label>
          <label class="adm-field">
            <span>N° Factura proveedor</span>
            <input type="text" name="supplier_invoice_number" maxlength="100" />
          </label>
          <label class="adm-field adm-field--full">
            <span>Notas</span>
            <textarea name="notes" rows="2"></textarea>
          </label>
        </div>

        <!-- Líneas -->
        <h3 class="adm-lines__title">Líneas de la factura</h3>
        <div id="purchaseLines">
          <div class="adm-line-row">
            <input type="text" name="lines[0][description]" placeholder="Descripción (ej: Café verde Huila)" required />
            <input type="text" name="lines[0][lot_reference]" placeholder="Referencia lote" />
            <input type="number" name="lines[0][quantity]" placeholder="Kg" min="0.01" step="0.01" required />
            <input type="number" name="lines[0][unit_price]" placeholder="$/kg" min="0" step="1" required />
            <span class="adm-line-remove" data-action="remove-purchase-line">✕</span>
          </div>
        </div>
        <button type="button" class="btn btn-secondary adm-btn--sm" id="addPurchaseLine">+ Agregar línea</button>

        <div class="adm-modal__actions">
          <button type="button" class="btn btn-secondary" id="closeModalPurchaseInvoice">Cancelar</button>
          <button type="submit" class="btn btn-primary">Crear factura</button>
        </div>
        <p class="adm-modal__msg" id="purchaseInvoiceMsg"></p>
      </form>
    </dialog>
  </section>
  </div>
</AdminLayout>

<style is:global>
  .adm-fin { display: flex; flex-direction: column; gap: 16px; }
  .adm-neg { color: var(--danger); }
  .adm-fin .adm-tabs { margin-bottom: 0; }

  /* Tabs */
  .adm-tabs {
    display: flex;
    gap: 0.35rem;
    border-bottom: 1px solid var(--rule);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .adm-tabs::-webkit-scrollbar { display: none; }
  .adm-tab {
    padding: 0.7rem 1.15rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    border-radius: 0;
    transition: color .15s, background .15s, border-color .15s;
  }
  .adm-tab:hover { color: var(--color-primary); background: var(--hover); }
  .adm-tab--active {
    color: var(--color-primary);
    border-bottom-color: var(--color-accent);
    font-weight: 600;
  }

  /* Panels */
  .adm-panel--hidden { display: none; }

  .adm-panel-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 1024px) {
    .adm-panel-grid { grid-template-columns: 1fr 1fr; }
  }

  .adm-panel-actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  /* Tarjeta de tabla - contenedor con cabecera + tabla edge-to-edge */
  .adm-table-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .adm-table-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    padding: 12px 16px;
    border-bottom: 1px solid var(--rule);
  }
  .adm-table-wrap { width: 100%; overflow-x: auto; }


  .adm-empty {
    color: var(--muted);
    font-size: 0.875rem;
    text-align: center;
    padding: 2.75rem 1.25rem;
    margin: 0;
  }
  .adm-link {
    display: block;
    padding: 10px 16px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    font-weight: 500;
    color: var(--accent-ink);
    text-decoration: none;
    text-align: right;
  }
  .adm-link:hover { color: var(--color-primary); }
  .adm-loading {
    text-align: center;
    padding: 2.75rem 1.25rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Modal */
  .adm-modal {
    border: none;
    border-radius: var(--radius);
    padding: 0;
    max-width: 560px;
    width: 95vw;
    box-shadow: 0 20px 50px color-mix(in oklab, var(--color-primary) 25%, transparent);
  }
  .adm-modal--wide { max-width: 750px; }
  .adm-modal::backdrop { background: color-mix(in oklab, var(--shell-dark) 55%, transparent); }
  .adm-modal__form { padding: 1.75rem; }
  .adm-modal__title { font-size: 17px; font-weight: 600; color: var(--color-text); margin: 0 0 1.25rem; }
  .adm-modal__actions { display: flex; gap: 0.75rem; justify-content: flex-end; margin-top: 1.25rem; flex-wrap: wrap; }
  .adm-modal__msg { margin-top: 0.75rem; font-size: 0.875rem; min-height: 1.25rem; }

  .adm-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.875rem;
  }
  .adm-field { display: flex; flex-direction: column; gap: 0.375rem; }
  .adm-field--full { grid-column: 1 / -1; }
  .adm-field span { font-size: 12px; font-weight: 500; color: var(--muted); }
  .adm-field input, .adm-field select, .adm-field textarea {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius-sm);
    font-size: 14px;
    background: var(--paper);
    color: var(--color-text);
    min-height: 40px;
  }
  .adm-field textarea { resize: vertical; min-height: 64px; }

  /* Líneas de factura */
  .adm-lines__title { font-size: 14px; font-weight: 600; margin: 1rem 0 0.5rem; color: var(--color-text); }

  .adm-lines-header {
    display: grid;
    grid-template-columns: 2.5fr 0.7fr 0.9fr 0.6fr 0.6fr 0.9fr auto;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    padding: 0 0 0.25rem;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0.375rem;
  }

  .adm-line-row {
    display: grid;
    grid-template-columns: 2fr 1fr 0.75fr 0.75fr auto;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .adm-line-row--sale {
    grid-template-columns: 2.5fr 0.7fr 0.9fr 0.6fr 0.6fr 0.9fr auto;
  }
  .adm-line-row input, .adm-line-row select {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--rule-2);
    border-radius: var(--radius-sm);
    font-size: 13px;
    min-height: 36px;
    width: 100%;
  }
  .adm-line-total {
    font-size: 0.8rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--color-text);
    white-space: nowrap;
    text-align: right;
  }
  .adm-line-remove {
    cursor: pointer;
    color: var(--danger);
