---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Ventas · DobleYo ERP" section="ventas">

<div class="page-header">
  <div class="page-header-top">
    <div>
      <div class="page-breadcrumb"><a href="/admin">Resumen</a> / Ventas</div>
      <h1 class="page-title">Ventas</h1>
      <div class="page-meta" id="periodMeta">Cargando periodo…</div>
    </div>
    <div class="page-header-actions">
      <a href="/admin/sales-map" class="btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 6l7-3 8 3 7-3v15l-7 3-8-3-7 3zM8 3v15M16 6v15"/></svg>
        Mapa de ventas
      </a>
      <a href="/admin/mercadolibre" class="btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M23 4v6h-6M1 20v-6h6M3.5 9a9 9 0 0 1 14.9-3.4L23 10M1 14l4.6 4.4A9 9 0 0 0 20.5 15"/></svg>
        Sincronizar ML
      </a>
      <button type="button" class="btn btn-primary" id="btnExport">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Exportar CSV
      </button>
    </div>
  </div>
</div>

<div class="erp-body sales">

  <!-- Filtros -->
  <div class="sales-filters" id="filterBar">
    <div class="seg" role="group" aria-label="Periodo" id="presetGroup">
      <button type="button" class="preset-btn" data-preset="today">Hoy</button>
      <button type="button" class="preset-btn" data-preset="7d">7 d</button>
      <button type="button" class="preset-btn active" data-preset="30d">30 d</button>
      <button type="button" class="preset-btn" data-preset="90d">90 d</button>
      <button type="button" class="preset-btn" data-preset="12m">12 m</button>
      <button type="button" class="preset-btn" data-preset="all">Todo</button>
      <button type="button" class="preset-btn" data-preset="custom">Rango</button>
    </div>
    <div class="sales-range" id="customRange" hidden>
      <label><span class="sr-only">Desde</span><input type="date" id="filterFrom" class="sales-input"></label>
      <span class="sales-muted" aria-hidden="true">a</span>
      <label><span class="sr-only">Hasta</span><input type="date" id="filterTo" class="sales-input"></label>
    </div>
    <span class="sales-sep" aria-hidden="true"></span>
    <label class="sales-field">
      <span>Ciudad</span>
      <select id="filterCity" class="sales-input"><option value="">Todas</option></select>
    </label>
    <label class="sales-field">
      <span>Departamento</span>
      <select id="filterState" class="sales-input"><option value="">Todos</option></select>
    </label>
    <label class="sales-field">
      <span>Estado</span>
      <select id="filterStatus" class="sales-input">
        <option value="">Todos</option>
        <option value="paid">Pagado</option>
        <option value="confirmed">Confirmado</option>
        <option value="pending">Pendiente</option>
        <option value="payment_required">Pago requerido</option>
        <option value="cancelled">Cancelado</option>
      </select>
    </label>
  </div>

  <!-- Indicadores -->
  <section class="kpi-grid" aria-label="Indicadores del periodo">
    <div class="kpi-tile">
      <div class="kpi-label">Ingresos</div>
      <div class="kpi-value" id="kpiRevenue"><span class="skeleton" style="width:60%"></span></div>
      <div class="kpi-sub"><span id="deltaRevenue"></span> <span id="prevRevenue"></span></div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-label">Órdenes</div>
      <div class="kpi-value" id="kpiOrders"><span class="skeleton" style="width:40%"></span></div>
      <div class="kpi-sub"><span id="deltaOrders"></span> <span id="prevOrders"></span></div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-label">Ticket promedio</div>
      <div class="kpi-value" id="kpiAov"><span class="skeleton" style="width:50%"></span></div>
      <div class="kpi-sub"><span id="deltaAov"></span> por orden</div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-label">Tasa de cancelación</div>
      <div class="kpi-value" id="kpiCancelRate"><span class="skeleton" style="width:40%"></span></div>
      <div class="kpi-sub"><span id="deltaCancel"></span> <span id="kpiCancelled"></span></div>
    </div>
  </section>

  <!-- Gráfica + estados -->
  <div class="sales-cols-21">
    <section class="panel" aria-labelledby="tTimeline">
      <div class="panel-header">
        <div>
          <h2 class="panel-title" id="tTimeline">Evolución del periodo</h2>
          <div class="sales-legend">
            <span><i class="sales-sw sales-sw--cur" aria-hidden="true"></i>Periodo actual</span>
            <span id="legendPrev"><i class="sales-sw sales-sw--prev" aria-hidden="true"></i>Periodo anterior</span>
          </div>
        </div>
        <div class="sales-toolbar">
          <div class="seg" role="group" aria-label="Métrica" id="metricToggle">
            <button type="button" class="toggle-btn active" data-metric="revenue">Ingresos</button>
            <button type="button" class="toggle-btn" data-metric="orders">Órdenes</button>
          </div>
          <div class="seg" role="group" aria-label="Agrupar por" id="granularityToggle">
            <button type="button" class="toggle-btn active" data-g="day">Día</button>
            <button type="button" class="toggle-btn" data-g="week">Semana</button>
            <button type="button" class="toggle-btn" data-g="month">Mes</button>
          </div>
        </div>
      </div>
      <div class="sales-chart" id="chartTimeline"><span class="skeleton" style="width:100%;height:220px"></span></div>
    </section>

    <section class="panel" aria-labelledby="tStatus">
      <div class="panel-header">
        <h2 class="panel-title" id="tStatus">Estado de las órdenes</h2>
        <span class="mono card-subtitle" id="statusSubtitle"></span>
      </div>
      <div id="chartStatus"><div class="sales-pad"><span class="skeleton" style="width:100%"></span></div></div>
    </section>
  </div>

  <!-- Rankings -->
  <div class="sales-cols-11">
    <section class="panel" aria-labelledby="tProducts">
      <div class="panel-header">
        <h2 class="panel-title" id="tProducts">Productos</h2>
        <span class="card-subtitle">por ingresos</span>
      </div>
      <div class="table-wrapper" id="chartProducts"><div class="sales-pad"><span class="skeleton" style="width:80%"></span></div></div>
    </section>
    <section class="panel" aria-labelledby="tCities">
      <div class="panel-header">
        <h2 class="panel-title" id="tCities">Ciudades</h2>
        <span class="card-subtitle" id="citiesSubtitle">por órdenes</span>
      </div>
      <div class="table-wrapper" id="chartCities"><div class="sales-pad"><span class="skeleton" style="width:80%"></span></div></div>
    </section>
  </div>

  <!-- Órdenes -->
  <section class="panel" aria-labelledby="tOrders">
    <div class="panel-header">
      <div class="sales-title-row">
        <h2 class="panel-title" id="tOrders">Órdenes</h2>
        <span class="count" id="tableSubtitle">·</span>
      </div>
      <label class="sales-search">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 21l-4.3-4.3M19 11a8 8 0 1 1-16 0 8 8 0 0 1 16 0z"/></svg>
        <span class="sr-only">Buscar órdenes</span>
        <input type="search" id="tableSearch" placeholder="Orden, ciudad o producto" autocomplete="off">
      </label>
    </div>
    <div class="table-wrapper">
      <table class="erp-table sales-orders">
        <thead>
          <tr>
            <th><button type="button" class="sort-col" data-col="ml_order_id">Orden</button></th>
            <th><button type="button" class="sort-col" data-col="purchase_date">Fecha</button></th>
            <th>Productos</th>
            <th><button type="button" class="sort-col" data-col="recipient_city">Ciudad</button></th>
            <th>Departamento</th>
            <th><button type="button" class="sort-col" data-col="order_status">Estado</button></th>
            <th>Envío</th>
            <th class="num"><button type="button" class="sort-col" data-col="total_amount">Total</button></th>
          </tr>
        </thead>
        <tbody id="ordersBody">
          <tr><td colspan="8" class="empty-state">Cargando órdenes…</td></tr>
        </tbody>
        <tfoot id="ordersFoot" hidden>
          <tr>
            <td colspan="7">Subtotal de la página <span class="sales-muted">(sin canceladas)</span></td>
            <td class="num mono" id="ordersSubtotal"></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="sales-pager" id="paginationBar"></div>
  </section>

</div>

<div id="chartTooltip" class="sales-tooltip" role="status"></div>

<style is:global>
/* Estilos globales pero acotados a .sales: el contenido de gráficas y tablas
   se arma en el navegador y los estilos scoped de Astro no le llegarían. */
.sales { display: flex; flex-direction: column; gap: 16px; }
.sales .sr-only {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}
.sales-muted { color: var(--muted); }
.sales-pad { padding: 16px; }

.sales-filters {
  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px;
  padding: 10px 12px;
  background: var(--paper);
  border: 1px solid var(--rule);
  border-radius: var(--radius);
}
.sales-sep { width: 1px; height: 22px; background: var(--rule); }
.sales-range { display: inline-flex; align-items: center; gap: 6px; }
.sales-range[hidden] { display: none; }
.sales-field { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
.sales-input {
  height: 32px; padding: 0 8px; max-width: 180px;
  border: 1px solid var(--rule-2); border-radius: var(--radius-sm);
  background: var(--paper); color: var(--color-text);
  font: inherit; font-size: 13px;
}

.sales-cols-21, .sales-cols-11 {
  display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start;
}
@media (min-width: 1024px) {
  .sales-cols-21 { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .sales-cols-11 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
}
.sales-title-row { display: flex; align-items: center; gap: 10px; }
.sales-toolbar { display: flex; flex-wrap: wrap; gap: 8px; }

/* Gráfica */
.sales-legend { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; font-size: 12px; color: var(--muted); }
.sales-legend span { display: inline-flex; align-items: center; gap: 6px; }
.sales-sw { display: inline-block; width: 16px; height: 0; border-top: 2px solid; }
.sales-sw--cur  { border-color: var(--color-accent); }
.sales-sw--prev { border-color: var(--st-neutral); border-top-style: dashed; }
.sales-chart { padding: 16px 16px 12px; }
.sales-chart-grid { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 8px; }
.sales-y {
  display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end;
  height: 220px; margin: -6px 0 6px; font-size: 11px; color: var(--muted);
}
.sales-plot { position: relative; height: 220px; }
.sales-plot svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.sales-gridline { position: absolute; left: 0; right: 0; border-top: 1px solid var(--rule); }
.sales-area { fill: var(--color-accent); fill-opacity: .1; }
.sales-line { fill: none; stroke: var(--color-accent); stroke-width: 2; }
.sales-line--prev { fill: none; stroke: var(--st-neutral); stroke-width: 1.5; stroke-dasharray: 4 4; }
.sales-cursor { stroke: var(--color-text); stroke-opacity: .35; stroke-width: 1; }
.sales-x { display: flex; justify-content: space-between; margin-top: 8px; font-size: 11px; color: var(--muted); }
.sales-tooltip {
  position: fixed; z-index: 1000; display: none; pointer-events: none;
  padding: 7px 10px; border-radius: var(--radius-sm);
  background: var(--shell-dark); color: var(--shell-dark-text);
  font-size: 12px; line-height: 1.5; white-space: nowrap;
}
.sales-tooltip b { font-weight: 600; }
.sales-tooltip .mono { margin-left: 8px; }

/* Estados */
.sales-stack { display: flex; gap: 2px; height: 10px; margin: 14px 16px 8px; border-radius: 3px; overflow: hidden; }
.sales-stack span { height: 100%; min-width: 2px; }

/* Barras de participación dentro de tablas */
.sales-share { display: flex; align-items: center; gap: 8px; min-width: 120px; }
.sales-share-track { flex: 1; height: 6px; background: var(--hover); border-radius: 3px; overflow: hidden; }
.sales-share-fill { height: 100%; background: var(--color-primary); border-radius: 3px; }
.sales-share .mono { width: 44px; text-align: right; font-size: 12px; color: var(--muted); }
.sales-ellipsis { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* Órdenes */
.sales-search {
  display: flex; align-items: center; gap: 6px;
  height: 30px; padding: 0 10px;
  border: 1px solid var(--rule-2); border-radius: var(--radius-sm); color: var(--muted);
}
.sales-search:focus-within { border-color: var(--accent-ink); }
.sales-search input { border: 0; outline: 0; background: transparent; font: inherit; font-size: 12px; width: 200px; color: var(--color-text); }
.sales-orders td { white-space: nowrap; }
.sales-orders .sort-col {
  appearance: none; border: 0; background: transparent; padding: 0;
  font: inherit; color: inherit; cursor: pointer;
}
.sales-orders .sort-col:hover { color: var(--color-text); }
.sales-orders .sort-col[aria-sort="ascending"]::after  { content: " ↑"; }
.sales-orders .sort-col[aria-sort="descending"]::after { content: " ↓"; }
.sales-orders .is-cancelled { color: var(--muted); text-decoration: line-through; }
.sales-pager {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
  padding: 10px 16px; border-top: 1px solid var(--rule);
  font-size: 12px; color: var(--muted);
}
.sales-pager:empty { display: none; }
.sales-pager-btns { display: flex; gap: 6px; }
.sales-empty { color: var(--muted); text-align: center; padding: 40px 16px; }
</style>

<script>
// ══════════════════════════════════════════════════════════════
// Estado
// ══════════════════════════════════════════════════════════════
const S: any = {
  preset: '30d',
  dateFrom: '',
  dateTo: '',
  city: '',
  state: '',
  status: '',
  granularity: 'day',
  metric: 'revenue',
  data: null,
  tableOffset: 0,
  tableLimit: 25,
  tableSort: 'purchase_date',
  tableSortDir: 'desc',
  tableSearch: '',
  allCities: [] as string[],
  allStates: [] as string[],
};

const $ = (id: string) => document.getElementById(id) as HTMLElement;

// ══════════════════════════════════════════════════════════════
// Formato
// ══════════════════════════════════════════════════════════════
const COP = new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 });
const NUM = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 0 });
const PCT = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 1 });

const fmtCOP = (v: unknown) => COP.format(Number(v) || 0);
const fmtNum = (v: unknown) => NUM.format(Number(v) || 0);
function fmtShortCOP(v: number) {
  const f = (x: number) => x.toLocaleString('es-CO', { maximumFractionDigits: 1 });
  if (v >= 1e6) return `$${f(v / 1e6)} M`;
  if (v >= 1e3) return `$${f(v / 1e3)} mil`;
  return `$${fmtNum(v)}`;
}
function esc(v: unknown) {
  return String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
}
function fmtPeriodLabel(s: string) {
  if (!s) return '';
  if (s.includes('W')) return `Sem. ${Number(s.split('W')[1])}`;
  if (s.length === 7) {
    const [y, m] = s.split('-');
    return new Date(+y, +m - 1, 1).toLocaleDateString('es-CO', { month: 'short', year: '2-digit' });
  }
  return new Date(s + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'short' });
}
const fmtDate = (s: string) => new Date(s + 'T12:00:00').toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' });
function fmtDateTime(s: string) {
  if (!s) return '';
  return new Date(s).toLocaleString('es-CO', { timeZone: 'America/Bogota', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false });
}

// ══════════════════════════════════════════════════════════════
// Rangos
// ══════════════════════════════════════════════════════════════
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
function getPresetRange(preset: string) {
  const now = new Date();
  const today = isoDate(now);
  const back = (days: number) => { const f = new Date(now); f.setDate(now.getDate() - days); return isoDate(f); };
  switch (preset) {
    case 'today': return { from: today, to: today };
    case '7d': return { from: back(6), to: today };
    case '30d': return { from: back(29), to: today };
    case '90d': return { from: back(89), to: today };
    case '12m': { const f = new Date(now); f.setFullYear(now.getFullYear() - 1); return { from: isoDate(f), to: today }; }
    case 'all': return { from: '', to: '' };
    default: return null;
  }
}
// Mismo cálculo que el servidor para el periodo anterior.
function prevRange(from: string, to: string) {
  const dFrom = new Date(from), dTo = new Date(to);
  const diff = dTo.getTime() - dFrom.getTime() + 86400000;
  const pTo = new Date(dFrom.getTime() - 1);
  const pFrom = new Date(pTo.getTime() - diff + 86400000);
  return { from: isoDate(pFrom), to: isoDate(pTo) };
}
function eachDay(from: string, to: string) {
  const out: string[] = [];
  for (let d = new Date(from + 'T00:00:00Z'); isoDate(d) <= to; d.setUTCDate(d.getUTCDate() + 1)) out.push(isoDate(d));
  return out;
}

// ══════════════════════════════════════════════════════════════
// Datos
// ══════════════════════════════════════════════════════════════
function baseParams() {
  const p = new URLSearchParams();
  if (S.dateFrom) p.set('dateFrom', S.dateFrom);
  if (S.dateTo)   p.set('dateTo', S.dateTo);
  if (S.city)     p.set('city', S.city);
  if (S.state)    p.set('state', S.state);
  if (S.status)   p.set('status', S.status);
  return p;
}
async function fetchAnalytics() {
  const p = baseParams();
  p.set('granularity', S.granularity);
  const res = await fetch(`/api/mercadolibre/analytics?${p}`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}
async function fetchOrders() {
  const p = baseParams();
  if (S.tableSearch) p.set('search', S.tableSearch);
  p.set('limit', String(S.tableLimit));
  p.set('offset', String(S.tableOffset));
  p.set('sort', S.tableSort);
  p.set('sortDir', S.tableSortDir);
  const res = await fetch(`/api/mercadolibre/sales?${p}`);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  return res.json();
}

// ══════════════════════════════════════════════════════════════
// Indicadores
// ══════════════════════════════════════════════════════════════
// good: 'up' si subir es bueno, 'down' si bajar es bueno (cancelaciones).
function setDelta(id: string, cur: number, prev: number | null | undefined, good: 'up' | 'down' = 'up', unit: '%' | 'pp' = '%') {
  const el = $(id);
  if (prev == null || (unit === '%' && Number(prev) === 0)) { el.textContent = ''; el.className = ''; return; }
  const diff = unit === '%' ? ((cur - prev) / prev) * 100 : cur - prev;
  const flat = Math.abs(diff) < 0.05;
  const better = good === 'up' ? diff > 0 : diff < 0;
  el.className = `mono ${flat ? 'sales-muted' : better ? 'sales-up' : 'sales-down'}`;
  el.style.color = flat ? '' : better ? 'var(--ok)' : 'var(--danger)';
  el.textContent = `${diff > 0 ? '▲ +' : diff < 0 ? '▼ -' : '= '}${PCT.format(Math.abs(diff))}${unit === '%' ? '%' : ' pp'}`;
}

function renderKPIs(k: any, prev: any) {
  const orders = Number(k.orders) || 0;
  const cancelled = Number(k.cancelled) || 0;
  const rate = orders ? (cancelled / orders) * 100 : 0;
  $('kpiRevenue').textContent = fmtCOP(k.revenue);
  $('kpiOrders').textContent = fmtNum(orders);
  $('kpiAov').textContent = fmtCOP(k.aov);
  $('kpiCancelRate').textContent = `${PCT.format(rate)}%`;
  $('kpiCancelled').textContent = `${fmtNum(cancelled)} ${cancelled === 1 ? 'orden' : 'órdenes'}`;

  if (prev) {
    const pOrders = Number(prev.orders) || 0;
    setDelta('deltaRevenue', Number(k.revenue) || 0, Number(prev.revenue));
    setDelta('deltaOrders', orders, pOrders);
    setDelta('deltaAov', Number(k.aov) || 0, Number(prev.aov));
    setDelta('deltaCancel', rate, pOrders ? ((Number(prev.cancelled) || 0) / pOrders) * 100 : null, 'down', 'pp');
    $('prevRevenue').textContent = `vs. ${fmtCOP(prev.revenue)}`;
    $('prevOrders').textContent = `vs. ${fmtNum(pOrders)}`;
  } else {
    ['deltaRevenue', 'deltaOrders', 'deltaAov', 'deltaCancel'].forEach((id) => { $(id).textContent = ''; });
    $('prevRevenue').textContent = 'sin comparación';
    $('prevOrders').textContent = 'sin comparación';
  }
}

// ══════════════════════════════════════════════════════════════
// Gráfica: periodo actual vs. anterior
// ══════════════════════════════════════════════════════════════
function niceMax(v: number) {
  if (v <= 0) return 1;
  const pow = 10 ** Math.floor(Math.log10(v));
  const n = v / pow;
  return (n <= 1 ? 1 : n <= 2 ? 2 : n <= 2.5 ? 2.5 : n <= 5 ? 5 : 10) * pow;
}

// Arma las dos series alineadas. En días se rellenan los días sin ventas
// para que ambas tengan la misma longitud; en semana y mes se alinean por posición.
function buildSeries(d: any) {
  const key = S.metric;
  const cur = (d.timeline || []) as any[];
  const prev = (d.prev_timeline || []) as any[];
  if (S.granularity === 'day' && S.dateFrom && S.dateTo) {
    const map = new Map(cur.map((r) => [r.period, Number(r[key]) || 0]));
    const days = eachDay(S.dateFrom, S.dateTo);
    const pr = prevRange(S.dateFrom, S.dateTo);
    const pmap = new Map(prev.map((r) => [r.period, Number(r[key]) || 0]));
    const pdays = eachDay(pr.from, pr.to);
    return {
      labels: days,
      cur: days.map((x) => map.get(x) ?? 0),
      prev: prev.length ? pdays.map((x) => pmap.get(x) ?? 0) : null,
      prevLabels: pdays,
    };
  }
  return {
    labels: cur.map((r) => r.period),
    cur: cur.map((r) => Number(r[key]) || 0),
    prev: prev.length ? cur.map((_, i) => Number(prev[i]?.[key]) || 0) : null,
    prevLabels: cur.map((_, i) => prev[i]?.period ?? ''),
  };
}

function drawTimeline(d: any) {
  const el = $('chartTimeline');
  const s = buildSeries(d);
  $('legendPrev').hidden = !s.prev;
  if (s.cur.length < 2) {
    el.innerHTML = '<p class="sales-empty">No hay suficientes datos en el periodo para graficar.</p>';
    return;
  }
  const W = 600, H = 220, N = s.cur.length;
  const fmt = S.metric === 'revenue' ? fmtShortCOP : fmtNum;
  const max = niceMax(Math.max(...s.cur, ...(s.prev ?? []), 1));
  const x = (i: number) => (i / (N - 1)) * W;
  const y = (v: number) => H - (v / max) * H;
  const path = (vals: number[]) => 'M' + vals.map((v, i) => `${x(i).toFixed(1)} ${y(v).toFixed(1)}`).join(' L');
  const cur = path(s.cur);
  const ticks = [1, .75, .5, .25, 0];
  const xi = [...new Set([0, Math.round((N - 1) / 4), Math.round((N - 1) / 2), Math.round(3 * (N - 1) / 4), N - 1])];

  el.innerHTML = `
    <div class="sales-chart-grid">
      <div class="sales-y mono" aria-hidden="true">${ticks.map((t) => `<span>${esc(fmt(max * t))}</span>`).join('')}</div>
      <div>
        <div class="sales-plot">
          ${ticks.map((t) => `<div class="sales-gridline" style="top:${(1 - t) * 100}%"></div>`).join('')}
          <svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" role="img"
               aria-label="${S.metric === 'revenue' ? 'Ingresos' : 'Órdenes'} por periodo${s.prev ? ' frente al periodo anterior' : ''}">
            <path d="${cur} L${W} ${H} L0 ${H} Z" class="sales-area"/>
            ${s.prev ? `<path d="${path(s.prev)}" class="sales-line--prev" vector-effect="non-scaling-stroke"/>` : ''}
            <path d="${cur}" class="sales-line" vector-effect="non-scaling-stroke"/>
            <line class="sales-cursor" x1="0" x2="0" y1="0" y2="${H}" vector-effect="non-scaling-stroke" visibility="hidden"/>
            <rect class="sales-hit" x="0" y="0" width="${W}" height="${H}" fill="transparent"/>
          </svg>
        </div>
        <div class="sales-x mono" aria-hidden="true">${xi.map((i) => `<span>${esc(fmtPeriodLabel(s.labels[i]))}</span>`).join('')}</div>
      </div>
    </div>`;

  // Tooltip: punto más cercano al cursor.
  const svg = el.querySelector('svg')!;
  const cursor = el.querySelector('.sales-cursor')!;
  const tip = $('chartTooltip');
  const valFmt = S.metric === 'revenue' ? fmtCOP : fmtNum;
  svg.addEventListener('mousemove', (e: MouseEvent) => {
    const b = svg.getBoundingClientRect();
    const i = Math.max(0, Math.min(N - 1, Math.round(((e.clientX - b.left) / b.width) * (N - 1))));
    cursor.setAttribute('x1', String(x(i)));
    cursor.setAttribute('x2', String(x(i)));
    cursor.setAttribute('visibility', 'visible');
    tip.innerHTML = `<b>${esc(fmtPeriodLabel(s.labels[i]))}</b><span class="mono">${esc(valFmt(s.cur[i]))}</span>` +
      (s.prev ? `<br><span>${esc(fmtPeriodLabel(s.prevLabels[i]))}</span><span class="mono">${esc(valFmt(s.prev[i]))}</span>` : '');
    tip.style.display = 'block';
    tip.style.left = `${e.clientX + 14}px`;
    tip.style.top = `${e.clientY - 44}px`;
  });
  svg.addEventListener('mouseleave', () => {
    cursor.setAttribute('visibility', 'hidden');
    tip.style.display = 'none';
  });
}

// ══════════════════════════════════════════════════════════════
// Estados, productos y ciudades
// ══════════════════════════════════════════════════════════════
const STATUS: Record<string, [string, string]> = {
  paid: ['Pagado', 'paid'],
  confirmed: ['Confirmado', 'confirmed'],
  pending: ['Pendiente', 'pending'],
  payment_required: ['Pago requerido', 'pending'],
  cancelled: ['Cancelado', 'cancelled'],
};
const statusInfo = (s: string) => STATUS[s] ?? [s || 'Sin estado', ''];
const statusVar = (cls: string) => (cls ? `var(--st-${cls})` : 'var(--st-neutral)');
const statusHtml = (s: string) => {
  const [label, cls] = statusInfo(s);
  return `<span class="status${cls ? ` status--${cls}` : ''}">${esc(label)}</span>`;
};

function drawStatus(data: any[]) {
  const el = $('chartStatus');
  const list = data || [];
  const total = list.reduce((a, d) => a + (Number(d.count) || 0), 0);
  $('statusSubtitle').textContent = `${fmtNum(total)} órdenes`;
  if (!total) { el.innerHTML = '<p class="sales-empty">Sin órdenes en el periodo.</p>'; return; }
  el.innerHTML = `
    <div class="sales-stack" role="img" aria-label="${esc(list.map((d) => `${statusInfo(d.status)[0]}: ${d.count}`).join(', '))}">
      ${list.map((d) => `<span style="width:${(Number(d.count) / total) * 100}%;background:${statusVar(statusInfo(d.status)[1])}"></span>`).join('')}
    </div>
    <table class="erp-table"><tbody>
      ${list.map((d) => `<tr>
        <td>${statusHtml(d.status)}</td>
        <td class="num mono">${fmtNum(d.count)}</td>
        <td class="num mono sales-muted">${PCT.format((Number(d.count) / total) * 100)}%</td>
        <td class="num mono">${fmtCOP(d.revenue)}</td>
      </tr>`).join('')}
    </tbody></table>`;
}

function shareCell(value: number, max: number, total: number) {
  return `<div class="sales-share">
    <div class="sales-share-track"><div class="sales-share-fill" style="width:${max ? (value / max) * 100 : 0}%"></div></div>
    <span class="mono">${PCT.format(total ? (value / total) * 100 : 0)}%</span>
  </div>`;
}

function drawProducts(items: any[]) {
  const el = $('chartProducts');
  const list = (items || []).slice(0, 8);
  if (!list.length) { el.innerHTML = '<p class="sales-empty">Sin ventas en el periodo.</p>'; return; }
  const total = (items || []).reduce((a, p) => a + (Number(p.revenue) || 0), 0);
  const max = Math.max(...list.map((p) => Number(p.revenue) || 0), 1);
  el.innerHTML = `<table class="erp-table">
    <thead><tr><th>Producto</th><th class="num">Unid.</th><th class="num">Ingresos</th><th>Participación</th></tr></thead>
    <tbody>${list.map((p) => `<tr>
      <td class="sales-ellipsis" title="${esc(p.title)}">${esc(p.title)}</td>
      <td class="num mono">${fmtNum(p.units)}</td>
      <td class="num mono">${fmtCOP(p.revenue)}</td>
      <td>${shareCell(Number(p.revenue) || 0, max, total)}</td>
    </tr>`).join('')}</tbody></table>`;
}

function drawCities(items: any[]) {
  const el = $('chartCities');
  const list = (items || []).filter((c) => c.city && c.city !== 'Unknown').slice(0, 8);
  $('citiesSubtitle').textContent = `${fmtNum(S.data?.kpis?.cities)} ciudades con ventas`;
  if (!list.length) { el.innerHTML = '<p class="sales-empty">Sin envíos en el periodo.</p>'; return; }
  const total = (items || []).reduce((a, c) => a + (Number(c.orders) || 0), 0);
  const max = Math.max(...list.map((c) => Number(c.orders) || 0), 1);
  el.innerHTML = `<table class="erp-table">
    <thead><tr><th>Ciudad</th><th class="num">Órdenes</th><th class="num">Ingresos</th><th>Participación</th></tr></thead>
    <tbody>${list.map((c) => `<tr>
      <td class="sales-ellipsis">${esc(c.city)}${c.state ? ` <span class="sales-muted">${esc(c.state)}</span>` : ''}</td>
      <td class="num mono">${fmtNum(c.orders)}</td>
      <td class="num mono">${fmtCOP(c.revenue)}</td>
      <td>${shareCell(Number(c.orders) || 0, max, total)}</td>
    </tr>`).join('')}</tbody></table>`;
}

// ══════════════════════════════════════════════════════════════
// Tabla de órdenes
// ══════════════════════════════════════════════════════════════
function renderOrders(result: any) {
  const tbody = $('ordersBody');
  const foot = $('ordersFoot');
  const pag = $('paginationBar');
  const rows = result?.data || [];

  if (!rows.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty-state">No hay órdenes con estos filtros.</td></tr>';
    $('tableSubtitle').textContent = '0';
    foot.hidden = true;
    pag.innerHTML = '';
    return;
  }

  const total = Number(result.pagination?.total) || rows.length;
  $('tableSubtitle').textContent = fmtNum(total);

  let subtotal = 0;
  tbody.innerHTML = rows.map((o: any) => {
    let products = '';
    try {
      const prods = Array.isArray(o.products) ? o.products : JSON.parse(o.products || '[]');
      products = prods.map((p: any) => `${p.title || 'Producto'} x${p.quantity}`).join(', ');
    } catch { products = ''; }
    const cancelled = o.order_status === 'cancelled';
    if (!cancelled) subtotal += Number(o.total_amount) || 0;
    return `<tr>
      <td class="mono">${esc(o.ml_order_id || '')}</td>
      <td class="mono sales-muted">${esc(fmtDateTime(o.purchase_date))}</td>
      <td class="sales-ellipsis" title="${esc(products)}">${esc(products) || '<span class="sales-muted">Sin detalle</span>'}</td>
      <td>${esc(o.recipient_city || '')}</td>
      <td class="sales-muted">${esc(o.recipient_state || '')}</td>
      <td>${statusHtml(o.order_status)}</td>
      <td class="sales-muted">${esc(o.shipping_method || '')}</td>
      <td class="num mono${cancelled ? ' is-cancelled' : ''}">${fmtCOP(o.total_amount)}</td>
    </tr>`;
  }).join('');
  $('ordersSubtotal').textContent = fmtCOP(subtotal);
  foot.hidden = false;

  const from = S.tableOffset + 1;
  const to = Math.min(S.tableOffset + S.tableLimit, total);
  pag.innerHTML = `
    <span class="mono">${fmtNum(from)}-${fmtNum(to)} de ${fmtNum(total)}</span>
    <div class="sales-pager-btns">
      <button type="button" class="btn btn-sm" data-step="-1" ${S.tableOffset === 0 ? 'disabled' : ''}>Anterior</button>
      <button type="button" class="btn btn-sm" data-step="1" ${to >= total ? 'disabled' : ''}>Siguiente</button>
    </div>`;
}

// ══════════════════════════════════════════════════════════════
// Periodo y render general
// ══════════════════════════════════════════════════════════════
function updatePeriodMeta() {
  const el = $('periodMeta');
  if (!S.dateFrom || !S.dateTo) {
    el.textContent = 'Todo el histórico · Hora de Colombia';
    return;
  }
  const pr = prevRange(S.dateFrom, S.dateTo);
  el.textContent = `${fmtDate(S.dateFrom)} a ${fmtDate(S.dateTo)} · comparado con ${fmtDate(pr.from)} a ${fmtDate(pr.to)}`;
}

function renderAll() {
  const d = S.data;
  if (!d) return;
  renderKPIs(d.kpis || {}, d.prev_kpis);
  drawTimeline(d);
  drawStatus(d.by_status);
  drawProducts(d.top_products);
  drawCities(d.top_cities);

  if (d.filter_options?.cities?.length) {
    const opts = d.filter_options.cities as any[];
    const cities = [...new Set(opts.map((c) => c.city).filter(Boolean))].sort() as string[];
    const states = [...new Set(opts.map((c) => c.state).filter(Boolean))].sort() as string[];
    const fill = (sel: HTMLSelectElement, values: string[], first: string, current: string) => {
      sel.replaceChildren(new Option(first, ''), ...values.map((v) => new Option(v, v, false, v === current)));
    };
    if (cities.length !== S.allCities.length) { S.allCities = cities; fill($('filterCity') as HTMLSelectElement, cities, 'Todas', S.city); }
    if (states.length !== S.allStates.length) { S.allStates = states; fill($('filterState') as HTMLSelectElement, states, 'Todos', S.state); }
  }
}

async function loadAnalytics() {
  try {
    const json = await fetchAnalytics();
    if (json.success) { S.data = json; renderAll(); }
  } catch (e) {
    console.error('[ventas] analytics error:', e);
    $('chartTimeline').innerHTML = '<p class="sales-empty">No se pudo cargar la analítica de ventas. Intente de nuevo.</p>';
  }
}

async function loadOrders() {
  $('ordersBody').innerHTML = '<tr><td colspan="8" class="empty-state">Cargando órdenes…</td></tr>';
  try {
    renderOrders(await fetchOrders());
  } catch {
    $('ordersBody').innerHTML = '<tr><td colspan="8" class="empty-state">No se pudieron cargar las órdenes. Intente de nuevo.</td></tr>';
  }
}

function loadAll() {
  updatePeriodMeta();
  return Promise.all([loadAnalytics(), loadOrders()]);
}

// ══════════════════════════════════════════════════════════════
// Exportar CSV
// ══════════════════════════════════════════════════════════════
async function exportCSV() {
  const p = baseParams();
  p.set('limit', '5000');
  p.set('offset', '0');
  const res = await fetch(`/api/mercadolibre/sales?${p}`);
  const json = await res.json();
  if (!json.data?.length) return;

  const headers = ['ID Orden', 'Fecha', 'Ciudad', 'Departamento', 'País', 'Total COP', 'Estado', 'Método envío', 'Productos'];
  const rows = json.data.map((o: any) => {
    let products = '';
    try {
      const prods = Array.isArray(o.products) ? o.products : JSON.parse(o.products || '[]');
      products = prods.map((x: any) => `${x.title} x${x.quantity}`).join(' | ');
    } catch {}
    return [o.ml_order_id, o.purchase_date, o.recipient_city, o.recipient_state, o.recipient_country,
      o.total_amount, o.order_status, o.shipping_method, products]
      .map((v) => `"${String(v ?? '').replace(/"/g, '""')}"`).join(',');
  });

  const blob = new Blob(['﻿' + [headers.join(','), ...rows].join('\n')], { type: 'text/csv;charset=utf-8;' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `dobleyo-ventas-${isoDate(new Date())}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}

// ══════════════════════════════════════════════════════════════
// Eventos
// ══════════════════════════════════════════════════════════════
function activate(group: string, btn: HTMLElement) {
  document.querySelectorAll<HTMLElement>(`${group} button`).forEach((b) => {
    const on = b === btn;
    b.classList.toggle('active', on);
    b.setAttribute('aria-pressed', String(on));
  });
}

document.addEventListener('DOMContentLoaded', () => {
  const range = getPresetRange('30d')!;
  S.dateFrom = range.from;
  S.dateTo = range.to;
  const fromEl = $('filterFrom') as HTMLInputElement;
  const toEl = $('filterTo') as HTMLInputElement;
  fromEl.value = S.dateFrom;
  toEl.value = S.dateTo;
  ['#presetGroup', '#metricToggle', '#granularityToggle'].forEach((g) => {
    const on = document.querySelector<HTMLElement>(`${g} button.active`);
    if (on) activate(g, on);
  });

  document.querySelectorAll<HTMLElement>('#presetGroup button').forEach((btn) => {
    btn.addEventListener('click', () => {
      activate('#presetGroup', btn);
      S.preset = btn.dataset.preset;
      const r = getPresetRange(S.preset);
      $('customRange').hidden = !!r;
      if (!r) return;
      S.dateFrom = r.from;
      S.dateTo = r.to;
      fromEl.value = S.dateFrom;
      toEl.value = S.dateTo;
      S.tableOffset = 0;
      loadAll();
    });
  });

  fromEl.addEventListener('change', () => { S.dateFrom = fromEl.value; S.tableOffset = 0; loadAll(); });
  toEl.addEventListener('change', () => { S.dateTo = toEl.value; S.tableOffset = 0; loadAll(); });

  ([['filterCity', 'city'], ['filterState', 'state'], ['filterStatus', 'status']] as const).forEach(([id, key]) => {
    const sel = $(id) as HTMLSelectElement;
    sel.addEventListener('change', () => { S[key] = sel.value; S.tableOffset = 0; loadAll(); });
  });

  document.querySelectorAll<HTMLElement>('#granularityToggle button').forEach((btn) => {
    btn.addEventListener('click', () => {
      activate('#granularityToggle', btn);
      S.granularity = btn.dataset.g;
      loadAnalytics();
    });
  });

  document.querySelectorAll<HTMLElement>('#metricToggle button').forEach((btn) => {
    btn.addEventListener('click', () => {
      activate('#metricToggle', btn);
      S.metric = btn.dataset.metric;
      if (S.data) drawTimeline(S.data);
    });
  });

  const sortButtons = document.querySelectorAll<HTMLElement>('.sort-col');
  const markSort = () => sortButtons.forEach((b) => {
    if (b.dataset.col === S.tableSort) b.setAttribute('aria-sort', S.tableSortDir === 'asc' ? 'ascending' : 'descending');
    else b.removeAttribute('aria-sort');
  });
  sortButtons.forEach((b) => {
    b.addEventListener('click', () => {
      if (S.tableSort === b.dataset.col) S.tableSortDir = S.tableSortDir === 'asc' ? 'desc' : 'asc';
      else { S.tableSort = b.dataset.col; S.tableSortDir = 'desc'; }
      markSort();
      S.tableOffset = 0;
      loadOrders();
    });
  });
  markSort();

  $('paginationBar').addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-step]');
    if (!btn || btn.disabled) return;
    S.tableOffset = Math.max(0, S.tableOffset + Number(btn.dataset.step) * S.tableLimit);
    loadOrders();
  });

  let searchTimer: ReturnType<typeof setTimeout> | undefined;
  const search = $('tableSearch') as HTMLInputElement;
  search.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => { S.tableSearch = search.value.trim(); S.tableOffset = 0; loadOrders(); }, 350);
  });

  $('btnExport').addEventListener('click', exportCSV);

  loadAll();
});
</script>

