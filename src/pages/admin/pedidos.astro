---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout title="Pedidos · DobleYo Admin" section="pedidos">
    <div class="page-header">
        <div class="page-header-top">
            <div>
                <div class="page-breadcrumb">Ventas · Tienda web</div>
                <h1 class="page-title">Pedidos</h1>
                <p class="page-subtitle">Pedidos de la tienda web: pago, estado y despacho.</p>
            </div>
        </div>
    </div>

    <div class="erp-body ped">
    <form class="filter-bar" id="filtersForm" role="search" aria-label="Filtrar pedidos">
        <label class="ff ff--grow">
            <span>Buscar</span>
            <input type="search" id="fSearch" class="ped-input" placeholder="Referencia, cliente o correo" />
        </label>
        <label class="ff">
            <span>Estado</span>
            <select id="fStatus" class="ped-input">
                <option value="">Todos</option>
                <option value="pending_payment">Pendiente de pago</option>
                <option value="paid">Pagado</option>
                <option value="processing">En proceso</option>
                <option value="shipped">Enviado</option>
                <option value="delivered">Entregado</option>
                <option value="cancelled">Cancelado</option>
                <option value="refunded">Reembolsado</option>
            </select>
        </label>
        <div class="filter-bar-actions">
            <button class="btn btn-sm btn-secondary" id="btnReset" type="button">Limpiar</button>
            <button class="btn btn-sm btn-primary" id="btnSearch" type="submit">Buscar</button>
        </div>
    </form>

    <section class="panel" aria-labelledby="pedTitle">
        <div class="panel-header">
            <h2 id="pedTitle" class="panel-title">Pedidos</h2>
            <span class="card-subtitle mono" id="summaryText">Cargando...</span>
        </div>
        <div class="table-wrapper">
            <table class="erp-table ped-table">
                <thead>
                    <tr>
                        <th>Referencia</th>
                        <th>Cliente</th>
                        <th>Ciudad</th>
                        <th class="num">Total</th>
                        <th>Pago</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                        <th><span class="ped-sr">Acciones</span></th>
                    </tr>
                </thead>
                <tbody id="ordersBody">
                    <tr><td colspan="8" class="ped-msg">Cargando pedidos...</td></tr>
                </tbody>
            </table>
        </div>
        <div class="ped-pager" id="pagination"></div>
    </section>
    </div>

    <!-- Detail / status modal -->
    <div class="modal-back" id="modalBack">
        <div
            class="modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="modalTitle"
        >
            <div class="modal-header">
                <h2 id="modalTitle">Pedido</h2>
                <button class="modal-close" id="modalClose" aria-label="Cerrar"
                    >&times;</button
                >
            </div>
            <div class="modal-body">
                <div id="modalDetails"></div>

                <div class="modal-section">
                    <div class="modal-section-title">Actualizar estado</div>
                    <div class="status-form">
                        <select id="newStatus" class="ped-input">
                            <option value="pending_payment">Pendiente de pago</option>
                            <option value="paid">Pagado</option>
                            <option value="processing">En proceso</option>
                            <option value="shipped">Enviado</option>
                            <option value="delivered">Entregado</option>
                            <option value="cancelled">Cancelado</option>
                            <option value="refunded">Reembolsado</option>
                        </select>
                        <button class="btn btn-primary" id="btnSaveStatus" type="button">Guardar</button>
                    </div>
                    <div class="save-msg" id="saveMsg"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ── Config ────────────────────────────────────────────────
        const PAGE_SIZE = 20;

        const STATUS_LABELS: Record<string, string> = {
            pending_payment: "Pendiente pago",
            paid: "Pagado",
            processing: "En proceso",
            shipped: "Enviado",
            delivered: "Entregado",
            cancelled: "Cancelado",
            refunded: "Reembolsado",
        };
        const STATUS_CLASS: Record<string, string> = {
            pending_payment: "status--pending",
            paid: "status--paid",
            processing: "status--confirmed",
            shipped: "status--confirmed",
            delivered: "status--paid",
            cancelled: "status--cancelled",
            refunded: "",
        };
        const esc = (v: unknown) =>
            String(v ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

        const fmtCOP = (n: number) =>
            new Intl.NumberFormat("es-CO", {
                style: "currency",
                currency: "COP",
                maximumFractionDigits: 0,
            }).format(n);
        const fmtDate = (s: string) =>
            s
                ? new Date(s).toLocaleDateString("es-CO", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric",
                      hour: "2-digit",
                      minute: "2-digit",
                  })
                : "-";
        const badge = (st: string) => {
            const cls = STATUS_CLASS[st] ?? "";
            return `<span class="status ${cls}">${esc(STATUS_LABELS[st] ?? st)}</span>`;
        };

        // ── State ─────────────────────────────────────────────────
        let currentPage = 0;
        let totalOrders = 0;
        let currentRef = "";

        const getFilters = () => ({
            status: (document.getElementById("fStatus") as HTMLSelectElement)
                .value,
            search: (
                document.getElementById("fSearch") as HTMLInputElement
            ).value.trim(),
        });

        // ── Load orders ───────────────────────────────────────────
        async function loadOrders(page = 0) {
            currentPage = page;
            const { status, search } = getFilters();
            const offset = page * PAGE_SIZE;
            const params = new URLSearchParams({
                limit: String(PAGE_SIZE),
                offset: String(offset),
            });
            if (status) params.set("status", status);

            const tbody = document.getElementById("ordersBody")!;
            tbody.innerHTML = `<tr><td colspan="8" class="ped-msg">Cargando...</td></tr>`;
            document.getElementById("summaryText")!.textContent = "Cargando...";

            try {
                const res = await fetch(`/api/orders?${params}`, {
                    credentials: "include",
                });
                if (!res.ok) throw new Error("Error al cargar");
                const data = await res.json();
                let rows: any[] = data.data ?? [];
                totalOrders = data.total ?? rows.length;

                // Client-side search filter
                if (search) {
                    const q = search.toLowerCase();
                    rows = rows.filter(
                        (o) =>
                            o.reference?.toLowerCase().includes(q) ||
                            o.customer_name?.toLowerCase().includes(q) ||
                            o.customer_email?.toLowerCase().includes(q),
                    );
                }

                document.getElementById("summaryText")!.textContent =
                    search ? `${rows.length} de ${totalOrders} pedidos` : `${totalOrders} pedidos`;

                if (rows.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" class="ped-msg">No hay pedidos con estos filtros.</td></tr>`;
                } else {
                    tbody.innerHTML = rows
                        .map(
                            (o) => `
            <tr>
              <td class="mono">${esc(o.reference ?? "-")}</td>
              <td>
                <div>${esc(o.customer_name ?? "-")}</div>
                <div class="ped-sub">${esc(o.customer_email ?? "")}</div>
              </td>
              <td>${esc(o.shipping_city ?? "-")}</td>
              <td class="num mono">${fmtCOP(Number(o.total_cop) || 0)}</td>
              <td class="ped-muted">${esc(o.payment_method ?? "-")}</td>
              <td>${badge(o.status)}</td>
              <td class="mono ped-muted ped-nowrap">${fmtDate(o.created_at)}</td>
              <td class="num">
                <button class="btn btn-sm btn-secondary btn-action" type="button" data-ref="${esc(o.reference)}" data-status="${esc(o.status)}">
                  Gestionar
                </button>
              </td>
            </tr>
          `,
                        )
                        .join("");

                    // Attach row click handlers
                    tbody.querySelectorAll(".btn-action").forEach((btn) => {
                        btn.addEventListener("click", () => {
                            const ref = (btn as HTMLElement).dataset.ref!;
                            const st = (btn as HTMLElement).dataset.status!;
                            openModal(
                                ref,
                                st,
                                rows.find((o) => o.reference === ref),
                            );
                        });
                    });
                }

                renderPagination();
            } catch {
                tbody.innerHTML = `<tr><td colspan="8" class="ped-msg">No se pudieron cargar los pedidos. Verifique su sesión.</td></tr>`;
            }
        }

        // ── Pagination ─────────────────────────────────────────────
        function renderPagination() {
            const total = Math.ceil(totalOrders / PAGE_SIZE);
            const pag = document.getElementById("pagination")!;
            if (total <= 1) {
                pag.innerHTML = "";
                return;
            }

            const pages = [];
            pages.push(
                `<button class="btn btn-sm btn-secondary" type="button" id="prevBtn" ${currentPage === 0 ? "disabled" : ""}>Anterior</button>`,
            );
            const start = Math.max(0, currentPage - 2);
            const end = Math.min(total - 1, currentPage + 2);
            for (let i = start; i <= end; i++) {
                pages.push(
                    `<button class="btn btn-sm btn-secondary mono" type="button" ${i === currentPage ? 'aria-current="page"' : ""} data-page="${i}">${i + 1}</button>`,
                );
            }
            pages.push(
                `<button class="btn btn-sm btn-secondary" type="button" id="nextBtn" ${currentPage >= total - 1 ? "disabled" : ""}>Siguiente</button>`,
            );
            pag.innerHTML = pages.join("");

            pag.querySelector("#prevBtn")?.addEventListener("click", () =>
                loadOrders(currentPage - 1),
            );
            pag.querySelector("#nextBtn")?.addEventListener("click", () =>
                loadOrders(currentPage + 1),
            );
            pag.querySelectorAll("[data-page]").forEach((btn) => {
                btn.addEventListener("click", () =>
                    loadOrders(Number((btn as HTMLElement).dataset.page)),
                );
            });
        }

        // ── Modal ─────────────────────────────────────────────────
        function openModal(ref: string, status: string, order: any) {
            currentRef = ref;
            document.getElementById("modalTitle")!.textContent =
                `Pedido ${ref}`;
            (document.getElementById("newStatus") as HTMLSelectElement).value =
                status;
            document.getElementById("saveMsg")!.textContent = "";

            const fields: [string, string][] = [
                ["Referencia", order?.reference ?? ref],
                ["Cliente", order?.customer_name ?? "-"],
                ["Correo", order?.customer_email ?? "-"],
                [
                    "Estado",
                    STATUS_LABELS[order?.status] ?? order?.status ?? "-",
                ],
                ["Total", fmtCOP(Number(order?.total_cop) || 0)],
                ["Método de pago", order?.payment_method ?? "-"],
                ["Ciudad", order?.shipping_city ?? "-"],
                ["Fecha", fmtDate(order?.created_at)],
            ];

            document.getElementById("modalDetails")!.innerHTML = fields
                .map(
                    ([l, v]) =>
                        `<div class="detail-row"><span class="detail-label">${esc(l)}</span><span class="detail-value">${esc(v)}</span></div>`,
                )
                .join("");

            document.getElementById("modalBack")!.classList.add("open");
        }

        // Close modal
        document.getElementById("modalClose")?.addEventListener("click", () => {
            document.getElementById("modalBack")!.classList.remove("open");
        });
        document.getElementById("modalBack")?.addEventListener("click", (e) => {
            if (e.target === e.currentTarget)
                document.getElementById("modalBack")!.classList.remove("open");
        });
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape")
                document.getElementById("modalBack")!.classList.remove("open");
        });

        // Save status
        document
            .getElementById("btnSaveStatus")
            ?.addEventListener("click", async () => {
                if (!currentRef) return;
                const status = (
                    document.getElementById("newStatus") as HTMLSelectElement
                ).value;
                const btn = document.getElementById(
                    "btnSaveStatus",
                ) as HTMLButtonElement;
                const msg = document.getElementById("saveMsg")!;
                btn.disabled = true;
                btn.textContent = "Guardando...";
                msg.textContent = "";
                msg.style.color = "";

                try {
                    const res = await fetch(
                        `/api/orders/${currentRef}/status`,
                        {
                            method: "PATCH",
                            credentials: "include",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ status }),
                        },
                    );
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error ?? "Error");
                    msg.textContent = "Estado actualizado.";
                    msg.style.color = "var(--ok)";
                    // Refresh table
                    await loadOrders(currentPage);
                } catch (err: any) {
                    msg.textContent = `No se pudo actualizar: ${err.message}`;
                    msg.style.color = "var(--danger)";
                } finally {
                    btn.disabled = false;
                    btn.textContent = "Guardar";
                }
            });

        // Filters
        document.getElementById("filtersForm")?.addEventListener("submit", (e) => {
            e.preventDefault();
            loadOrders(0);
        });
        document.getElementById("btnReset")?.addEventListener("click", () => {
            (document.getElementById("fStatus") as HTMLSelectElement).value =
                "";
            (document.getElementById("fSearch") as HTMLInputElement).value = "";
            loadOrders(0);
        });

        // ── Init ──────────────────────────────────────────────────
        // Check for ?ref= in URL
        const urlRef = new URLSearchParams(window.location.search).get("ref");
        if (urlRef) {
            (document.getElementById("fSearch") as HTMLInputElement).value =
                urlRef;
        }
        loadOrders(0);
    </script>
</AdminLayout>

<style is:global>
  /* Global y acotado a .pg-pedidos: la tabla y el modal se pintan con innerHTML. */
  .pg-pedidos .ped { display: flex; flex-direction: column; gap: 16px; }
  .pg-pedidos .ped-table { min-width: 860px; }
  .pg-pedidos .ped-sub { font-size: 12px; color: var(--muted); }
  .pg-pedidos .ped-muted { color: var(--muted); }
  .pg-pedidos .ped-nowrap { white-space: nowrap; }
  .pg-pedidos .ped-msg { padding: 32px 16px; color: var(--muted); }
  .pg-pedidos .ped-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .pg-pedidos .ped-pager:empty { display: none; }
  .pg-pedidos .ped-pager {
    display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 6px;
    padding: 10px 16px; border-top: 1px solid var(--rule);
  }
  .pg-pedidos .ped-pager [aria-current="page"] { background: var(--active-bg); color: var(--color-text); border-color: var(--rule-2); }

  /* Modal de gestión */
  .pg-pedidos .modal-back {
    display: none; position: fixed; inset: 0; z-index: 300;
    align-items: center; justify-content: center; padding: 16px;
    background: color-mix(in oklab, var(--shell-dark) 55%, transparent);
  }
  .pg-pedidos .modal-back.open { display: flex; }
  .pg-pedidos .modal {
    width: 100%; max-width: 560px; max-height: 90vh; overflow-y: auto;
    background: var(--paper); border: 1px solid var(--rule); border-radius: var(--radius);
    box-shadow: 0 20px 50px color-mix(in oklab, var(--color-primary) 25%, transparent);
  }
  .pg-pedidos .modal-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 14px 16px; border-bottom: 1px solid var(--rule);
  }
  .pg-pedidos .modal-header h2 { margin: 0; font-size: 16px; font-weight: 600; color: var(--color-text); }
  .pg-pedidos .modal-close {
    background: none; border: 0; cursor: pointer; color: var(--muted);
    font-size: 22px; line-height: 1; padding: 2px 6px; border-radius: var(--radius-sm);
  }
  .pg-pedidos .modal-close:hover { background: var(--hover); color: var(--color-text); }
  .pg-pedidos .modal-body { padding: 16px; }
  .pg-pedidos .detail-row {
    display: flex; justify-content: space-between; gap: 16px;
    padding: 8px 0; border-bottom: 1px solid var(--rule); font-size: 13px;
  }
  .pg-pedidos .detail-row:last-child { border-bottom: 0; }
  .pg-pedidos .detail-label { color: var(--muted); }
  .pg-pedidos .detail-value { color: var(--color-text); text-align: right; max-width: 60%; word-break: break-word; }
  .pg-pedidos .modal-section { margin-top: 20px; }
  .pg-pedidos .modal-section-title { font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 8px; }
  .pg-pedidos .status-form { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .pg-pedidos .status-form select {
    flex: 1; min-width: 160px; height: 36px; padding: 0 10px;
    border: 1px solid var(--rule-2); border-radius: var(--radius-sm);
    background: var(--paper); color: var(--color-text); font: inherit; font-size: 13px;
  }
  .pg-pedidos .save-msg { font-size: 12px; margin-top: 8px; }
</style>
