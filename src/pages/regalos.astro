---
import Layout from "../layouts/Layout.astro";
import GiftBox from "../components/shop/GiftBox.astro";
import Icon from "../components/Icon.astro";
import { getCanonicalUrl } from "../i18n/index.ts";
import { contentsOf, hasFreeShipping, FREE_SHIPPING_COP } from "../lib/gifts.ts";

let kits: any[] = [];
try {
  const { query } = await import("../../server/db.js");
  const result = await query(
    `SELECT
       id, slug, name, category, description,
       price, price_usd, rating,
       image_url AS image,
       stock_quantity AS stock,
       is_deal AS deal, is_bestseller AS bestseller, is_new AS new, is_fast AS fast
     FROM products
     WHERE is_gift_set = 1 AND is_active = 1
     ORDER BY price ASC`
  );
  kits = result.rows.map((p: any) => ({
    ...p,
    category: 'Regalos',
    notes: null,
  }));
} catch (_) { /* BD no disponible */ }

// Regla de envío: dónde cae cada kit respecto al umbral de envío gratis
const shipMax = Math.max(FREE_SHIPPING_COP, ...kits.map((k: any) => Number(k.price))) * 1.08;
const shipPct = (n: number) => (n / shipMax) * 100;
const freeKits = kits.filter((k: any) => hasFreeShipping(k.price)).map((k: any) => k.name);
const price = (n: number) => `$${Number(n).toLocaleString("es-CO")}`;
// Fuera del marcado: Astro lee "<" dentro de una expresión como inicio de etiqueta
const stockOf = (k: any) => {
  const n = Number(k.stock);
  return { out: n === 0, low: n > 0 && n <= 5 };
};
const freeKitsText =
  freeKits.length === 0 ? "" :
  freeKits.length === 1 ? `${freeKits[0]} ya incluye envío gratis.` :
  `${freeKits.slice(0, -1).join(", ")} y ${freeKits[freeKits.length - 1]} ya incluyen envío gratis.`;
---

<Layout
  title="Regalos · DobleYo Café"
  description="Kits de regalo con café de especialidad colombiano, en caja de regalo lista para entregar. Envío gratis desde $120.000."
  canonical={getCanonicalUrl('/regalos', 'es')}
>
  <div class="gifts-page">
    <!-- Encabezado oscuro con la caja que se abre -->
    <section class="gh" aria-labelledby="ghTitle">
      <div class="gh__inner">
        <div class="gh__copy">
          <nav class="gh__crumbs" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span aria-hidden="true">/</span>
            <span>Regalos</span>
          </nav>
          <h1 id="ghTitle" class="gh__title" data-split>Regale café <em>de origen colombiano.</em></h1>
          <p class="gh__lead">Kits curados con nuestros cafés de especialidad, en caja de regalo lista para entregar.</p>
          <ul class="gh__facts">
            <li><Icon name="gift" size={18} /> Caja de regalo incluida</li>
            <li><Icon name="truck" size={18} /> Envío gratis desde $120.000</li>
          </ul>
          {kits.length > 0 && (
            <a href="#kits" class="gh__cta">Ver los kits <Icon name="arrow-right" size={18} /></a>
          )}
        </div>
        <GiftBox kits={kits.map((k: any) => ({ id: k.id, name: k.name, price: Number(k.price) }))} />
      </div>
    </section>

    <!-- Kits -->
    <section id="kits" class="gk" aria-labelledby="gkTitle">
      <header class="gk__head">
        <p class="gk__eyebrow">Kits de regalo</p>
        <h2 id="gkTitle" class="gk__title">Elija el kit</h2>
      </header>

      {kits.length > 0 ? (
        <div class="gk__grid">
          {kits.map((k: any) => {
            const { out, low } = stockOf(k);
            return (
              <article class="kit">
                <a href={`/producto/${k.id}`} class="kit__media" tabindex="-1" aria-hidden="true">
                  <img src={k.image} alt="" loading="lazy" />
                  {hasFreeShipping(k.price) && <span class="kit__badge"><Icon name="truck" size={14} /> Envío gratis</span>}
                </a>
                <div class="kit__body">
                  <h3 class="kit__name"><a href={`/producto/${k.id}`}>{k.name}</a></h3>
                  <p class="kit__label">Qué trae</p>
                  <ul class="kit__contents">
                    {contentsOf(k.id).map((item) => (
                      <li><Icon name="check" size={16} /> {item}</li>
                    ))}
                  </ul>
                  <div class="kit__foot">
                    <div class="kit__price">
                      <span>{price(k.price)}</span>
                      {low && <small class="kit__stock">Quedan {k.stock}</small>}
                      {out && <small class="kit__stock kit__stock--out">Agotado</small>}
                    </div>
                    <button
                      class="kit__add"
                      data-add={k.id}
                      data-name={k.name}
                      data-price={k.price}
                      data-image={k.image}
                      disabled={out || undefined}
                    >
                      {out ? "Agotado" : "Agregar"}
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="gk__empty">
          <p>Próximamente: estamos preparando nuevos kits de regalo.</p>
          <a href="/tienda" class="gh__cta gh__cta--light">Ver la tienda <Icon name="arrow-right" size={18} /></a>
        </div>
      )}
    </section>

    <!-- Cómo llega -->
    <section class="gb" aria-labelledby="gbTitle">
      <h2 id="gbTitle" class="gb__title">Así llega su regalo</h2>
      <div class="gb__grid">
        <div class="gb__item">
          <span class="gb__icon"><Icon name="package" size={26} /></span>
          <h3>Empaque especial</h3>
          <p>Todos los kits vienen en caja de regalo lista para entregar.</p>
        </div>
        <div class="gb__item">
          <span class="gb__icon"><Icon name="truck" size={26} /></span>
          <h3>Envío a todo el país</h3>
          <p>Gratis en pedidos desde $120.000.</p>
          {kits.length > 0 && (
            <div class="ship" data-ship aria-hidden="true">
              <div class="ship__track">
                <span class="ship__free" style={`left:${shipPct(FREE_SHIPPING_COP)}%`}></span>
                <span class="ship__mark" style={`left:${shipPct(FREE_SHIPPING_COP)}%`}>$120.000</span>
                {kits.map((k: any) => (
                  <span
                    class:list={["ship__kit", { "is-free": hasFreeShipping(k.price) }]}
                    style={`left:${shipPct(Number(k.price))}%`}
                  ></span>
                ))}
              </div>
            </div>
          )}
          {freeKitsText && <p class="ship__note">{freeKitsText}</p>}
        </div>
        <div class="gb__item">
          <span class="gb__icon"><Icon name="map-pin" size={26} /></span>
          <h3>De origen único</h3>
          <p>Cada café viene de una sola finca colombiana.</p>
        </div>
      </div>
    </section>
  </div>

  <style>
    .gifts-page { --gw: 1200px; }

    /* ── Encabezado ─────────────────────────────────────────────────────── */
    .gh {
      background:
        radial-gradient(70% 90% at 80% 40%, rgba(var(--caramel-rgb), .22), transparent 70%),
        var(--espresso);
      color: var(--cream);
      overflow: hidden;
    }
    .gh__inner {
      max-width: var(--gw);
      margin: 0 auto;
      padding: var(--space-10) 1.25rem var(--space-12);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-10);
      align-items: center;
    }
    @media (min-width: 1024px) {
      .gh__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding-block: var(--space-16); }
    }
    .gh__crumbs { display: flex; gap: .5rem; font-size: var(--text-xs); color: rgba(var(--cream-rgb), .6); margin-bottom: var(--space-6); }
    .gh__crumbs a { color: rgba(var(--cream-rgb), .85); text-decoration: none; }
    .gh__crumbs a:hover { color: var(--mucilage); }
    .gh__title {
      font-family: var(--font-display);
      font-size: var(--text-hero);
      line-height: 1.02;
      letter-spacing: -.01em;
      margin: 0;
      color: var(--cream);
      text-wrap: balance;
    }
    .gh__title em { font-style: italic; color: var(--mucilage); }
    .gh__lead { margin: var(--space-5) 0 0; max-width: 42ch; color: rgba(var(--cream-rgb), .78); font-size: var(--text-lg); line-height: 1.55; }
    .gh__facts { list-style: none; margin: var(--space-6) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); }
    .gh__facts li { display: inline-flex; align-items: center; gap: .45rem; font-size: var(--text-sm); color: rgba(var(--cream-rgb), .85); }
    .gh__facts :global(svg) { color: var(--mucilage); }
    .gh__cta {
      display: inline-flex; align-items: center; gap: .5rem;
      margin-top: var(--space-8);
      padding: .8rem 1.4rem;
      border-radius: 999px;
      background: var(--cream);
      color: var(--espresso);
      font-weight: 700;
      text-decoration: none;
      transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .gh__cta:hover { background: var(--mucilage); }
    .gh__cta:focus-visible { outline: 2px solid var(--mucilage); outline-offset: 3px; }
    .gh__cta--light { background: var(--espresso); color: var(--cream); }

    /* ── Kits ───────────────────────────────────────────────────────────── */
    .gk { max-width: var(--gw); margin: 0 auto; padding: var(--space-16) 1.25rem var(--space-12); scroll-margin-top: 120px; }
    .gk__head { margin-bottom: var(--space-8); }
    .gk__eyebrow { margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--caramel); }
    .gk__title { margin: 0; font-family: var(--font-display); font-size: var(--text-3xl); color: var(--espresso); }
    .gk__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-6); }
    @media (min-width: 768px) { .gk__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (min-width: 1024px) { .gk__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

    .kit {
      display: flex;
      flex-direction: column;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
    }
    .kit:hover { box-shadow: 0 18px 40px -24px rgba(var(--espresso-rgb), .45); }
    .kit__media { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--sand); }
    .kit__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
    .kit:hover .kit__media img { transform: scale(1.04); }
    .kit__badge {
      position: absolute; left: var(--space-3); top: var(--space-3);
      display: inline-flex; align-items: center; gap: .35rem;
      padding: .3rem .65rem; border-radius: 999px;
      background: var(--leaf-bg); color: var(--leaf);
      font-size: var(--text-xs); font-weight: 700;
    }
    .kit__body { display: flex; flex-direction: column; flex: 1; padding: var(--space-5) var(--space-5) var(--space-6); }
    .kit__name { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); line-height: 1.2; }
    .kit__name a { color: var(--espresso); text-decoration: none; }
    .kit__name a:hover { color: var(--caramel-deep); }
    .kit__label { margin: var(--space-4) 0 var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
    .kit__contents { list-style: none; margin: 0; padding: 0; display: grid; gap: .4rem; }
    .kit__contents li { display: flex; align-items: flex-start; gap: .5rem; font-size: var(--text-sm); color: var(--espresso); line-height: 1.4; }
    .kit__contents :global(svg) { color: var(--leaf); flex-shrink: 0; margin-top: 1px; }
    .kit__foot { margin-top: auto; padding-top: var(--space-6); display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
    .kit__price { display: grid; }
    .kit__price span { font-family: var(--font-display); font-size: var(--text-2xl); color: var(--espresso); font-variant-numeric: tabular-nums; }
    .kit__stock { font-size: var(--text-xs); color: var(--caramel-deep); font-weight: 600; }
    .kit__stock--out { color: var(--danger); }
    .kit__add {
      padding: .7rem 1.3rem; min-height: 44px;
      border: 0; border-radius: 999px;
      background: var(--espresso); color: var(--cream);
      font-family: var(--font-body); font-size: var(--text-sm); font-weight: 700;
      cursor: pointer;
      transition: background var(--dur) var(--ease);
    }
    .kit__add:hover { background: var(--caramel-deep); }
    .kit__add:focus-visible { outline: 2px solid var(--caramel); outline-offset: 2px; }
    .kit__add:disabled { opacity: .5; cursor: not-allowed; }
    .gk__empty { text-align: center; padding: var(--space-12) 0; color: var(--ink-muted); }

    /* ── Así llega ──────────────────────────────────────────────────────── */
    .gb { max-width: var(--gw); margin: 0 auto var(--space-16); padding: 0 1.25rem; }
    .gb__title { margin: 0 0 var(--space-6); font-family: var(--font-display); font-size: var(--text-2xl); color: var(--espresso); }
    .gb__grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      background: var(--sand);
      border-radius: var(--radius-lg);
      overflow: hidden;
    }
    @media (min-width: 768px) { .gb__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    .gb__item { padding: var(--space-8) var(--space-6); }
    .gb__item + .gb__item { border-top: 1px solid var(--border); }
    @media (min-width: 768px) { .gb__item + .gb__item { border-top: 0; border-left: 1px solid var(--border); } }
    .gb__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--card); color: var(--caramel); margin-bottom: var(--space-4); }
    .gb__item h3 { margin: 0 0 var(--space-2); font-size: var(--text-base); color: var(--espresso); }
    .gb__item p { margin: 0; font-size: var(--text-sm); color: var(--ink-muted); line-height: 1.5; }

    /* Regla de envío: dónde cae cada kit respecto al umbral */
    .ship { margin: var(--space-5) 0 0; max-width: 280px; padding-right: var(--space-4); }
    .ship__track { position: relative; height: 6px; border-radius: 99px; background: var(--border); }
    .ship__free { position: absolute; top: 0; bottom: 0; right: 0; border-radius: 0 99px 99px 0; background: color-mix(in srgb, var(--leaf) 30%, var(--leaf-bg)); }
    .ship__mark { position: absolute; top: 14px; transform: translateX(-50%); font-size: .7rem; font-weight: 700; color: var(--leaf); white-space: nowrap; }
    .ship__mark::before { content: ""; position: absolute; left: 50%; top: -17px; width: 2px; height: 14px; background: var(--leaf); }
    .ship__kit { position: absolute; top: 50%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--caramel); box-shadow: 0 0 0 3px var(--sand); }
    .ship__kit.is-free { background: var(--leaf); }
    .gb__item .ship__note { margin-top: var(--space-8); font-size: var(--text-xs); color: var(--leaf); font-weight: 600; }
  </style>
  <script>
    import "../scripts/shop/index.ts";
  </script>
</Layout>
