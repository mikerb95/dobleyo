---
/**
 * "Del grano a tu taza": el recorrido del lote destacado en cuatro capítulos,
 * cada uno con una fotografía real y la ficha técnica del lote en ese punto.
 *
 *   01 Cosecha     finca, origen, altitud, fecha de cosecha
 *   02 Beneficio   proceso y variedad
 *   03 Tueste      nivel, temperatura, duración y fecha
 *   04 En tu taza  sin ficha: cierra con la foto
 *
 * Maqueta por defecto (sin JS, móvil, movimiento reducido): cada capítulo con
 * su foto encima o al lado, todo visible. En escritorio el script activa
 * `.tj--sticky`: las fotos pasan a una columna fija y cambian según el
 * capítulo que se está leyendo.
 */
import type { Lang } from "../../i18n/index.ts";
import { t } from "../../i18n/index.ts";
import type { LotView } from "../../lib/lot.ts";
import { processKind } from "../../lib/lot.ts";
import QrCode from "./QrCode.astro";
import { SHOW_TRACEABILITY } from "../../lib/flags.ts";

interface Props {
  lang: Lang;
  lot: LotView;
}

const { lang, lot } = Astro.props;
const k = (key: string) => t(`home.journey.${key}`, lang);
const kh = (key: string) => t(`home.hero.${key}`, lang);

// Solo las filas con dato: un lote sin fecha de cosecha no muestra la fila vacía.
const rows = (pairs: [string, string | number | null | undefined][]) =>
  pairs.filter((row): row is [string, string] => Boolean(row[1])).map(([label, value]) => [k(label), String(value)]);

const chapters = [
  {
    photo: "origen-cosecha",
    position: "50% 45%",
    data: rows([
      ["data_farm", lot.farm],
      ["data_place", lot.region],
      ["data_altitude", lot.altitudeLabel],
      ["data_harvest", lot.harvestDate],
    ]),
  },
  {
    photo: "proceso-verde",
    position: "58% 50%",
    desc: k(`process_${processKind(lot.process)}`),
    data: rows([
      ["data_process", lot.process],
      ["data_variety", lot.variety],
    ]),
  },
  {
    photo: "tueste-enfriado",
    position: "45% 50%",
    data: rows([
      ["data_level", lot.roastLevel],
      ["data_temp", lot.roastTemp && `${lot.roastTemp} °C`],
      ["data_time", lot.roastMinutes && `${lot.roastMinutes} min`],
      ["data_date", lot.roastDate],
    ]),
  },
  {
    photo: "taza-filtrado",
    position: "40% 50%",
    data: [],
  },
].map((c, i) => ({
  ...c,
  num: String(i + 1).padStart(2, "0"),
  title: k(`step_${i + 1}_title`),
  desc: c.desc ?? k(`step_${i + 1}_desc`),
  alt: k(`photo_${i + 1}`),
}));

const traceHref = lang === "en" ? "/en/traceability" : `/trazabilidad?lote=${encodeURIComponent(lot.code)}`;
---

<section class="tj" id="viaje" data-journey aria-labelledby="tjTitle">
  <header class="tj__head">
    <p class="tj__eyebrow">{k("eyebrow")}</p>
    <h2 id="tjTitle" class="tj__title">{k("title")}</h2>
    <p class="tj__sub">{k("sub")}</p>
    <p class="tj__lot">
      {lot.illustrative ? kh("illustrative") : <>{k("lot_label")} <strong>{[lot.farm, lot.region.split(", ").pop()].filter(Boolean).join(", ")}</strong></>}
    </p>
  </header>

  <div class="tj__body" data-journey-body>
    <ol class="tj__chapters">
      {chapters.map((c, i) => (
        <li class="tj__chapter" data-chapter={i}>
          <figure class="tj__photo">
            <picture>
              <source media="(max-width: 767px)" srcset={`/assets/img/${c.photo}-sm.webp`} />
              <img
                src={`/assets/img/${c.photo}.webp`}
                alt={c.alt}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
                style={`object-position: ${c.position}`}
              />
            </picture>
          </figure>
          <div class="tj__text">
            <p class="tj__num" aria-hidden="true">{c.num}</p>
            <h3 class="tj__chapter-title">{c.title}</h3>
            <p class="tj__desc">{c.desc}</p>
            {c.data.length > 0 && (
              <dl class="tj__data">
                {c.data.map(([label, value]) => (
                  <div>
                    <dt>{label}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </li>
      ))}
    </ol>

    <div class="tj__media" aria-hidden="true">
      {chapters.map((c, i) => (
        <figure class:list={["tj__frame", { "is-active": i === 0 }]} data-frame={i}>
          <img src={`/assets/img/${c.photo}.webp`} alt="" width="1600" height="900" loading="lazy" decoding="async" style={`object-position: ${c.position}`} />
        </figure>
      ))}
      <p class="tj__counter"><span data-counter>01</span> / 04</p>
    </div>
  </div>

  {SHOW_TRACEABILITY && (
    <div class="tcta" data-trace-cta>
      <div class="tcta__glow" aria-hidden="true"></div>
      <a class="tcta__qr" href={traceHref} aria-label={`${k("cta_button")}: ${lot.code}`}>
        <QrCode text={lot.qrUrl} />
        <span class="tcta__scan" aria-hidden="true"></span>
      </a>
      <div class="tcta__copy">
        <p class="tcta__eyebrow">{k("cta_eyebrow")}</p>
        <h3 class="tcta__title">{k("cta_title_1")}<br />{k("cta_title_2")}</h3>
        <p class="tcta__sub">{k("cta_sub")}</p>
        <div class="tcta__actions">
          <a href={traceHref} class="btn tcta__btn" data-magnetic><span data-magnetic-inner>{k("cta_button")}</span></a>
          <span class="tcta__hint">{k("cta_hint")}</span>
        </div>
        <p class="tcta__try">{k("cta_try")} <code>{lot.code}</code></p>
      </div>
    </div>
  )}
</section>

<style>
  .tj {
    padding: 6rem 0 5rem;
    border-top: 1px solid var(--border);
  }

  /* ── Encabezado ─────────────────────────────────────────────────────── */
  .tj__head { display: grid; gap: 1.25rem; margin: 0 0 4rem; }
  .tj__eyebrow {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin: 0;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .tj__eyebrow::before { content: ""; width: 2rem; height: 1px; background: currentColor; }
  .tj__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 1.4rem + 3.4vw, 3.9rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -.02em;
    color: var(--coffee);
  }
  .tj__sub { margin: 0; max-width: 40ch; font-size: 1.05rem; line-height: 1.65; color: var(--muted-fg); }
  .tj__lot {
    margin: 0;
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted-fg);
  }
  .tj__lot strong { margin-left: .35rem; font-weight: 600; color: var(--coffee); font-variant-numeric: tabular-nums; }
  @media (min-width: 1024px) {
    .tj__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-areas: "eyebrow eyebrow" "title sub" "title lot";
      column-gap: clamp(3rem, 6vw, 6rem);
      align-items: end;
      margin-bottom: 5rem;
    }
    .tj__eyebrow { grid-area: eyebrow; }
    .tj__title { grid-area: title; }
    .tj__sub { grid-area: sub; }
    .tj__lot { grid-area: lot; }
  }

  /* ── Capítulos (maqueta por defecto) ────────────────────────────────── */
  .tj__chapters { list-style: none; margin: 0; padding: 0; display: grid; gap: 4.5rem; }
  .tj__chapter { display: grid; gap: 1.75rem; align-items: center; }
  .tj__photo {
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--espresso);
  }
  .tj__photo picture,
  .tj__photo img { display: block; width: 100%; height: 100%; }
  .tj__photo img { object-fit: cover; }
  @media (min-width: 768px) {
    .tj__chapter { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 3rem; }
    .tj__photo { order: 2; }
  }

  .tj__num {
    display: flex;
    align-items: center;
    gap: .85rem;
    margin: 0 0 1.1rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .tj__num::after { content: ""; width: 2.5rem; height: 1px; background: currentColor; opacity: .45; }
  .tj__chapter-title {
    margin: 0 0 .9rem;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.4rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.015em;
    color: var(--coffee);
  }
  .tj__desc { margin: 0 0 1.75rem; max-width: 40ch; font-size: 1rem; line-height: 1.7; color: var(--muted-fg); }
  .tj__data { margin: 0; max-width: 24rem; border-top: 1px solid var(--border); }
  .tj__data div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding: .7rem 0;
    border-bottom: 1px solid var(--border);
  }
  .tj__data dt {
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted-fg);
  }
  .tj__data dd {
    margin: 0;
    font-size: .92rem;
    font-weight: 500;
    text-align: right;
    color: var(--coffee);
    font-variant-numeric: tabular-nums;
  }

  .tj__media { display: none; }

  /* ── Columna fija (escritorio con JS, lo activa el script) ──────────── */
  :global(.tj--sticky) .tj__body {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    column-gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
  }
  :global(.tj--sticky) .tj__chapters { gap: 0; }
  :global(.tj--sticky) .tj__chapter {
    display: flex;
    align-items: center;
    min-height: min(66vh, 620px);
  }
  :global(.tj--sticky) .tj__photo { display: none; }
  :global(.tj--sticky) .tj__text { opacity: .28; transition: opacity .7s var(--ease); }
  :global(.tj--sticky) .tj__chapter.is-active .tj__text { opacity: 1; }

  :global(.tj--sticky) .tj__media {
    display: block;
    position: sticky;
    top: var(--pin-top, 120px);
    height: min(calc(100vh - var(--pin-top, 120px) - 2.5rem), 760px);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--espresso);
  }
  .tj__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(to top, rgba(var(--espresso-rgb), .5), transparent 28%);
    pointer-events: none;
  }
  .tj__frame {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 1.1s var(--ease);
  }
  .tj__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    transition: transform 2.6s cubic-bezier(.2, .6, .2, 1);
  }
  .tj__frame.is-active { z-index: 1; opacity: 1; }
  .tj__frame.is-active img { transform: scale(1); }
  .tj__counter {
    position: absolute;
    z-index: 3;
    left: 1.5rem;
    bottom: 1.25rem;
    margin: 0;
    font-size: .72rem;
    letter-spacing: .16em;
    color: rgba(var(--cream-rgb), .65);
    font-variant-numeric: tabular-nums;
  }
  .tj__counter span { color: var(--cream); font-weight: 600; }

  /* ── CTA de trazabilidad ─────────────────────────────────────────────── */
  .tcta {
    position: relative;
    margin-top: 4rem;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 2.75rem;
    background: var(--coffee);
    border-radius: 1.25rem;
    padding: 2.75rem 3rem;
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgba(var(--espresso-rgb), .5);
  }
  .tcta__glow {
    position: absolute;
    top: -40%;
    right: -10%;
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, rgba(var(--caramel-rgb), .32) 0%, rgba(var(--caramel-rgb), 0) 70%);
    pointer-events: none;
  }
  .tcta__qr {
    position: relative;
    z-index: 1;
    display: block;
    width: 172px;
    padding: 12px;
    background: var(--cream);
    color: var(--espresso) !important;
    border-radius: 1rem;
    overflow: hidden;
    transition: transform var(--dur) var(--ease);
  }
  .tcta__qr:hover { transform: scale(1.03); }
  .tcta__scan {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 8%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    box-shadow: 0 0 12px 2px rgba(var(--caramel-rgb), .6);
    opacity: 0;
  }
  .tcta__copy { position: relative; z-index: 1; }
  .tcta__eyebrow {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 .75rem;
  }
  .tcta__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--cream);
    margin: 0 0 .9rem;
  }
  .tcta__sub { font-size: .95rem; line-height: 1.65; color: rgba(var(--cream-rgb), .7); margin: 0 0 1.6rem; max-width: 56ch; }
  .tcta__actions { display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap; }
  .tcta__btn { background: var(--accent); color: var(--accent-contrast); box-shadow: 0 10px 24px -8px rgba(var(--caramel-rgb), .7); }
  .tcta__btn span { display: inline-block; }
  .tcta__hint { font-size: .78rem; letter-spacing: .04em; color: rgba(var(--cream-rgb), .5); }
  .tcta__try { margin: 1.1rem 0 0; font-size: .8rem; color: rgba(var(--cream-rgb), .6); }
  .tcta__try code {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: .06em;
    color: var(--cream);
    background: rgba(var(--cream-rgb), .08);
    border-radius: 4px;
    padding: .1rem .4rem;
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .tj { padding: 4rem 0 3.5rem; }
    .tj__head { margin-bottom: 3rem; }
    .tj__chapters { gap: 3.5rem; }
    .tj__chapter { gap: 1.25rem; }
    .tcta {
      grid-template-columns: 1fr;
      text-align: center;
      padding: 2.25rem 1.5rem;
      gap: 1.75rem;
      margin-top: 3rem;
    }
    .tcta__qr { justify-self: center; width: 148px; }
    .tcta__sub { margin-left: auto; margin-right: auto; }
    .tcta__actions { justify-content: center; }
  }
</style>
