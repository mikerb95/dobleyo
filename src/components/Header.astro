---
import { Image } from "astro:assets";
import type { Lang } from "../i18n/index.ts";
import LangToggle from "./LangToggle.astro";
import logo from "../assets/logo.png";
import { SHOW_TRACEABILITY } from "../lib/flags.ts";

interface Props { lang?: Lang; }
const { lang = "es" } = Astro.props;

// Navegación por idioma. En el subdominio en. las rutas planas (/shop, /cart…)
// se reescriben a /en/* vía vercel.json, por eso van sin prefijo /en.
const NAV = {
  es: [
    { href: "/", label: "Inicio" },
    { href: "/tienda", label: "Tienda" },
    { href: "/cacao", label: "Cacao" },
    { href: "/suscripcion", label: "Suscripción" },
    { href: "/regalos", label: "Regalos" },
    { href: "/blog", label: "Blog" },
    ...(SHOW_TRACEABILITY ? [{ href: "/trazabilidad", label: "Trazabilidad" }] : []),
    { href: "/envios-devoluciones", label: "Envíos" },
  ],
  en: [
    { href: "/", label: "Home" },
    { href: "/shop", label: "Shop" },
    { href: "/wholesale", label: "Wholesale" },
    ...(SHOW_TRACEABILITY ? [{ href: "/traceability", label: "Traceability" }] : []),
    { href: "/contact", label: "Contact" },
  ],
};
const L = {
  es: { cart: "Carrito de compras", cartEmpty: "Tu carrito está vacío", profile: "Perfil",
        apps: "Panel de apps", products: "Productos", audit: "Auditoría",
        logout: "Cerrar sesión", login: "Iniciar sesión", register: "Registrarse",
        account: "Mi Cuenta", menu: "Menú de usuario",
        search: "Buscar", searchOpen: "Buscar en el catálogo",
        searchPlaceholder: "Busque por café, origen, proceso o nota de cata",
        searchClose: "Cerrar búsqueda",
        searchAll: "Ver todos los resultados",
        searchEmpty: "No encontramos productos para esa búsqueda",
        searchHint: "Escriba al menos dos caracteres",
        searchError: "No fue posible completar la búsqueda. Intente de nuevo.",
        searchShortcut: "Buscar (/)",
        search_ui: {
          recent: "Búsquedas recientes", clearRecent: "Borrar", removeRecent: "Quitar de recientes",
          origins: "Orígenes", processes: "Procesos", notes: "Notas de cata",
          popular: "Los más pedidos", suggestions: "Sugerencias",
          origin: "origen", process: "proceso", note: "nota",
          one: "producto", many: "productos", outOfStock: "Agotado",
          keysMove: "navegar", keysOpen: "abrir", keysClose: "cerrar",
          clear: "Borrar texto",
        } },
  en: { cart: "Shopping cart", cartEmpty: "Your cart is empty", profile: "Profile",
        apps: "Apps panel", products: "Products", audit: "Audit",
        logout: "Sign out", login: "Sign in", register: "Sign up",
        account: "My Account", menu: "User menu",
        search: "Search", searchOpen: "Search the catalog",
        searchPlaceholder: "Search by coffee, origin, process or tasting note",
        searchClose: "Close search",
        searchAll: "See all results",
        searchEmpty: "No products matched that search",
        searchHint: "Type at least two characters",
        searchError: "The search could not be completed. Please try again.",
        searchShortcut: "Search (/)",
        search_ui: {
          recent: "Recent searches", clearRecent: "Clear", removeRecent: "Remove from recent",
          origins: "Origins", processes: "Processes", notes: "Tasting notes",
          popular: "Most popular", suggestions: "Suggestions",
          origin: "origin", process: "process", note: "note",
          one: "product", many: "products", outOfStock: "Sold out",
          keysMove: "navigate", keysOpen: "open", keysClose: "close",
          clear: "Clear text",
        } },
};
const nav = NAV[lang] ?? NAV.es;
const tx = L[lang] ?? L.es;
const homeHref = "/";
const cartHref = "/cart";
const accountHref = lang === "en" ? "/account" : "/cuenta";
const searchHref = lang === "en" ? "/search" : "/buscar";
---


<header class="site-header" id="siteHeader" transition:persist={`header-${lang}`} data-lang={lang} data-cart-empty={tx.cartEmpty} data-account-href={accountHref} data-menu-label={tx.menu}>
  <div class="container">
    <div class="nav-beans" aria-hidden="true"></div>
    <a class="brand" href={homeHref}>
      <Image src={logo} alt="DobleYo" height={80} width={80} loading="eager" />
    </a>
    <nav class="nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="actions">
      <button
        class="icon-btn"
        id="searchBtn"
        aria-label={tx.searchOpen}
        title={tx.searchShortcut}
        aria-keyshortcuts="/ Control+K Meta+K"
        aria-expanded="false"
        aria-controls="searchPanel"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
          <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
      <LangToggle lang={lang} />
      <div class="cart-preview-wrap" id="cartPreviewWrap">
        <a href={cartHref} class="icon-btn" aria-label={tx.cart}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 8h14l-1.1 11.1a2 2 0 01-2 1.9H8.1a2 2 0 01-2-1.9L5 8z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9 10V7a3 3 0 016 0v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="badge" id="cartCount" data-count="0">0</span>
        </a>
        <div class="cart-preview" id="cartPreview" role="tooltip" aria-live="polite">
          <div class="cart-preview-inner" id="cartPreviewInner">
            <p class="cart-preview-empty">{tx.cartEmpty}</p>
          </div>
        </div>
      </div>
      <div class="user-dropdown" id="userDropdown">
        <button
          class="icon-btn user-btn"
          aria-label={tx.menu}
          aria-haspopup="true"
          aria-expanded="false"
          id="userNavBtn"
        >
          <span id="userNameDisplay" class="user-name" style="display: none;"></span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
            <path d="M4.5 20c.9-3.5 3.9-5.5 7.5-5.5s6.6 2 7.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="dropdown-menu" id="userDropdownMenu">
          <!-- Opciones autenticado -->
          <div id="authenticatedMenu" style="display: none;">
            <a href={accountHref} class="dropdown-item">{tx.profile}</a>
            <a
              href="/admin"
              class="dropdown-item"
              id="appsLink"
              style="display: none;">{tx.apps}</a
            >
            <a
              href="/admin/productos"
              class="dropdown-item"
              id="productosLink"
              style="display: none;">{tx.products}</a
            >
            <a
              href="/admin/auditoria"
              class="dropdown-item"
              id="auditLink"
              style="display: none;">{tx.audit}</a
            >
            <button class="dropdown-item" id="logoutBtn">{tx.logout}</button>
          </div>
          <!-- Opciones no autenticado -->
          <div
            id="unauthenticatedMenu"
            style="display: flex; flex-direction: column;"
          >
            <button class="dropdown-item" id="openLoginModal">{tx.login}</button>
            <button class="dropdown-item" id="openRegisterModal">{tx.register}</button>
          </div>
        </div>
      </div>
      <button id="menuBtn" class="hamburger" aria-label={tx.menu} aria-expanded="false" aria-controls="mobileMenu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path class="hamburger__line hamburger__line--top" d="M4 7h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path class="hamburger__line hamburger__line--mid" d="M4 12h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          <path class="hamburger__line hamburger__line--bot" d="M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
  <!--
    Buscador. El formulario apunta a /buscar (o /search) con method GET, así que
    funciona sin JavaScript; el panel de sugerencias es una mejora progresiva.
  -->
  <div class="search-panel" id="searchPanel" hidden>
    <div class="search-sheet">
      <form class="search-form" id="searchForm" action={searchHref} method="get" role="search">
        <div class="search-field">
          <label class="sr-only" for="searchInput">{tx.searchOpen}</label>
          <span class="search-field__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.6" />
              <path d="M16.5 16.5L21 21" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
            <span class="search-field__spinner"></span>
          </span>
          <input
            type="search"
            id="searchInput"
            name="q"
            class="search-field__input"
            placeholder={tx.searchPlaceholder}
            autocomplete="off"
            enterkeyhint="search"
            spellcheck="false"
            role="combobox"
            aria-expanded="false"
            aria-controls="searchResults"
            aria-autocomplete="list"
          />
          <button type="button" class="search-field__clear" id="searchClear" aria-label={tx.search_ui.clear} hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
          </button>
          <button type="submit" class="search-field__submit">
            <span class="search-field__submit-label">{tx.search}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
        <button type="button" class="search-form__close" id="searchClose" aria-label={tx.searchClose}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </form>

      <div class="search-body">
        <div class="search-idle" id="searchIdle" aria-live="polite"></div>
        <div
          class="search-results"
          id="searchResults"
          role="listbox"
          aria-label={tx.searchOpen}
          data-href={searchHref}
          data-lang={lang}
          data-all={tx.searchAll}
          data-empty={tx.searchEmpty}
          data-hint={tx.searchHint}
          data-error={tx.searchError}
          hidden
        ></div>
      </div>

      <div class="search-foot" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> {tx.search_ui.keysMove}</span>
        <span><kbd>Enter</kbd> {tx.search_ui.keysOpen}</span>
        <span><kbd>Esc</kbd> {tx.search_ui.keysClose}</span>
      </div>
    </div>
    <script is:inline type="application/json" id="searchI18n" set:html={JSON.stringify(tx.search_ui)} />
  </div>

  <div class="mobile-menu" id="mobileMenu" hidden>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}

    <div class="mobile-lang"><LangToggle lang={lang} size="md" /></div>

    <!-- Opciones autenticado en móvil -->
    <div id="mobileAuthenticatedMenu" style="display: none;">
      <a href={accountHref} class="user-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M4.5 20c.9-3.5 3.9-5.5 7.5-5.5s6.6 2 7.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span id="userNameMobileDisplay" style="display: none;"></span>
        <span id="userMobileLabel">{tx.account}</span>
      </a>
      <a href="/admin" class="user-btn" id="mobileAppsLink" style="display: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="4" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <rect x="13" y="4" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <rect x="4" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
          <rect x="13" y="13" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <span>{tx.apps}</span>
      </a>
      <button type="button" class="user-btn user-btn--logout" id="mobileLogoutBtn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14 4h4a2 2 0 012 2v12a2 2 0 01-2 2h-4M10 16l-4-4 4-4M6 12h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>{tx.logout}</span>
      </button>
    </div>

    <!-- Opciones no autenticado en móvil -->
    <div
      id="mobileUnauthenticatedMenu"
      style="display: flex; flex-direction: column;"
    >
      <button type="button" class="user-btn" id="mobileOpenLoginModal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M4.5 20c.9-3.5 3.9-5.5 7.5-5.5s6.6 2 7.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>{tx.login}</span>
      </button>
      <button type="button" class="user-btn" id="mobileOpenRegisterModal">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="10" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M3 20c.9-3.5 3.6-5.5 7-5.5 1.3 0 2.5.3 3.5.8M18 14v6M15 17h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <span>{tx.register}</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Lógica del Header (granos, menú, auth, dropdown, cart preview).
  // El <header> se persiste entre navegaciones (transition:persist), así que
  // los bindings sobreviven. Este init es idempotente y se re-ejecuta en
  // astro:page-load para el único caso en que el header se re-renderiza:
  // el cambio de idioma ES↔EN (nombres de persistencia distintos).
  function initHeader() {
  const headerRoot = document.getElementById("siteHeader");
  if (!headerRoot || headerRoot.dataset.jsInit) return;
  headerRoot.dataset.jsInit = "1";

  // ── Buscador ───────────────────────────────────────────────────────────────
  // Sin escribir: búsquedas recientes, orígenes, procesos y notas reales del
  // catálogo y los más pedidos (/api/products/search/suggest). Escribiendo:
  // atajos a esas facetas (sin importar tildes) y productos en vivo de
  // /api/products/search. El formulario sigue funcionando sin JavaScript.
  (function initSearch() {
    const btn      = document.getElementById("searchBtn");
    const panel    = document.getElementById("searchPanel");
    const form     = document.getElementById("searchForm");
    const input    = document.getElementById("searchInput");
    const closeBtn = document.getElementById("searchClose");
    const clearBtn = document.getElementById("searchClear");
    const results  = document.getElementById("searchResults");
    const idle     = document.getElementById("searchIdle");
    if (!btn || !panel || !form || !input || !results || !idle) return;

    let ui = {};
    try { ui = JSON.parse(document.getElementById("searchI18n")?.textContent || "{}"); } catch (_) {}

    const searchHref = results.dataset.href || "/buscar";
    const lang       = results.dataset.lang === "en" ? "en" : "es";
    const MIN_CHARS  = 2;
    const SHOWN      = 6;
    const RECENT_KEY = "dy-search-recent";
    const RECENT_MAX = 6;

    let controller = null;
    let debounceId = 0;
    let activeIndex = -1;
    let facets = null;
    let facetsPromise = null;

    const money = (p) =>
      lang === "en"
        ? `US$${Number(p.price_usd ?? 0).toLocaleString("en-US")}`
        : `$${Number(p.price ?? 0).toLocaleString("es-CO")}`;

    const escapeHtml = (s) =>
      String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      })[c]);

    // Minúsculas y sin tildes: "narino" encuentra "Nariño".
    const fold = (s) =>
      String(s ?? "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

    // Resalta el término sin importar tildes ni mayúsculas. Solo cuando el
    // texto conserva su longitud al quitar tildes (el caso normal en español),
    // para que los índices coincidan con el original.
    function highlight(text, q) {
      const t = String(text ?? "");
      const ft = fold(t);
      const fq = fold(String(q ?? "").trim());
      const i = fq && ft.length === t.length ? ft.indexOf(fq) : -1;
      if (i < 0) return escapeHtml(t);
      return (
        escapeHtml(t.slice(0, i)) +
        `<mark>${escapeHtml(t.slice(i, i + fq.length))}</mark>` +
        escapeHtml(t.slice(i + fq.length))
      );
    }

    const hrefFor = (term) => `${searchHref}?q=${encodeURIComponent(term)}`;
    const productHref = (p) => `/producto/${encodeURIComponent(p.slug || p.id)}`;
    const productName = (p) => (lang === "en" && p.name_en) || p.name;
    const isOut = (p) => p.stock !== null && p.stock !== undefined && Number(p.stock) <= 0;

    const ICON_CLOCK = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 8v4l2.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`;
    const ICON_X = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>`;
    const ICON_ARROW = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

    // ── Recientes (solo en este navegador) ──
    function readRecent() {
      try {
        const v = JSON.parse(localStorage.getItem(RECENT_KEY) || "[]");
        return Array.isArray(v) ? v.filter((x) => typeof x === "string").slice(0, RECENT_MAX) : [];
      } catch (_) {
        return [];
      }
    }
    function writeRecent(list) {
      try { localStorage.setItem(RECENT_KEY, JSON.stringify(list.slice(0, RECENT_MAX))); } catch (_) {}
    }
    function remember(term) {
      const t = String(term ?? "").trim();
      if (t.length < MIN_CHARS) return;
      writeRecent([t, ...readRecent().filter((x) => fold(x) !== fold(t))]);
    }

    // ── Facetas y más pedidos: se piden una vez por carga ──
    function loadFacets() {
      if (facetsPromise) return facetsPromise;
      facetsPromise = fetch("/api/products/search/suggest", { headers: { Accept: "application/json" } })
        .then((r) => (r.ok ? r.json() : null))
        .then((j) => (facets = j && j.success ? j.data : null))
        .catch(() => {
          facetsPromise = null;
          return null;
        });
      return facetsPromise;
    }

    const facetNotes = () => (facets ? (lang === "en" ? facets.notesEn : facets.notes) || [] : []);

    const chip = (value, kind, q = "") =>
      `<a class="search-opt search-chip search-chip--${kind}" href="${hrefFor(value)}" data-term="${escapeHtml(value)}">` +
      `${highlight(value, q)}${q ? `<small>${escapeHtml(ui[kind] || "")}</small>` : ""}</a>`;

    function renderIdle() {
      const recent = readRecent();
      const sections = [];

      if (recent.length) {
        sections.push(`
          <section class="search-sec">
            <div class="search-sec__head">
              <h3 class="search-sec__title">${escapeHtml(ui.recent)}</h3>
              <button type="button" class="search-sec__action" data-clear-recent>${escapeHtml(ui.clearRecent)}</button>
            </div>
            <ul class="search-recent">
              ${recent.map((r) => `
                <li class="search-recent__item">
                  <a class="search-opt search-recent__link" href="${hrefFor(r)}" data-term="${escapeHtml(r)}">${ICON_CLOCK}<span>${escapeHtml(r)}</span></a>
                  <button type="button" class="search-recent__remove" data-remove-recent="${escapeHtml(r)}" aria-label="${escapeHtml(`${ui.removeRecent}: ${r}`)}">${ICON_X}</button>
                </li>`).join("")}
            </ul>
          </section>`);
      }

      if (facets) {
        const groups = [
          [ui.origins, facets.origins, "origin"],
          [ui.processes, facets.processes, "process"],
          [ui.notes, facetNotes(), "note"],
        ].filter(([, list]) => list && list.length);

        if (groups.length) {
          sections.push(`
            <section class="search-sec search-facets">
              ${groups.map(([title, list, kind]) => `
                <div class="search-facet">
                  <h3 class="search-sec__title">${escapeHtml(title)}</h3>
                  <div class="search-chips">${list.map((x) => chip(x.value, kind)).join("")}</div>
                </div>`).join("")}
            </section>`);
        }

        if (facets.popular && facets.popular.length) {
          sections.push(`
            <section class="search-sec">
              <h3 class="search-sec__title">${escapeHtml(ui.popular)}</h3>
              <div class="search-popular">
                ${facets.popular.map((p) => `
                  <a class="search-opt search-pop" href="${productHref(p)}">
                    <span class="search-pop__img"><img src="${escapeHtml(p.image || "/assets/logo.png")}" alt="" loading="lazy" width="160" height="160"></span>
                    <span class="search-pop__name">${escapeHtml(productName(p))}</span>
                    <span class="search-pop__price">${money(p)}</span>
                  </a>`).join("")}
              </div>
            </section>`);
        }
      }

      idle.innerHTML = sections.join("");
      activeIndex = -1;
    }

    // ── Estados del panel ──
    function showIdle() {
      results.hidden = true;
      results.innerHTML = "";
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      idle.hidden = false;
      renderIdle();
    }

    function showResults() {
      idle.hidden = true;
      results.hidden = false;
      input.setAttribute("aria-expanded", "true");
    }

    function setMessage(text) {
      results.innerHTML = `<p class="search-results__msg">${escapeHtml(text)}</p>`;
      activeIndex = -1;
      showResults();
    }

    function setLoading(on) {
      form.classList.toggle("is-loading", on);
    }

    function facetMatches(q) {
      if (!facets) return [];
      const fq = fold(q);
      return [
        ...(facets.origins || []).map((x) => [x.value, "origin"]),
        ...(facets.processes || []).map((x) => [x.value, "process"]),
        ...facetNotes().map((x) => [x.value, "note"]),
      ]
        .filter(([v]) => fold(v).includes(fq) && fold(v) !== fq)
        .slice(0, 4);
    }

    function render(items, q) {
      const sugg = facetMatches(q);
      let html = "";

      if (sugg.length) {
        html += `
          <div class="search-suggest">
            <span class="search-sec__title">${escapeHtml(ui.suggestions)}</span>
            <div class="search-chips">${sugg.map(([v, kind]) => chip(v, kind, q)).join("")}</div>
          </div>`;
      }

      if (!items.length) {
        html += `<p class="search-results__msg">${escapeHtml(results.dataset.empty || "")}</p>`;
      } else {
        const total = items.length;
        const label = total === 1 ? ui.one : ui.many;
        html += `<p class="search-results__count">${total >= 24 ? "24+" : total} ${escapeHtml(label)}</p>`;
        html += items.slice(0, SHOWN).map((p) => {
          const meta = [lang === "es" ? p.categoryLabel : null, p.origin, p.process].filter(Boolean);
          const notes = p.category === "cafe" ? ((lang === "en" ? p.notesEn : p.notes) || []).slice(0, 3) : [];
          const out = isOut(p);
          return `
            <a class="search-opt search-hit${out ? " is-out" : ""}" href="${productHref(p)}" data-term="${escapeHtml(q)}">
              <img class="search-hit__img" src="${escapeHtml(p.image || "/assets/logo.png")}" alt="" width="56" height="56" loading="lazy">
              <span class="search-hit__text">
                <span class="search-hit__name">${highlight(productName(p), q)}</span>
                ${meta.length ? `<span class="search-hit__meta">${meta.map((m) => highlight(m, q)).join(" · ")}</span>` : ""}
                ${notes.length ? `<span class="search-hit__notes">${notes.map((n) => `<span>${highlight(n, q)}</span>`).join("")}</span>` : ""}
              </span>
              <span class="search-hit__side">
                <span class="search-hit__price">${money(p)}</span>
                ${out ? `<span class="search-hit__stock">${escapeHtml(ui.outOfStock)}</span>` : ""}
              </span>
            </a>`;
        }).join("");
      }

      html += `
        <a class="search-opt search-results__all" href="${hrefFor(q)}" data-term="${escapeHtml(q)}">
          <span>${escapeHtml(results.dataset.all || "")} <strong>“${escapeHtml(q)}”</strong></span>${ICON_ARROW}
        </a>`;

      results.innerHTML = html;
      results.querySelectorAll(".search-opt").forEach((el, i) => {
        el.id = `searchOpt${i}`;
        el.setAttribute("role", "option");
        el.setAttribute("aria-selected", "false");
      });
      activeIndex = -1;
      input.removeAttribute("aria-activedescendant");
      showResults();
    }

    async function runSearch(q) {
      if (controller) controller.abort();
      controller = new AbortController();
      setLoading(true);
      try {
        const res = await fetch(
          `/api/products/search?q=${encodeURIComponent(q)}&limit=24`,
          { signal: controller.signal, headers: { Accept: "application/json" } }
        );
        const json = await res.json();
        if (!res.ok || !json.success) throw new Error(json.error || "search failed");
        if (input.value.trim() !== q) return;
        render(json.data || [], q);
        setLoading(false);
      } catch (err) {
        if (err.name === "AbortError") return;
        setLoading(false);
        setMessage(results.dataset.error || "");
      }
    }

    // ── Teclado: flechas sobre lo que esté visible (sugerencias o resultados) ──
    function options() {
      return Array.from((results.hidden ? idle : results).querySelectorAll(".search-opt"));
    }

    function moveActive(delta) {
      const opts = options();
      if (!opts.length) return;
      if (opts[activeIndex]) {
        opts[activeIndex].classList.remove("is-active");
        opts[activeIndex].setAttribute("aria-selected", "false");
      }
      activeIndex = (activeIndex + delta + opts.length) % opts.length;
      const el = opts[activeIndex];
      el.classList.add("is-active");
      el.setAttribute("aria-selected", "true");
      if (el.id) input.setAttribute("aria-activedescendant", el.id);
      el.scrollIntoView({ block: "nearest" });
    }

    // ── Abrir y cerrar ──
    function positionPanel() {
      const rect = headerRoot.getBoundingClientRect();
      panel.style.top = `${rect.bottom}px`;
      panel.style.setProperty("--search-top", `${rect.bottom}px`);
    }

    function openPanel() {
      positionPanel();
      panel.hidden = false;
      document.documentElement.classList.add("search-open");
      btn.setAttribute("aria-expanded", "true");
      btn.classList.add("active");
      if (clearBtn) clearBtn.hidden = !input.value;
      if (input.value.trim().length >= MIN_CHARS) runSearch(input.value.trim());
      else showIdle();
      loadFacets().then(() => {
        if (!panel.hidden && results.hidden) renderIdle();
      });
      input.focus();
      input.select();
    }

    function closePanel() {
      console.log("CLOSEPANEL", new Error().stack);
      panel.hidden = true;
      document.documentElement.classList.remove("search-open");
      btn.setAttribute("aria-expanded", "false");
      btn.classList.remove("active");
      input.setAttribute("aria-expanded", "false");
      input.removeAttribute("aria-activedescendant");
      activeIndex = -1;
      setLoading(false);
      if (controller) controller.abort();
    }

    btn.addEventListener("click", () => {
      if (panel.hidden) openPanel();
      else closePanel();
    });

    closeBtn?.addEventListener("click", () => { closePanel(); btn.focus(); });

    clearBtn?.addEventListener("click", () => {
      input.value = "";
      input.dispatchEvent(new Event("input"));
      input.focus();
    });

    input.addEventListener("input", () => {
      const q = input.value.trim();
      if (clearBtn) clearBtn.hidden = !input.value;
      window.clearTimeout(debounceId);
      if (q.length === 0) {
        if (controller) controller.abort();
        setLoading(false);
        showIdle();
        return;
      }
      if (q.length < MIN_CHARS) {
        setMessage(results.dataset.hint || "");
        return;
      }
      debounceId = window.setTimeout(() => runSearch(q), 200);
    });

    input.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowDown") { ev.preventDefault(); moveActive(1); }
      else if (ev.key === "ArrowUp") { ev.preventDefault(); moveActive(-1); }
      else if (ev.key === "Enter" && activeIndex >= 0) {
        const el = options()[activeIndex];
        if (el) { ev.preventDefault(); el.click(); }
      }
    });

    form.addEventListener("submit", (ev) => {
      const q = input.value.trim();
      if (q.length < MIN_CHARS) {
        ev.preventDefault();
        setMessage(results.dataset.hint || "");
        return;
      }
      remember(q);
    });

    // Clics dentro del panel: recientes (borrar/quitar) y guardar el término
    // de lo que se abre.
    panel.addEventListener("click", (ev) => {
      const target = ev.target;
      if (!(target instanceof Element)) return;

      if (target.closest("[data-clear-recent]")) {
        writeRecent([]);
        renderIdle();
        input.focus();
        return;
      }
      const remove = target.closest("[data-remove-recent]");
      if (remove) {
        const term = remove.getAttribute("data-remove-recent") || "";
        writeRecent(readRecent().filter((x) => x !== term));
        renderIdle();
        input.focus();
        return;
      }
      const link = target.closest("a[data-term]");
      if (link) remember(link.getAttribute("data-term"));
    });

    document.addEventListener("keydown", (ev) => {
      if (ev.key === "Escape" && !panel.hidden) {
        closePanel();
        btn.focus();
        return;
      }
      // Atajos: "/" desde cualquier parte (si no se está escribiendo) y Ctrl/⌘+K.
      const typing = ev.target instanceof Element &&
        ev.target.closest("input, textarea, select, [contenteditable='true']");
      if ((ev.ctrlKey || ev.metaKey) && !ev.altKey && ev.key.toLowerCase() === "k") {
        ev.preventDefault();
        if (panel.hidden) openPanel();
        else input.focus();
      } else if (ev.key === "/" && !typing && !ev.ctrlKey && !ev.metaKey && !ev.altKey) {
        ev.preventDefault();
        if (panel.hidden) openPanel();
      }
    });

    document.addEventListener("click", (ev) => {
      if (panel.hidden) return;
      const target = ev.target;
      // Un nodo que el propio panel acaba de re-renderizar (p. ej. quitar una
      // reciente) ya no está en el DOM: no es un clic afuera.
      if (!(target instanceof Node) || !target.isConnected) return;
      if (target === panel) { closePanel(); return; }
      if (panel.contains(target) || btn.contains(target)) return;
      closePanel();
    });

    // El header persiste entre páginas (View Transitions): cerrar al navegar.
    document.addEventListener("astro:after-swap", () => { if (!panel.hidden) closePanel(); });

    window.addEventListener("resize", () => { if (!panel.hidden) positionPanel(); });
    window.addEventListener("scroll", () => { if (!panel.hidden) positionPanel(); }, { passive: true });
  })();

  (function initNavBeans() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const header = document.querySelector(".site-header");
    const layer = document.querySelector(".nav-beans");
    if (!header || !layer) return;
    const beanSrc = "/assets/branding/coffebeannav.png"; // Ruta absoluta desde public
    const beans = [];
    const COUNT = 68;
    for (let i = 0; i < COUNT; i++) {
      const img = document.createElement("img");
      img.className = "bean";
      img.src = beanSrc;
      const xPct = 4 + Math.random() * 92;
      const yPct = 8 + Math.random() * 84;
      const rot = -40 + Math.random() * 80;
      const scale = 0.8 + Math.random() * 0.6;
      const size = 16 + Math.random() * 16 + (Math.random() < 0.15 ? 8 : 0);
      img.style.left = xPct + "%";
      img.style.top = yPct + "%";
      img.style.setProperty("--rot", rot + "deg");
      img.style.setProperty("--s", scale.toString());
      img.style.setProperty("--bean-size", size + "px");
      // @ts-ignore
      img._xPct = xPct / 100;
      // @ts-ignore
      img._yPct = yPct / 100;
      // @ts-ignore
      img._rand = Math.random();
      layer.appendChild(img);
      beans.push(img);
    }

    const pointer = { x: 0, y: 0, active: false };
    let rafId = 0;
    function animate() {
      if (pointer.active) {
        const rect = layer.getBoundingClientRect();
        const cx = pointer.x - rect.left;
        const cy = pointer.y - rect.top;
        for (const b of beans) {
          // @ts-ignore
          const bx = (b._xPct || 0.5) * rect.width;
          // @ts-ignore
          const by = (b._yPct || 0.5) * rect.height;
          const dx0 = bx - cx;
          const dy0 = by - cy;
          const d = Math.hypot(dx0, dy0) || 0.0001;
          const radius = 140;
          // @ts-ignore
          const strength = 26 + (b._rand || 0) * 22;
          const falloff = Math.max(0, radius - d) / radius;
          const repel = falloff * strength;
          const nx = dx0 / d;
          const ny = dy0 / d;
          const dx = nx * repel;
          const dy = ny * repel;
          b.style.setProperty("--dx", dx.toFixed(2) + "px");
          b.style.setProperty("--dy", dy.toFixed(2) + "px");
        }
      }
      rafId = requestAnimationFrame(animate);
    }
    rafId = requestAnimationFrame(animate);

    header.addEventListener("mouseenter", () => {
      pointer.active = true;
      header.classList.add("beans-active");
    });
    header.addEventListener("mousemove", (e) => {
      pointer.x = e.clientX;
      pointer.y = e.clientY;
    });
    header.addEventListener("mouseleave", () => {
      pointer.active = false;
      header.classList.remove("beans-active");
      beans.forEach((b) => {
        b.style.setProperty("--dx", "0px");
        b.style.setProperty("--dy", "0px");
      });
    });
  })();

  // Menu movil
  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  if (menuBtn && mobileMenu) {
    // Toggle del menú
    menuBtn.addEventListener("click", () => {
      const hidden = mobileMenu.hasAttribute("hidden");
      if (hidden) {
        mobileMenu.removeAttribute("hidden");
        menuBtn.classList.add("active");
        menuBtn.setAttribute("aria-expanded", "true");
        document.body.classList.add("menu-open");
      } else {
        mobileMenu.setAttribute("hidden", "");
        menuBtn.classList.remove("active");
        menuBtn.setAttribute("aria-expanded", "false");
        document.body.classList.remove("menu-open");
      }
    });

    // Cerrar menú al hacer click en un enlace
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.setAttribute("hidden", "");
        menuBtn.classList.remove("active");
        menuBtn.setAttribute("aria-expanded", "false");
        document.body.classList.remove("menu-open");
      });
    });

    // Cerrar menú al hacer click fuera
    document.addEventListener("click", (e) => {
      if (!menuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
        const hidden = mobileMenu.hasAttribute("hidden");
        if (!hidden) {
          mobileMenu.setAttribute("hidden", "");
          menuBtn.classList.remove("active");
          menuBtn.setAttribute("aria-expanded", "false");
          document.body.classList.remove("menu-open");
        }
      }
    });
  }

  // Verificar sesión y actualizar botón de usuario
  (async function checkAuthStatus() {
    const userBtn = document.getElementById("userNavBtn");
    const userNameDisplay = document.getElementById("userNameDisplay");
    const userMobileLabel = document.getElementById("userMobileLabel");
    const appsLink = document.getElementById("appsLink");
    const productosLink = document.getElementById("productosLink");
    const auditLink = document.getElementById("auditLink");

    // Elementos del dropdown y menú móvil
    const authenticatedMenu = document.getElementById("authenticatedMenu");
    const unauthenticatedMenu = document.getElementById("unauthenticatedMenu");
    const mobileAuthenticatedMenu = document.getElementById(
      "mobileAuthenticatedMenu"
    );
    const mobileUnauthenticatedMenu = document.getElementById(
      "mobileUnauthenticatedMenu"
    );

    try {
      const res = await fetch("/api/auth/me", {
        credentials: "include",
      });

      if (res.ok) {
        const user = await res.json();
        // Usuario logueado - mostrar menú autenticado
        const firstName = user.first_name || "Usuario";

        if (userNameDisplay) {
          userNameDisplay.textContent = firstName;
          userNameDisplay.style.display = "inline";
        }
        if (userMobileLabel) {
          userMobileLabel.textContent = firstName;
        }
        if (userBtn) {
          const header = document.getElementById("siteHeader");
          userBtn.href = header?.dataset.accountHref ?? "/cuenta";
          userBtn.setAttribute("aria-label", `${firstName}`);
          userBtn.dataset.auth = "true";
        }

        // Mostrar opciones de autenticado, ocultar no autenticado
        if (authenticatedMenu) authenticatedMenu.style.display = "block";
        if (unauthenticatedMenu) unauthenticatedMenu.style.display = "none";
        if (mobileAuthenticatedMenu)
          mobileAuthenticatedMenu.style.display = "flex";
        if (mobileUnauthenticatedMenu)
          mobileUnauthenticatedMenu.style.display = "none";

        // Mostrar opciones admin
        const mobileAppsLink = document.getElementById("mobileAppsLink");
        if (mobileAppsLink && user.role === "admin") {
          mobileAppsLink.style.display = "flex";
        }
        if (appsLink && user.role === "admin") {
          appsLink.style.display = "block";
        }
        if (productosLink && user.role === "admin") {
          productosLink.style.display = "block";
        }
        if (auditLink && user.role === "admin") {
          auditLink.style.display = "block";
        }

      } else if (res.status === 401) {
        // No autenticado - mostrar menú de login/registro

        if (authenticatedMenu) authenticatedMenu.style.display = "none";
        if (unauthenticatedMenu) unauthenticatedMenu.style.display = "flex";
        if (mobileAuthenticatedMenu)
          mobileAuthenticatedMenu.style.display = "none";
        if (mobileUnauthenticatedMenu)
          mobileUnauthenticatedMenu.style.display = "flex";

        if (userBtn) {
          const header = document.getElementById("siteHeader");
          userBtn.setAttribute("aria-label", header?.dataset.menuLabel ?? "User menu");
        }
      } else {
        // Error del servidor — mostrar menú no autenticado
        console.warn("[Header] Error del servidor en /api/auth/me:", res.status);
        if (authenticatedMenu) authenticatedMenu.style.display = "none";
        if (unauthenticatedMenu) unauthenticatedMenu.style.display = "flex";
        if (mobileAuthenticatedMenu) mobileAuthenticatedMenu.style.display = "none";
        if (mobileUnauthenticatedMenu) mobileUnauthenticatedMenu.style.display = "flex";
      }
    } catch (err) {
      console.error("[Header] Error checking auth status:", err);
      if (authenticatedMenu) authenticatedMenu.style.display = "none";
      if (unauthenticatedMenu) unauthenticatedMenu.style.display = "flex";
      if (mobileAuthenticatedMenu) mobileAuthenticatedMenu.style.display = "none";
      if (mobileUnauthenticatedMenu) mobileUnauthenticatedMenu.style.display = "flex";
    }
  })();

  // Logout (dropdown de escritorio y menú móvil). Un único listener por botón:
  // antes había dos en #logoutBtn y cada clic llamaba dos veces a /logout.
  async function logout(e) {
    e.preventDefault();
    try {
      const response = await fetch("/api/auth/logout", {
        method: "POST",
        credentials: "include",
      });
      if (response.ok) {
        window.location.href = "/login";
      }
    } catch (err) {
      console.error("Error al cerrar sesión:", err);
    }
  }
  document.getElementById("logoutBtn")?.addEventListener("click", logout);
  document.getElementById("mobileLogoutBtn")?.addEventListener("click", logout);

  // Botones de auth modal (desktop dropdown)
  document.getElementById('openLoginModal')?.addEventListener('click', () => {
    document.getElementById('userDropdown')?.classList.remove('active');
    window.AuthModal?.open('login');
  });
  document.getElementById('openRegisterModal')?.addEventListener('click', () => {
    document.getElementById('userDropdown')?.classList.remove('active');
    window.AuthModal?.open('register');
  });

  // Botones de auth modal (menú móvil)
  document.getElementById('mobileOpenLoginModal')?.addEventListener('click', () => {
    const mobileMenu = document.getElementById('mobileMenu');
    const menuBtn = document.getElementById('menuBtn');
    if (mobileMenu) mobileMenu.setAttribute('hidden', '');
    if (menuBtn) { menuBtn.classList.remove('active'); menuBtn.setAttribute('aria-expanded', 'false'); }
    document.body.classList.remove('menu-open');
    window.AuthModal?.open('login');
  });
  document.getElementById('mobileOpenRegisterModal')?.addEventListener('click', () => {
    const mobileMenu = document.getElementById('mobileMenu');
    const menuBtn = document.getElementById('menuBtn');
    if (mobileMenu) mobileMenu.setAttribute('hidden', '');
    if (menuBtn) { menuBtn.classList.remove('active'); menuBtn.setAttribute('aria-expanded', 'false'); }
    document.body.classList.remove('menu-open');
    window.AuthModal?.open('register');
  });

  // Dropdown menu logic
  (function initUserDropdown() {
    const userDropdown = document.getElementById("userDropdown");
    const userBtn = document.getElementById("userNavBtn");
    const dropdownMenu = document.getElementById("userDropdownMenu");

    if (!userBtn || !userDropdown || !dropdownMenu) return;

    // Función para posicionar el dropdown
    function positionDropdown() {
      const rect = userBtn.getBoundingClientRect();
      dropdownMenu.style.top = rect.bottom + 8 + "px";
      dropdownMenu.style.right = window.innerWidth - rect.right + "px";
    }

    // Toggle dropdown al hacer click en el botón
    // Si no está autenticado, abre la modal directamente
    userBtn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (userBtn.dataset.auth !== "true") {
        window.AuthModal?.open("login");
        return;
      }
      userDropdown.classList.toggle("active");
      userBtn.setAttribute(
        "aria-expanded",
        userDropdown.classList.contains("active")
      );
      if (userDropdown.classList.contains("active")) {
        positionDropdown();
      }
    });

    // Cerrar dropdown al hacer click en un item
    dropdownMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        userDropdown.classList.remove("active");
        userBtn.setAttribute("aria-expanded", "false");
      });
    });

    // Cerrar dropdown al hacer clic fuera
    document.addEventListener("click", (e) => {
      if (!userDropdown.contains(e.target)) {
        userDropdown.classList.remove("active");
        userBtn.setAttribute("aria-expanded", "false");
      }
    });
  })();

  // Establecer altura dinámica del header para usar en CSS
  (function setHeaderHeight() {
    const header = document.querySelector(".site-header");
    if (!header) return;

    function updateHeaderHeight() {
      const height = header.offsetHeight;
      document.documentElement.style.setProperty(
        "--header-height",
        height + "px"
      );
    }

    // Ejecutar al cargar
    updateHeaderHeight();

    // Actualizar cuando se redimensiona la ventana
    window.addEventListener("resize", updateHeaderHeight);
  })();

  // Cart preview hover
  (function initCartPreview() {
    const wrap = document.getElementById("cartPreviewWrap");
    const preview = document.getElementById("cartPreview");
    const inner = document.getElementById("cartPreviewInner");
    if (!wrap || !preview || !inner) return;

    function positionPreview() {
      const rect = wrap.getBoundingClientRect();
      preview.style.top = (rect.bottom + 8) + "px";
      preview.style.right = (window.innerWidth - rect.right) + "px";
    }

    const headerEl = document.getElementById('siteHeader');
    const lang = headerEl?.dataset.lang === 'en' ? 'en' : 'es';
    const emptyMsg = headerEl?.dataset.cartEmpty || 'Tu carrito está vacío';
    const locale = lang === 'en' ? 'en-US' : 'es-CO';
    const currency = lang === 'en' ? 'USD' : 'COP';

    function renderPreview() {
      const cart = window.Cart ? window.Cart.getCart() : [];
      if (cart.length === 0) {
        inner.innerHTML = '<p class="cart-preview-empty">' + emptyMsg + '</p>';
        return;
      }
      const fmt = (n) => new Intl.NumberFormat(locale, { style: 'currency', currency, maximumFractionDigits: 0 }).format(Number(n));
      const items = cart.slice(0, 4).map(item => `
        <div class="cart-preview-item">
          <img src="${item.image || '/assets/logo.png'}" alt="" width="20" height="20" loading="lazy" style="width:20px;height:20px;min-width:20px;flex-shrink:0">
          <span class="cart-preview-item-name">${item.name}<span class="cart-preview-item-qty"> × ${item.qty || 1}</span></span>
          <span class="cart-preview-item-price">${fmt((item.price || 0) * (item.qty || 1))}</span>
        </div>`).join('');
      const moreLbl = lang === 'en' ? 'more' : 'más';
      const extra = cart.length > 4 ? `<p class="cart-preview-empty">+${cart.length - 4} ${moreLbl}</p>` : '';
      const subtotal = window.Cart.subtotal();
      inner.innerHTML = items + extra + `
        <div style="border-top:1px solid var(--border);margin-top:0.4rem;padding-top:0.5rem;display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:0.75rem;color:var(--muted-fg)">Subtotal</span>
          <span style="font-size:0.85rem;font-weight:700;color:var(--coffee)">${fmt(subtotal)}</span>
        </div>`;
    }

    wrap.addEventListener("mouseenter", () => {
      positionPreview();
      renderPreview();
    });

    window.addEventListener("resize", () => {
      if (preview.style.opacity === '1' || wrap.matches(':hover')) positionPreview();
    });
  })();
  }

  initHeader();
  document.addEventListener("astro:page-load", initHeader);
</script>
