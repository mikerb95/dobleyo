---
// Tarjeta centrada para los flujos de cuenta por correo (recuperar y restablecer
// contraseña). Los estilos de formulario son globales dentro de .account-card.
interface Props {
  title: string;
  intro?: string;
}
const { title, intro } = Astro.props;
---

<div class="account-page">
  <section class="account-card">
    <h1 class="account-card__title">{title}</h1>
    {intro && <p class="account-card__intro">{intro}</p>}
    <slot />
  </section>
</div>

<style is:global>
  .account-page {
    min-height: 70vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
    background: var(--cream);
  }

  .account-card {
    width: 100%;
    max-width: 440px;
    background: var(--card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: var(--space-8) var(--space-5);
  }


  .account-card__title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.2;
    color: var(--espresso);
  }

  .account-card__intro {
    margin: 0 0 var(--space-6);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .account-card form { display: grid; gap: var(--space-4); }

  .account-card label {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--espresso);
  }

  .account-card input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    font: inherit;
    font-weight: 400;
    color: var(--espresso);
    background: var(--card);
    border: 1.5px solid rgba(var(--espresso-rgb), .18);
    border-radius: var(--radius-sm);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .account-card input:focus {
    outline: none;
    border-color: var(--caramel);
    box-shadow: 0 0 0 3px rgba(var(--caramel-rgb), .18);
  }

  .account-card .field-hint {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--ink-muted);
  }

  .account-card button[type="submit"] {
    padding: var(--space-3) var(--space-6);
    font: inherit;
    font-weight: 600;
    color: var(--cream);
    background: var(--espresso);
    border: 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .account-card button[type="submit"]:hover:not(:disabled) { background: var(--coffee-700); }
  .account-card button[type="submit"]:disabled { opacity: .6; cursor: not-allowed; }

  .account-card__status {
    margin: 0;
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    line-height: 1.5;
    border-radius: var(--radius-sm);
  }

  .account-card__status:empty { display: none; }
  .account-card__status[data-tone="success"] { color: var(--leaf); background: var(--leaf-bg); }
  .account-card__status[data-tone="error"] { color: var(--danger); background: var(--danger-bg); }

  .account-card__links {
    margin: var(--space-6) 0 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    text-align: center;
  }

  .account-card__links a { color: var(--caramel-deep); font-weight: 600; }

  @media (min-width: 480px) {
    .account-card { padding: var(--space-10) var(--space-8); }
  }
</style>
