---
import type { Lang } from "../i18n/routes.ts";
import { buildLangHref } from "../i18n/routes.ts";

interface Props {
  lang?: Lang;
  /** `sm` en la barra del header, `md` en el menú móvil. */
  size?: "sm" | "md";
}
const { lang = "es", size = "sm" } = Astro.props;

// Href por defecto (SSR). El script del cliente los recalcula con la URL real
// del navegador, ya que en páginas estáticas el host de build no es fiable.
const hostname = Astro.url.hostname;
const pathname = Astro.url.pathname;
const esHref = buildLangHref("es", lang, hostname, pathname);
const enHref = buildLangHref("en", lang, hostname, pathname);
// El toggle se pinta dos veces (header y menú móvil): los clipPath necesitan
// ids únicos o el segundo SVG recorta con la máscara del primero.
const uid = Math.random().toString(36).slice(2, 8);
const flagW = size === "sm" ? 18 : 20;
const flagH = size === "sm" ? 12 : 14;
const hrefs = { es: esHref, en: enHref } as const;
---

<div
  class={`lang-toggle lang-toggle--${size}`}
  data-lang-toggle
  data-current={lang}
  role="group"
  aria-label={lang === "es" ? "Ver en inglés" : "View in Spanish"}
>
  {
    (["es", "en"] as const).map((code) => {
      const isActive = code === lang;
      const flag = (
        <svg class="lang-flag" viewBox="0 0 20 14" width={flagW} height={flagH} aria-hidden="true" focusable="false">
          <clipPath id={`flag-${code}-${uid}`}><rect width="20" height="14" rx="2.2" /></clipPath>
          <g clip-path={`url(#flag-${code}-${uid})`}>
            {code === "es" ? (
              <>
                <rect width="20" height="14" fill="#AA151B" />
                <rect y="3.5" width="20" height="7" fill="#F1BF00" />
                <g fill="#AA151B" opacity=".9">
                  <rect x="4.1" y="5.6" width="2.6" height="2.9" rx=".5" />
                  <rect x="3.5" y="5.1" width="3.8" height="1" rx=".4" />
                </g>
              </>
            ) : (
              <>
                <rect width="20" height="14" fill="#FFFFFF" />
                <g fill="#B31942">
                  <rect width="20" height="1.077" y="0" />
                  <rect width="20" height="1.077" y="2.154" />
                  <rect width="20" height="1.077" y="4.308" />
                  <rect width="20" height="1.077" y="6.462" />
                  <rect width="20" height="1.077" y="8.615" />
                  <rect width="20" height="1.077" y="10.769" />
                  <rect width="20" height="1.077" y="12.923" />
                </g>
                <rect width="8.6" height="7.54" fill="#0A3161" />
                <g fill="#FFFFFF">
                  <circle cx="1.6" cy="1.4" r=".52" /><circle cx="4.3" cy="1.4" r=".52" /><circle cx="7" cy="1.4" r=".52" />
                  <circle cx="2.95" cy="2.75" r=".52" /><circle cx="5.65" cy="2.75" r=".52" />
                  <circle cx="1.6" cy="4.1" r=".52" /><circle cx="4.3" cy="4.1" r=".52" /><circle cx="7" cy="4.1" r=".52" />
                  <circle cx="2.95" cy="5.45" r=".52" /><circle cx="5.65" cy="5.45" r=".52" />
                  <circle cx="1.6" cy="6.6" r=".52" /><circle cx="4.3" cy="6.6" r=".52" /><circle cx="7" cy="6.6" r=".52" />
                </g>
              </>
            )}
          </g>
          <rect class="lang-flag-edge" width="20" height="14" rx="2.2" />
        </svg>
      );

      return isActive ? (
        <span class="lang-opt is-active" aria-current="true" lang={code}>
          {flag}
          {/* La bandera ya identifica el idioma activo; el código se oculta
              visualmente pero sigue leyéndose en lectores de pantalla. */}
          <span class="sr-only">{code.toUpperCase()}</span>
        </span>
      ) : (
        <a
          class="lang-opt"
          data-lang-opt={code}
          href={hrefs[code]}
          hreflang={code}
          lang={code}
          title={code === "en" ? "View in English" : "Ver en español"}
        >
          {flag}
          <span>{code.toUpperCase()}</span>
        </a>
      );
    })
  }
</div>

<style>
  /* Réplica del LangSwitch de codebymike.net: cápsula con la opción activa
     elevada mostrando solo la bandera, y la inactiva con bandera desaturada
     más su código hasta el hover. */
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(var(--coffee-rgb), 0.04);
    width: max-content;
    line-height: 1;
  }
  .lang-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    color: var(--muted-fg);
    font-family: var(--font-mono, ui-monospace, Menlo, monospace);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  /* El activo solo muestra la bandera: menos aire lateral para que la
     píldora no quede descompensada. */
  .lang-opt.is-active {
    padding-inline: 0.5rem;
    color: var(--fg);
    background: var(--card);
    box-shadow: 0 1px 2px rgba(var(--coffee-rgb), 0.18);
  }
  .lang-toggle--md .lang-opt {
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 12px;
  }
  .lang-toggle--md .lang-opt.is-active { padding-inline: 0.625rem; }

  .lang-flag {
    display: block;
    flex-shrink: 0;
    border-radius: 2px;
    transition: filter var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  a.lang-opt .lang-flag {
    filter: saturate(0.25);
    opacity: 0.7;
  }
  .lang-flag-edge {
    fill: none;
    stroke: rgba(var(--coffee-rgb), 0.18);
    stroke-width: 1;
  }
  a.lang-opt:hover {
    color: var(--caramel-deep);
    background: rgba(var(--caramel-rgb), 0.08);
  }
  a.lang-opt:hover .lang-flag,
  a.lang-opt:focus-visible .lang-flag {
    filter: none;
    opacity: 1;
  }
  a.lang-opt:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-opt,
    .lang-flag { transition: none; }
  }
</style>

<script>
  import { buildLangHref } from "../i18n/routes.ts";

  // Recalcula los href con la URL real del navegador. Debe re-ejecutarse en
  // cada navegación (astro:page-load): el toggle vive en el header persistido,
  // así que sin esto quedaría apuntando a la página donde inició la sesión.
  function syncLangToggles() {
    document.querySelectorAll("[data-lang-toggle]").forEach((toggle) => {
      const current = (toggle.getAttribute("data-current") === "en" ? "en" : "es");
      const { hostname, pathname } = window.location;
      toggle.querySelectorAll("[data-lang-opt]").forEach((el) => {
        const a = el as HTMLAnchorElement;
        const target = a.getAttribute("data-lang-opt") === "en" ? "en" : "es";
        a.href = buildLangHref(target, current, hostname, pathname);
      });
    });
  }

  syncLangToggles();
  document.addEventListener("astro:page-load", syncLangToggles);
</script>
