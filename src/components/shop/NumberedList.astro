---
/**
 * Lista numerada en tarjetas (consejos, pasos). Solo para contenido que de
 * verdad es una secuencia o un conteo ("5 consejos", "Cómo funciona"): el
 * número dice algo. La clase .nlist__grid la animan las piezas de motion.
 */
interface Props {
  eyebrow?: string;
  title: string;
  items: { title?: string; text: string }[];
  /** Une las tarjetas con una línea (pasos de un proceso) */
  connected?: boolean;
}
const { eyebrow, title, items, connected = false } = Astro.props;
---

<section class:list={["nlist", { "nlist--steps": connected }]}>
  {eyebrow && <p class="nlist__eyebrow">{eyebrow}</p>}
  <h2 class="nlist__title">{title}</h2>
  <ol class="nlist__grid" style={`--n:${items.length}`}>
    {items.map((it, i) => (
      <li class="nlist__item">
        <span class="nlist__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
        {it.title && <h3 class="nlist__item-title">{it.title}</h3>}
        <p class="nlist__text">{it.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .nlist { max-width: 1200px; margin: 0 auto; padding: var(--space-16) 1.25rem var(--space-8); }
  .nlist__eyebrow { margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--caramel); }
  .nlist__title { margin: 0 0 var(--space-8); font-family: var(--font-display); font-size: var(--text-3xl); color: var(--espresso); }
  .nlist__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    position: relative;
  }
  @media (min-width: 768px) { .nlist__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .nlist__grid { grid-template-columns: repeat(min(var(--n), 5), minmax(0, 1fr)); } }
  .nlist__item {
    position: relative;
    padding: var(--space-6) var(--space-5);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .nlist__n {
    display: block;
    margin-bottom: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--caramel);
    font-variant-numeric: tabular-nums;
  }
  .nlist__item-title { margin: 0 0 var(--space-2); font-size: var(--text-base); color: var(--espresso); }
  .nlist__text { margin: 0; font-size: var(--text-sm); line-height: 1.55; color: var(--ink-muted); }

  /* Pasos conectados: una línea une los números en escritorio */
  @media (min-width: 1024px) {
    .nlist--steps .nlist__grid::before {
      content: "";
      position: absolute;
      left: 2rem;
      right: 2rem;
      top: calc(var(--space-6) + 1rem);
      height: 1px;
      background: repeating-linear-gradient(90deg, var(--caramel) 0 6px, transparent 6px 12px);
      opacity: .5;
    }
    .nlist--steps .nlist__n { position: relative; display: inline-block; padding-right: .5rem; background: var(--card); }
  }
</style>
