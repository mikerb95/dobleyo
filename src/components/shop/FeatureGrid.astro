---
/**
 * Rejilla de beneficios con ícono. Los íconos se trazan al entrar en pantalla
 * y las tarjetas tienen luz que sigue al cursor (src/scripts/shop/sections.ts).
 */
import Icon from "../Icon.astro";
interface Props {
  eyebrow?: string;
  title: string;
  items: { icon: string; title: string; text: string }[];
}
const { eyebrow, title, items } = Astro.props;
---

<section class="fgrid">
  {eyebrow && <p class="fgrid__eyebrow">{eyebrow}</p>}
  <h2 class="fgrid__title">{title}</h2>
  <ul class:list={["fgrid__list", { "fgrid__list--4": items.length % 4 === 0 }]} data-fgrid>
    {items.map((it) => (
      <li class="fgrid__item">
        <span class="fgrid__icon" aria-hidden="true"><Icon name={it.icon as any} size={26} /></span>
        <h3 class="fgrid__item-title">{it.title}</h3>
        <p class="fgrid__text">{it.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .fgrid { max-width: 1200px; margin: 0 auto; padding: var(--space-16) 1.25rem var(--space-8); }
  .fgrid__eyebrow { margin: 0 0 var(--space-2); font-size: var(--text-xs); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--caramel); }
  .fgrid__title { margin: 0 0 var(--space-8); font-family: var(--font-display); font-size: var(--text-3xl); color: var(--espresso); max-width: 22ch; text-wrap: balance; }
  .fgrid__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
  @media (min-width: 640px) { .fgrid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .fgrid__list { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  /* Con 4 (u 8) tarjetas, una fila de 4: en 3 columnas quedaría una sola abajo */
  @media (min-width: 1024px) { .fgrid__list--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fgrid__item { padding: var(--space-6); background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-lg); }
  .fgrid__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--cream); color: var(--caramel); margin-bottom: var(--space-4); }
  .fgrid__item-title { margin: 0 0 var(--space-2); font-size: var(--text-base); color: var(--espresso); }
  .fgrid__text { margin: 0; font-size: var(--text-sm); line-height: 1.55; color: var(--ink-muted); }
</style>
