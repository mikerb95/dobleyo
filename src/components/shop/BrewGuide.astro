---
/**
 * Panel de recetas de /guias y /en/guides: una pestaña por método y, para cada
 * uno, la receta dibujada: la proporción con las barras de café y agua a
 * escala, la molienda en una escala de 5, el tiempo en un anillo y la
 * temperatura en una regla de 80 a 100 °C. Los números salen del mismo texto
 * de la receta (lib/brew.ts); lo que no tiene número se muestra como texto.
 *
 * Todos los paneles se pintan en el servidor y las pestañas solo cambian cuál
 * se ve (script de este componente, funciona sin motion). El motion
 * (src/scripts/shop/guides.ts) dibuja cada panel al mostrarse.
 */
import Icon from "../Icon.astro";
import type { Lang } from "../../i18n/index.ts";
import { t } from "../../i18n/index.ts";
import { parseDose, ratioLabel, parseTempC, parseSeconds, grindIndex, GRIND_STEPS } from "../../lib/brew.ts";

export interface BrewMethod {
  icon: string;
  title: string;
  summary: string;
  ratio: string;
  grind: string;
  time: string;
  temp: string;
}

interface Props {
  methods: BrewMethod[];
  lang: Lang;
}

const { methods, lang } = Astro.props;
const k = (key: string) => t(`guides.panel.${key}`, lang);
const id = (i: number) => `brew-${i}`;

// Regla de temperatura: de 80 a 100 °C
const tempPct = (c: number) => Math.max(0, Math.min(100, ((c - 80) / 20) * 100));
// El anillo del tiempo se llena en proporción a 5 minutos
const RING = 2 * Math.PI * 26;
const timePct = (s: number) => Math.min(1, s / 300);
---

<div class="brew" data-brew>
  <div class="brew__tabs" role="tablist" aria-label={k("panel_label")}>
    {methods.map((m, i) => (
      <button
        type="button"
        role="tab"
        class="brew__tab"
        id={`${id(i)}-tab`}
        aria-controls={id(i)}
        aria-selected={i === 0 ? "true" : "false"}
        tabindex={i === 0 ? 0 : -1}
      >
        <Icon name={m.icon as any} size={20} />
        <span>{m.title}</span>
      </button>
    ))}
  </div>

  {methods.map((m, i) => {
    const dose = parseDose(m.ratio);
    const ratio = ratioLabel(m.ratio);
    const tempC = parseTempC(m.temp);
    const secs = parseSeconds(m.time);
    const grind = grindIndex(m.grind, lang);
    return (
      <section
        class="brew__panel"
        id={id(i)}
        role="tabpanel"
        aria-labelledby={`${id(i)}-tab`}
        hidden={i !== 0}
      >
        <header class="brew__head">
          <span class="brew__icon" aria-hidden="true"><Icon name={m.icon as any} size={34} /></span>
          <div>
            <h3 class="brew__title">{m.title}</h3>
            <p class="brew__summary">{m.summary}</p>
          </div>
        </header>

        <div class="brew__grid">
          <div class="brew__cell brew__cell--wide">
            <p class="brew__label">{k("ratio")}</p>
            {ratio ? <p class="brew__big" data-count>{ratio}</p> : <p class="brew__text">{m.ratio}</p>}
            {dose && (
              <div class="dose" aria-hidden="true">
                <div class="dose__row">
                  <span class="dose__name">{k("coffee")}</span>
                  <span class="dose__track"><span class="dose__bar dose__bar--coffee" style={`width:${(dose.coffee / dose.water) * 100}%`}></span></span>
                  <span class="dose__val" data-count>{dose.coffee} g</span>
                </div>
                <div class="dose__row">
                  <span class="dose__name">{k("water")}</span>
                  <span class="dose__track"><span class="dose__bar dose__bar--water" style="width:100%"></span></span>
                  <span class="dose__val" data-count>{dose.water} ml</span>
                </div>
              </div>
            )}
          </div>

          <div class="brew__cell">
            <p class="brew__label">{k("grind")}</p>
            <p class="brew__value">{m.grind}</p>
            {grind != null && (
              <div class="grind" aria-hidden="true">
                <div class="grind__dots">
                  {Array.from({ length: GRIND_STEPS }, (_, s) => (
                    <span class:list={["grind__dot", { "is-on": s === grind }]} style={`--s:${s}`}></span>
                  ))}
                </div>
                <div class="grind__ends"><span>{k("fine")}</span><span>{k("coarse")}</span></div>
              </div>
            )}
          </div>

          <div class="brew__cell brew__cell--time">
            {secs != null && (
              <svg class="ring" viewBox="0 0 64 64" aria-hidden="true">
                <circle class="ring__bg" cx="32" cy="32" r="26" />
                <circle
                  class="ring__fg"
                  cx="32"
                  cy="32"
                  r="26"
                  stroke-dasharray={RING}
                  stroke-dashoffset={RING * (1 - timePct(secs))}
                  transform="rotate(-90 32 32)"
                />
              </svg>
            )}
            <div>
              <p class="brew__label">{k("time")}</p>
              <p class="brew__value">{m.time}</p>
            </div>
          </div>

          <div class="brew__cell brew__cell--wide">
            <p class="brew__label">{k("temp")}</p>
            <p class="brew__value">{m.temp}</p>
            {tempC != null ? (
              <div class="temp" aria-hidden="true">
                <span class="temp__track"><span class="temp__bar" style={`width:${tempPct(tempC)}%`}></span></span>
                <div class="temp__ends"><span>80 °C</span><span>100 °C</span></div>
              </div>
            ) : (
              <span class="brew__flame" aria-hidden="true"><Icon name="flame" size={22} /></span>
            )}
          </div>
        </div>
      </section>
    );
  })}
</div>

<script>
  // Pestañas accesibles: clic, flechas, Inicio y Fin. Avisa con brew:show para
  // que el motion dibuje el panel que se acaba de mostrar.
  function initBrew() {
    const root = document.querySelector<HTMLElement>("[data-brew]");
    if (!root || root.dataset.jsInit) return;
    root.dataset.jsInit = "1";
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const show = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      root.dispatchEvent(new CustomEvent("brew:show", { detail: tab.getAttribute("aria-controls") }));
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => tab.getAttribute("aria-selected") !== "true" && show(tab));
      tab.addEventListener("keydown", (e) => {
        const n = tabs.length;
        const to =
          e.key === "ArrowRight" ? (i + 1) % n :
          e.key === "ArrowLeft" ? (i - 1 + n) % n :
          e.key === "Home" ? 0 :
          e.key === "End" ? n - 1 : -1;
        if (to < 0) return;
        e.preventDefault();
        show(tabs[to], true);
      });
    });
  }
  initBrew();
  document.addEventListener("astro:page-load", initBrew);
</script>

<style>
  .brew {
    background: var(--card);
    color: var(--espresso);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: 0 30px 60px -36px rgba(0, 0, 0, .7);
  }
  .brew__tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: var(--radius-md);
    background: var(--sand);
  }
  .brew__tab {
    display: grid;
    justify-items: center;
    gap: 4px;
    padding: .55rem .25rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    cursor: pointer;
    min-height: 56px;
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .brew__tab span { line-height: 1.2; text-align: center; }
  .brew__tab:hover { color: var(--espresso); }
  .brew__tab[aria-selected="true"] { background: var(--card); color: var(--caramel-deep); box-shadow: 0 2px 8px -4px rgba(var(--espresso-rgb), .35); }
  .brew__tab:focus-visible { outline: 2px solid var(--caramel); outline-offset: 2px; }

  .brew__panel { padding: var(--space-5) var(--space-2) var(--space-2); }
  .brew__head { display: flex; gap: var(--space-4); align-items: flex-start; }
  .brew__icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--cream); color: var(--caramel); flex-shrink: 0; }
  .brew__title { margin: 0; font-family: var(--font-display); font-size: var(--text-xl); color: var(--espresso); }
  .brew__summary { margin: .25rem 0 0; font-size: var(--text-sm); color: var(--ink-muted); line-height: 1.5; }

  /* Celdas separadas por líneas de 1 px: el fondo de la rejilla asoma por el gap */
  .brew__grid {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .brew__cell { padding: var(--space-4); min-width: 0; background: var(--card); }
  .brew__cell--wide { grid-column: 1 / -1; }
  .brew__label { margin: 0 0 .3rem; font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-muted); }
  .brew__big { margin: 0; font-family: var(--font-display); font-size: var(--text-3xl); line-height: 1; color: var(--espresso); font-variant-numeric: tabular-nums; }
  .brew__value { margin: 0; font-weight: 700; font-size: var(--text-sm); color: var(--espresso); font-variant-numeric: tabular-nums; }
  .brew__text { margin: 0; font-weight: 600; font-size: var(--text-sm); color: var(--espresso); }

  /* Café y agua a escala: la barra del café mide lo que pesa frente al agua */
  .dose { margin-top: var(--space-3); display: grid; gap: .45rem; }
  .dose__row { display: grid; grid-template-columns: 3.4rem minmax(0, 1fr) 4rem; gap: var(--space-2); align-items: center; }
  .dose__name { font-size: var(--text-xs); color: var(--ink-muted); }
  .dose__track { height: 8px; border-radius: 99px; background: var(--sand); overflow: hidden; }
  .dose__bar { display: block; height: 100%; border-radius: 99px; transform-origin: 0 50%; }
  .dose__bar--coffee { background: var(--espresso); min-width: 4px; }
  .dose__bar--water { background: color-mix(in srgb, var(--leaf) 40%, var(--cream)); }
  .dose__val { font-size: var(--text-xs); font-weight: 700; text-align: right; font-variant-numeric: tabular-nums; }

  .grind { margin-top: var(--space-3); }
  .grind__dots { display: flex; justify-content: space-between; align-items: center; }
  .grind__dot { width: calc(6px + var(--s) * 2.5px); height: calc(6px + var(--s) * 2.5px); border-radius: 50%; background: var(--border); }
  .grind__dot.is-on { background: var(--caramel); box-shadow: 0 0 0 4px rgba(var(--caramel-rgb), .18); }
  .grind__ends, .temp__ends { display: flex; justify-content: space-between; margin-top: .35rem; font-size: .65rem; color: var(--ink-muted); }

  .brew__cell--time { display: flex; gap: var(--space-3); align-items: center; }
  .ring { width: 54px; height: 54px; flex-shrink: 0; }
  .ring__bg { fill: none; stroke: var(--sand); stroke-width: 6; }
  .ring__fg { fill: none; stroke: var(--caramel); stroke-width: 6; stroke-linecap: round; }

  .temp { margin-top: var(--space-3); }
  .temp__track { display: block; height: 8px; border-radius: 99px; background: var(--sand); overflow: hidden; }
  .temp__bar { display: block; height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--mucilage), var(--cherry)); transform-origin: 0 50%; }
  .brew__flame { display: inline-flex; margin-top: var(--space-2); color: var(--cherry); }

  @media (max-width: 480px) {
    .brew { padding: var(--space-3); }
    .brew__tab { font-size: .66rem; }
    .brew__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
