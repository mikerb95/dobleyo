---
/**
 * Caja del asistente con IA en la pantalla principal del panel (/admin).
 * Busca sin IA mientras se escribe y, con Enter, le pregunta al asistente.
 * Plan: docs/plan-asistente.md. Lógica: ./asistente-cliente.ts.
 */
import Icon from '../Icon.astro';
---

<section class="asis" id="asistente" aria-labelledby="asis-saludo" data-estado="cargando">
  <div class="asis__cabeza">
    <h2 class="asis__saludo" id="asis-saludo">Hola</h2>
    <p class="asis__sub" id="asis-sub">Pregunte por pedidos, producción, inventario o ventas. Los cambios siempre los aprueba usted.</p>
  </div>

  <div class="asis__hilo" id="asis-hilo" aria-live="polite"></div>

  <form class="asis__caja" id="asis-form" autocomplete="off" role="search">
    <span class="asis__icono" aria-hidden="true"><Icon name="search" size={18} /></span>
    <label class="visually-hidden" for="asis-entrada">Pregunte o busque algo</label>
    <input
      id="asis-entrada"
      class="asis__entrada"
      type="text"
      name="pregunta"
      maxlength="2000"
      placeholder="Pregunte o busque algo"
      aria-describedby="asis-nota"
      aria-controls="asis-resultados"
      aria-autocomplete="list"
      enterkeyhint="send"
    />
    <button class="btn btn-primary asis__enviar" id="asis-enviar" type="submit">Preguntar</button>
    <ul class="asis__resultados" id="asis-resultados" role="listbox" hidden></ul>
  </form>

  <p class="asis__nota" id="asis-nota"></p>

  <div class="asis__atajos" id="asis-atajos" aria-label="Preguntas frecuentes"></div>

  <div class="asis__pie">
    <div class="asis__recientes" id="asis-recientes-caja" hidden>
      <h3 class="asis__titulo-chico">Recientes</h3>
      <ul class="asis__lista-recientes" id="asis-recientes"></ul>
      <a class="asis__nueva" id="asis-nueva" href="/admin" hidden>Empezar otra conversación</a>
    </div>

    <details class="asis__consumo" id="asis-consumo" hidden>
      <summary>Consumo y topes del asistente</summary>
      <div class="asis__consumo-cuerpo" id="asis-consumo-cuerpo">
        <p class="asis__nota">Cargando…</p>
      </div>
    </details>
  </div>
</section>

<style>
  .asis {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 16px 16px 4px;
  }
  @media (min-width: 768px) {
    .asis { padding: 20px 24px 4px; }
  }

  .asis__saludo {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: -0.01em;
  }
  .asis__sub { margin: 2px 0 0; color: var(--muted); }

  /* Caja */
  .asis__caja {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: 12px;
    padding: 6px 6px 6px 12px;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--color-primary) 8%, transparent);
    transition: border-color .15s, box-shadow .15s;
  }
  .asis__caja:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-accent) 22%, transparent);
  }
  .asis__icono { display: inline-flex; color: var(--muted); }
  .asis__entrada {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    font-size: 15px;
    color: var(--color-text);
    padding: 8px 0;
  }
  .asis__entrada::placeholder { color: var(--muted-2); }
  /* El foco lo marca la caja entera (:focus-within); el estilo global de input no aplica aquí. */
  .asis__entrada:focus { border: 0; box-shadow: none; outline: none; }
  .asis__enviar { height: 34px; padding: 0 14px; border-radius: 8px; flex-shrink: 0; }

  .asis__resultados {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 6px);
    z-index: 30;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: 10px;
    box-shadow: 0 8px 24px color-mix(in oklab, var(--color-primary) 14%, transparent);
    max-height: 320px;
    overflow: auto;
  }
  .asis__resultados :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 6px;
    text-decoration: none;
  }
  .asis__resultados :global(a:hover),
  .asis__resultados :global(a[aria-selected="true"]) { background: var(--active-bg); }
  .asis__resultados :global(.asis__res-detalle) { color: var(--muted); font-size: 12px; }
  .asis__resultados :global(.asis__res-tipo) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: var(--muted-2);
  }

  .asis__nota { margin: 0; color: var(--muted); font-size: 12px; min-height: 1em; }
  .asis__nota:empty { display: none; }

  /* Atajos */
  .asis__atajos { display: flex; flex-wrap: wrap; gap: 8px; }
  .asis__atajos :global(button) {
    border: 1px solid var(--rule-2);
    background: var(--paper);
    color: var(--color-text);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 12.5px;
  }
  .asis__atajos :global(button:hover) { background: var(--active-bg); border-color: var(--color-accent); }

  /* Hilo */
  .asis__hilo { display: flex; flex-direction: column; gap: 16px; }
  .asis__hilo:empty { display: none; }
  .asis__hilo :global(.asis-turno) { display: flex; flex-direction: column; gap: 8px; }
  .asis__hilo :global(.asis-pregunta) {
    align-self: flex-end;
    max-width: min(560px, 90%);
    background: var(--shell-dark);
    color: var(--shell-dark-text);
    padding: 8px 12px;
    border-radius: 12px 12px 2px 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .asis__hilo :global(.asis-pasos) {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .asis__hilo :global(.asis-paso) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
    background: var(--subtle);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 3px 10px;
  }
  .asis__hilo :global(.asis-paso::before) {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .asis__hilo :global(.asis-respuesta) {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 12px 12px 12px 2px;
    padding: 12px 14px;
    line-height: 1.55;
    font-size: 13.5px;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .asis__hilo :global(.asis-respuesta:empty) { display: none; }
  .asis__hilo :global(.asis-respuesta p) { margin: 0 0 8px; }
  .asis__hilo :global(.asis-respuesta p:last-child) { margin-bottom: 0; }
  .asis__hilo :global(.asis-respuesta ul) { margin: 0 0 8px; padding-left: 18px; }
  .asis__hilo :global(.asis-respuesta a) {
    color: var(--accent-ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .asis__hilo :global(.asis-escribiendo) { color: var(--muted); font-size: 12px; }
  .asis__hilo :global(.asis-aviso) {
    display: flex;
    gap: 8px;
    align-items: flex-start;
    background: var(--c-warning-bg);
    border: 1px solid var(--c-warning-border);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12.5px;
  }
  .asis__hilo :global(.asis-error) {
    background: var(--c-error-bg);
    border: 1px solid var(--c-error-border);
    color: var(--c-error);
    border-radius: 8px;
    padding: 8px 10px;
  }
  .asis__hilo :global(.asis-error a) { color: inherit; font-weight: 600; }

  /* Tarjeta de aprobación */
  .asis__hilo :global(.asis-tarjeta) {
    background: var(--paper);
    border: 1px solid var(--rule-2);
    border-radius: 12px;
    box-shadow: 0 2px 10px color-mix(in oklab, var(--color-primary) 8%, transparent);
    overflow: hidden;
  }
  .asis__hilo :global(.asis-tarjeta__cabeza) {
    padding: 12px 14px 10px;
    background: var(--subtle);
    border-bottom: 1px solid var(--rule);
  }
  .asis__hilo :global(.asis-tarjeta__rotulo) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--accent-ink);
    font-weight: 600;
  }
  .asis__hilo :global(.asis-tarjeta__rotulo::before) {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .asis__hilo :global(.asis-tarjeta__titulo) { margin: 4px 0 0; font-size: 15px; font-weight: 600; color: var(--color-primary); }
  .asis__hilo :global(.asis-tarjeta__contexto) { margin: 2px 0 0; color: var(--muted); font-size: 12px; }
  .asis__hilo :global(.asis-tarjeta__cambios) { width: 100%; border-collapse: collapse; font-size: 13px; }
  .asis__hilo :global(.asis-tarjeta__cambios th),
  .asis__hilo :global(.asis-tarjeta__cambios td) {
    text-align: left;
    padding: 8px 14px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    overflow-wrap: anywhere;
  }
  .asis__hilo :global(.asis-tarjeta__cambios th) { color: var(--muted); font-weight: 500; width: 28%; }
  .asis__hilo :global(.asis-antes) { color: var(--muted-2); text-decoration: line-through; margin-right: 6px; }
  .asis__hilo :global(.asis-flecha) { color: var(--muted-2); margin-right: 6px; }
  .asis__hilo :global(.asis-despues) {
    font-weight: 600;
    color: var(--color-primary);
    background: color-mix(in oklab, var(--ok) 10%, white);
    border-radius: 4px;
    padding: 0 4px;
  }
  .asis__hilo :global(.asis-vacio) { color: var(--muted-2); font-style: italic; margin-right: 6px; }
  .asis__hilo :global(.asis-tarjeta__avisos) { margin: 0; padding: 10px 14px 0; list-style: none; display: grid; gap: 8px; }
  .asis__hilo :global(.asis-tarjeta__avisos li) {
    background: var(--c-warning-bg);
    border: 1px solid var(--c-warning-border);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-text);
  }
  .asis__hilo :global(.asis-tarjeta__opciones) { padding: 10px 14px 0; display: grid; gap: 6px; }
  .asis__hilo :global(.asis-tarjeta__opciones label) { display: inline-flex; gap: 8px; align-items: center; cursor: pointer; }
  .asis__hilo :global(.asis-tarjeta__acciones) { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 12px 14px 4px; }
  .asis__hilo :global(.asis-tarjeta__nota) { margin: 0; padding: 4px 14px 12px; color: var(--muted); font-size: 12px; }
  .asis__hilo :global(.asis-tarjeta__sello) {
    margin: 0;
    padding: 10px 14px 12px;
    font-weight: 600;
    font-size: 12.5px;
  }
  .asis__hilo :global(.asis-tarjeta[data-decision="aprobada"] .asis-tarjeta__sello) { color: var(--ok); }
  .asis__hilo :global(.asis-tarjeta[data-decision="descartada"] .asis-tarjeta__sello),
  .asis__hilo :global(.asis-tarjeta[data-decision="cambios"] .asis-tarjeta__sello) { color: var(--muted); }

  /* Pie: recientes y consumo */
  .asis__pie { display: grid; gap: 12px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 1024px) {
    .asis__pie { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); align-items: start; }
  }
  .asis__titulo-chico { margin: 0 0 6px; font-size: 12px; color: var(--muted-2); font-weight: 500; text-transform: uppercase; letter-spacing: .04em; }
  .asis__lista-recientes { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .asis__lista-recientes :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 8px;
    border-radius: 6px;
    text-decoration: none;
    color: var(--color-text);
  }
  .asis__lista-recientes :global(a:hover) { background: var(--hover); }
  .asis__lista-recientes :global(.asis-rec-texto) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .asis__lista-recientes :global(.asis-rec-marca) {
    flex-shrink: 0;
    font-size: 11px;
    color: var(--accent-ink);
    background: var(--active-bg);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .asis__nueva { display: inline-block; margin-top: 6px; font-size: 12px; color: var(--accent-ink); }
  .asis__nueva[hidden] { display: none; }

  .asis__consumo {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 10px;
    padding: 8px 12px;
  }
  .asis__consumo summary { cursor: pointer; color: var(--muted); font-size: 12.5px; }
  .asis__consumo-cuerpo { display: grid; gap: 10px; padding-top: 10px; }
  .asis__consumo-cuerpo :global(dl) { margin: 0; display: grid; grid-template-columns: auto auto; gap: 4px 12px; }
  .asis__consumo-cuerpo :global(dt) { color: var(--muted); }
  .asis__consumo-cuerpo :global(dd) { margin: 0; font-family: var(--font-mono); text-align: right; }
  .asis__consumo-cuerpo :global(form) { display: grid; gap: 8px; }
  .asis__consumo-cuerpo :global(label) { display: grid; gap: 4px; font-size: 12px; color: var(--muted); }
  .asis__consumo-cuerpo :global(input) {
    font: inherit;
    padding: 6px 8px;
    border: 1px solid var(--rule-2);
    border-radius: 6px;
    background: var(--paper);
    color: var(--color-text);
  }

  /* Con conversación, la caja baja debajo del hilo y los atajos se ocultan. */
  .asis.is-chat .asis__cabeza { order: 0; }
  .asis.is-chat .asis__hilo { order: 1; }
  .asis.is-chat .asis__caja {
    order: 2;
    position: sticky;
    bottom: 16px;
    z-index: 20;
  }
  .asis.is-chat .asis__nota { order: 3; }
  .asis.is-chat .asis__atajos { display: none; }
  .asis.is-chat .asis__pie { order: 4; }
  .asis.is-chat .asis__resultados { top: auto; bottom: calc(100% + 6px); }

  .visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  import { iniciarAsistente } from './asistente-cliente';
  iniciarAsistente();
</script>
