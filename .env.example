# Variables de entorno para DobleYo Café
# Copia este archivo a .env en la raíz del proyecto y completa los valores.
# NUNCA subas el archivo .env real al repositorio.

# ── Entorno ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
SITE_BASE_URL=https://dobleyo.cafe

# ── Base de Datos (Turso/libSQL) ─────────────────────────────────────────────
# URL remota: libsql://tu-db.turso.io  (producción)
# URL local:  file:local.db            (desarrollo sin auth token)
# Crear en:   https://turso.tech → Dashboard → Create Database
TURSO_DATABASE_URL=libsql://tu-db-nombre.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Mínimo 32 caracteres. Usar: openssl rand -base64 48
JWT_SECRET=cambia_esto_en_produccion_minimo_32_chars
JWT_REFRESH_SECRET=cambia_esto_en_produccion_minimo_32_chars_refresh

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Debe ser de un dominio verificado en Resend (SPF + DKIM), si no Resend rechaza el envío.
RESEND_FROM_EMAIL=noreply@dobleyo.cafe
RESEND_FROM_NAME=DobleYo Café
# A dónde llegan las respuestas de los clientes (por defecto ADMIN_EMAIL).
RESEND_REPLY_TO=hola@dobleyo.cafe
# Secreto del webhook (Resend > Webhooks), empieza por whsec_. Eventos: email.bounced, email.complained.
# URL del webhook: https://dobleyo.cafe/api/emails/webhook
RESEND_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Admin inicial (solo para script de setup) ─────────────────────────────────
ADMIN_EMAIL=admin@dobleyo.cafe
ADMIN_PASSWORD=contraseña_segura_min_12_chars
SETUP_SECRET_KEY=string_aleatorio_para_proteger_endpoint_setup

# ── Crons protegidos (Vercel Cron) ────────────────────────────────────────────
# Protege los endpoints disparados por cron: la analítica de demanda
# (api/ml/recompute.py) y el sync automático de MercadoLibre
# (GET /api/mercadolibre/cron-sync). Vercel Cron envía
# "Authorization: Bearer <CRON_SECRET>" automáticamente. Genere uno aleatorio.
CRON_SECRET=string_aleatorio_para_proteger_crons

# ── Pasarelas de Pago ─────────────────────────────────────────────────────────

# Wompi (Colombia) — https://dashboard.wompi.co/
WOMPI_PUBLIC_KEY=pub_prod_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_prod_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_SECRET=prod_events_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=prod_integrity_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Base del API de Wompi: producción https://production.wompi.co · pruebas https://sandbox.wompi.co
WOMPI_API_BASE=https://production.wompi.co

# Suscripción de café (cobro recurrente con fuente de pago Wompi)
SUBSCRIPTION_DISCOUNT_PERCENT=10
# Secreto que protege POST /api/subscriptions/run-billing (lo invoca un scheduler externo)
SUBSCRIPTIONS_CRON_SECRET=cambieme_por_un_string_aleatorio_largo

# MercadoPago (Colombia/LATAM) — https://www.mercadopago.com.co/
MERCADOPAGO_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MERCADOPAGO_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Tope de monto para pedidos con pago contraentrega (COP)
COD_MAX_TOTAL_COP=300000

# ── Logística de envíos (Mipaquete.com) ───────────────────────────────────────
# Documentación API v2: https://api.documentacion.mipaquete.com/
# apikey se genera UNA VEZ con POST /generateapikey {email,password} — nunca
# guarde el email/password del vendedor en el repo, solo el apikey resultante.
MIPAQUETE_API_URL=https://api-v2.mipaquete.com
MIPAQUETE_API_KEY=
MIPAQUETE_SESSION_TRACKER=
MIPAQUETE_USER_ID=
# Código DANE (8 dígitos) de la bodega/finca de despacho
MIPAQUETE_ORIGIN_DANE=
MIPAQUETE_SENDER_NAME=DobleYo
MIPAQUETE_SENDER_SURNAME=Cafe
MIPAQUETE_SENDER_CELLPHONE=
MIPAQUETE_SENDER_EMAIL=
MIPAQUETE_SENDER_NIT=
MIPAQUETE_SENDER_NIT_TYPE=NIT
MIPAQUETE_SENDER_PICKUP_ADDRESS=
# Código paymentType de Mipaquete para contraentrega — CONFIRMAR en sandbox
# antes de habilitar COD en producción (ver server/services/mipaquete.js)
MIPAQUETE_PAYMENT_TYPE_COD=102
# Secreto propio (no de Mipaquete) para proteger POST /api/shipping/webhook
MIPAQUETE_WEBHOOK_TOKEN=cambieme_por_un_string_aleatorio_largo

# ── Interrapidísimo (API B2B directa, cuenta de crédito corporativa) ──────────
# Credenciales, firma y hosts de producción los entrega el asesor comercial de
# Inter. Sin INTER_*_URL se usan los hosts de PRUEBAS (stgwww3).
INTER_USER=
INTER_PASSWORD=
INTER_SIGNATURE=
INTER_CLIENT_ID=
INTER_BRANCH_ID=
# Código DANE de despacho; si se omite se usa MIPAQUETE_ORIGIN_DANE
INTER_ORIGIN_DANE=
INTER_AUTH_URL=
INTER_VENTA_URL=
INTER_COTIZADOR_URL=
# El documento define el token como GET con body; si POST falla en pruebas, probar GET
INTER_AUTH_METHOD=POST

# ── Envia.com (agregador de transportadoras) ─────────────────────────────────
# Token en Envia.com → Developer → API Keys. El de sandbox no sirve en producción.
ENVIA_TOKEN=
# sandbox (por defecto, no genera guías reales) | production
ENVIA_ENV=sandbox
# Transportadoras a cotizar (Envia exige cotizar una por una)
ENVIA_CARRIERS=coordinadora,servientrega,interrapidisimo,tcc,deprisa
# Código DANE de despacho; si se omite se usa MIPAQUETE_ORIGIN_DANE
ENVIA_ORIGIN_DANE=
# Remitente que aparece en la guía y dirección de recogida
ENVIA_SENDER_NAME=DobleYo Café
ENVIA_SENDER_COMPANY=DobleYo Café
ENVIA_SENDER_PHONE=
ENVIA_SENDER_EMAIL=
ENVIA_SENDER_ADDRESS=
ENVIA_SENDER_NIT=
# Franja de recogida (horas, 24 h) y tamaño de la etiqueta
ENVIA_PICKUP_FROM=9
ENVIA_PICKUP_TO=17
ENVIA_PRINT_SIZE=STOCK_4X6
# Secreto propio para proteger POST /api/shipping/envia/webhook
ENVIA_WEBHOOK_TOKEN=cambieme_por_un_string_aleatorio_largo

# ── MercadoLibre (sincronización de órdenes) ──────────────────────────────────
# Sync automático: cron cada 6 h (GET /api/mercadolibre/cron-sync, protegido por
# CRON_SECRET). Tiempo casi-real: registre el webhook POST /api/mercadolibre/webhook
# en su app de MercadoLibre (topic orders_v2).
ML_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX-XXXXXXXXX
ML_SELLER_ID=123456789

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Obtener en: https://console.cloud.google.com/ → APIs & Services → Credentials
# Tipo: OAuth 2.0 Client ID (Web application)
# Authorized JS origins: https://dobleyo.cafe
# Nota: el prefijo PUBLIC_ expone la variable al cliente (requerido por Astro)
PUBLIC_GOOGLE_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
# Service ID creado en Apple Developer > Certificates, Identifiers & Profiles
# Configurar: Return URL = https://dobleyo.cafe, Domains = dobleyo.cafe
PUBLIC_APPLE_CLIENT_ID=cafe.dobleyo.signin
APPLE_CLIENT_ID=cafe.dobleyo.signin

# ── GitHub OAuth (login de administradores en /admin/login) ──────────────────
# Crear una OAuth App en GitHub > Settings > Developer settings > OAuth Apps.
# Authorization callback URL: <SITE_BASE_URL>/api/auth/github/callback
# GitHub admite una sola URL de callback por app: para local, crear otra app
# apuntando a http://localhost:4321/api/auth/github/callback.
# Las cuentas autorizadas están en ADMIN_GITHUB_ACCOUNTS (server/routes/auth.js).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Credenciales de desarrollo (acceso directo al panel admin) ───────────────
# Si están definidas, permiten login con estas credenciales sin consultar la BD.
# Omitir en producción o dejar vacías para deshabilitar.
DEV_USER=
DEV_PASSWORD=

# ── Notificaciones push (ntfy) ───────────────────────────────────────────────
# Avisos operativos al celular vía https://ntfy.sh o una instancia propia.
# Sin NTFY_TOPIC el servicio queda inactivo (no rompe nada, solo no envía).
# Suscríbase al mismo topic desde la app de ntfy (Android/iOS/web).
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Token de acceso, solo si el topic está protegido (instancia propia o ntfy Pro)
NTFY_TOKEN=
# Secreto para que un cron externo pueda llamar
# POST /api/notifications/pending-intake con el header x-cron-secret
NTFY_CRON_SECRET=

# ── Tests / CI ────────────────────────────────────────────────────────────────
# Para tests locales con Playwright E2E
PLAYWRIGHT_BASE_URL=http://localhost:4321
